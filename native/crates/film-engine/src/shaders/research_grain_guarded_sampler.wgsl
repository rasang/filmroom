fn sr_prepare_binomial(n:u32,pb:vec2<u32>)->SrBinomialSetup{
 let nf=sf_integer(n);if(sf_cmp(pb,vec2<u32>(0x00000000u,0x3fe00000u))<=0){if(sf_cmp(sf_mul(pb,nf),vec2<u32>(0x00000000u,0x403e0000u))<=0){return sr_prepare_inversion(n,pb);}return sr_prepare_btpe(n,pb);}
 let q=sf_sub(vec2<u32>(0x00000000u,0x3ff00000u),pb);if(sf_cmp(sf_mul(q,nf),vec2<u32>(0x00000000u,0x403e0000u))<=0){return sr_prepare_inversion(n,q);}return sr_prepare_btpe(n,q);
}
