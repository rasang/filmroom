+#[test]
+fn the_five_original_trees_and_signed_zero_guards_are_fixed() {
+    let local = functions(KERNEL).unwrap();
+    let main = local["main"];
+    assert_ordered(main, &[
+        "if (operation == 1u) {\n        result = OP_ZERO;",
+        "else if (operation == 2u)",
+        "let weighted = op_mul(parameter, x1)",
+        "result = op_add(x0, weighted)",
+        "else if (operation == 3u)",
+        "let source_weight = op_sub(OP_ONE, parameter)",
+        "let source_part = op_mul(source_weight, x0)",
+        "let core_weight = op_sub(OP_ONE, tail_weight)",
+        "let core_part = op_mul(core_weight, x1)",
+        "let tail_part = op_mul(tail_weight, x2)",
+        "let mixture = op_add(core_part, tail_part)",
+        "let scatter_part = op_mul(parameter, mixture)",
+        "result = op_add(source_part, scatter_part)",
+        "else if (operation == 4u)",
+        "let bounce = op_mul(parameter, x1)",
+        "result = op_add(x0, bounce)",
+        "result = op_div(x0, parameter)",
+    ]);
+    let scatter = main.split("else if (operation == 3u)").nth(1).unwrap()
+        .split("else if (operation == 4u)").next().unwrap();
+    assert_eq!(scatter.matches("op_sub(").count(), 2);
+    assert_eq!(scatter.matches("op_mul(").count(), 4);
+    assert_eq!(scatter.matches("op_add(").count(), 2);
+    assert_eq!(local["op_sub"].matches("op_add(a, sf_neg(b))").count(), 1);
+    assert!(local["op_add"].contains("(a.y & b.y) & 0x80000000u"));
+    for name in ["op_mul", "op_div"] {
+        assert!(local[name].contains("(a.y ^ b.y) & 0x80000000u"));
+    }
+    assert_ordered(local["op_div"], &[
+        "let a_ok = op_accept(a)", "let b_ok = op_accept(b)",
+        "if (!a_ok || !b_ok)", "if (sf_zero(b))",
+        "if (sf_cmpu(sf_abs(b), OP_DIVISOR_FLOOR) < 0)",
+        "if (sf_zero(a))", "let result = sf_div(a, b)", "op_accept(result)",
