+#[test]
+fn capacities_and_all_retained_host_payload_are_budgeted() {
+    let p = one(Job::divide(b(1.05)).unwrap(), [0.25, 0.0, 0.0]);
+    let r = Resources::fixed();
+    let expected = p.words.capacity() as u64 * 8 + r.upload_bytes + 17 * 8 + 4096 + 8192 + 65536;
+    assert_eq!(p.host_payload_bytes(r.upload_bytes, 17, 4096, 8192).unwrap(), expected);
+    assert!(p.host_payload_bytes(u64::MAX, 0, 0, 0).is_err());
+    assert!(p.host_payload_bytes(0, usize::MAX, 0, 0).is_err());
+    assert!(p.host_payload_bytes(0, 0, 0, r.host_bytes).is_err());
+    // Extra capacity counts even when the packet's logical length is unchanged.
+    let mut q = p.clone(); q.words.reserve_exact(4096);
+    assert!(q.host_payload_bytes(0, 0, 0, 0).unwrap() > p.host_payload_bytes(0, 0, 0, 0).unwrap());
+}
