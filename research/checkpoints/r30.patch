+#[test]
+fn actual384_parameter_fixture_and_original_scalar_preparation_are_pinned() {
+    let text = include_str!("actual384_params.json");
+    assert_eq!(format!("{:x}", Sha256::digest(text.as_bytes())),
+        "613ca4d2479226e62d7854bc4c502bc08cc4d3eedba418cb3e66ce7da5c4dfca");
+    let p: spektrafilm_core::params::RuntimeParams = serde_json::from_str(text).unwrap();
+    assert_eq!(p.camera.pixel_size_um_override, Some(10.0));
+    let h = &p.film_render.halation;
+    assert_eq!(h.halation_n_bounces, 3);
+    assert_eq!(h.scatter_amount.to_bits(), b(1.0));
+    assert_eq!(h.scatter_tail_weight.map(b), [b(0.78), b(0.65), b(0.67)]);
+    let strengths = h.halation_strength.map(|a| a * h.halation_amount);
+    assert_eq!(strengths.map(b), [b(0.05), b(0.015), b(0.0)]);
+    let mut weights: Vec<f64> = (0..h.halation_n_bounces)
+        .map(|k| h.halation_bounce_decay.powi(k as i32)).collect();
+    let sum: f64 = weights.iter().sum();
+    for value in &mut weights { *value /= sum; }
+    assert_eq!(weights.iter().copied().map(b).collect::<Vec<_>>(), vec![b(4.0/7.0), b(2.0/7.0), b(1.0/7.0)]);
+    for coefficient in [0.1633, 0.6496, 0.1870].into_iter().chain(weights) {
+        assert_exact(&one(Job::weighted_accum(b(coefficient)).unwrap(), [-0.125, 0.7, 0.0]));
+    }
+    for ch in 0..3 {
+        assert_exact(&one(Job::scatter(b(h.scatter_amount), b(h.scatter_tail_weight[ch])).unwrap(), [0.3, -0.1, 0.4]));
+        // Zero-strength primitive coverage does not assert that CPU schedules a blue bounce.
+        assert_exact(&one(Job::bounce_add(b(strengths[ch])).unwrap(), [0.3, 0.4, 0.0]));
+        assert_exact(&one(Job::divide(b(1.0 + strengths[ch])).unwrap(), [0.3, 0.0, 0.0]));
+    }
+}
