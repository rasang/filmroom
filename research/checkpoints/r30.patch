index 0000000000000000000000000000000000000000..2eef0b4d7102846f63de941e0d096d8e02167c3c
--- /dev/null
+++ b/native/crates/film-engine/src/research_optics64_point/kernel.wgsl
@@ -0,0 +1,149 @@
+// Closed point-only optics unit. Three input lanes are operand roles, not RGB.
+// Every candidate remains private until the whole dispatch's sticky flag is read.
+struct OpticsPointParameters { words: array<vec4<u32>, 4>, }
+@group(0) @binding(0) var<storage, read> optics_packet: array<vec2<u32>>;
+@group(0) @binding(1) var<storage, read_write> optics_result: array<vec2<u32>>;
+@group(0) @binding(2) var<storage, read_write> optics_error: atomic<u32>;
+@group(0) @binding(3) var<uniform> optics_parameters: OpticsPointParameters;
+const OP_CAPACITY: u32 = 4096u;
+const OP_PREFIX: u32 = 32u;
+const OP_PACKET_WORDS: u32 = 12320u;
+const OP_BOUND: vec2<u32> = vec2<u32>(0x20000000u, 0x430c6bf5u);
+const OP_DIVISOR_FLOOR: vec2<u32> = vec2<u32>(0xa0000000u, 0x3cd203afu);
+const OP_ZERO: vec2<u32> = vec2<u32>(0u);
+const OP_ONE: vec2<u32> = vec2<u32>(0u, 0x3ff00000u);
+
+fn op_reject() {
+    sf_failed = 1u;
+    atomicOr(&optics_error, 1u);
+}
+fn op_accept(value: vec2<u32>) -> bool {
+    if (sf_failed != 0u || !sf_valid(value)) { op_reject(); return false; }
+    if (sf_cmpu(sf_abs(value), OP_BOUND) > 0) { op_reject(); return false; }
+    return true;
+}
+fn op_canonical_zero(value: vec2<u32>) -> bool {
+    if (any(value != OP_ZERO)) { op_reject(); return false; }
+    return true;
+}
+fn op_add(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    let a_ok = op_accept(a);
+    let b_ok = op_accept(b);
+    if (!a_ok || !b_ok) { return SF_NAN; }
+    if (sf_zero(a) && sf_zero(b)) {
+        return vec2<u32>(0u, (a.y & b.y) & 0x80000000u);
+    }
+    let result = sf_add(a, b);
+    if (!op_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn op_sub(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    return op_add(a, sf_neg(b));
+}
+fn op_mul(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    let a_ok = op_accept(a);
+    let b_ok = op_accept(b);
+    if (!a_ok || !b_ok) { return SF_NAN; }
+    if (sf_zero(a) || sf_zero(b)) {
+        return vec2<u32>(0u, (a.y ^ b.y) & 0x80000000u);
+    }
+    let result = sf_mul(a, b);
+    if (!op_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn op_div(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    let a_ok = op_accept(a);
+    let b_ok = op_accept(b);
+    if (!a_ok || !b_ok) { return SF_NAN; }
+    if (sf_zero(b)) { op_reject(); return SF_NAN; }
+    // Existing conservative GPU admission floor, not a native CPU restriction.
+    if (sf_cmpu(sf_abs(b), OP_DIVISOR_FLOOR) < 0) { op_reject(); return SF_NAN; }
+    if (sf_zero(a)) {
+        return vec2<u32>(0u, (a.y ^ b.y) & 0x80000000u);
+    }
+    let result = sf_div(a, b);
+    if (!op_accept(result)) { return SF_NAN; }
+    return result;
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    // Do not reset or short-circuit on the request-wide atomic error. Each of
+    // the fixed 4096 invocations owns three input words, including late padding.
+    let header = optics_parameters.words[0];
+    let shape = optics_parameters.words[1];
+    let operation = header.y;
+    let count = header.z;
+    if (header.x != 1u || operation < 1u || operation > 5u ||
+        count == 0u || count > OP_CAPACITY || header.w != OP_CAPACITY ||
+        shape.x != OP_PREFIX || shape.y != 3u || shape.z != 1u ||
+        shape.w != 0x4f503634u ||
+        any(optics_parameters.words[2] != vec4<u32>(0u)) ||
+        any(optics_parameters.words[3] != vec4<u32>(0u)) ||
+        arrayLength(&optics_packet) != OP_PACKET_WORDS ||
+        arrayLength(&optics_result) != OP_CAPACITY ||
+        gid.x >= OP_CAPACITY || gid.y != 0u || gid.z != 0u) {
+        op_reject(); return;
+    }
+    // Exact lengths and the invocation bound have been checked before all
+    // storage indexing. The prefix is validated even for a one-point request.
+    let index = gid.x;
+    if (index < OP_PREFIX) {
+        let constant = optics_packet[index];
+        if ((index == 0u && operation != 1u) || (index == 1u && operation == 3u)) {
+            let constant_ok = op_accept(constant);
+        } else {
+            let constant_zero = op_canonical_zero(constant);
+        }
+    }
+    let at = OP_PREFIX + 3u * index;
+    let x0 = optics_packet[at];
+    let x1 = optics_packet[at + 1u];
+    let x2 = optics_packet[at + 2u];
+    if (index >= count || operation == 1u) {
+        let x0_zero = op_canonical_zero(x0);
+        let x1_zero = op_canonical_zero(x1);
+        let x2_zero = op_canonical_zero(x2);
+    } else {
+        let x0_ok = op_accept(x0);
+        if (operation == 5u) {
+            let x1_zero = op_canonical_zero(x1);
+        } else {
+            let x1_ok = op_accept(x1);
+        }
+        if (operation == 3u) {
+            let x2_ok = op_accept(x2);
+        } else {
+            let x2_zero = op_canonical_zero(x2);
+        }
+    }
+    // Never lose a private arithmetic failure through an inactive early return.
+    if (sf_failed != 0u) { op_reject(); return; }
+    if (index >= count) { return; }
+    let parameter = optics_packet[0u];
+    var result = OP_ZERO;
+    if (operation == 1u) {
+        result = OP_ZERO;
+    } else if (operation == 2u) {
+        let weighted = op_mul(parameter, x1);
+        result = op_add(x0, weighted);
+    } else if (operation == 3u) {
+        let tail_weight = optics_packet[1u];
+        let source_weight = op_sub(OP_ONE, parameter);
+        let source_part = op_mul(source_weight, x0);
+        let core_weight = op_sub(OP_ONE, tail_weight);
+        let core_part = op_mul(core_weight, x1);
+        let tail_part = op_mul(tail_weight, x2);
+        let mixture = op_add(core_part, tail_part);
+        let scatter_part = op_mul(parameter, mixture);
+        result = op_add(source_part, scatter_part);
+    } else if (operation == 4u) {
+        let bounce = op_mul(parameter, x1);
+        result = op_add(x0, bounce);
+    } else {
+        result = op_div(x0, parameter);
+    }
+    if (!op_accept(result)) { return; }
+    if (sf_failed != 0u) { op_reject(); return; }
+    optics_result[index] = result;
+}
