@@ -0,0 +1,462 @@
+//! Closed optics point shader composition. Shared arithmetic is extracted,
+//! never rewritten. Source tests are definitions, not evidence of execution.
+use crate::research_grain::soft64;
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub(super) const LAYOUT: &str =
+    "opticsPacket64:read,scalarResult64:read_write,error:atomic_u32,parameters:array_vec4_u32_4";
+pub(super) const SHARED_SHA256: &str =
+    "7173a5998b5fc2d22434f12cd07b5b81091e25d4f5ac05c2923fe79947fd5ce1";
+pub(super) const KERNEL_SHA256: &str =
+    "84dd20d5ba31321c91209bc55a2d188df2c796c61548270b22e0bf42ee83dfb4";
+pub(super) const GENERATED_SHA256: &str = "902b93644cb850975467498c038e416aab5939f31a3c18ad98cce9dd0f01bbf7";
+pub(super) const POINT_CAPACITY: usize = 4096;
+pub(super) const PREFIX_WORDS: usize = 32;
+pub(super) const PACKET_WORDS: usize = 12_320;
+pub(super) const HEADER_WORDS: usize = 16;
+pub(super) const WORKGROUP_SIZE: u32 = 64;
+pub(super) const WORKGROUPS: u32 = 64;
+const KERNEL: &str = include_str!("kernel.wgsl");
+const DECLARATIONS: [&str; 2] = [
+    "const SF_NAN:vec2<u32>=vec2<u32>(0u,0x7ff80000u);",
+    "var<private> sf_failed:u32;",
+];
+const HELPERS: [&str; 17] = [
+    "sf_abs", "sf_add", "sf_addu", "sf_cmpu", "sf_div", "sf_exp", "sf_fail", "sf_jam",
+    "sf_mul", "sf_neg", "sf_round", "sf_shl", "sf_shr", "sf_sig", "sf_subu", "sf_valid",
+    "sf_zero",
+];
+const LOCAL_FUNCTIONS: [&str; 8] = [
+    "main", "op_accept", "op_add", "op_canonical_zero", "op_div", "op_mul", "op_reject",
+    "op_sub",
+];
+const FORBIDDEN: [&str; 14] = [
+    "f16", "f32", "f64", "sf_scalar", "sf_log", "sf_exp_nonpositive", "sf_sqrt",
+    "sf_integer", "sf_floor", "fma", "pow", "sqrt", "exp", "log",
+];
+const ERROR: &str = "GPU_OPTICS64_POINT_SHADER_IDENTITY";
+const CLOSURE_ERROR: &str = "GPU_OPTICS64_POINT_SHADER_CLOSURE";
+
+pub(super) fn shader() -> super::R<String> {
+    compose(soft64::SHADER, KERNEL)
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+#[derive(Clone, Copy)]
+struct Token<'a> {
+    text: &'a str,
+    start: usize,
+    end: usize,
+}
+
+// Parse byte spans while excluding comments from both function discovery and
+// reachability. WGSL has no string literals; non-ASCII outside comments rejects.
+fn tokens(source: &str) -> super::R<Vec<Token<'_>>> {
+    let bytes = source.as_bytes();
+    let mut out = Vec::new();
+    let mut cursor = 0;
+    while cursor < bytes.len() {
+        if bytes[cursor].is_ascii_whitespace() {
+            cursor += 1;
+        } else if bytes[cursor..].starts_with(b"//") {
+            cursor += 2;
+            while cursor < bytes.len() && bytes[cursor] != b'\n' {
+                cursor += 1;
+            }
+        } else if bytes[cursor..].starts_with(b"/*") {
+            cursor += 2;
+            let mut depth = 1usize;
+            while cursor < bytes.len() && depth != 0 {
+                if bytes[cursor..].starts_with(b"/*") {
+                    depth = depth.checked_add(1).ok_or(ERROR)?;
+                    cursor += 2;
+                } else if bytes[cursor..].starts_with(b"*/") {
+                    depth = depth.checked_sub(1).ok_or(ERROR)?;
+                    cursor += 2;
+                } else {
+                    cursor += 1;
+                }
+            }
+            if depth != 0 {
+                return Err(ERROR.into());
+            }
+        } else {
+            let start = cursor;
+            if !bytes[cursor].is_ascii() {
+                return Err(ERROR.into());
+            }
+            cursor += 1;
+            if bytes[start].is_ascii_alphanumeric() || bytes[start] == b'_' {
+                while cursor < bytes.len()
+                    && (bytes[cursor].is_ascii_alphanumeric() || bytes[cursor] == b'_')
+                {
+                    cursor += 1;
+                }
+            }
+            out.push(Token {
+                text: &source[start..cursor],
+                start,
+                end: cursor,
+            });
+        }
+    }
+    Ok(out)
+}
+
+fn identifier(text: &str) -> bool {
+    text.as_bytes()
+        .first()
+        .map(|b| b.is_ascii_alphabetic() || *b == b'_')
+        .unwrap_or(false)
+        && text.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+}
+
+fn identifiers(source: &str) -> super::R<BTreeSet<&str>> {
+    Ok(tokens(source)?
+        .into_iter()
+        .map(|token| token.text)
+        .filter(|text| identifier(text))
+        .collect())
+}
+
+fn functions(source: &str) -> super::R<BTreeMap<String, &str>> {
+    let tokens = tokens(source)?;
+    let mut out = BTreeMap::new();
+    let mut cursor = 0;
+    while cursor < tokens.len() {
+        if tokens[cursor].text != "fn" {
+            cursor += 1;
+            continue;
+        }
+        let start = tokens[cursor].start;
+        let name = tokens.get(cursor + 1).ok_or(ERROR)?.text;
+        if !identifier(name) || tokens.get(cursor + 2).ok_or(ERROR)?.text != "(" {
+            return Err(ERROR.into());
+        }
+        cursor += 3;
+        while cursor < tokens.len() && tokens[cursor].text != "{" {
+            cursor += 1;
+        }
+        if cursor == tokens.len() {
+            return Err(ERROR.into());
+        }
+        let mut depth = 0usize;
+        let mut end = None;
+        while cursor < tokens.len() {
+            match tokens[cursor].text {
+                "{" => depth = depth.checked_add(1).ok_or(ERROR)?,
+                "}" => {
+                    depth = depth.checked_sub(1).ok_or(ERROR)?;
+                    if depth == 0 {
+                        end = Some(tokens[cursor].end);
+                        cursor += 1;
+                        break;
+                    }
+                }
+                _ => {}
+            }
+            cursor += 1;
+        }
+        let end = end.ok_or(ERROR)?;
+        if out.insert(name.to_owned(), &source[start..end]).is_some() {
+            return Err(ERROR.into());
+        }
+    }
+    Ok(out)
+}
+
+fn reachable(all: &BTreeMap<String, &str>, root: &str) -> super::R<BTreeSet<String>> {
+    if !all.contains_key(root) {
+        return Err(CLOSURE_ERROR.into());
+    }
+    let mut reached = BTreeSet::from([root.to_owned()]);
+    loop {
+        let mut next = reached.clone();
+        for name in &reached {
+            for name in identifiers(all[name])? {
+                if all.contains_key(name) {
+                    next.insert(name.to_owned());
+                } else if name.starts_with("sf_") && name != "sf_failed" {
+                    return Err(CLOSURE_ERROR.into());
+                }
+            }
+        }
+        if next == reached {
+            return Ok(reached);
+        }
+        reached = next;
+    }
+}
+
+fn compose(shared: &str, kernel: &str) -> super::R<String> {
+    if digest(shared.as_bytes()) != SHARED_SHA256 || digest(kernel.as_bytes()) != KERNEL_SHA256 {
+        return Err(ERROR.into());
+    }
+    let shared_functions = functions(shared)?;
+    let local_functions = functions(kernel)?;
+    let local_names: BTreeSet<String> = LOCAL_FUNCTIONS.into_iter().map(str::to_owned).collect();
+    if shared_functions.len() != 26
+        || local_functions.keys().cloned().collect::<BTreeSet<_>>() != local_names
+        || shared_functions.keys().any(|name| local_functions.contains_key(name))
+    {
+        return Err(CLOSURE_ERROR.into());
+    }
+    let mut all = shared_functions.clone();
+    all.extend(local_functions.clone());
+    let reached = reachable(&all, "main")?;
+    let wanted: BTreeSet<String> = HELPERS
+        .into_iter()
+        .chain(LOCAL_FUNCTIONS)
+        .map(str::to_owned)
+        .collect();
+    if reached != wanted {
+        return Err(CLOSURE_ERROR.into());
+    }
+    let mut output = String::new();
+    for declaration in DECLARATIONS {
+        if shared.matches(declaration).count() != 1 || kernel.contains(declaration) {
+            return Err(ERROR.into());
+        }
+        let start = shared.find(declaration).ok_or(ERROR)?;
+        output.push_str(&shared[start..start + declaration.len()]);
+        output.push('\n');
+    }
+    for helper in HELPERS {
+        output.push_str(shared_functions.get(helper).ok_or(CLOSURE_ERROR)?);
+        output.push('\n');
+    }
+    output.push_str(kernel);
+    let output_identifiers = identifiers(&output)?;
+    if FORBIDDEN.into_iter().any(|name| output_identifiers.contains(name)) {
+        return Err(ERROR.into());
+    }
+    // Fail closed if a body, declaration, helper set or generated byte changes.
+    let output_functions = functions(&output)?;
+    if output_functions.keys().cloned().collect::<BTreeSet<_>>() != wanted {
+        return Err(CLOSURE_ERROR.into());
+    }
+    for name in &reached {
+        if output_functions.get(name) != all.get(name) {
+            return Err(ERROR.into());
+        }
+    }
+    for declaration in DECLARATIONS {
+        if output.matches(declaration).count() != 1 {
+            return Err(ERROR.into());
+        }
+    }
+    if digest(output.as_bytes()) != GENERATED_SHA256 {
+        return Err(ERROR.into());
+    }
+    Ok(output)
+}
