+use super::*;
+use host::{Guard, guarded_model, native_oracle};
+use sha2::{Digest, Sha256};
+
+fn b(x: f64) -> u64 { x.to_bits() }
+fn one(job: Job, values: [f64; 3]) -> Packet {
+    Packet::new(job, &[values.map(b)]).unwrap()
+}
+fn assert_exact(packet: &Packet) {
+    let expected = native_oracle(packet).unwrap();
+    let actual = guarded_model(packet).unwrap();
+    assert_eq!(actual, expected, "operation {:?}", packet.job.operation);
+}
+fn jobs() -> Vec<Job> {
+    vec![Job::clear(), Job::weighted_accum(b(0.1633)).unwrap(),
+        Job::scatter(b(1.0), b(0.78)).unwrap(), Job::bounce_add(b(0.05)).unwrap(),
+        Job::divide(b(1.05)).unwrap()]
+}
+fn row_for(job: Job, row: [u64; 3]) -> [u64; 3] {
+    let mut row = row;
+    row[job.operation.used_lanes()..].fill(0);
+    row
+}
+
+#[test]
+fn fixed_resource_and_full_family_accounting_are_exact() {
+    let r = Resources::fixed();
+    assert_eq!(r.packet_bytes, 98560);
+    assert_eq!(r.output_bytes, 32768);
+    assert_eq!(r.map_bytes, 32772);
+    assert_eq!(r.error_bytes, 4);
+    assert_eq!(r.uniform_bytes, 64);
+    assert_eq!(r.pool_bytes, 164168);
+    assert_eq!(r.upload_bytes, 98624);
+    assert_eq!(r.pool_bytes + r.upload_bytes + r.margin_bytes, 328328);
+    assert_eq!(r.device_bytes, 64 * MIB);
+    assert_eq!(r.fixed_bytes, r.host_bytes + r.helper_bytes);
+    assert_eq!(r.fixed_bytes, 128 * MIB);
+    assert_eq!(r.family_bytes, 64 * MIB);
+    assert_eq!(r.combined_bytes, r.fixed_bytes + r.family_bytes + r.device_bytes);
+    assert_eq!(r.combined_bytes, 256 * MIB);
+    assert_eq!(r.fresh_charged_bytes, 201490760);
+    assert!(r.fresh_charged_bytes < r.combined_bytes);
+    assert!(checked_sum(&[u64::MAX, 1]).is_err());
+    assert!(checked_bytes(usize::MAX, u64::MAX).is_err());
+}
+
+#[test]
+fn opaque_packet_exact_shape_all_operations_and_counts() {
+    for job in jobs() {
+        for count in [1, 17, CAPACITY] {
+            let rows = vec![row_for(job, [b(0.25), b(0.5), b(0.75)]); count];
+            let p = Packet::new(job, &rows).unwrap();
+            assert_eq!(p.count(), count);
+            assert_eq!(p.words().len(), 12320);
+            assert_eq!(p.parameters()[2], count as u32);
+            assert_eq!(p.invocations(), 4096);
+            assert_eq!(&p.words()[..2], &job.constants);
+            assert!(p.words()[PREFIX_WORDS + count * LANES..].iter().all(|&v| v == 0));
+            assert_exact(&p);
+        }
+    }
