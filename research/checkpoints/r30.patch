+#[test]
+fn intermediate_bound_failures_cannot_be_hidden_by_final_arithmetic() {
+    let bound = f64::from_bits(BOUND_BITS);
+    let p = one(Job::weighted_accum(b(2.0)).unwrap(), [-bound, bound, 0.0]);
+    assert_eq!(native_oracle(&p).unwrap(), vec![BOUND_BITS]);
+    assert!(guarded_model(&p).is_err());
+    // CPU ultimately gives source1, but core*2 exceeds the guarded bound first.
+    let p = one(Job::scatter(b(0.0), b(-1.0)).unwrap(), [1.0, bound, bound]);
+    assert_eq!(native_oracle(&p).unwrap(), vec![b(1.0)]);
+    assert!(guarded_model(&p).is_err());
+    assert_exact(&one(Job::scatter(b(0.0), b(-1.0)).unwrap(), [1.0, 2.0, 2.0]));
+}
