+    let packet = super::Packet::new(super::Job::clear(), &[[0; 3]]).unwrap();
+    assert_eq!(packet.parameters().len(), HEADER_WORDS);
+    assert_eq!(packet.parameters(), &[1, 1, 1, 4096, 32, 3, 1, 0x4f50_3634,
