index 0000000000000000000000000000000000000000..3b4bdad81c15cf44505af9fbe9e4db688e1e1d07
--- /dev/null
+++ b/native/crates/film-engine/src/research_optics64_point.rs
@@ -0,0 +1,238 @@
+//! Closed test-only scalar optics primitives. No GPU runner, image graph,
+//! provenance, production admission or spatial-kernel change is supplied here.
+#![cfg(test)]
+
+pub(crate) type R<T> = Result<T, String>;
+pub(crate) const CAPACITY: usize = 4096;
+pub(crate) const PREFIX_WORDS: usize = 32;
+pub(crate) const LANES: usize = 3;
+pub(crate) const PACKET_WORDS: usize = PREFIX_WORDS + LANES * CAPACITY;
+pub(crate) const BOUND_BITS: u64 = 0x430c_6bf5_2000_0000;
+// Existing GPU tdiv's conservative admission floor, not a native CPU rule.
+pub(crate) const DIVISOR_FLOOR_BITS: u64 = 0x3cd2_03af_a000_0000;
+const SIGN: u64 = 1 << 63;
+const TAG: u32 = 0x4f50_3634;
+const VERSION: u32 = 1;
+const ZERO_POLICY: u32 = 1;
+const ERROR: &str = "GPU_OPTICS64_POINT_DESCRIPTOR";
+pub(crate) const DOMAIN_ERROR: &str = "GPU_OPTICS64_POINT_NUMERIC_DOMAIN";
+const MIB: u64 = 1024 * 1024;
+
+mod host;
+mod kernel;
+mod tests;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub(crate) enum Operation {
+    Clear = 1,
+    WeightedAccum = 2,
+    Scatter = 3,
+    BounceAdd = 4,
+    Divide = 5,
+}
+impl Operation {
+    fn from_word(word: u32) -> R<Self> {
+        match word {
+            1 => Ok(Self::Clear),
+            2 => Ok(Self::WeightedAccum),
+            3 => Ok(Self::Scatter),
+            4 => Ok(Self::BounceAdd),
+            5 => Ok(Self::Divide),
+            _ => Err(ERROR.into()),
+        }
+    }
+    fn used_lanes(self) -> usize {
+        match self {
+            Self::Clear => 0,
+            Self::WeightedAccum | Self::BounceAdd => 2,
+            Self::Scatter => 3,
+            Self::Divide => 1,
+        }
+    }
+}
+
+/// Mathematical primitive only. This does not certify original image input,
+/// a physical profile's parameter range, or an optical schedule.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Job {
+    operation: Operation,
+    constants: [u64; 2],
+}
+impl Job {
+    pub(crate) fn clear() -> Self {
+        Self { operation: Operation::Clear, constants: [0; 2] }
+    }
+    fn construct(operation: Operation, constants: [u64; 2]) -> R<Self> {
+        let job = Self { operation, constants };
+        job.validate()?;
+        Ok(job)
+    }
+    pub(crate) fn weighted_accum(coefficient: u64) -> R<Self> {
+        Self::construct(Operation::WeightedAccum, [coefficient, 0])
+    }
+    pub(crate) fn scatter(amount: u64, tail_weight: u64) -> R<Self> {
+        Self::construct(Operation::Scatter, [amount, tail_weight])
+    }
+    pub(crate) fn bounce_add(strength: u64) -> R<Self> {
+        Self::construct(Operation::BounceAdd, [strength, 0])
+    }
+    pub(crate) fn divide(divisor: u64) -> R<Self> {
+        Self::construct(Operation::Divide, [divisor, 0])
+    }
+    fn validate(&self) -> R<()> {
+        if self.constants.iter().any(|&v| !admitted(v)) {
+            return Err(DOMAIN_ERROR.into());
+        }
+        if (self.operation == Operation::Clear && self.constants != [0; 2])
+            || (self.operation != Operation::Scatter && self.constants[1] != 0)
+        {
+            return Err(ERROR.into());
+        }
+        if self.operation == Operation::Divide
+            && (zero(self.constants[0])
+                || magnitude(self.constants[0]) < DIVISOR_FLOOR_BITS)
+        {
+            return Err(DOMAIN_ERROR.into());
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Packet {
+    job: Job,
+    count: usize,
+    words: Vec<u64>,
+    parameters: [u32; 16],
+}
+impl Packet {
+    pub(crate) fn new(job: Job, values: &[[u64; 3]]) -> R<Self> {
+        job.validate()?;
+        if values.is_empty() || values.len() > CAPACITY {
+            return Err(ERROR.into());
+        }
+        for row in values {
+            validate_row(job.operation, row)?;
+        }
+        let mut words = Vec::with_capacity(PACKET_WORDS);
+        words.resize(PACKET_WORDS, 0);
+        words[..2].copy_from_slice(&job.constants);
+        for (i, row) in values.iter().enumerate() {
+            words[PREFIX_WORDS + LANES * i..PREFIX_WORDS + LANES * (i + 1)]
+                .copy_from_slice(row);
+        }
+        let mut parameters = [0; 16];
+        parameters[..8].copy_from_slice(&[
+            VERSION, job.operation as u32, values.len() as u32,
+            CAPACITY as u32, PREFIX_WORDS as u32, LANES as u32, ZERO_POLICY, TAG,
+        ]);
+        let packet = Self { job, count: values.len(), words, parameters };
+        packet.validate()?;
+        Ok(packet)
+    }
+    pub(crate) fn validate(&self) -> R<()> {
+        self.job.validate()?;
+        let operation = Operation::from_word(self.parameters[1])?;
+        if self.count == 0 || self.count > CAPACITY
+            || self.words.len() != PACKET_WORDS
+            || self.parameters[..8] != [VERSION, operation as u32, self.count as u32,
+                CAPACITY as u32, PREFIX_WORDS as u32, LANES as u32, ZERO_POLICY, TAG]
+            || self.parameters[8..].iter().any(|&v| v != 0)
+            || operation != self.job.operation
+            || self.words[..2] != self.job.constants
+            || self.words[2..PREFIX_WORDS].iter().any(|&v| v != 0)
+        {
+            return Err(ERROR.into());
+        }
+        for (i, row) in self.words[PREFIX_WORDS..].chunks_exact(LANES).enumerate() {
+            let row: &[u64; 3] = row.try_into().map_err(|_| ERROR)?;
+            if i < self.count {
+                validate_row(operation, row)?;
+            } else if row.iter().any(|&v| v != 0) {
+                return Err(ERROR.into());
+            }
+        }
+        self.host_payload_bytes(0, 0, 0, 0)?;
+        Ok(())
+    }
+    pub(crate) fn count(&self) -> usize { self.count }
+    pub(crate) fn words(&self) -> &[u64] { &self.words }
+    pub(crate) fn parameters(&self) -> &[u32; 16] { &self.parameters }
+    pub(crate) fn invocations(&self) -> u32 { CAPACITY as u32 }
+    /// Includes capacities, serialized uploads, output, shader and caller-owned
+    /// retained fixture/oracle/active-input memory. No total-process RSS claim.
+    pub(crate) fn host_payload_bytes(
+        &self, upload_capacity_bytes: u64, output_capacity_words: usize,
+        shader_capacity_bytes: u64, caller_retained_bytes: u64,
+    ) -> R<u64> {
+        let bytes = checked_sum(&[
+            checked_bytes(self.words.capacity(), 8)?, upload_capacity_bytes,
+            checked_bytes(output_capacity_words, 8)?, shader_capacity_bytes,
+            caller_retained_bytes, 65536,
+        ])?;
+        if bytes > Resources::fixed().host_bytes {
+            return Err("GPU_OPTICS64_POINT_HOST_BUDGET".into());
+        }
+        Ok(bytes)
+    }
+}
+fn validate_row(operation: Operation, values: &[u64; 3]) -> R<()> {
+    if values.iter().any(|&v| !admitted(v)) {
+        return Err(DOMAIN_ERROR.into());
+    }
+    if values[operation.used_lanes()..].iter().any(|&v| v != 0) {
+        return Err(ERROR.into());
+    }
+    Ok(())
+}
+pub(crate) fn admitted(bits: u64) -> bool {
+    let absolute = magnitude(bits);
+    let exponent = absolute >> 52;
+    exponent != 2047 && (exponent != 0 || absolute == 0) && absolute <= BOUND_BITS
+}
+fn magnitude(bits: u64) -> u64 { bits & !SIGN }
+fn zero(bits: u64) -> bool { magnitude(bits) == 0 }
+fn checked_bytes(count: usize, unit: u64) -> R<u64> {
+    u64::try_from(count).ok().and_then(|n| n.checked_mul(unit))
+        .ok_or_else(|| "GPU_OPTICS64_POINT_BUDGET".into())
+}
+fn checked_sum(parts: &[u64]) -> R<u64> {
+    parts.iter().try_fold(0u64, |a, &b| a.checked_add(b)
+        .ok_or_else(|| "GPU_OPTICS64_POINT_BUDGET".into()))
+}
+
+/// Future runner's fixed accounting contract, not an implemented GPU owner.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Resources {
+    pub packet_bytes: u64,
+    pub output_bytes: u64,
+    pub map_bytes: u64,
+    pub error_bytes: u64,
+    pub uniform_bytes: u64,
+    pub pool_bytes: u64,
+    pub upload_bytes: u64,
+    pub margin_bytes: u64,
+    pub device_bytes: u64,
+    pub host_bytes: u64,
+    pub helper_bytes: u64,
+    pub fixed_bytes: u64,
+    pub family_bytes: u64,
+    pub combined_bytes: u64,
+    pub fresh_charged_bytes: u64,
+}
+impl Resources {
+    pub(crate) fn fixed() -> Self {
+        let packet_bytes = (PACKET_WORDS * 8) as u64;
+        let output_bytes = (CAPACITY * 8) as u64;
+        let map_bytes = output_bytes + 4;
+        let pool_bytes = packet_bytes + output_bytes + map_bytes + 4 + 64;
+        Self {
+            packet_bytes, output_bytes, map_bytes, error_bytes: 4, uniform_bytes: 64,
+            pool_bytes, upload_bytes: packet_bytes + 64, margin_bytes: 65536,
+            device_bytes: 64 * MIB, host_bytes: 64 * MIB, helper_bytes: 64 * MIB,
+            fixed_bytes: 128 * MIB, family_bytes: 64 * MIB,
+            combined_bytes: 256 * MIB, fresh_charged_bytes: 192 * MIB + pool_bytes,
+        }
+    }
+}
