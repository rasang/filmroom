+    let values: Vec<[u64; 3]> = (0..CAPACITY).map(|i| std::array::from_fn(|lane| {
+        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        if (i + lane) % 17 == 0 { return if i % 2 == 0 { 0 } else { SIGN }; }
