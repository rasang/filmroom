+    for (name, zero_branch) in [("op_add", "if (sf_zero(a) &&"), ("op_mul", "if (sf_zero(a) ||")] {
+        assert_ordered(local[name], &[
+            "let a_ok = op_accept(a)", "let b_ok = op_accept(b)",
