+#[test]
+fn gpu_bound_and_divisor_floor_are_exact_conservative_subset() {
+    assert_eq!((1e15f32 as f64).to_bits(), BOUND_BITS);
+    assert_eq!((1e-15f32 as f64).to_bits(), DIVISOR_FLOOR_BITS);
+    for sign in [0, SIGN] {
+        assert!(admitted(BOUND_BITS | sign));
+        assert!(!admitted((BOUND_BITS + 1) | sign));
+        assert!(admitted(f64::MIN_POSITIVE.to_bits() | sign));
+        assert!(!admitted((f64::MIN_POSITIVE.to_bits() - 1) | sign));
+        assert!(Job::divide(DIVISOR_FLOOR_BITS | sign).is_ok());
+        assert!(Job::divide((DIVISOR_FLOOR_BITS - 1) | sign).is_err());
+        let mut g = Guard::default(); g.div(0, (DIVISOR_FLOOR_BITS - 1) | sign);
+        assert!(g.failed, "floor must precede zero numerator");
+        let d = f64::from_bits(DIVISOR_FLOOR_BITS | sign);
+        assert_exact(&one(Job::divide(d.to_bits()).unwrap(), [1e-16, 0.0, 0.0]));
+    }
+    // Native CPU can divide by a value that this existing GPU subset rejects.
+    assert!((1e-16f64 / 1e-16f64).is_finite());
+    assert!(Job::divide(b(1e-16)).is_err());
+}
