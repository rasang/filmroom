+#[test]
+fn local_zero_wrappers_validate_operands_before_zero_shortcuts() {
+    let invalid = [f64::NAN.to_bits(), f64::INFINITY.to_bits(), f64::NEG_INFINITY.to_bits(), 1,
+        SIGN | 1, BOUND_BITS + 1];
+    for bad in invalid {
+        for z in [0, SIGN] {
+            let mut g = Guard::default(); g.mul(z, bad); assert!(g.failed);
+            let mut g = Guard::default(); g.mul(bad, z); assert!(g.failed);
+            let mut g = Guard::default(); g.add(z, bad); assert!(g.failed);
+            let mut g = Guard::default(); g.div(z, bad); assert!(g.failed);
+        }
+    }
+    for a in [0, SIGN] { for d in [0, SIGN] {
+        let mut g = Guard::default(); g.div(a, d); assert!(g.failed);
+    }}
+    for z in [0, SIGN] {
+        let mut g = Guard::default(); assert_eq!(g.div(z, b(-1.0)), z ^ SIGN); assert!(!g.failed);
+    }
+}
