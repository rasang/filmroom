+    for bits in [super::BOUND_BITS, super::DIVISOR_FLOOR_BITS] {
+        assert!(KERNEL.contains(&format!("vec2<u32>(0x{:08x}u, 0x{:08x}u)",
+            bits as u32, (bits >> 32) as u32)));
+    }
+    assert_eq!(PREFIX_WORDS, 32);
+    assert_eq!(PACKET_WORDS, PREFIX_WORDS + 3 * POINT_CAPACITY);
+    assert_eq!(HEADER_WORDS, 16);
+    assert_eq!(WORKGROUPS * WORKGROUP_SIZE, POINT_CAPACITY as u32);
+    assert_eq!(PACKET_WORDS * 8, 98_560);
