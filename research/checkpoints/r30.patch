+#[test]
+fn conservative_underflow_boundary_and_masked_underflow_remain_rejected() {
+    let below_one = f64::from_bits(b(1.0) - 1);
+    let minimum = f64::MIN_POSITIVE;
+    for (a, value) in [(below_one, minimum), (minimum, below_one)] {
+        assert_eq!((a * value).to_bits(), minimum.to_bits());
+        let mut g = Guard::default(); let result = g.mul(b(a), b(value));
+        assert!(g.failed);
+        assert_eq!(result, crate::research_grain::soft64::NAN);
+    }
+    let p = one(Job::weighted_accum(b(0.1633)).unwrap(), [1.0, minimum, 0.0]);
+    assert_eq!(native_oracle(&p).unwrap(), vec![b(1.0)]);
+    assert!(guarded_model(&p).is_err());
+    let p = one(Job::divide(b(1.05)).unwrap(), [minimum, 0.0, 0.0]);
+    assert!(!admitted(native_oracle(&p).unwrap()[0]));
+    assert!(guarded_model(&p).is_err());
+    assert_exact(&one(Job::weighted_accum(b(1.0)).unwrap(), [0.0, minimum, 0.0]));
+}
