+//! Independent literal native-f64 oracle and separately guarded soft64 model.
+//! Both are test models, not candidate-side CPU image arithmetic.
+use super::*;
+use crate::research_grain::soft64;
+
+pub(super) fn native_oracle(packet: &Packet) -> R<Vec<u64>> {
+    packet.validate()?;
+    let [k, w] = packet.job.constants.map(f64::from_bits);
+    let mut output = Vec::with_capacity(packet.count);
+    for row in packet.words[PREFIX_WORDS..PREFIX_WORDS + packet.count * LANES]
+        .chunks_exact(LANES)
+    {
+        let x0 = f64::from_bits(row[0]);
+        let x1 = f64::from_bits(row[1]);
+        let x2 = f64::from_bits(row[2]);
+        let result = match packet.job.operation {
+            Operation::Clear => 0.0,
+            Operation::WeightedAccum => x0 + k * x1,
+            Operation::Scatter => (1.0 - k) * x0 + k * ((1.0 - w) * x1 + w * x2),
+            Operation::BounceAdd => x0 + k * x1,
+            Operation::Divide => x0 / k,
+        };
+        // No final-domain or intermediate check is imposed on the original
+        // oracle. A finite native answer may still be outside the GPU subset.
+        output.push(result.to_bits());
+    }
+    Ok(output)
+}
+
+#[derive(Default)]
+pub(super) struct Guard { pub(super) failed: bool }
+impl Guard {
+    fn accept(&mut self, value: u64) -> bool {
+        if self.failed || !admitted(value) { self.failed = true; false } else { true }
+    }
+    fn reject(&mut self) -> u64 { self.failed = true; soft64::NAN }
+    fn checked(&mut self, value: u64) -> u64 {
+        if self.accept(value) { value } else { soft64::NAN }
+    }
+    pub(super) fn add(&mut self, a: u64, b: u64) -> u64 {
+        if !self.accept(a) || !self.accept(b) { return self.reject(); }
+        if zero(a) && zero(b) { return (a & b) & SIGN; }
+        self.checked(soft64::add(a, b))
+    }
+    pub(super) fn sub(&mut self, a: u64, b: u64) -> u64 { self.add(a, b ^ SIGN) }
+    pub(super) fn mul(&mut self, a: u64, b: u64) -> u64 {
+        if !self.accept(a) || !self.accept(b) { return self.reject(); }
+        if zero(a) || zero(b) { return (a ^ b) & SIGN; }
+        self.checked(soft64::mul(a, b))
+    }
+    pub(super) fn div(&mut self, a: u64, b: u64) -> u64 {
+        if !self.accept(a) || !self.accept(b) { return self.reject(); }
+        // Preserve the existing GPU subset; native CPU has no such floor.
+        if zero(b) || magnitude(b) < DIVISOR_FLOOR_BITS { return self.reject(); }
+        if zero(a) { return (a ^ b) & SIGN; }
+        self.checked(soft64::div(a, b))
+    }
+}
+
+pub(super) fn guarded_model(packet: &Packet) -> R<Vec<u64>> {
+    packet.validate()?;
+    let [k, w] = packet.job.constants;
+    let one = 1.0f64.to_bits();
+    let mut guard = Guard::default();
+    let mut output = Vec::with_capacity(packet.count);
+    for row in packet.words[PREFIX_WORDS..PREFIX_WORDS + packet.count * LANES]
+        .chunks_exact(LANES)
+    {
+        let result = match packet.job.operation {
+            Operation::Clear => 0,
+            Operation::WeightedAccum | Operation::BounceAdd => {
+                let product = guard.mul(k, row[1]);
+                guard.add(row[0], product)
+            }
+            Operation::Scatter => {
+                let source_weight = guard.sub(one, k);
+                let source_term = guard.mul(source_weight, row[0]);
+                let core_weight = guard.sub(one, w);
+                let core_term = guard.mul(core_weight, row[1]);
+                let tail_term = guard.mul(w, row[2]);
+                let core_tail = guard.add(core_term, tail_term);
+                let scatter_term = guard.mul(k, core_tail);
+                guard.add(source_term, scatter_term)
+            }
+            Operation::Divide => guard.div(row[0], k),
+        };
+        if !guard.accept(result) { return Err(DOMAIN_ERROR.into()); }
+        output.push(result);
+    }
+    Ok(output)
+}
