+#[test]
+fn linear_stage_cancellation_identity_and_partial_candidate_are_closed() {
+    let root = Root::new();
+    let base = fixture(23, 17, true);
+    let p = base.clone().with_linear_exposure(0.73).unwrap();
+    let input = logs(p.width, p.height);
+    let paths = write_inputs(&root, &input);
+    let dir = root.0.join("gpu-stage-88");
+    let plan = full_stage::prepare_stage(paths.each_ref().map(|p| p.as_path()), &dir, 88, p.width, p.height, &p, || false).unwrap();
+    assert_eq!(plan.input_mode, p.input_mode);
+    let original = fs::read(dir.join("manifest.json")).unwrap();
+    let mut tampered: serde_json::Value = serde_json::from_slice(&original).unwrap();
+    tampered["dirConfig"]["inputMode"] = serde_json::json!({"mode":"logarithmic"});
+    fs::write(dir.join("manifest.json"), serde_json::to_vec(&tampered).unwrap()).unwrap();
+    assert!(full_stage::run_stage_cpu_mirror_for_test(&dir, 88, &plan.manifest_sha256, || false).is_err());
+    fs::write(dir.join("manifest.json"), &original).unwrap();
+    // Cancellation at every check must remove any partial output; successful
+    // endpoint is verified once after sweeping all earlier cancellation points.
+    let mut reached_success = false;
+    for limit in 0..500 {
+        let mut count = 0;
+        let result = full_stage::run_stage_cpu_mirror_for_test(&dir, 88, &plan.manifest_sha256, || { count += 1; count > limit });
+        match result {
+            Err(e) => { assert_eq!(e, "CANCELLED"); assert!(!dir.join("candidate").exists()); }
+            Ok(_) => { reached_success = true; break; }
+        }
+    }
+    assert!(reached_success);
+    let output = full_stage::validate_outputs(&dir, 88, &plan.manifest_sha256, || false).unwrap();
+    fs::remove_file(&output[2]).unwrap();
+    assert!(full_stage::validate_outputs(&dir, 88, &plan.manifest_sha256, || false).is_err());
+    for ch in 0..3 { assert_eq!(fs::read(&paths[ch]).unwrap(), fs::read(dir.join(format!("source-{ch}.f64le"))).unwrap()); }
+}
