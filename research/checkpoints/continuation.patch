+/// The linear route is explicitly experimental f32, not original f64 parity.
+/// Correction comes from the original prepared pipeline, never recomputed here.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "mode", rename_all = "camelCase", deny_unknown_fields)]
+pub enum DirInput {
+    #[default]
+    Logarithmic,
+    LinearExposureF32 {
+        #[serde(with = "f64_scalar_bits")]
+        correction: f64,
+    },
+}
+impl DirInput {
+    pub fn is_logarithmic(&self) -> bool { matches!(self, Self::Logarithmic) }
+    fn validate(&self) -> R<()> {
+        if let Self::LinearExposureF32 { correction } = self {
+            if !finite(*correction) || *correction <= 0. || (*correction as f32) <= 0. {
+                return Err("INVALID_DIR_INPUT_MODE".into());
+            }
+        }
+        Ok(())
+    }
+    pub fn log_f64(&self, x: f64) -> f64 {
+        match self {
+            Self::Logarithmic => x,
+            Self::LinearExposureF32 { correction } => ((x * correction).max(0.) + 1e-10).log10(),
+        }
+    }
+    pub fn log_f32(&self, x: f32) -> R<f32> {
+        match self {
+            Self::Logarithmic => Ok(x),
+            Self::LinearExposureF32 { correction } => {
+                // Match the shader's conservative pre-arithmetic admission.
+                let factor = *correction as f32;
+                if !x.is_finite() || x.abs() > 1e15 || factor.abs() > 1e15 {
+                    return Err("GPU_DIR_NUMERIC_DOMAIN".into());
+                }
+                let corrected = x * factor;
+                if !corrected.is_finite() || corrected.abs() > 1e15 {
+                    return Err("GPU_DIR_NUMERIC_DOMAIN".into());
+                }
+                Ok((corrected.max(0.) + 1e-10f32).ln() * std::f32::consts::LOG10_E)
+            }
+        }
+    }
+}
