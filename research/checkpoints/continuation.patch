+    assert!(old.get("inputMode").is_none());
+    assert_eq!(serde_json::from_value::<DirPlan>(old).unwrap(), p);
+    let correction = 1.2345678901234567;
+    let linear = p.clone().with_linear_exposure(correction).unwrap();
+    let encoded = serde_json::to_value(&linear).unwrap();
+    assert_eq!(encoded["inputMode"]["correction"], format!("{:016x}", correction.to_bits()));
+    assert_eq!(serde_json::from_value::<DirPlan>(encoded.clone()).unwrap(), linear);
+    let mut unknown = encoded;
+    unknown["inputMode"]["unchecked"] = true.into();
+    assert!(serde_json::from_value::<DirPlan>(unknown).is_err());
+    for c in [0., -1., f64::INFINITY, f64::NAN, 1e-300] {
+        assert!(p.clone().with_linear_exposure(c).is_err());
+    }
+    let mode = DirInput::LinearExposureF32 { correction: 2. };
+    for x in [f32::MAX, -f32::MAX, f32::INFINITY, f32::NAN, 1e15] {
