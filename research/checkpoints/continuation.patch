+// Closed composition on the already guarded original DIR shader. Any upstream
+// input-expression drift fails before GPU submission rather than silently omitting log.
+fn linear_shader() -> R<String> {
+    let mut s = crate::research_spatial::guarded::shader()?;
+    for (old, new) in [
+        ("ch,probe.values[524288u+3u*i+ch])", "ch,dir_input_log(probe.values[524288u+3u*i+ch]))"),
+        ("tsub(probe.values[524288u+i],source.values[index])", "tsub(dir_input_log(probe.values[524288u+i]),source.values[index])"),
+    ] {
+        if s.matches(old).count() != 1 { return Err("GPU_DIR_SHADER_VERSION".into()); }
+        s = s.replace(old, new);
+    }
+    s.push_str(include_str!("shaders/research_dir_linear.wgsl"));
+    Ok(s)
