+// Only the two DIR input loads call this function. No full RGB plane allocation.
+// Exactly the separate globalLog f32 arithmetic order, including additive epsilon.
+// The shared request-wide error is sticky even when density clamps the result.
+fn dir_input_log(x:f32)->f32 {
+ if(p.u[6].y==0u){return x;}
+ let corrected=tmul(x,bitcast<f32>(p.u[6].z));
+ return tmul(tlog(tadd(max(corrected,0.0),1e-10)),0.4342944819032518);
+}
