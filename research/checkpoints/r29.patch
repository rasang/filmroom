+//! Deterministic test-only fault state. No GPU callback is exposed to callers.
+#![cfg(test)]
+use std::cell::{Cell,RefCell};
+use std::sync::atomic::{AtomicBool,Ordering};
+use sha2::{Digest,Sha256};
+#[derive(Clone,Copy,Debug,serde::Serialize)]
+pub(crate) enum TestFault{PreCancel,AfterSubmitCancel,AfterUnmapCancel,AfterUnmapDeviceError,SerializedTableWord{index:usize,raw64:u64}}
+#[derive(Clone,Debug,Default,serde::Serialize)]
+pub(crate) struct FaultTrace{
+ pub events:Vec<&'static str>,pub triggers:u32,pub packet_validations:u32,pub acquires:u32,pub pipelines:u32,pub encoded_passes:u32,pub submits:u32,pub maps_requested:u32,pub maps_succeeded:u32,pub numeric_flag:Option<u32>,pub decoded_words:Option<usize>,pub unmaps:u32,pub release_reached:u32,pub releases:u32,pub owner_drops:u32,pub returned_error:Option<String>,pub table_patch:Option<serde_json::Value>,
+}
+pub(crate) struct FaultControl{plan:TestFault,cancel:Cell<bool>,trace:RefCell<FaultTrace>}
+impl FaultControl{
+ pub(crate) fn new(plan:TestFault)->Self{Self{plan,cancel:Cell::new(false),trace:RefCell::new(FaultTrace::default())}}
+ pub(crate) fn snapshot(&self)->FaultTrace{self.trace.borrow().clone()}
+ pub(crate) fn clear_caller_cancel(&self){self.cancel.set(false);}
+ pub(crate) fn cancelled(&self)->bool{self.cancel.get()}
+ pub(super) fn event(&self,name:&'static str){let mut t=self.trace.borrow_mut();assert!(t.events.len()<32);t.events.push(name);match name{"validated"=>t.packet_validations+=1,"acquired"=>t.acquires+=1,"pipeline"=>t.pipelines+=1,"encoded_pass"=>t.encoded_passes+=1,"submit"=>t.submits+=1,"map_requested"=>t.maps_requested+=1,"map_succeeded"=>t.maps_succeeded+=1,"unmap"=>t.unmaps+=1,"release_reached"=>t.release_reached+=1,"released"=>t.releases+=1,"owner_dropped"=>t.owner_drops+=1,_=>{}}}
+ fn trigger(&self,name:&'static str){self.event(name);let mut t=self.trace.borrow_mut();t.triggers+=1;assert_eq!(t.triggers,1);}
+ pub(super) fn initial(&self){self.event("entry");if matches!(self.plan,TestFault::PreCancel){self.trigger("before_initial_check");self.cancel.set(true);}}
+ pub(super) fn submitted(&self){self.event("submit");if matches!(self.plan,TestFault::AfterSubmitCancel){self.trigger("after_submit");self.cancel.set(true);}}
+ pub(super) fn unmapped(&self,error:&AtomicBool){self.event("unmap");match self.plan{TestFault::AfterUnmapCancel=>{self.trigger("after_unmap_cancel");self.cancel.set(true);},TestFault::AfterUnmapDeviceError=>{self.trigger("after_unmap_device_error");error.store(true,Ordering::Release);},_=>{}}}
+ pub(super) fn flag(&self,v:u32){self.trace.borrow_mut().numeric_flag=Some(v);}
+ pub(super) fn decoded(&self,n:usize){self.trace.borrow_mut().decoded_words=Some(n);}
+ pub(super) fn returned(&self,error:Option<&String>){self.trace.borrow_mut().returned_error=error.cloned();}
+ pub(super) fn table(&self,words:&mut[u32]){
+  if let TestFault::SerializedTableWord{index,raw64}=self.plan{
+   assert!(index<words.len()/2);let before=format!("{:x}",Sha256::digest(bytemuck::cast_slice(words)));
+   let old=u64::from(words[index*2])|(u64::from(words[index*2+1])<<32);assert_ne!(old,raw64);
+   words[index*2]=raw64 as u32;words[index*2+1]=(raw64>>32)as u32;
+   let after=format!("{:x}",Sha256::digest(bytemuck::cast_slice(words)));
+   self.trigger("serialized_table_ready");self.trace.borrow_mut().table_patch=Some(serde_json::json!({"index":index,"beforeBits":format!("{old:016x}"),"afterBits":format!("{raw64:016x}"),"beforeSha256":before,"afterSha256":after,"changedRaw64Words":1}));
+  }
+ }
+}
+
+#[test]
+fn named_fault_controls_are_single_shot_and_table_patch_is_local(){
+ let pre=FaultControl::new(TestFault::PreCancel);pre.initial();assert!(pre.cancelled());assert_eq!(pre.snapshot().triggers,1);pre.clear_caller_cancel();assert!(!pre.cancelled());
+ let table=FaultControl::new(TestFault::SerializedTableWord{index:1,raw64:0x7ff8000000000001});let mut words=[0u32,0x3ff00000,0,0x40000000,0,0x40080000];let old=words;table.table(&mut words);assert_eq!(&words[..2],&old[..2]);assert_eq!(&words[4..],&old[4..]);assert_eq!((words[2],words[3]),(1,0x7ff80000));assert_eq!(table.snapshot().triggers,1);assert!(!table.cancelled());
+}
+#[test]
+fn normal_entry_delegates_none_and_timeout_origin_is_preserved(){
+ let source=include_str!("gpu.rs");assert!(source.contains("run_impl(packet, epoch, c, None)"));
+ assert!(source.contains("let started = Instant::now();\n        let command = encoder.finish();"));
+ let unmap=source.find("readback.unmap();").unwrap();let injection=source.find("f.unmapped(&context.error)").unwrap();let decode=source.find("let raw64 = mapped_result?;").unwrap();let release=source.find("context.release_transients_after_fence()?").unwrap();assert!(unmap<injection&&injection<decode&&decode<release);
+}
