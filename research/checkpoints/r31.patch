+#[test]
+fn named_fault_controls_are_local_and_deterministic() {
+    let f = FaultControl::new(Fault::SerializedWord { index: 1, bits: b(-1.0) });
+    let mut words = [0u32,0x3ff00000,0,0x40000000,0,0x40080000]; let before = words;
+    f.serialized(&mut words, &mut [0;16]);
+    assert_eq!(&words[..2], &before[..2]); assert_eq!(&words[4..], &before[4..]);
+    assert_eq!((words[2], words[3]), (0, 0xbff00000)); assert_eq!(f.snapshot().triggers, 1);
+    let f = FaultControl::new(Fault::AfterUnmapCancel); assert!(!f.cancelled());
+    f.after_unmap(&std::sync::atomic::AtomicBool::new(false)); assert!(f.cancelled());
+    f.clear_caller_cancel(); assert!(!f.cancelled());
+    let f = FaultControl::new(Fault::AfterUnmapDeviceError); let error = std::sync::atomic::AtomicBool::new(false);
+    f.after_unmap(&error); assert!(error.load(Ordering::Acquire)); assert_eq!(f.snapshot().triggers, 1);
+}
