+//! Each ignored gate requires its own externally guarded process. Never run
+//! multiple actual cases in one registry or infer device success from host tests.
+use super::*;
+use super::fault::{Fault, FaultControl};
+use crate::gpu_session_contract::StageTicket;
+use std::{cell::Cell, rc::Rc};
+
+const EPOCH: u64 = 0x4f50_3634_0000_0001;
+fn b(value: f64) -> u64 { value.to_bits() }
+fn packet(job: Job, row: [f64; 3]) -> Packet { Packet::new(job, &[row.map(b)]).unwrap() }
+fn ticket(sequence: u64) -> StageTicket { StageTicket { epoch: EPOCH, generation: 1, sequence } }
+fn activate() {
+    let r = Resources::fixed();
+    session::activate(EPOCH, r.combined_bytes, r.fixed_bytes, 1).unwrap();
+    session::begin_frame(EPOCH, 1).unwrap();
+}
+fn emit(value: serde_json::Value) { println!("{}", value); }
+fn trace_scope(token: u64, calls: Rc<Cell<u64>>) -> trace::TaskScope {
+    trace::TaskScope::for_test(token, 31, move |snapshot| {
+        calls.set(calls.get() + 1);
+        use std::io::Write;
+        let Ok(mut bytes) = serde_json::to_vec(&serde_json::json!({"optics64PointPhase":snapshot,"observationOnly":true})) else { return false; };
+        bytes.push(b'\n'); let stderr = std::io::stderr(); let mut sink = stderr.lock();
+        sink.write_all(&bytes).and_then(|_| sink.flush()).is_ok()
+    })
+}
+fn jobs() -> Vec<Job> {
+    vec![Job::clear(), Job::weighted_accum(b(0.1633)).unwrap(),
+        Job::scatter(b(1.0), b(0.78)).unwrap(), Job::bounce_add(b(0.05)).unwrap(),
+        Job::divide(b(1.05)).unwrap()]
+}
+fn original_jobs() -> Vec<Job> {
+    let params: spektrafilm_core::params::RuntimeParams =
+        serde_json::from_str(include_str!("../actual384_params.json")).unwrap();
+    let h = &params.film_render.halation;
+    let mut weights: Vec<f64> = (0..h.halation_n_bounces)
+        .map(|k| h.halation_bounce_decay.powi(k as i32)).collect();
+    let sum: f64 = weights.iter().sum(); for v in &mut weights { *v /= sum; }
+    let mut all = vec![Job::clear()];
+    for k in [0.1633, 0.6496, 0.1870].into_iter().chain(weights) {
+        all.push(Job::weighted_accum(b(k)).unwrap());
+    }
+    let strengths = h.halation_strength.map(|s| s * h.halation_amount);
+    for ch in 0..3 {
+        all.push(Job::scatter(b(h.scatter_amount), b(h.scatter_tail_weight[ch])).unwrap());
+        // Zero-strength primitive is covered, without claiming CPU schedules it.
+        all.push(Job::bounce_add(b(strengths[ch])).unwrap());
+        all.push(Job::divide(b(1.0 + strengths[ch])).unwrap());
+    }
+    all
+}
+fn run_success(p: &Packet, sequence: u64) -> session::SessionStats {
+    let r = Resources::fixed();
+    let original = host::native_oracle(p).unwrap();
+    assert_eq!(original, host::guarded_model(p).unwrap());
+    // Current oracle plus a bounded 1 MiB caller reserve covers the at most 16 Jobs,
+    // receipt/trace state and at most one other 98560-byte Packet in fault tests.
+    // The current packet/upload/shader/output are separately counted by run.
+    let caller = checked_sum(&[checked_bytes(original.capacity(), 8).unwrap(), MIB]).unwrap();
+    assert!(p.host_payload_bytes(r.upload_bytes, p.count(), MIB, caller).is_ok());
+    let t = ticket(sequence); session::begin_stage(t, r.family_bytes).unwrap();
+    let out = run(p, EPOCH, &mut || false).unwrap();
+    assert_eq!(out.words, original, "op {:?}", p.job.operation);
+    assert!(!session::is_cancelled(EPOCH));
+    let seal = session::complete_stage(t).unwrap();
+    assert!(!session::is_cancelled(EPOCH));
+    assert_eq!((seal.epoch, seal.prepaid_bytes, seal.fixed_bytes), (EPOCH, r.combined_bytes, r.fixed_bytes));
+    assert_eq!((seal.pool_bytes, seal.charged_bytes, seal.pipeline_slots), (r.pool_bytes, r.fresh_charged_bytes, 1));
+    assert_eq!(seal.pipeline_hits, sequence - 1);
+    assert_eq!(seal.buffer_hits, 5 * (sequence - 1));
+    assert_eq!((out.stats.dispatches, out.stats.readbacks, out.stats.releases), (1, 1, 1));
+    assert_eq!((out.stats.active_points, out.stats.validation_points, out.stats.workgroups), (p.count() as u64, 4096, 64));
+    assert_eq!(out.stats.pipeline_count, 1);
+    assert_eq!(out.stats.source_sha256, kernel::GENERATED_SHA256);
+    assert_eq!(out.stats.resident_bytes, r.pool_bytes);
+    assert_eq!(out.stats.reserved_combined_bytes, r.combined_bytes);
+    assert_eq!(out.stats.upload_staging_bytes, r.upload_bytes);
+    assert!(out.stats.resident_bytes + out.stats.upload_staging_bytes + out.stats.device_margin_bytes <= r.device_bytes);
+    assert!(caller + out.stats.known_host_payload_bytes <= r.host_bytes);
+    assert!(!out.stats.host_image_arithmetic);
+    emit(serde_json::json!({"pointSuccess":true,"operation":p.job.operation as u32,
+        "sequence":sequence,"words":p.count(),"allNativeWordsEqual":true,"zeroSignDifferences":0,
+        "stats":out.stats,"seal":seal,"callerBytes":caller,
+        "scope":"synthetic scalar point primitives; no spatial/image/Adreno claim"}));
+    seal
+}
+fn success_case(count: usize, repeated: bool) {
+    success_jobs(count, repeated, jobs());
+}
+fn success_jobs(count: usize, repeated: bool, operations: Vec<Job>) {
+    let calls = Rc::new(Cell::new(0)); let mut diagnostics = trace_scope(0x4f50_3634_5355_4301, calls);
+    activate(); let mut sequence = 0;
+    for round in 0..if repeated { 2 } else { 1 } {
+        for &job in &operations {
+            let rows: Vec<_> = (0..count).map(|i| {
+                let base = if count == 1 { 0.25 }
+                    else if i % 11 == 0 { if i % 2 == 0 { 0.0 } else { -0.0 } }
+                    else { (i as f64 + 1.0) / 8192.0 - 0.25 };
+                let mut row = [b(base), b(0.125 + round as f64 * 0.1), b(-0.375)];
+                row[job.operation.used_lanes()..].fill(0); row
+            }).collect();
+            let p = Packet::new(job, &rows).unwrap();
+            if count == 1 && job.operation == Operation::Divide {
+                assert!(!zero(p.words()[PREFIX_WORDS]), "first Divide must exercise sf_div");
+            }
+            drop(rows); sequence += 1; run_success(&p, sequence);
+        }
+    }
+    session::finish_frame(EPOCH, 1).unwrap(); diagnostics.finish(&Ok::<(), String>(()));
+}
+
+fn rejected_case(label: &str, valid: Packet, rejected: Packet, plan: Fault) {
+    let calls = Rc::new(Cell::new(0)); let mut diagnostics = trace_scope(0x4f50_3634_4641_554c, calls);
+    activate(); run_success(&valid, 1);
+    let r = Resources::fixed(); let t = ticket(2);
+    session::begin_stage(t, r.family_bytes).unwrap();
+    let control = FaultControl::new(plan);
+    let result = run_with_fault(&rejected, EPOCH, &mut || false, &control);
+    let observed = control.snapshot();
+    let error = match result {
+        Ok(output) => { emit(serde_json::json!({"unexpectedAcceptedOutput":output.words,"stats":output.stats})); panic!("fault returned accepted output"); },
+        Err(error) => error,
+    };
+    // Preserve the actual failure state even if a later expectation is wrong.
+    emit(serde_json::json!({"pointFaultObservation":true,"observationOnly":true,
+        "case":label,"plan":plan,"error":error,"observed":observed}));
+    assert_eq!(observed.triggers, if matches!(plan, Fault::ObserveOnly) { 0 } else { 1 });
+    assert_eq!(observed.returned_error.as_deref(), Some(error.as_str()));
+    assert_eq!((observed.release_reached, observed.releases), (0, 0));
+    match plan {
+        Fault::PreCancel => {
+            assert_eq!(error, "CANCELLED");
+            assert_eq!((observed.validations, observed.acquires, observed.pipelines, observed.encoded,
+                observed.submits, observed.maps_requested, observed.unmaps, observed.owner_drops), (0,0,0,0,0,0,0,0));
+        }
+        Fault::AfterSubmitCancel => {
+            assert_eq!(error, "CANCELLED");
+            assert_eq!((observed.acquires, observed.encoded, observed.submits, observed.maps_requested,
+                observed.maps_succeeded, observed.unmaps, observed.owner_drops), (1,1,1,1,0,1,1));
+            assert_eq!(observed.decoded_words, None);
+        }
+        Fault::AfterUnmapCancel | Fault::AfterUnmapDeviceError => {
+            assert_eq!(error, if matches!(plan, Fault::AfterUnmapCancel) { "CANCELLED" } else { "GPU_DEVICE_FAILED" });
+            assert_eq!((observed.acquires, observed.encoded, observed.submits, observed.maps_requested,
+                observed.maps_succeeded, observed.unmaps, observed.owner_drops), (1,1,1,1,1,1,1));
+            assert_eq!(observed.numeric_flag, Some(0));
+            assert_eq!(observed.decoded_words, Some(rejected.count()));
+        }
+        _ => {
+            assert_eq!(error, DOMAIN_ERROR);
+            assert_eq!((observed.acquires, observed.encoded, observed.submits, observed.maps_requested,
+                observed.maps_succeeded, observed.unmaps, observed.owner_drops), (1,1,1,1,1,1,1));
+            assert!(observed.numeric_flag.is_some_and(|v| v != 0));
+            assert_eq!(observed.decoded_words, None);
+        }
+    }
+    control.clear_caller_cancel(); assert!(session::is_cancelled(EPOCH));
+    // Fresh diagnostic scope only, NOT a fresh epoch: prove ordinary retry
+    // stops before any driver/preparation event after caller cancel is cleared.
+    let retry_calls = Rc::new(Cell::new(0));
+    let mut retry_diagnostics = trace_scope(0x4f50_3634_5254_5259, retry_calls.clone());
+    let before = retry_calls.get(); let retry = run(&valid, EPOCH, &mut || false);
+    let after = retry_calls.get(); assert_eq!(before, after);
+    let retry_error = retry.expect_err("retired epoch reused");
+    retry_diagnostics.finish(&Err::<(), String>(retry_error.clone())); drop(retry_diagnostics);
+    assert_eq!(retry_error, "GPU_SESSION_RECYCLE_REQUIRED");
+    let seal_error = session::complete_stage(t).expect_err("fault stage sealed");
+    let next_error = session::begin_stage(ticket(3), r.family_bytes).expect_err("retired next stage");
+    let frame_error = session::finish_frame(EPOCH, 1).expect_err("retired frame completed");
+    for value in [&seal_error, &next_error, &frame_error] { assert_eq!(value, "GPU_SESSION_RECYCLE_REQUIRED"); }
+    emit(serde_json::json!({"expectedPointRejection":true,"case":label,"plan":plan,"error":error,
+        "observed":observed,"retryError":retry_error,"retryGpuPhaseEvents":after-before,
+        "sealError":seal_error,"nextStageError":next_error,"finishFrameError":frame_error,
+        "noAcceptedOutput":true,"noSuccessfulFaultSeal":true,"resourceRefundClaim":false,
+        "confirmedProcessDeathClaim":false}));
+    diagnostics.finish(&Ok::<(), String>(()));
+}
+fn ordinary_fault(label: &str, plan: Fault) {
+    let p = packet(Job::divide(b(1.05)).unwrap(), [-0.0, 0.0, 0.0]);
+    rejected_case(label, p.clone(), p, plan);
+}
+fn padding_fault(label: &str, bits: u64) {
+    let p = packet(Job::clear(), [0.0; 3]);
+    rejected_case(label, p.clone(), p, Fault::SerializedWord { index: PACKET_WORDS - 1, bits });
+}
