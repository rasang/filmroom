+#[test]
+fn owner_none_path_fixed_dispatch_and_postmap_hooks_are_source_bound() {
+    let source = include_str!("../gpu.rs");
+    assert!(source.contains("run_impl(packet, epoch, cancel, None)"));
+    assert!(source.contains("pass.dispatch_workgroups(kernel::WORKGROUPS, 1, 1)"));
+    assert!(source.contains("let started = Instant::now();\n        let command = encoder.finish();"));
+    let unmap = source.find("readback.unmap();").unwrap();
+    let success = source.find("let words = mapped_result?;").unwrap();
+    let inject = source.find("f.after_unmap(&context.error)").unwrap();
+    let release = source.find("context.release_transients_after_fence()?").unwrap();
+    assert!(unmap < success && success < inject && inject < release);
+    assert!(source.contains("session::validate_fixed_reserve(epoch, r.fixed_bytes)?"));
+    assert!(source.contains("Duration::from_secs(5)"));
+    assert!(source.contains("r.output_bytes, 4"));
+}
