@@ -0,0 +1,82 @@
+//! Closed, explicit one-shot faults. Normal run always supplies None.
+use std::{cell::{Cell, RefCell}, sync::atomic::{AtomicBool, Ordering}};
+use sha2::{Digest, Sha256};
+
+#[derive(Clone, Copy, Debug, serde::Serialize)]
+pub(super) enum Fault {
+    ObserveOnly,
+    PreCancel, AfterSubmitCancel, AfterUnmapCancel, AfterUnmapDeviceError,
+    SerializedWord { index: usize, bits: u64 },
+    UniformWord { index: usize, value: u32 },
+}
+#[derive(Clone, Debug, Default, serde::Serialize)]
+pub(super) struct Observation {
+    pub events: Vec<&'static str>, pub triggers: u32, pub validations: u32,
+    pub acquires: u32, pub pipelines: u32, pub encoded: u32, pub submits: u32,
+    pub maps_requested: u32, pub maps_succeeded: u32, pub numeric_flag: Option<u32>,
+    pub decoded_words: Option<usize>, pub unmaps: u32, pub release_reached: u32,
+    pub releases: u32, pub owner_drops: u32, pub returned_error: Option<String>,
+    pub patch: Option<serde_json::Value>,
+}
+pub(super) struct FaultControl { plan: Fault, cancel: Cell<bool>, trace: RefCell<Observation> }
+impl FaultControl {
+    pub(super) fn new(plan: Fault) -> Self {
+        Self { plan, cancel: Cell::new(false), trace: RefCell::new(Observation::default()) }
+    }
+    pub(super) fn snapshot(&self) -> Observation { self.trace.borrow().clone() }
+    pub(super) fn cancelled(&self) -> bool { self.cancel.get() }
+    pub(super) fn clear_caller_cancel(&self) { self.cancel.set(false); }
+    pub(super) fn event(&self, name: &'static str) {
+        let mut t = self.trace.borrow_mut(); assert!(t.events.len() < 48); t.events.push(name);
+        match name {
+            "validated" => t.validations += 1, "acquired" => t.acquires += 1,
+            "pipeline" => t.pipelines += 1, "encoded" => t.encoded += 1,
+            "submit" => t.submits += 1, "map_requested" => t.maps_requested += 1,
+            "map_succeeded" => t.maps_succeeded += 1, "unmap" => t.unmaps += 1,
+            "release_reached" => t.release_reached += 1, "released" => t.releases += 1,
+            "owner_dropped" => t.owner_drops += 1, _ => {}
+        }
+    }
+    fn trigger(&self, event: &'static str) {
+        self.event(event); let mut t = self.trace.borrow_mut(); t.triggers += 1; assert_eq!(t.triggers, 1);
+    }
+    pub(super) fn initial(&self) {
+        self.event("entry");
+        if matches!(self.plan, Fault::PreCancel) { self.trigger("pre_cancel"); self.cancel.set(true); }
+    }
+    pub(super) fn submitted(&self) {
+        if matches!(self.plan, Fault::AfterSubmitCancel) { self.trigger("post_submit_cancel"); self.cancel.set(true); }
+    }
+    pub(super) fn after_unmap(&self, device_error: &AtomicBool) {
+        match self.plan {
+            Fault::AfterUnmapCancel => { self.trigger("post_unmap_cancel"); self.cancel.set(true); }
+            Fault::AfterUnmapDeviceError => { self.trigger("post_unmap_device_error"); device_error.store(true, Ordering::Release); }
+            _ => {}
+        }
+    }
+    pub(super) fn flag(&self, value: u32) { self.trace.borrow_mut().numeric_flag = Some(value); }
+    pub(super) fn decoded(&self, count: usize) { self.trace.borrow_mut().decoded_words = Some(count); }
+    pub(super) fn returned(&self, error: Option<&String>) { self.trace.borrow_mut().returned_error = error.cloned(); }
+    pub(super) fn serialized(&self, words: &mut [u32], params: &mut [u32; 16]) {
+        match self.plan {
+            Fault::SerializedWord { index, bits } => {
+                assert!(index < words.len() / 2);
+                let before = format!("{:x}", Sha256::digest(bytemuck::cast_slice(words)));
+                let old = u64::from(words[index * 2]) | (u64::from(words[index * 2 + 1]) << 32);
+                assert_ne!(old, bits); words[index * 2] = bits as u32; words[index * 2 + 1] = (bits >> 32) as u32;
+                let after = format!("{:x}", Sha256::digest(bytemuck::cast_slice(words)));
+                self.trigger("serialized_word");
+                self.trace.borrow_mut().patch = Some(serde_json::json!({"index": index,
+                    "beforeBits": format!("{old:016x}"), "afterBits": format!("{bits:016x}"),
+                    "beforeSha256": before, "afterSha256": after, "changedRaw64Words": 1}));
+            }
+            Fault::UniformWord { index, value } => {
+                assert!(index < params.len()); let old = params[index]; assert_ne!(old, value);
+                params[index] = value; self.trigger("uniform_word");
+                self.trace.borrow_mut().patch = Some(serde_json::json!({"index": index,
+                    "before": old, "after": value, "changedU32Words": 1}));
+            }
+            _ => {}
+        }
+    }
+}
