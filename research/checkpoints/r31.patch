index 0000000000000000000000000000000000000000..3dd4c29dba4b6a7e3f54d54f86847f2fa594bdaf
--- /dev/null
+++ b/native/crates/film-engine/src/research_optics64_point/gpu.rs
@@ -0,0 +1,228 @@
+//! Isolated one-stage point runner. The caller owns the real session/ticket,
+//! full family prepayment and post-return seal. No files or spatial operations.
+use super::*;
+use crate::{gpu_phase_diagnostics::{self as trace, Phase}, gpu_session as session};
+use std::{sync::{atomic::Ordering, mpsc}, time::{Duration, Instant}};
+
+mod fault;
+mod tests;
+use fault::FaultControl;
+
+#[derive(Debug, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct Stats {
+    pub adapter: String,
+    pub source_sha256: String,
+    pub compile_ms: f64,
+    pub upload_ms: f64,
+    pub dispatch_readback_ms: f64,
+    pub known_host_payload_bytes: u64,
+    pub resident_bytes: u64,
+    pub upload_staging_bytes: u64,
+    pub device_margin_bytes: u64,
+    pub reserved_combined_bytes: u64,
+    pub dispatches: u64,
+    pub workgroups: u64,
+    pub active_points: u64,
+    pub validation_points: u64,
+    pub readbacks: u64,
+    pub releases: u64,
+    pub pipeline_count: u64,
+    pub host_image_arithmetic: bool,
+}
+#[derive(Debug)]
+pub(super) struct Output { pub words: Vec<u64>, pub stats: Stats }
+
+pub(super) fn run(packet: &Packet, epoch: u64, cancel: &mut impl FnMut() -> bool) -> R<Output> {
+    run_impl(packet, epoch, cancel, None)
+}
+fn run_with_fault(packet: &Packet, epoch: u64, cancel: &mut impl FnMut() -> bool,
+    control: &FaultControl) -> R<Output> {
+    run_impl(packet, epoch, cancel, Some(control))
+}
+fn event(fault: Option<&FaultControl>, name: &'static str) {
+    if let Some(f) = fault { f.event(name); }
+}
+fn check(cancel: &mut impl FnMut() -> bool) -> R<()> {
+    if cancel() { Err("CANCELLED".into()) } else { Ok(()) }
+}
+fn healthy(context: &session::Context, epoch: u64, cancel: &mut impl FnMut() -> bool) -> R<()> {
+    check(cancel)?;
+    if context.error.load(Ordering::Acquire) || session::is_cancelled(epoch) {
+        return Err("GPU_DEVICE_FAILED".into());
+    }
+    Ok(())
+}
+fn run_impl(packet: &Packet, epoch: u64, cancel: &mut impl FnMut() -> bool,
+    fault: Option<&FaultControl>) -> R<Output> {
+    if let Some(f) = fault { f.initial(); }
+    let mut combined_cancel = || fault.is_some_and(FaultControl::cancelled) || cancel();
+    let result = run_inner(packet, epoch, &mut combined_cancel, fault);
+    if result.is_err() { session::retire_current(); }
+    if let Some(f) = fault { f.returned(result.as_ref().err()); }
+    result
+}
+
+fn run_inner(packet: &Packet, epoch: u64, cancel: &mut impl FnMut() -> bool,
+    fault: Option<&FaultControl>) -> R<Output> {
+    check(cancel)?;
+    packet.validate()?;
+    event(fault, "validated");
+    let r = Resources::fixed();
+    // acquire alone permits legacy standalone use. This preflight must precede
+    // it and the first trace/driver operation; retired retries stop here.
+    session::validate_fixed_reserve(epoch, r.fixed_bytes)?;
+    if session::is_cancelled(epoch) { return Err("GPU_DEVICE_FAILED".into()); }
+    if !cfg!(target_endian = "little") { return Err("GPU_OPTICS64_POINT_ENDIAN".into()); }
+    if checked_sum(&[r.pool_bytes, r.upload_bytes, r.margin_bytes])? > r.device_bytes {
+        return Err("GPU_OPTICS64_POINT_BUDGET".into());
+    }
+    let shader = trace::phase_result(Phase::Prepare, kernel::shader)?;
+    let shader_bytes = checked_bytes(shader.capacity(), 1)?;
+    let known_host_payload_bytes = packet.host_payload_bytes(
+        r.upload_bytes, packet.count(), shader_bytes, 0)?;
+    check(cancel)?;
+    let context = trace::phase_result(Phase::Device,
+        || session::Context::acquire(r.packet_bytes, 3, true))?;
+    event(fault, "acquired");
+    // GPU buffers, groups, pipeline, encoder and mapped views are closure-local
+    // and therefore drop before the single Context below, on every Result path.
+    let result = (|| {
+        healthy(&context, epoch, cancel)?;
+        let entries: Vec<_> = (0..4).map(|binding| wgpu::BindGroupLayoutEntry {
+            binding, visibility: wgpu::ShaderStages::COMPUTE,
+            ty: wgpu::BindingType::Buffer {
+                ty: if binding == 3 { wgpu::BufferBindingType::Uniform }
+                    else { wgpu::BufferBindingType::Storage { read_only: binding == 0 } },
+                has_dynamic_offset: false,
+                min_binding_size: wgpu::BufferSize::new(match binding { 2 => 4, 3 => 64, _ => 8 }),
+            }, count: None,
+        }).collect();
+        let started_compile = Instant::now();
+        let (mut pipelines, _) = trace::phase_result(Phase::Pipeline,
+            || context.pipelines(&[&shader], Some(&entries)))?;
+        let compile_ms = started_compile.elapsed().as_secs_f64() * 1000.;
+        if pipelines.len() != 1 { return Err("GPU_OPTICS64_POINT_PIPELINE_COUNT".into()); }
+        let pipeline = pipelines.pop().ok_or("GPU_OPTICS64_POINT_PIPELINE_COUNT")?;
+        event(fault, "pipeline");
+        healthy(&context, epoch, cancel)?;
+        let upload_phase = trace::PhaseGuard::begin(Phase::Upload);
+        let upload_start = Instant::now();
+        let mut words = Vec::with_capacity(PACKET_WORDS * 2);
+        words.extend(packet.words().iter().flat_map(|v| [*v as u32, (*v >> 32) as u32]));
+        let mut parameters = *packet.parameters();
+        if checked_bytes(words.len(), 4)? != r.packet_bytes {
+            return Err("GPU_OPTICS64_POINT_UPLOAD_SIZE".into());
+        }
+        let actual_upload_capacity = checked_sum(&[checked_bytes(words.capacity(), 4)?, 64])?;
+        let _preflight_upload_payload_bytes = packet.host_payload_bytes(
+            actual_upload_capacity, packet.count(), shader_bytes, 0)?;
+        if let Some(f) = fault { f.serialized(&mut words, &mut parameters); }
+        let init = |label, data: &[u32], usage| context.buffer_init(
+            &wgpu::util::BufferInitDescriptor {
+                label: Some(label), contents: bytemuck::cast_slice(data), usage,
+            }, true);
+        let uniform = init("optics64 immutable point descriptor", &parameters, wgpu::BufferUsages::UNIFORM)?;
+        let input = init("optics64 fixed packet including all padding", &words, wgpu::BufferUsages::STORAGE)?;
+        drop(words);
+        let make = |label, size, usage| context.buffer(&wgpu::BufferDescriptor {
+            label: Some(label), size, usage, mapped_at_creation: false,
+        }, true);
+        let storage = wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC;
+        let output = make("optics64 separate raw64 output", r.output_bytes, storage)?;
+        // Zero initialized only for a valid new request, never reset after error.
+        let error = make("optics64 request sticky error", r.error_bytes, storage)?;
+        let readback = make("optics64 full output and fixed-offset flag", r.map_bytes,
+            wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST)?;
+        let upload_ms = upload_start.elapsed().as_secs_f64() * 1000.;
+        upload_phase.finish();
+        healthy(&context, epoch, cancel)?;
+        let buffers = [&input, &output, &error, &uniform];
+        let bindings: Vec<_> = buffers.iter().enumerate().map(|(binding, buffer)|
+            wgpu::BindGroupEntry { binding: binding as u32, resource: buffer.as_entire_binding() }).collect();
+        let group = context.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("optics64 exact four binding ABI"),
+            layout: &pipeline.get_bind_group_layout(0), entries: &bindings,
+        });
+        let encoding_phase = trace::StepGuard::begin(1, Phase::Compute);
+        let mut encoder = context.device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+                label: Some("optics64 full-capacity validation and active point math"), timestamp_writes: None,
+            });
+            pass.set_pipeline(&pipeline); pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(kernel::WORKGROUPS, 1, 1);
+        }
+        event(fault, "encoded");
+        encoder.copy_buffer_to_buffer(&output, 0, &readback, 0, r.output_bytes);
+        encoder.copy_buffer_to_buffer(&error, 0, &readback, r.output_bytes, 4);
+        healthy(&context, epoch, cancel)?;
+        let started = Instant::now();
+        let command = encoder.finish();
+        encoding_phase.finish();
+        let submit_phase = trace::StepGuard::begin(2, Phase::Compute);
+        context.queue.submit([command]);
+        event(fault, "submit");
+        if let Some(f) = fault { f.submitted(); }
+        submit_phase.finish();
+        let readback_phase = trace::PhaseGuard::begin(Phase::Readback);
+        let (tx, rx) = mpsc::channel();
+        readback.slice(0..r.map_bytes).map_async(wgpu::MapMode::Read, move |result| { let _ = tx.send(result); });
+        event(fault, "map_requested");
+        let mapped_result: R<Vec<u64>> = (|| {
+            loop {
+                healthy(&context, epoch, cancel)?;
+                if started.elapsed() > Duration::from_secs(5) { return Err("GPU_OPTICS64_POINT_TIMEOUT".into()); }
+                let _ = context.device.poll(wgpu::Maintain::Poll);
+                match rx.try_recv() {
+                    Ok(Ok(())) => break,
+                    Ok(Err(_)) | Err(mpsc::TryRecvError::Disconnected) => return Err("GPU_OPTICS64_POINT_READBACK".into()),
+                    Err(mpsc::TryRecvError::Empty) => {}
+                }
+                if started.elapsed() > Duration::from_secs(5) { return Err("GPU_OPTICS64_POINT_TIMEOUT".into()); }
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            event(fault, "map_succeeded");
+            if started.elapsed() > Duration::from_secs(5) { return Err("GPU_OPTICS64_POINT_TIMEOUT".into()); }
+            let mapped = readback.slice(0..r.map_bytes).get_mapped_range();
+            let flag = u32::from_le_bytes(mapped[r.output_bytes as usize..].try_into().unwrap());
+            if let Some(f) = fault { f.flag(flag); }
+            if flag != 0 { return Err(DOMAIN_ERROR.into()); }
+            let active_bytes = packet.count() * 8;
+            let words: Vec<u64> = mapped[..active_bytes].chunks_exact(8)
+                .map(|v| u64::from_le_bytes(v.try_into().unwrap())).collect();
+            if words.iter().any(|&v| !admitted(v)) { return Err("GPU_OPTICS64_POINT_OUTPUT_DOMAIN".into()); }
+            if let Some(f) = fault { f.decoded(words.len()); }
+            Ok(words)
+        })();
+        // mapped views have died with mapped_result's closure, including errors.
+        readback.unmap(); event(fault, "unmap");
+        let words = mapped_result?;
+        let known_host_payload_bytes = packet.host_payload_bytes(
+            actual_upload_capacity, words.capacity(), shader_bytes, 0)?;
+        // Named hook only after successful map/decode/unmap, not guessed polling.
+        if let Some(f) = fault { f.after_unmap(&context.error); }
+        if started.elapsed() > Duration::from_secs(5) { return Err("GPU_OPTICS64_POINT_TIMEOUT".into()); }
+        readback_phase.finish();
+        healthy(&context, epoch, cancel)?;
+        event(fault, "release_reached");
+        context.release_transients_after_fence()?;
+        event(fault, "released");
+        healthy(&context, epoch, cancel)?;
+        Ok(Output { words, stats: Stats {
+            adapter: context.info.name.clone(), source_sha256: kernel::GENERATED_SHA256.into(),
+            compile_ms, upload_ms, dispatch_readback_ms: started.elapsed().as_secs_f64() * 1000.,
+            known_host_payload_bytes, resident_bytes: r.pool_bytes, upload_staging_bytes: r.upload_bytes,
+            device_margin_bytes: r.margin_bytes, reserved_combined_bytes: r.combined_bytes,
+            dispatches: 1, workgroups: kernel::WORKGROUPS as u64, active_points: packet.count() as u64,
+            validation_points: CAPACITY as u64, readbacks: 1, releases: 1, pipeline_count: 1,
+            host_image_arithmetic: false,
+        } })
+    })();
+    if result.is_err() { context.error.store(true, Ordering::Release); session::retire_current(); }
+    drop(context); event(fault, "owner_dropped");
+    // Outer complete_stage checks the last fence and live-owner count; the
+    // caller then checks cancellation again before treating these words as accepted.
+    let _ = known_host_payload_bytes; // pre-allocation bound checked above
+    result
+}
