+#[test]
+fn line_tag_sigma_coefficients_geometry_and_input_guards_are_revalidated() {
+    for sigma in [-1., 0.5, 3.] {
+        let filter = Gaussian::from_sigma(sigma, 23, 17).unwrap();
+        for (length, lines) in [(0, 1), (40_001, 1), (1, 0), (40_000, u32::MAX)] {
+            assert!(filter.line(length, lines).is_err());
+        }
+        let capacity = if sigma >= 3. {
+            super::super::CAPACITY
+        } else {
+            super::super::fir::CAPACITY
+        };
+        assert_eq!(
+            filter.line(1, capacity).unwrap().sample_count().unwrap(),
+            capacity as usize
+        );
+        assert!(filter.line(1, capacity + 1).is_err());
+        let line = filter.line(23, 1).unwrap();
+        for word in [
+            f64::NAN.to_bits(),
+            f64::INFINITY.to_bits(),
+            1,
+            super::super::BOUND.to_bits() + 1,
+        ] {
+            let mut input = vec![0; 23];
+            input[7] = word;
+            assert!(line.validate_input(&input).is_err());
+        }
+        let mut changed = line.clone();
+        match &mut changed {
+            SpatialLine::Identity {
+                original_sigma_bits,
+                ..
+            } => *original_sigma_bits = 1_f32.to_bits(),
+            SpatialLine::Fir(copy) => copy.coefficient_bits[0] ^= 1,
+            SpatialLine::Iir(copy) => copy.coefficient_bits[0] ^= 1,
+        }
+        assert!(changed.validate().is_err());
+        assert!(changed.sample_count().is_err());
+        assert!(changed.validate_input(&vec![0; 23]).is_err());
+    }
+    let copy = FirSpec::new(0., 23, 1).unwrap();
+    assert!(SpatialLine::Fir(copy.clone()).validate().is_err());
+    let mut negative_zero_copy = copy;
+    negative_zero_copy.sigma_bits = (-0_f32).to_bits();
+    assert!(
+        SpatialLine::Identity {
+            original_sigma_bits: (-1_f32).to_bits(),
+            copy: negative_zero_copy
+        }
+        .validate()
+        .is_err()
+    );
+    let fir = FirSpec::new(0.5, 23, 1).unwrap();
+    assert!(
+        SpatialLine::Identity {
+            original_sigma_bits: 0,
+            copy: fir
+        }
+        .validate()
+        .is_err()
+    );
+    let mut iir = LineSpec {
+        length: 23,
+        lines: 1,
+        sigma_bits: 3_f32.to_bits(),
+        coefficient_bits: original_iir(3.),
+    };
+    iir.sigma_bits = 0.5_f32.to_bits();
+    assert!(SpatialLine::Iir(iir).validate().is_err());
