+//! Explicit opt-in evidence only. Never changes shader, RNG, or production metrics.
+use super::*;
+use std::{cell::RefCell,path::PathBuf,sync::OnceLock,io::Write};
+const ENV:&str="FILM_GRAIN_EVIDENCE_DIR";
+thread_local!{static ACTIVE:RefCell<Option<(PathBuf,u64)>>=const{RefCell::new(None)};}
+static ROOT:OnceLock<Result<PathBuf,String>>=OnceLock::new();
+pub(super) struct Session{path:PathBuf}
+fn write_new(path:&Path,bytes:&[u8])->R<()>{
+ let mut file=OpenOptions::new().write(true).create_new(true).open(path).map_err(|e|format!("EVIDENCE_CREATE_NEW: {e}"))?;
+ file.write_all(bytes).and_then(|_|file.sync_all()).map_err(|e|format!("EVIDENCE_WRITE: {e}"))
+}
+impl Session{
+ pub(super) fn begin(label:&str,p:&GrainPlan)->R<Option<Self>>{
+  let Some(value)=std::env::var_os(ENV)else{return Ok(None)};let requested=PathBuf::from(value);
+  if !requested.is_absolute(){return Err("EVIDENCE_REQUIRES_ABSOLUTE_NEW_DIRECTORY".into());}
+  let root=ROOT.get_or_init(||{std::fs::create_dir(&requested).map_err(|e|format!("EVIDENCE_NEW_DIRECTORY: {e}"))?;Ok(requested.clone())}).as_ref().map_err(Clone::clone)?;
+  if root!=&requested{return Err("EVIDENCE_DIRECTORY_CHANGED".into());}
+  if !label.bytes().all(|c|c.is_ascii_alphanumeric()||c==b'-'){return Err("EVIDENCE_INVALID_LABEL".into());}
+  if ACTIVE.with(|a|a.borrow().is_some()){return Err("EVIDENCE_NESTED_SESSION".into());}
+  let path=root.join(format!("{label}-{:?}-{}x{}",p.rng_mode,p.width,p.height));
+  std::fs::create_dir(&path).map_err(|e|format!("EVIDENCE_NEW_CASE: {e}"))?;
+  let session=Self{path};session.write("plan.json",&serde_json::to_vec_pretty(p).map_err(|e|e.to_string())?)?;
+  session.write("format.txt",b"v1: f64le image planes; census records f32le raw finite integer lanes. Prepared snapshots retain slots0..17 only (parameters, RNG state/words/steps/failure, particles), never ALU temporaries or candidate cache slots. Extra test readbacks use separate metrics. This artifact run is not a performance benchmark.\n")?;
+  session.write("code-identity.json",&serde_json::to_vec_pretty(&serde_json::json!({"aluAbi":super::super::alu_programs::ABI_VERSION,"codeSha256":super::super::alu_programs::CODE_PREFIX_SHA256})).map_err(|e|e.to_string())?)?;
+  ACTIVE.with(|a|*a.borrow_mut()=Some((session.path.clone(),0)));Ok(Some(session))
+ }
+ pub(super) fn write(&self,name:&str,bytes:&[u8])->R<()>{write_new(&self.path.join(name),bytes)}
+}
+impl Drop for Session{fn drop(&mut self){ACTIVE.with(|a|*a.borrow_mut()=None);}}
+fn record(label:&str,bytes:&[u8])->R<()>{ACTIVE.with(|a|{
+ let mut state=a.borrow_mut();let Some((path,index))=state.as_mut()else{return Ok(())};
+ let file=path.join(format!("census-{index:05}-{label}.bin"));write_new(&file,bytes)?;*index+=1;Ok(())
+})}
+pub(super) fn floats(label:&str,data:&[f32])->R<()>{
+ if !ACTIVE.with(|a|a.borrow().is_some()){return Ok(());}
+ record(label,&data.iter().flat_map(|v|v.to_le_bytes()).collect::<Vec<_>>())
+}
+pub(super) fn frames(r:&Runner,kind:u32,base:u32,count:u32,c:&mut impl FnMut()->bool,m:&RunMetrics)->R<()>{
+ if !ACTIVE.with(|a|a.borrow().is_some()){return Ok(());}
+ // Do not falsify the production contract's counters with test-only readbacks.
+ // A detached metrics value accounts for these extra commands separately.
+ let mut extra=m.clone();let total=count as u64*544;let mut raw=Vec::with_capacity(total as usize);let mut at=0;
+ while at<total{let bytes=(total-at).min(spatial::TRANSFER_BYTES);raw.extend(r.test_read_grain_scratch(4800+at,bytes,c,&mut extra)?);at+=bytes;}
+ let common:Vec<u8>=raw.chunks_exact(544).flat_map(|frame|frame[..18*4].iter().copied()).collect();
+ record(&format!("prepared-kind{kind}-base{base}-count{count}"),&common)
+}
+#[cfg(test)]mod tests{
+ use super::*;
+ #[test]fn create_new_never_overwrites_evidence(){
+  let root=std::env::temp_dir().join(format!("grain-evidence-create-new-{}-{}",std::process::id(),std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+  std::fs::create_dir(&root).unwrap();let path=root.join("proof");write_new(&path,b"first").unwrap();assert!(write_new(&path,b"second").is_err());assert_eq!(std::fs::read(&path).unwrap(),b"first");std::fs::remove_dir_all(root).unwrap();
+ }
+}
