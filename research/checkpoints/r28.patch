+//! Synthetic host-only schema, binding, and filesystem tests. No test here
+//! certifies the real factory, a retained GPU adapter, or GPU execution.
+use super::*;
+use serde_json::json;
+
+fn context() -> ExperimentContext {
+    ExperimentContext {
+        build_sha256: "1".repeat(64),
+        fixture_sha256: "2".repeat(64),
+        profile_sha256: "3".repeat(64),
+        params_sha256: "4".repeat(64),
+        prefix_records_sha256: "5".repeat(64),
+        actual_metered_ev_bits: Some(0f32.to_bits()),
+        actual_ae_scale_promoted_bits: Some(1f64.to_bits()),
+        exposure_compensation_scale_promoted_bits: 1f64.to_bits(),
+        effective_exposure_factor_bits: 1f64.to_bits(),
+        log_correction_bits: 1f64.to_bits(),
+        resume: ExperimentResume::FreshFrame,
+    }
+}
+fn stage(width: u32, height: u32) -> StagePlan {
+    let p = GlobalPlan::log_exposure(width, height, 1.).unwrap();
+    StagePlan {
+        schema_version: 1,
+        operation: "fullExposureLog".into(),
+        token: 73,
+        manifest_sha256: "6".repeat(64),
+        width,
+        height,
+        sample_width: p.sample_width,
+        sample_height: p.sample_height,
+        grid_version: p.grid_version,
+        device_bytes: p.device_bytes,
+        host_bytes: p.host_bytes,
+        driver_allowance_bytes: p.driver_allowance_bytes,
+        helper_allowance_bytes: p.helper_allowance_bytes,
+        combined_peak_bytes: p.combined_peak_bytes,
+        disk_bytes: p.disk_bytes,
+    }
+}
+fn ticket() -> StageTicket {
+    StageTicket {
+        epoch: 71,
+        generation: 72,
+        sequence: 74,
+    }
+}
+fn seal(p: &StagePlan) -> Value {
+    json!({"ok":true,"schemaVersion":1,"epoch":71,"generation":72,"sequence":74,"token":73,"operation":"fullExposureLog","stageSealed":true,"summary":{"ok":true,"schemaVersion":1,"gpuUsed":true,"fullImage":true,"operation":"fullExposureLog","token":73,"manifestSha256":p.manifest_sha256,"width":p.width,"height":p.height,"backend":EXPECTED_BACKEND,"dispatches":3,"vendor":65535},"session":{"epoch":71}})
+}
+
+/// Host-test fixture only. It bypasses the real factory and makes NO GPU,
+/// native-seal, adapter, prefix, or adoption claim. The intentionally fake
+/// producer origin remains visible in its serialized identity. This helper is
+/// unavailable outside cfg(test) and cannot stand in for the actual chain gate.
+pub(in crate::research_iir_soft64) fn synthetic_evidence_for_test(
+    width: u32,
+    height: u32,
+    context: ExperimentContext,
+    output_hashes: [String; 3],
+) -> DerivedLogEvidence {
+    let p = stage(width, height);
+    let producer_directory = PathBuf::from("/synthetic-host-only-not-gpu-provenance/gpu-stage-73");
+    DerivedLogEvidence {
+        input_identity: INPUT_IDENTITY.into(),
+        real_factory_evidence: false,
+        epoch: 71,
+        generation: 72,
+        sequence: 74,
+        token: 73,
+        plan_sha256: digest(&encode(&p).unwrap()),
+        plan: p,
+        native_seal_sha256: digest(b"SYNTHETIC HOST FIXTURE: NO NATIVE SEAL OR GPU PROOF"),
+        producer_shader_sha256: digest(crate::research_global::LOG_SHADER.as_bytes()),
+        input_plane_sha256: std::array::from_fn(|_| "7".repeat(64)),
+        output_plane_sha256: output_hashes,
+        context,
+        producer_outputs: std::array::from_fn(|channel| ProducerOutputIdentity {
+            path: producer_directory
+                .join("candidate")
+                .join(format!("plane-{channel}.f64le")),
+            device: u64::MAX,
+            inode: u64::MAX - channel as u64,
+        }),
+        producer_directory,
+    }
+}
+fn evidence() -> DerivedLogEvidence {
+    synthetic_evidence_for_test(7, 3, context(), std::array::from_fn(|_| "8".repeat(64)))
+}
