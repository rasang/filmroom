+//! Test-only, one-batch typed binary64 exposure. The caller owns the real
+//! session/frame/stage and must drop this call's resources before sealing it.
+//! No session activation, standalone fallback, reset, files, JNI or full chain.
+#![cfg(test)]
+use super::Packet;
+use crate::{gpu_session as session, gpu_phase_diagnostics::{self as trace, Phase}};
+use std::{sync::{atomic::Ordering, mpsc}, time::{Duration, Instant}};
+
+type R<T> = Result<T, String>;
+const MIB: u64 = 1024 * 1024;
+const HOST_BYTES: u64 = 96 * MIB;
+const FIXED_BYTES: u64 = HOST_BYTES + 64 * MIB; // Host payload + isolated helper.
+const FAMILY_BYTES: u64 = 64 * MIB; // Whole driver/compiler family, not a cheap slot.
+const DEVICE_BYTES: u64 = 64 * MIB; // Pool AND queued upload staging.
+const COMBINED_BYTES: u64 = FIXED_BYTES + FAMILY_BYTES + DEVICE_BYTES;
+
+#[derive(Debug)]
+pub(crate) struct Stats {
+    pub adapter: String,
+    pub compile_ms: f64,
+    pub upload_ms: f64,
+    pub dispatch_readback_ms: f64,
+    pub resident_bytes: u64,
+    pub upload_bytes: u64,
+    pub upload_staging_bytes: u64,
+    pub reserved_combined_bytes: u64,
+    pub dispatches: u64,
+    pub readbacks: u64,
+    pub releases: u64,
+    pub host_image_arithmetic: bool,
+    // Actual cache counters are available only from caller's post-seal stats.
+    pub pipeline_cache_hits: Option<u64>,
+    pub pipeline_count: u64,
+}
+#[derive(Debug)]
+pub(crate) struct Output {
+    pub raw64: Vec<u64>,
+    pub stats: Stats,
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err("CANCELLED".into()) } else { Ok(()) }
+}
+fn sum(parts: &[u64]) -> R<u64> {
+    parts.iter().try_fold(0u64, |a, b| a.checked_add(*b).ok_or_else(|| "GPU_EXPOSURE64_BUDGET".into()))
+}
+fn bytes(n: usize, width: u64) -> R<u64> {
+    u64::try_from(n).ok().and_then(|n| n.checked_mul(width)).ok_or_else(|| "GPU_EXPOSURE64_BUDGET".into())
+}
+fn healthy(context: &session::Context, epoch: u64, c: &mut impl FnMut() -> bool) -> R<()> {
+    check(c)?;
+    if context.error.load(Ordering::Acquire) || session::is_cancelled(epoch) {
+        return Err("GPU_DEVICE_FAILED".into());
+    }
+    Ok(())
+}
+
+/// Exactly one bounded batch in the caller's already-begun session. Failures
+/// retire that epoch; neither cancellation nor partial results permit reuse.
+pub(crate) fn run(packet: &Packet, epoch: u64, c: &mut impl FnMut() -> bool) -> R<Output> {
+    let result = run_inner(packet, epoch, c);
+    if result.is_err() { session::retire_current(); }
+    result
+}
+// Exact-size pool reuse only. Never silently admit another allocation shape in
+// this thread's epoch, nor erase accumulated debt. Session is worker-confined.
+thread_local! {
+    static SHAPE: std::cell::Cell<Option<(u64, u64, u64)>> = const { std::cell::Cell::new(None) };
+}
+fn run_inner(packet: &Packet, epoch: u64, c: &mut impl FnMut() -> bool) -> R<Output> {
+    check(c)?;
+    packet.validate()?;
+    // This preflight must precede acquire: acquire alone permits standalone use.
+    session::validate_fixed_reserve(epoch, FIXED_BYTES)?;
+    if session::is_cancelled(epoch) { return Err("GPU_DEVICE_FAILED".into()); }
+    if !cfg!(target_endian = "little") { return Err("GPU_EXPOSURE64_ENDIAN".into()); }
+    let pixels = packet.input.len() / 3;
+    if packet.input.is_empty() || packet.input.len() % 3 != 0
+        || packet.chunk_cap == 0 || packet.chunk_cap > 65536
+        || pixels > packet.chunk_cap as usize {
+        return Err("GPU_EXPOSURE64_CHUNK".into());
+    }
+    let input_bytes = bytes(packet.input.len(), 8)?;
+    let table_bytes = bytes(packet.descriptor.table.len(), 8)?;
+    let capacity_bytes = u64::from(packet.chunk_cap).checked_mul(24).ok_or("GPU_EXPOSURE64_BUDGET")?;
+    let map_bytes = sum(&[capacity_bytes, 4])?;
+    let mapped_bytes = sum(&[input_bytes, 4])?;
+    let shape = (epoch, capacity_bytes, table_bytes);
+    SHAPE.with(|v| match v.get() {
+        None => { v.set(Some(shape)); Ok(()) },
+        Some(old) if old == shape => Ok(()),
+        _ => Err("GPU_EXPOSURE64_ALLOCATION_SHAPE_CHANGED".to_string()),
+    })?;
+    let resident_bytes = sum(&[capacity_bytes, table_bytes, capacity_bytes, map_bytes, 4, 256])?;
+    let upload_bytes = sum(&[capacity_bytes, table_bytes, 256])?;
+    if table_bytes == 0 || sum(&[resident_bytes, upload_bytes])? > DEVICE_BYTES {
+        return Err("GPU_EXPOSURE64_BUDGET".into());
+    }
+    // Reserve the original host vectors, serialized uploads and decoded output
+    // simultaneously. Capacities count too; the 96 MiB is not just input size.
+    let host_bytes = sum(&[bytes(packet.input.capacity(), 8)?,
+        bytes(packet.descriptor.table.capacity(), 8)?, upload_bytes, input_bytes])?;
+    if host_bytes > HOST_BYTES { return Err("GPU_EXPOSURE64_HOST_BUDGET".into()); }
+    let source = trace::phase_result(Phase::Prepare, super::shader)?;
+    if sum(&[host_bytes, bytes(source.capacity(), 1)?])? > HOST_BYTES {
+        return Err("GPU_EXPOSURE64_HOST_BUDGET".into());
+    }
+    check(c)?;
+    let context = trace::phase_result(Phase::Device, || {
+        session::Context::acquire(map_bytes.max(table_bytes).max(256), 4, true)
+    })?;
+    // All GPU resources live inside this closure, and die before Context does.
+    let result = (|| {
+        healthy(&context, epoch, c)?;
+        let layout: Vec<_> = (0..5).map(|binding| wgpu::BindGroupLayoutEntry {
+            binding, visibility: wgpu::ShaderStages::COMPUTE,
+            ty: wgpu::BindingType::Buffer {
+                ty: if binding == 0 { wgpu::BufferBindingType::Uniform }
+                    else { wgpu::BufferBindingType::Storage { read_only: binding == 1 || binding == 2 } },
+                has_dynamic_offset: false,
+                min_binding_size: wgpu::BufferSize::new(if binding == 0 { 256 } else if binding == 4 { 4 } else { 8 }),
+            }, count: None,
+        }).collect();
+        let compile_at = Instant::now();
+        let (mut pipelines, _) = trace::phase_result(Phase::Pipeline, || context.pipelines(&[&source], Some(&layout)))?;
+        let pipeline = pipelines.pop().ok_or("GPU_EXPOSURE64_PIPELINE")?;
+        let compile_ms = compile_at.elapsed().as_secs_f64() * 1000.;
+        healthy(&context, epoch, c)?;
+        let upload_phase = trace::PhaseGuard::begin(Phase::Upload);
+        let at = Instant::now();
+        let mut input_words = packet.input_words();
+        let table_words = packet.table_words();
+        let params = packet.params();
+        if bytes(input_words.len(), 4)? != input_bytes { return Err("GPU_EXPOSURE64_INPUT".into()); }
+        input_words.resize((capacity_bytes / 4) as usize, 0);
+        if bytes(input_words.len(), 4)? != capacity_bytes || bytes(table_words.len(), 4)? != table_bytes
+            || sum(&[bytes(packet.input.capacity(), 8)?, bytes(packet.descriptor.table.capacity(), 8)?,
+                bytes(input_words.capacity(), 4)?, bytes(table_words.capacity(), 4)?, 256,
+                input_bytes, bytes(source.capacity(), 1)?])? > HOST_BYTES {
+            return Err("GPU_EXPOSURE64_HOST_BUDGET".into());
+        }
+        let init = |label, words: &[u32], usage| context.buffer_init(&wgpu::util::BufferInitDescriptor {
+            label: Some(label), contents: bytemuck::cast_slice(words), usage,
+        }, true);
+        let uniform = init("exposure64 immutable 256-byte descriptor", &params, wgpu::BufferUsages::UNIFORM)?;
+        let input = init("exposure64 raw input", &input_words, wgpu::BufferUsages::STORAGE)?;
+        let table = init("exposure64 raw original table", &table_words, wgpu::BufferUsages::STORAGE)?;
+        drop(input_words);
+        drop(table_words);
+        let make = |label, size, usage| context.buffer(&wgpu::BufferDescriptor {
+            label: Some(label), size, usage, mapped_at_creation: false,
+        }, true);
+        let storage = wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC;
+        let output = make("exposure64 raw output", capacity_bytes, storage)?;
+        // New checkout is zero initialized. Never reset a numeric failure.
+        let error = make("exposure64 sticky numeric error", 4, storage)?;
+        let readback = make("exposure64 typed result and error", map_bytes,
+            wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST)?;
+        let upload_ms = at.elapsed().as_secs_f64() * 1000.;
+        upload_phase.finish();
+        let encoding_phase = trace::StepGuard::begin(1, Phase::Compute);
+        let bindings = [&uniform, &input, &table, &output, &error];
+        let entries: Vec<_> = bindings.iter().enumerate().map(|(i, b)| wgpu::BindGroupEntry {
+            binding: i as u32, resource: b.as_entire_binding(),
+        }).collect();
+        let group = context.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("closed exposure64 typed ABI"), layout: &pipeline.get_bind_group_layout(0), entries: &entries,
+        });
+        let mut encoder = context.device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+                label: Some("closed exposure64 single bounded batch"), timestamp_writes: None,
+            });
+            pass.set_pipeline(&pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups((pixels.max(packet.descriptor.table.len()) as u32).div_ceil(64), 1, 1);
+        }
+        encoder.copy_buffer_to_buffer(&output, 0, &readback, 0, input_bytes);
+        encoder.copy_buffer_to_buffer(&error, 0, &readback, input_bytes, 4);
+        healthy(&context, epoch, c)?;
+        let started = Instant::now();
+        let command = encoder.finish();
+        encoding_phase.finish();
+        let submit_phase = trace::StepGuard::begin(2, Phase::Compute);
+        context.queue.submit([command]);
+        submit_phase.finish();
+        let readback_phase = trace::PhaseGuard::begin(Phase::Readback);
+        let (tx, rx) = mpsc::channel();
+        readback.slice(0..mapped_bytes).map_async(wgpu::MapMode::Read, move |r| { let _ = tx.send(r); });
+        let mapped_result: R<Vec<u64>> = (|| {
+            loop {
+                healthy(&context, epoch, c)?;
+                let _ = context.device.poll(wgpu::Maintain::Poll);
+                match rx.try_recv() {
+                    Ok(Ok(())) => break,
+                    Ok(Err(_)) | Err(mpsc::TryRecvError::Disconnected) => return Err("GPU_EXPOSURE64_READBACK".into()),
+                    Err(mpsc::TryRecvError::Empty) => {}
+                }
+                if started.elapsed() > Duration::from_secs(5) { return Err("GPU_EXPOSURE64_TIMEOUT".into()); }
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            let mapped = readback.slice(0..mapped_bytes).get_mapped_range();
+            let flag = u32::from_le_bytes(mapped[input_bytes as usize..].try_into().unwrap());
+            if flag != 0 { return Err("GPU_EXPOSURE64_NUMERIC_DOMAIN".into()); }
+            let raw64: Vec<u64> = mapped[..input_bytes as usize].chunks_exact(8)
+                .map(|v| u64::from_le_bytes(v.try_into().unwrap())).collect();
+            if raw64.iter().any(|v| !super::admitted(*v)) { return Err("GPU_EXPOSURE64_OUTPUT_DOMAIN".into()); }
+            Ok(raw64)
+        })();
+        // All mapped views are dropped even on decode/numeric/cancel errors.
+        readback.unmap();
+        let raw64 = mapped_result?;
+        readback_phase.finish();
+        healthy(&context, epoch, c)?;
+        context.release_transients_after_fence()?;
+        healthy(&context, epoch, c)?;
+        Ok(Output { raw64, stats: Stats {
+            adapter: context.info.name.clone(), compile_ms, upload_ms,
+            dispatch_readback_ms: started.elapsed().as_secs_f64() * 1000.,
+            resident_bytes, upload_bytes, upload_staging_bytes: upload_bytes,
+            reserved_combined_bytes: COMBINED_BYTES, dispatches: 1, readbacks: 1,
+            releases: 1, host_image_arithmetic: false, pipeline_cache_hits: None, pipeline_count: 1,
+        } })
+    })();
+    if result.is_err() { context.error.store(true, Ordering::Release); session::retire_current(); }
+    // The caller's complete_stage provides the final queue fence and checks
+    // device/retirement state after this Context has gone away. It must also
+    // recheck its cancellation token after that fence before accepting output.
+    result
+}
+
+#[test]
+fn declared_reservations_cover_full_family_and_helper() {
+    assert_eq!(COMBINED_BYTES, 288 * MIB);
+    assert_eq!(FIXED_BYTES, 160 * MIB);
+    assert_eq!(FAMILY_BYTES, 64 * MIB);
+    assert_eq!(DEVICE_BYTES, 64 * MIB);
+}
diff --git a/native/crates/film-engine/src/research_exposure64/host.rs b/native/crates/film-engine/src/research_exposure64/host.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef12299ef7a8f7aecfc70082e7490c951a749fe0
--- /dev/null
+++ b/native/crates/film-engine/src/research_exposure64/host.rs
@@ -0,0 +1,96 @@
+//! Independent executable host model of the admitted integer arithmetic and
+//! exact expression tree. The actual original spectral function remains oracle.
+use super::*;
+use std::ops::{Add, Sub, Mul, Div, Neg};
+#[derive(Clone, Copy, Debug)]
+pub(super) struct V(pub u64);
+impl V {
+    pub fn c(x:f64)->Self {Self(x.to_bits())}
+    fn valid(self)->bool {admitted(self.0)}
+    fn zero(self)->bool {self.0 & !SIGN == 0}
+    fn invalid()->Self {Self(soft64::NAN)}
+    fn cmp(self,r:Self)->Option<std::cmp::Ordering> {
+        if !self.valid()||!r.valid(){None}else{soft64::cmp(self.0,r.0)}
+    }
+    fn abs(self)->Self {Self(self.0 & !SIGN)}
+    fn clamp(self,lo:Self,hi:Self)->Self {
+        if !self.valid()||!lo.valid()||!hi.valid(){return Self::invalid();}
+        if self.cmp(lo).unwrap().is_lt(){lo}else if self.cmp(hi).unwrap().is_gt(){hi}else{self}
+    }
+    fn checked(bits:u64)->Self {if admitted(bits){Self(bits)}else{Self::invalid()}}
+}
+impl Add for V {type Output=Self;fn add(self,r:Self)->Self {
+    if !self.valid()||!r.valid(){return Self::invalid();}
+    if self.zero()&&r.zero(){return Self((self.0&r.0)&SIGN);}
+    Self::checked(soft64::add(self.0,r.0))
+}}
+impl Neg for V {type Output=Self;fn neg(self)->Self {Self(self.0^SIGN)}}
+impl Sub for V {type Output=Self;fn sub(self,r:Self)->Self {self+(-r)}}
+impl Mul for V {type Output=Self;fn mul(self,r:Self)->Self {
+    if !self.valid()||!r.valid(){return Self::invalid();}
+    if self.zero()||r.zero(){return Self((self.0^r.0)&SIGN);}
+    Self::checked(soft64::mul(self.0,r.0))
+}}
+impl Div for V {type Output=Self;fn div(self,r:Self)->Self {
+    // 0/0 is always rejected, even with signed zeros.
+    if !self.valid()||!r.valid()||r.zero(){return Self::invalid();}
+    if self.zero(){return Self((self.0^r.0)&SIGN);}
+    Self::checked(soft64::div(self.0,r.0))
+}}
+pub(super) fn weight(t:V)->V {
+    if !t.valid(){return V::invalid();}
+    let x=t.abs();let b=V::c(1./3.);let c=V::c(1./3.);let k=V::c;
+    if x.cmp(k(1.)).unwrap().is_lt() {
+        k(1./6.)*((k(12.)-k(9.)*b-k(6.)*c)*x*x*x
+            +(-k(18.)+k(12.)*b+k(6.)*c)*x*x+(k(6.)-k(2.)*b))
+    }else if x.cmp(k(2.)).unwrap().is_lt(){
+        k(1./6.)*((-b-k(6.)*c)*x*x*x+(k(6.)*b+k(30.)*c)*x*x
+            +(-k(12.)*b-k(48.)*c)*x+(k(8.)*b+k(24.)*c))
+    }else{k(0.)}
+}
+pub(super) fn reflect(index:i32,side:u32)->usize {
+    if index<0 {(-index) as usize}else if index>=side as i32{(2*(side as i32-1)-index) as usize}else{index as usize}
+}
+pub(super) fn index(x:V,side:u32)->R<usize> {
+    if !(2..=1024).contains(&side)||!x.valid()||x.cmp(V::c(0.)).unwrap().is_lt()
+        ||x.cmp(V::c((side-1) as f64)).unwrap().is_gt(){return Err(ERROR.into());}
+    if x.cmp(V::c((side-1) as f64)).unwrap().is_ge(){return Ok((side-2) as usize);}
+    let i=soft64::floor(x.0).ok_or(ERROR)?;
+    if i<0||i>=i64::from(side-1){return Err(ERROR.into());}Ok(i as usize)
+}
+pub(super) fn run(p:&Packet)->R<Vec<u64>> {
+    p.validate()?;
+    let d=&p.descriptor;let k=V::c;let side=d.size as u32;
+    let row=|m:&[f64;3],v:[V;3]|(k(m[0])*v[0]+k(m[1])*v[1])+k(m[2])*v[2];
+    let mut out=Vec::with_capacity(p.input.len());
+    for input in p.input.chunks_exact(3) {
+        let rgb=std::array::from_fn(|c| (V(input[c])*k(d.auto_exposure))*k(d.exposure));
+        let native=std::array::from_fn(|c|row(&d.rgb_to_xyz[c],rgb));
+        let xyz:[V;3]=std::array::from_fn(|c|row(&d.adaptation[c],native));
+        let b=(xyz[0]+xyz[1])+xyz[2];
+        if !b.valid(){return Err(ERROR.into());}
+        if b.cmp(k(1e-10)).unwrap().is_le(){out.extend_from_slice(&[0;3]);continue;}
+        let x=xyz[0]/b;let y=xyz[1]/b;let om=k(1.)-x;
+        if !om.valid(){return Err(ERROR.into());}
+        let tx=(om*om).clamp(k(0.),k(1.));
+        let denominator=if om.cmp(k(1e-10)).unwrap().is_lt(){k(1e-10)}else{om};
+        let ty=(y/denominator).clamp(k(0.),k(1.));
+        let maximum=k((side-1) as f64);
+        let xf=(tx*maximum).clamp(k(0.),maximum);let yf=(ty*maximum).clamp(k(0.),maximum);
+        let xi=index(xf,side)?;let yi=index(yf,side)?;
+        let fx=xf-k(xi as f64);let fy=yf-k(yi as f64);
+        let wx=[weight(fx+k(1.)),weight(fx),weight(fx-k(1.)),weight(fx-k(2.))];
+        let wy=[weight(fy+k(1.)),weight(fy),weight(fy-k(1.)),weight(fy-k(2.))];
+        let mut result=[k(0.);3];let mut total=k(0.);
+        for i in 0..4 {let ix=reflect(xi as i32+i as i32-1,side);
+            for j in 0..4 {let iy=reflect(yi as i32+j as i32-1,side);
+                let w=wx[i]*wy[j];total=total+w;
+                for c in 0..3 {result[c]=result[c]+w*k(d.table[(ix*d.size+iy)*3+c]);}
+            }
+        }
+        if !total.valid(){return Err(ERROR.into());}
+        if !total.zero(){for r in &mut result{*r=*r/total;}}
+        for r in result {let value=r*b;if !value.valid(){return Err(ERROR.into());}out.push(value.0);}
+    }
+    Ok(out)
+}
diff --git a/native/crates/film-engine/src/research_exposure64/kernel.wgsl b/native/crates/film-engine/src/research_exposure64/kernel.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..2855867b4a07222491549dc36366c21e6ae28e8f
--- /dev/null
+++ b/native/crates/film-engine/src/research_exposure64/kernel.wgsl
@@ -0,0 +1,137 @@
+// Closed original exposure arithmetic on integer word pairs. No narrowing.
+struct ExposureParams { words: array<vec4<u32>,16>, }
+@group(0) @binding(0) var<uniform> p:ExposureParams;
+@group(0) @binding(1) var<storage,read> input:array<vec2<u32>>;
+@group(0) @binding(2) var<storage,read> table:array<vec2<u32>>;
+@group(0) @binding(3) var<storage,read_write> output:array<vec2<u32>>;
+@group(0) @binding(4) var<storage,read_write> error:atomic<u32>;
+const EX_BOUND:vec2<u32>=vec2<u32>(0x20000000u,0x430c6bf5u);
+const EX_ZERO:vec2<u32>=vec2<u32>(0u);
+const EX_ONE:vec2<u32>=vec2<u32>(0u,0x3ff00000u);
+const EX_THIRD:vec2<u32>=vec2<u32>(0x55555555u,0x3fd55555u);
+const EX_SIXTH:vec2<u32>=vec2<u32>(0x55555555u,0x3fc55555u);
+const EX_EPS:vec2<u32>=vec2<u32>(0xd9d7bdbbu,0x3ddb7cdfu);
+fn ex_reject(){sf_failed=1u;atomicOr(&error,1u);}
+fn ex_accept(x:vec2<u32>)->bool{
+ if(sf_failed!=0u||!sf_valid(x)){ex_reject();return false;}
+ if(sf_cmpu(sf_abs(x),EX_BOUND)>0){ex_reject();return false;}return true;
+}
+fn ex_add(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{
+ if(!ex_accept(a)||!ex_accept(b)){return SF_NAN;}
+ if(sf_zero(a)&&sf_zero(b)){return vec2<u32>(0u,(a.y&b.y)&0x80000000u);}
+ let r=sf_add(a,b);if(!ex_accept(r)){return SF_NAN;}return r;
+}
+fn ex_sub(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{return ex_add(a,sf_neg(b));}
+fn ex_mul(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{
+ if(!ex_accept(a)||!ex_accept(b)){return SF_NAN;}
+ if(sf_zero(a)||sf_zero(b)){return vec2<u32>(0u,(a.y^b.y)&0x80000000u);}
+ let r=sf_mul(a,b);if(!ex_accept(r)){return SF_NAN;}return r;
+}
+fn ex_div(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{
+ // Invalid/bounded operands and ZERO DENOMINATOR precede zero numerator.
+ if(!ex_accept(a)||!ex_accept(b)){return SF_NAN;}
+ if(sf_zero(b)){ex_reject();return SF_NAN;}
+ if(sf_zero(a)){return vec2<u32>(0u,(a.y^b.y)&0x80000000u);}
+ let r=sf_div(a,b);if(!ex_accept(r)){return SF_NAN;}return r;
+}
+fn ex_cmp(a:vec2<u32>,b:vec2<u32>)->i32{
+ if(!ex_accept(a)||!ex_accept(b)){return 0;}let r=sf_cmp(a,b);
+ if(sf_failed!=0u){ex_reject();}return r;
+}
+fn ex_clamp(a:vec2<u32>,lo:vec2<u32>,hi:vec2<u32>)->vec2<u32>{
+ if(ex_cmp(a,lo)<0){return lo;}if(ex_cmp(a,hi)>0){return hi;}return a;
+}
+fn ex_word(i:u32)->u32{return p.words[i/4u][i%4u];}
+fn ex_param(i:u32)->vec2<u32>{return vec2<u32>(ex_word(4u+2u*i),ex_word(5u+2u*i));}
+fn ex_i(i:u32)->vec2<u32>{return sf_integer(i);}
+fn ex_weight(t:vec2<u32>)->vec2<u32>{
+ let x=sf_abs(t);let b=EX_THIRD;let c=EX_THIRD;
+ if(ex_cmp(x,EX_ONE)<0){
+  let a=ex_sub(ex_sub(ex_i(12u),ex_mul(ex_i(9u),b)),ex_mul(ex_i(6u),c));
+  let d=ex_add(ex_add(sf_neg(ex_i(18u)),ex_mul(ex_i(12u),b)),ex_mul(ex_i(6u),c));
+  let e=ex_sub(ex_i(6u),ex_mul(ex_i(2u),b));
+  let cubic=ex_mul(ex_mul(ex_mul(a,x),x),x);
+  let square=ex_mul(ex_mul(d,x),x);
+  return ex_mul(EX_SIXTH,ex_add(ex_add(cubic,square),e));
+ }
+ if(ex_cmp(x,ex_i(2u))<0){
+  let a=ex_sub(sf_neg(b),ex_mul(ex_i(6u),c));
+  let d=ex_add(ex_mul(ex_i(6u),b),ex_mul(ex_i(30u),c));
+  let e=ex_sub(ex_mul(sf_neg(ex_i(12u)),b),ex_mul(ex_i(48u),c));
+  let f=ex_add(ex_mul(ex_i(8u),b),ex_mul(ex_i(24u),c));
+  let cubic=ex_mul(ex_mul(ex_mul(a,x),x),x);
+  let square=ex_mul(ex_mul(d,x),x);
+  return ex_mul(EX_SIXTH,ex_add(ex_add(ex_add(cubic,square),ex_mul(e,x)),f));
+ }
+ return EX_ZERO;
+}
+fn ex_row(base:u32,r:vec2<u32>,g:vec2<u32>,b_in:vec2<u32>)->vec2<u32>{
+ let a=ex_mul(ex_param(base),r);let b=ex_mul(ex_param(base+1u),g);
+ let ab=ex_add(a,b);let c=ex_mul(ex_param(base+2u),b_in);return ex_add(ab,c);
+}
+fn ex_reflect(index:i32,side:u32)->u32{
+ if(index<0){return u32(-index);}if(index>=i32(side)){return u32(2*(i32(side)-1)-index);}return u32(index);
+}
+fn ex_index(x:vec2<u32>,side:u32)->u32{
+ if(!ex_accept(x)||ex_cmp(x,EX_ZERO)<0||ex_cmp(x,ex_i(side-1u))>0){ex_reject();return 0u;}
+ if(ex_cmp(x,ex_i(side-1u))>=0){return side-2u;}
+ let index=sf_floor(x);if(sf_failed!=0u||index<0||index>=i32(side-1u)){ex_reject();return 0u;}return u32(index);
+}
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>){
+ if(atomicLoad(&error)!=0u){return;}
+ let count=ex_word(0u);let side=ex_word(1u);let cap=ex_word(2u);
+ if(count==0u||cap==0u||cap>65536u||count>cap||side<2u||side>1024u||ex_word(3u)!=0u){ex_reject();return;}
+ if(arrayLength(&input)!=3u*cap||arrayLength(&output)!=3u*cap||arrayLength(&table)!=3u*side*side){ex_reject();return;}
+ for(var i=44u;i<64u;i++){if(ex_word(i)!=0u){ex_reject();return;}}
+ for(var i=0u;i<20u;i++){if(!ex_accept(ex_param(i))){return;}}
+ if(ex_cmp(ex_param(0u),EX_ZERO)<=0||ex_cmp(ex_param(1u),EX_ZERO)<=0){ex_reject();return;}
+ let index=gid.x;
+ // Entire table is checked, even cells not read by this pixel batch.
+ if(index<arrayLength(&table)){if(!ex_accept(table[index])){return;}}
+ if(index>=count){return;}
+ let at=3u*index;
+ let rgb0=ex_mul(ex_mul(input[at],ex_param(0u)),ex_param(1u));
+ let rgb1=ex_mul(ex_mul(input[at+1u],ex_param(0u)),ex_param(1u));
+ let rgb2=ex_mul(ex_mul(input[at+2u],ex_param(0u)),ex_param(1u));
+ let native0=ex_row(2u,rgb0,rgb1,rgb2);
+ let native1=ex_row(5u,rgb0,rgb1,rgb2);
+ let native2=ex_row(8u,rgb0,rgb1,rgb2);
+ let xyz0=ex_row(11u,native0,native1,native2);
+ let xyz1=ex_row(14u,native0,native1,native2);
+ let xyz2=ex_row(17u,native0,native1,native2);
+ let brightness=ex_add(ex_add(xyz0,xyz1),xyz2);
+ if(sf_failed!=0u){return;}
+ if(ex_cmp(brightness,EX_EPS)<=0){output[at]=EX_ZERO;output[at+1u]=EX_ZERO;output[at+2u]=EX_ZERO;return;}
+ let x=ex_div(xyz0,brightness);let y=ex_div(xyz1,brightness);
+ let one_minus_x=ex_sub(EX_ONE,x);
+ let tx=ex_clamp(ex_mul(one_minus_x,one_minus_x),EX_ZERO,EX_ONE);
+ var den=one_minus_x;if(ex_cmp(den,EX_EPS)<0){den=EX_EPS;}
+ let ty=ex_clamp(ex_div(y,den),EX_ZERO,EX_ONE);
+ let maximum=ex_i(side-1u);
+ let xf=ex_clamp(ex_mul(tx,maximum),EX_ZERO,maximum);
+ let yf=ex_clamp(ex_mul(ty,maximum),EX_ZERO,maximum);
+ let xi=ex_index(xf,side);let yi=ex_index(yf,side);
+ let fx=ex_sub(xf,ex_i(xi));let fy=ex_sub(yf,ex_i(yi));
+ let wx=array<vec2<u32>,4>(ex_weight(ex_add(fx,EX_ONE)),ex_weight(fx),ex_weight(ex_sub(fx,EX_ONE)),ex_weight(ex_sub(fx,ex_i(2u))));
+ let wy=array<vec2<u32>,4>(ex_weight(ex_add(fy,EX_ONE)),ex_weight(fy),ex_weight(ex_sub(fy,EX_ONE)),ex_weight(ex_sub(fy,ex_i(2u))));
+ var result0=EX_ZERO;var result1=EX_ZERO;var result2=EX_ZERO;var total=EX_ZERO;
+ for(var i=0u;i<4u;i++){let ix=ex_reflect(i32(xi)+i32(i)-1,side);
+  for(var j=0u;j<4u;j++){let iy=ex_reflect(i32(yi)+i32(j)-1,side);
+   let w=ex_mul(wx[i],wy[j]);total=ex_add(total,w);let base=(ix*side+iy)*3u;
+   result0=ex_add(result0,ex_mul(w,table[base]));
+   result1=ex_add(result1,ex_mul(w,table[base+1u]));
+   result2=ex_add(result2,ex_mul(w,table[base+2u]));
+  }
+ }
+ if(ex_cmp(total,EX_ZERO)!=0){
+  result0=ex_div(result0,total);
+  result1=ex_div(result1,total);
+  result2=ex_div(result2,total);
+ }
+ result0=ex_mul(result0,brightness);
+ result1=ex_mul(result1,brightness);
+ result2=ex_mul(result2,brightness);
+ if(sf_failed!=0u){return;}
+ output[at]=result0;output[at+1u]=result1;output[at+2u]=result2;
+}
