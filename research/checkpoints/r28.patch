+fn native_cpu_backend_confirms_inactive_and_nonpositive_core_branches() {
+    use spektrafilm_gpu::{ComputeBackend, cpu_backend::CpuBackend};
+    use spektrafilm_math::image::ImageBuf;
+    for positive in [false, true] {
+        for (active, core_um) in [(false, 1.), (true, 0.), (true, -20.)] {
+            let mut pipe = pipeline(positive).clone();
+            pipe.params.film_render.density_curve_gamma = 1.3;
+            pipe.params.film_render.grain.active = false;
+            pipe.params.camera.pixel_size_um_override = Some(FIXTURE_PITCH);
+            pipe.params.film_render.dir_couplers.active = active;
+            pipe.params.film_render.dir_couplers.diffusion_size_um = core_um;
+            pipe.params.film_render.dir_couplers.diffusion_tail_um = 0.;
+            let calibration = DirCalibration::from_pipeline(&pipe, FIXTURE_PITCH, 3, 2).unwrap();
+            assert!(calibration.coefficient_bits.is_none());
+            let logs = ImageBuf::from_data(3, 2, (0..18).map(|i| -2. + i as f64 * 0.21).collect());
+            let actual = spektrafilm_core::stages::filming::develop(
+                &logs,
+                &pipe.film,
+                &pipe.params,
+                &CpuBackend,
+            );
+            let decode = |curve: &CurveWords| {
+                (
+                    curve
+                        .axis
+                        .iter()
+                        .copied()
+                        .map(f64::from_bits)
+                        .collect::<Vec<_>>(),
+                    curve
+                        .values
+                        .iter()
+                        .map(|row| row.map(f64::from_bits))
+                        .collect::<Vec<_>>(),
+                )
+            };
+            let (initial_axis, initial_values) = decode(&calibration.initial);
+            let initial =
+                CpuBackend.density_curve_interp(&logs, &initial_axis, &initial_values, 1.);
+            let expected = if active {
+                let corrected = spektrafilm_model::couplers::compute_exposure_correction(
+                    &logs,
+                    &initial,
+                    calibration.density_max_bits.map(f64::from_bits),
+                    &calibration.matrix_bits.map(|row| row.map(f64::from_bits)),
+                    f32::from_bits(calibration.core_sigma_bits),
+                    f32::from_bits(calibration.tail_decay_bits),
+                    f64::from_bits(calibration.tail_weight_bits),
+                    positive,
+                    &CpuBackend,
+                );
+                let (axis, values) = decode(&calibration.before_dir);
+                CpuBackend.density_curve_interp(&corrected, &axis, &values, 1.)
+            } else {
+                initial
+            };
+            assert_eq!(
+                actual.data.iter().map(|x| x.to_bits()).collect::<Vec<_>>(),
+                expected
+                    .data
+                    .iter()
+                    .map(|x| x.to_bits())
+                    .collect::<Vec<_>>()
+            );
+        }
+    }
+}
