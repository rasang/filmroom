+#[test]
+fn point_tables_match_original_cpu_for_fir_mixed_identity_and_both_film_polarities() {
+    // With an f32 public gamma the nearest values beside 1 are outside the
+    // near-one threshold. Exactly 1 must preserve the independent input axes.
+    for positive in [false, true] {
+        for gamma in [
+            1.,
+            f32::from_bits(1_f32.to_bits() - 1),
+            f32::from_bits(1_f32.to_bits() + 1),
+            1.3,
+        ] {
+            for (core, tail) in [(5., 2.), (30., 20.), (5., 0.), (5., -20.)] {
+                let mut pipe = pipeline(positive).clone();
+                pipe.params.film_render.density_curve_gamma = gamma;
+                let d = &mut pipe.params.film_render.dir_couplers;
+                d.active = true;
+                d.diffusion_size_um = core;
+                d.diffusion_tail_um = tail;
+                let actual =
+                    DirMixedCalibration::from_pipeline(&pipe, ORIGINAL_PITCH, 23, 17).unwrap();
+                assert_original_point(&actual, &pipe);
+                actual.validate().unwrap();
+            }
+        }
+    }
+    let mut pipe = original384_pipeline();
+    pipe.params.film_render.density_curve_gamma = 1.3;
+    let actual = DirMixedCalibration::from_pipeline(&pipe, ORIGINAL_PITCH, 23, 17).unwrap();
+    assert_ne!(actual.initial.axis, actual.before_dir.axis);
+    assert_ne!(actual.initial.inverse_dx, actual.before_dir.inverse_dx);
+}
