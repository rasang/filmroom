+#[test]
+#[cfg(feature = "precision-f64")]
+fn original_inactive_and_nonpositive_core_paths_remain_distinct() {
+    let mut pipe = pipeline();
+    pipe.params.film_render.dir_couplers.active = false;
+    let inactive = DirCalibration::from_pipeline(&pipe, 36_000. / 8192., 31, 17).unwrap();
+    let values = curve_vectors(&inactive.initial);
+    for channel in 0..3 {
+        let j = job(Operation::InitialCorrection, channel, 0);
+        assert_words(
+            &evaluate(&inactive, j, &values, &mut || false).unwrap(),
+            &original(&inactive, j, &values),
+            "inactive density",
+        );
+    }
+    assert!(
+        job(Operation::RedevelopFiltered, 0, 0)
+            .validate(&inactive)
+            .is_err()
+    );
+    assert!(
+        job(Operation::RedevelopUnfiltered, 0, 0)
+            .validate(&inactive)
+            .is_err()
+    );
+    pipe.params.film_render.dir_couplers.active = true;
+    pipe.params.film_render.dir_couplers.diffusion_size_um = 0.;
+    let no_core = DirCalibration::from_pipeline(&pipe, 36_000. / 8192., 31, 17).unwrap();
+    let values = vec![[(-2f64).to_bits(), 0.1f64.to_bits(), 0]; 31];
+    for channel in 0..3 {
+        let j = job(Operation::RedevelopUnfiltered, channel, 0);
+        assert_words(
+            &evaluate(&no_core, j, &values, &mut || false).unwrap(),
+            &original(&no_core, j, &values),
+            "unfiltered redevelopment",
+        );
+    }
+    assert!(
+        job(Operation::TailAccumulate, 0, 0)
+            .validate(&no_core)
+            .is_err()
+    );
+}
+
+#[test]
+fn point_packet_has_exact_nonoverlapping_original_words_and_limits() {
+    let p = calibration();
+    let values = vec![[(-1f64).to_bits(), 0, 1f64.to_bits()]; POINT_CAPACITY];
+    let j = job(Operation::InitialCorrection, 2, 0);
+    let packet = Packet::new(&p, j, &values).unwrap();
+    assert_eq!(packet.words.len(), PREFIX_WORDS + 3 * POINT_CAPACITY);
+    assert!(packet.words.len() <= PACKET_CAPACITY);
+    assert_eq!(packet.words[PREFIX_WORDS..PREFIX_WORDS + 3], values[0]);
+    assert_eq!(packet.parameters[0..4], [3, POINT_CAPACITY as u32, 2, 0]);
+    assert_eq!(packet.parameters[8], HEADER_WORDS as u32);
+    assert_eq!(
+        packet.parameters[9],
+        (HEADER_WORDS + p.initial.axis.len() * 5) as u32
+    );
+    assert!(packet.parameters[12] <= PREFIX_WORDS as u32);
+    assert_eq!(
+        &packet.words[HEADER_WORDS..HEADER_WORDS + p.initial.axis.len()],
+        p.initial.axis.as_slice()
+    );
+    let end = packet.parameters[12] as usize;
+    assert!(packet.words[end..PREFIX_WORDS].iter().all(|&x| x == 0));
+    assert!(Packet::new(&p, j, &[]).is_err());
+    assert!(Packet::new(&p, j, &vec![[0; 3]; POINT_CAPACITY + 1]).is_err());
+    assert!(Packet::new(&p, job(Operation::InitialCorrection, 3, 0), &[[0; 3]]).is_err());
+    assert!(Packet::new(&p, job(Operation::InitialCorrection, 0, 1), &[[0; 3]]).is_err());
+}
+
+#[test]
+fn point_faults_do_not_hide_invalid_inputs_or_partial_results() {
+    let p = calibration();
+    let j = job(Operation::TailAccumulate, 0, 0);
+    for invalid in [
+        1,
+        f64::NAN.to_bits(),
+        f64::INFINITY.to_bits(),
+        super::super::BOUND.to_bits() + 1,
+    ] {
+        assert!(
+            evaluate(&p, j, &[[0, 0, invalid]], &mut || false).is_err(),
+            "unused input lane is still domain checked"
+        );
+        assert!(Packet::new(&p, j, &[[0, invalid, 0]]).is_err());
+    }
+    // An admitted normal input can produce an unsupported subnormal product.
+    // Preserve explicit rejection, not a silently zeroed or NaN output.
+    assert_eq!(
+        evaluate(&p, j, &[[0, f64::MIN_POSITIVE.to_bits(), 0]], &mut || false).unwrap_err(),
+        DOMAIN_ERROR
+    );
+    let mut values = vec![[0, 1f64.to_bits(), 0]; 513];
+    values[512][0] = f64::NAN.to_bits();
+    assert_eq!(
+        evaluate(&p, j, &values, &mut || false).unwrap_err(),
+        DOMAIN_ERROR
+    );
+    let mut calls = 0;
+    assert_eq!(
+        evaluate(&p, j, &vec![[0, 0, 0]; 513], &mut || {
+            calls += 1;
+            calls >= 3
+        })
+        .unwrap_err(),
+        "GPU_DIR64_POINT_CANCELLED"
+    );
+    let mut g = Guard::default();
+    assert_eq!(
+        subtract(
+            &mut g,
+            super::super::BOUND.to_bits(),
+            (-super::super::BOUND).to_bits()
+        ),
+        soft64::NAN
+    );
+    assert!(g.failed);
+}
+
+#[test]
+#[cfg(feature = "precision-f64")]
+fn original_positive_silver_inversion_retains_donor_order() {
+    let pipe = pipeline_named("fujifilm_provia_100f");
+    let p = DirCalibration::from_pipeline(&pipe, 36_000. / 8192., 31, 17).unwrap();
+    assert!(p.positive);
+    let values = curve_vectors(&p.initial);
+    for channel in 0..3 {
+        let j = job(Operation::InitialCorrection, channel, 0);
+        assert_words(
+            &evaluate(&p, j, &values, &mut || false).unwrap(),
+            &original(&p, j, &values),
+            "original positive silver coupling",
+        );
+    }
+}
