+//! Exact Poisson invariant cache. Applied only after the original shader hashes
+//! and typed ALU v2 identity have been checked. No allocation/dispatch change.
+use super::R;
+const OLD_STRUCT:&str=r#"struct SrPoissonSetup {enlam:vec2<u32>,loglam:vec2<u32>,b:vec2<u32>,a:vec2<u32>,invalpha:vec2<u32>,vr:vec2<u32>,}"#;
+const NEW_STRUCT:&str=r#"struct SrPoissonSetup {enlam:vec2<u32>,loglam:vec2<u32>,b:vec2<u32>,a:vec2<u32>,invalpha:vec2<u32>,vr:vec2<u32>,cache_lalpha:vec2<u32>,cache_ealpha:vec2<u32>,cache_elam:vec2<u32>,cache_fail_lalpha:u32,cache_fail_ealpha:u32,cache_fail_elam:u32,}"#;
+const OLD_PREPARE:&str=r#"fn sr_prepare_poisson(lam:vec2<u32>)->SrPoissonSetup{
+ var result:SrPoissonSetup;
