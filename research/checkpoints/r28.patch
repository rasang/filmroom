+use super::*;
+use crate::{gpu_session as session, gpu_session_contract::StageTicket};
+use std::sync::{Arc, atomic::AtomicBool};
+
+fn begin(epoch: u64, generation: u64) -> StageTicket {
+    let ticket = StageTicket {
+        epoch,
+        generation,
+        sequence: generation,
+    };
+    session::begin_frame(epoch, generation).unwrap();
+    session::begin_stage(ticket, DRIVER_BYTES).unwrap();
+    ticket
+}
+fn activate(epoch: u64) -> StageTicket {
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 1).unwrap();
+    begin(epoch, 1)
+}
+fn finish(gpu: FirGpu, ticket: StageTicket) -> crate::gpu_session::SessionStats {
+    assert!(
+        session::complete_stage(ticket).is_err(),
+        "live owner cannot seal"
+    );
+    assert_eq!(gpu.metrics.dispatches, gpu.metrics.completed_readbacks);
+    assert_eq!(gpu.metrics.dispatches, gpu.metrics.transient_releases);
+    eprintln!(
+        "original FIR raw64 metrics={:?}; complete lines only",
+        gpu.metrics
+    );
+    drop(gpu);
+    let stats = session::complete_stage(ticket).unwrap();
+    assert_eq!(stats.pool_bytes, RESIDENT_BYTES);
+    assert_eq!(stats.pipeline_slots, 1);
+    assert!(stats.charged_bytes <= COMBINED_BYTES);
+    session::finish_frame(ticket.epoch, ticket.generation).unwrap();
+    stats
+}
+fn values(length: u32, lines: u32, kind: u32) -> Vec<u64> {
+    (0..length * lines)
+        .map(|i| {
+            let x = i % length;
+            let line = i / length;
+            let v = match kind {
+                0 => {
+                    if x == 0 || x == length / 2 {
+                        8. + 2f64.powi(-40)
+                    } else {
+                        -0.25
+                    }
+                }
+                1 => {
+                    (if (x + line) % 2 == 0 { -1. } else { 1. })
+                        + ((i * 13 % 37) as f64 - 18.) / 37.
+                }
+                2 => (1. + ((i * 7) % 13) as f64 / 13.) * 1e-40,
+                _ => {
+                    if i % 2 == 0 {
+                        0.
+                    } else {
+                        -0.
+                    }
+                }
+            };
+            v.to_bits()
+        })
+        .collect()
+}
+// These are derived with the unchanged original fixture's f64 division then
+// f32 storage and original FIT scaling, not decimal aliases for the sigmas.
+fn fixture_sigmas() -> [f32; 4] {
+    let pitch = 10f32;
+    let core = (5f64 / pitch as f64) as f32;
+    let decay = (2f64 / pitch as f64) as f32;
+    [
+        core,
+        (0.5360 * decay as f64) as f32,
+        (1.5236 * decay as f64) as f32,
+        (2.7684 * decay as f64) as f32,
+    ]
+}
+#[cfg(feature = "precision-f64")]
+fn compare(gpu: &mut FirGpu, p: &FirSpec, input: &[u64]) -> Vec<u64> {
+    let original = super::super::fir::original_reference(p, input).unwrap();
+    assert_eq!(
+        super::super::fir::cpu_reference(p, input).unwrap(),
+        original
+    );
+    let actual = gpu.execute(p, input, &mut || false).unwrap();
+    assert_eq!(actual.len(), original.len());
+    for (i, (&a, &b)) in actual.iter().zip(&original).enumerate() {
+        assert_eq!(
+            a, b,
+            "original FIR full-word mismatch sigma={:08x} length={} lines={} index={i}",
+            p.sigma_bits, p.length, p.lines
+        );
+    }
+    actual
+}
+
+#[test]
+fn fir_gpu_exact_reservation_includes_prefix_and_separate_upload() {
+    use super::super::fir;
+    assert_eq!(MAP_BYTES, fir::MAP_BYTES);
+    assert_eq!(RESIDENT_BYTES, fir::POOL_BYTES);
+    assert_eq!(DEVICE_BYTES, fir::DEVICE_BYTES);
+    assert_eq!(HOST_BYTES, fir::HOST_BYTES);
+    assert_eq!(DRIVER_BYTES, fir::DRIVER_BYTES);
+    assert_eq!(COMBINED_BYTES, fir::COMBINED_BYTES);
+    assert_eq!(FIXED_BYTES, fir::HOST_BYTES + fir::HELPER_BYTES);
+    assert_eq!(RESIDENT_BYTES, 12 * 1024 * 1024 + 72);
+    assert_eq!(COMBINED_BYTES, 220 * 1024 * 1024 + 65536);
+    assert!(RESIDENT_BYTES + fir::UPLOAD_BYTES <= DEVICE_BYTES);
+    assert_eq!(
+        (u64::from(fir::CAPACITY) + u64::from(fir::PREFIX_WORDS)) * 8,
+        BATCH_BYTES
+    );
+}
+
+#[test]
+#[ignore = "Fresh process: original 384 fixture sigmas, full short/384/512 lines, repeated half-sample reflection; no image-graph claim"]
+#[cfg(feature = "precision-f64")]
+fn actual_fir_original_fixture_sigmas_and_complete_reflection_match() {
+    let ticket = activate(96101);
+    let mut gpu = FirGpu::new(&mut || false).unwrap();
+    for sigma in fixture_sigmas() {
+        for length in [1, 2, 3, 17, 384, 512] {
+            let p = FirSpec::new(sigma, length, 3).unwrap();
+            for kind in 0..3 {
+                compare(&mut gpu, &p, &values(length, 3, kind));
+            }
+        }
+    }
+    assert_eq!(gpu.metrics.dispatches, 72);
+    finish(gpu, ticket);
+}
+
+#[test]
+#[ignore = "Fresh process: sigma-zero copy versus positive radius-zero, exact nextbelow-three FIR and tiny raw64 values; original all-word oracle"]
+#[cfg(feature = "precision-f64")]
+fn actual_fir_zero_radius_boundary_and_raw_precision_match() {
+    let ticket = activate(96102);
+    let mut gpu = FirGpu::new(&mut || false).unwrap();
+    let threshold = (1f32 / 6.).to_bits();
+    let sigmas = [
+        0.,
+        -0.,
+        f32::from_bits(1),
+        f32::MIN_POSITIVE,
+        f32::from_bits(threshold - 1),
+        f32::from_bits(threshold),
+        f32::from_bits(threshold + 1),
+        f32::from_bits(3f32.to_bits() - 1),
+    ];
+    for sigma in sigmas {
+        for length in [1, 2, 17] {
+            let p = FirSpec::new(sigma, length, 2).unwrap();
+            let zeros = compare(&mut gpu, &p, &values(length, 2, 3));
+            if sigma == 0. {
+                assert_eq!(zeros, values(length, 2, 3));
+            } else {
+                assert!(zeros.iter().all(|x| *x == 0));
+            }
+            let tiny = compare(&mut gpu, &p, &values(length, 2, 2));
+            assert!(
+                tiny.iter()
+                    .all(|x| f64::from_bits(*x) > 0.
+                        && f64::from_bits(*x) < f32::MIN_POSITIVE as f64)
+            );
+        }
+    }
+    assert!(
+        FirSpec::new(3., 17, 1).is_err(),
+        "exactly three belongs to unchanged IIR"
+    );
+    assert_eq!(gpu.metrics.dispatches, 48);
+    finish(gpu, ticket);
+}
+
+#[test]
+#[ignore = "Fresh process: full capacity includes coefficient prefix, long full lines, forced line batches and two actual session frames"]
+#[cfg(feature = "precision-f64")]
+fn actual_fir_full_capacity_complete_line_batches_and_session_reuse() {
+    let epoch = 96103;
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 1).unwrap();
+    let mut previous_hits = None;
+    for generation in 1..=2 {
+        let ticket = begin(epoch, generation);
+        let mut gpu = FirGpu::new(&mut || false).unwrap();
+        // Identity is still a real GPU dispatch over the complete physical
+        // prefix+source capacity; it is not a CPU shortcut or size reduction.
+        let p = FirSpec::new(0., 1, super::super::fir::CAPACITY).unwrap();
+        compare(&mut gpu, &p, &values(1, p.lines, 3));
+        for length in [8192, 6144, 40000] {
+            let sigma = fixture_sigmas()[3];
+            let p = FirSpec::new(sigma, length, 3).unwrap();
+            let input = values(length, 3, 1);
+            let bulk = compare(&mut gpu, &p, &input);
+            let one = FirSpec::new(sigma, length, 1).unwrap();
+            let mut batched = Vec::new();
+            for line in input.chunks_exact(length as usize) {
+                batched.extend(compare(&mut gpu, &one, line));
+            }
+            assert_eq!(bulk, batched, "complete line grouping changed words");
+        }
+        assert_eq!(gpu.metrics.dispatches, 13);
+        let stats = finish(gpu, ticket);
+        if let Some((pipeline, buffer)) = previous_hits {
+            assert!(stats.pipeline_hits > pipeline && stats.buffer_hits > buffer);
+        }
+        previous_hits = Some((stats.pipeline_hits, stats.buffer_hits));
+    }
+}
+
+fn reject_packet(epoch: u64, mutate: impl FnOnce(&mut Packet)) {
+    let ticket = activate(epoch);
+    let mut gpu = FirGpu::new(&mut || false).unwrap();
+    let p = FirSpec::new(0.5, 17, 3).unwrap();
+    let input = values(17, 3, 0);
+    let mut packet = p.packet(&input).unwrap();
+    mutate(&mut packet);
+    assert!(
+        packet.validate(&p).is_err(),
+        "normal host boundary must reject fault first"
+    );
+    // Explicit private cfg(test) fault route: prove device-side rejection too.
+    let result = gpu.execute_inner(&p, &packet, &mut || false, false);
+    if result.is_err() {
+        gpu.poison();
+    }
+    assert_eq!(result.unwrap_err(), "GPU_FIR64_NUMERIC_DOMAIN");
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert_eq!(gpu.metrics.transient_releases, 0);
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    assert_eq!(
+        gpu.execute(&p, &input, &mut || false).unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+}
+#[test]
+#[ignore = "Fresh process: last input NaN independently rejects entire dispatch, never masked by another sticky fault"]
+fn actual_fir_late_nan_rejects_and_poison() {
+    reject_packet(96104, |p| *p.words.last_mut().unwrap() = f64::NAN.to_bits());
+}
