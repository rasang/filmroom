+#[test]
+fn guarded_add_and_multiply_match_binary64_rounding_and_cancellation() {
+    let values = [
+        0f64,
+        -0.,
+        1.,
+        -1.,
+        f64::from_bits(1f64.to_bits() + 1),
+        f64::from_bits(1f64.to_bits() - 1),
+        2f64.powi(-52),
+        2f64.powi(-53),
+        2f64.powi(-54),
+        BOUND / 4.,
+        -BOUND / 4.,
+        1e-100,
+        -1e-100,
+        f64::MIN_POSITIVE,
+    ];
+    let below_one_bits = 1f64.to_bits() - 1;
+    let minimum_normal_bits = f64::MIN_POSITIVE.to_bits();
+    let mut conservative_boundary_rejections = 0;
+    for a in values {
+        for b in values {
+            for (multiply, expected) in [(false, a + b), (true, a * b)] {
+                let mut guard = Guard::default();
+                let actual = if multiply {
+                    guard.mul(a.to_bits(), b.to_bits())
+                } else {
+                    guard.add(a.to_bits(), b.to_bits())
+                };
+                let underflow_to_zero = multiply && a != 0. && b != 0. && expected == 0.;
+                // Exact product lies below minimum-normal, but hardware binary64
+                // rounds the halfway result up to minimum-normal. The unchanged
+                // shared library conservatively rejects this underflow boundary.
+                // Keep both ordered pairs as strict rejection cases, not omitted
+                // samples or a general allowance for unexpected NaN results.
+                let conservative_boundary = multiply
+                    && ((a.to_bits() == below_one_bits && b.to_bits() == minimum_normal_bits)
+                        || (b.to_bits() == below_one_bits && a.to_bits() == minimum_normal_bits));
+                if conservative_boundary {
+                    assert_eq!(expected.to_bits(), minimum_normal_bits);
+                    conservative_boundary_rejections += 1;
+                }
+                if !admitted(expected.to_bits()) || underflow_to_zero || conservative_boundary {
+                    assert!(guard.failed, "a={a:?}, b={b:?}, multiply={multiply}");
+                    assert_eq!(actual, soft64::NAN, "a={a:?}, b={b:?}, multiply={multiply}");
+                } else {
+                    assert!(!guard.failed, "a={a:?}, b={b:?}, multiply={multiply}");
+                    if expected == 0. {
+                        assert_eq!(f64::from_bits(actual), 0.);
+                    } else {
+                        assert_eq!(
+                            actual,
+                            expected.to_bits(),
+                            "a={a:?}, b={b:?}, multiply={multiply}"
+                        );
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(conservative_boundary_rejections, 2);
+}
