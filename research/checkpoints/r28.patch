+// C: one original channel result, all sixteen ordered products/sums preserved.
+struct ExposureParams { words: array<vec4<u32>,16>, }
+@group(0) @binding(0) var<uniform> p:ExposureParams;
+@group(0) @binding(1) var<storage,read> work:array<vec2<u32>>;
+@group(0) @binding(2) var<storage,read> table:array<vec2<u32>>;
+@group(0) @binding(3) var<storage,read_write> output:array<vec2<u32>>;
+@group(0) @binding(4) var<storage,read_write> error:atomic<u32>;
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>){
+ if(atomicLoad(&error)!=0u){return;}
+ let count=ex_word(0u);let side=ex_word(1u);let cap=ex_word(2u);
+ if(count==0u||cap==0u||cap>65536u||count>cap||side<2u||side>1024u||ex_word(3u)!=0u){ex_reject();return;}
+ if(arrayLength(&work)!=16u*cap||arrayLength(&table)!=3u*side*side||arrayLength(&output)!=3u*cap){ex_reject();return;}
+ let index=gid.x;
+ // Full table scan MUST precede both pixel-range and inactive-pixel returns.
+ if(index<arrayLength(&table)){if(!ex_accept(table[index])){return;}}
+ if(index>=3u*count){return;}
+ let pixel=index/3u;let channel=index%3u;let base=16u*pixel;
+ if(!ex_geometry(base,side)){return;}
+ for(var k=8u;k<16u;k++){if(!ex_accept(work[base+k])){return;}}
+ if(work[base+4u].x==0u){
+  for(var k=8u;k<16u;k++){if(any(work[base+k]!=EX_ZERO)){ex_reject();return;}}
+  output[index]=EX_ZERO;return;
+ }
+ let cell=work[base+3u];let brightness=work[base];
+ var result=EX_ZERO;var total=EX_ZERO;
+ for(var i=0u;i<4u;i++){let ix=ex_reflect(i32(cell.x)+i32(i)-1,side);
+  for(var j=0u;j<4u;j++){let iy=ex_reflect(i32(cell.y)+i32(j)-1,side);
+   let w=ex_mul(work[base+8u+i],work[base+12u+j]);total=ex_add(total,w);
+   let offset=(ix*side+iy)*3u+channel;
+   result=ex_add(result,ex_mul(w,table[offset]));
+  }
+ }
+ if(ex_cmp(total,EX_ZERO)!=0){result=ex_div(result,total);}
+ result=ex_mul(result,brightness);
+ if(sf_failed!=0u){return;}
+ output[index]=result;
+}
