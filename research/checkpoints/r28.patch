index 0000000000000000000000000000000000000000..ea9cdf58a37a9dfbbb5435241ee0522ff437ebac
--- /dev/null
+++ b/native/crates/film-engine/src/research_exposure64.rs
@@ -0,0 +1,147 @@
+//! Closed test-only exposure64 unit. No production route, JNI, files or RNG changes.
+//! Current oracle is this build's original host CPU implementation. This is not
+//! Android CPU/libm parity: already-computed AE/exposure bits are supplied, never recomputed.
+#![cfg(test)]
+use crate::research_exposure::ExposureDescriptor;
+use crate::research_grain::soft64;
+use sha2::{Digest, Sha256};
+use spektrafilm_math::{image::ImageBuf, spectral::TcLut};
+use std::collections::{BTreeMap, BTreeSet};
+pub(crate) type R<T> = Result<T, String>;
+pub(crate) const CAP: u32 = 65_536;
+pub(crate) const MIB: u64 = 1024 * 1024;
+pub(crate) const DEVICE_BYTES: u64 = 64 * MIB;
+pub(crate) const HOST_BYTES: u64 = 96 * MIB;
+pub(crate) const HELPER_BYTES: u64 = 64 * MIB;
+pub(crate) const DRIVER_BYTES: u64 = 64 * MIB;
+pub(crate) const FIXED_BYTES: u64 = HOST_BYTES + HELPER_BYTES;
+pub(crate) const COMBINED_BYTES: u64 = DEVICE_BYTES + FIXED_BYTES + DRIVER_BYTES;
+const BOUND: f64 = 1e15f32 as f64;
+const SIGN: u64 = 1 << 63;
+const ERROR: &str = "GPU_EXPOSURE64_DOMAIN";
+const SHARED_SHA: &str = "7173a5998b5fc2d22434f12cd07b5b81091e25d4f5ac05c2923fe79947fd5ce1";
+const KERNEL_SHA: &str = "5f05a07b887f3bd17241beb204c2986e37b3d12f137913a821738afd63d1dfe5";
+const KERNEL: &str = include_str!("research_exposure64/kernel.wgsl");
+#[cfg(feature = "gpu-diffusion-research")]
+pub(crate) mod gpu;
+mod host;
+mod tests;
+
+#[derive(Clone)]
+pub(crate) struct Packet {
+    pub descriptor: ExposureDescriptor,
+    /// Exact host widening only, before either exposure multiplication.
+    pub input: Vec<u64>,
+    pub chunk_cap: u32,
+}
+impl Packet {
+    pub(crate) fn new(descriptor: ExposureDescriptor, source: &[[f32; 3]], chunk_cap: u32) -> R<Self> {
+        if !cfg!(feature = "precision-f64") || source.is_empty()
+            || chunk_cap == 0 || chunk_cap > CAP || source.len() > chunk_cap as usize
+            || source.iter().flatten().any(|v| !v.is_finite()) {
+            return Err(ERROR.into());
+        }
+        let p = Self { descriptor, input: source.iter().flatten().map(|v| (*v as f64).to_bits()).collect(), chunk_cap };
+        p.validate()?;
+        Ok(p)
+    }
+    pub(crate) fn validate(&self) -> R<()> {
+        self.descriptor.validate().map_err(str::to_owned)?;
+        if !cfg!(feature = "precision-f64") || self.chunk_cap == 0 || self.chunk_cap > CAP
+            || self.input.is_empty() || self.input.len() % 3 != 0
+            || self.input.len() / 3 > self.chunk_cap as usize {
+            return Err(ERROR.into());
+        }
+        // No hidden raw64 inputs unlike the actual original f32 spool contract.
+        if self.input.iter().any(|v| !admitted(*v)
+            || ((f64::from_bits(*v) as f32) as f64).to_bits() != *v) {
+            return Err(ERROR.into());
+        }
+        if self.descriptor.table.iter()
+            .chain(self.descriptor.rgb_to_xyz.iter().flatten())
+            .chain(self.descriptor.adaptation.iter().flatten())
+            .chain([&self.descriptor.auto_exposure, &self.descriptor.exposure])
+            .any(|v| !admitted(v.to_bits())) { return Err(ERROR.into()); }
+        Ok(())
+    }
+    pub(crate) fn params(&self) -> [u32; 64] {
+        let mut p = [0u32; 64];
+        p[0] = (self.input.len() / 3) as u32;
+        p[1] = self.descriptor.size as u32;
+        p[2] = self.chunk_cap;
+        let values = [self.descriptor.auto_exposure, self.descriptor.exposure].into_iter()
+            .chain(self.descriptor.rgb_to_xyz.iter().flatten().copied())
+            .chain(self.descriptor.adaptation.iter().flatten().copied());
+        for (i, v) in values.enumerate() { let b = v.to_bits(); p[4+2*i] = b as u32; p[5+2*i] = (b >> 32) as u32; }
+        p
+    }
+    pub(crate) fn table_words(&self) -> Vec<u32> {
+        self.descriptor.table.iter().flat_map(|v| { let b=v.to_bits(); [b as u32,(b>>32) as u32] }).collect()
+    }
+    pub(crate) fn input_words(&self) -> Vec<u32> {
+        self.input.iter().flat_map(|v| [*v as u32,(*v>>32) as u32]).collect()
+    }
+    /// Direct original spectral implementation, not descriptor.reference or our mirror.
+    pub(crate) fn oracle(&self) -> R<Vec<u64>> {
+        self.validate()?;
+        let d=&self.descriptor;
+        let scaled=self.input.iter().map(|v| spektrafilm_math::precision::from_f64(
+            (f64::from_bits(*v)*d.auto_exposure)*d.exposure)).collect();
+        let image=ImageBuf::from_data((self.input.len()/3) as u32,1,scaled);
+        let table=TcLut { size:d.size, channels:3, data:d.table.clone() };
+        let output=spektrafilm_math::spectral::hanatos2025_rgb_to_raw_prepared(
+            &image,&table,&d.rgb_to_xyz,&d.adaptation);
+        Ok(output.data.iter().map(|v| (*v as f64).to_bits()).collect())
+    }
+}
+pub(crate) fn admitted(bits:u64)->bool {
+    let x=f64::from_bits(bits);
+    x.is_finite() && (x==0. || x.is_normal()) && x.abs()<=BOUND
+}
+fn digest(bytes:&[u8])->String { format!("{:x}",Sha256::digest(bytes)) }
+fn identifiers(s:&str)->BTreeSet<&str> {
+    s.split(|c:char| !(c.is_ascii_alphanumeric() || c=='_')).filter(|s|!s.is_empty()).collect()
+}
+// Pinned-source brace scanner, not a generic WGSL rewriter.
+fn functions(s:&str)->R<BTreeMap<String,&str>> {
+    let mut out=BTreeMap::new(); let mut cursor=0;
+    while let Some(offset)=s[cursor..].find("fn ") {
+        let start=cursor+offset; let name_start=start+3;
+        let end_name=name_start+s[name_start..].find('(').ok_or(ERROR)?;
+        let name=&s[name_start..end_name];
+        if name.is_empty() || !name.bytes().all(|b|b.is_ascii_alphanumeric() || b==b'_') { return Err(ERROR.into()); }
+        let open=end_name+s[end_name..].find('{').ok_or(ERROR)?;
+        let mut depth=0u32; let mut end=None;
+        for (i,b) in s.bytes().enumerate().skip(open) {
+            if b==b'{' { depth=depth.checked_add(1).ok_or(ERROR)?; }
+            if b==b'}' { depth=depth.checked_sub(1).ok_or(ERROR)?; if depth==0 {end=Some(i+1);break;} }
+        }
+        let end=end.ok_or(ERROR)?;
+        if out.insert(name.to_owned(),&s[start..end]).is_some() {return Err(ERROR.into());} cursor=end;
+    }
+    Ok(out)
+}
+const HELPERS: &[&str] = &[
+    "sf_abs","sf_add","sf_addu","sf_cmp","sf_cmpu","sf_div","sf_exp","sf_fail",
+    "sf_floor","sf_integer","sf_jam","sf_mul","sf_neg","sf_round","sf_shl","sf_shr",
+    "sf_sig","sf_subu","sf_valid","sf_zero",
+];
+pub(crate) fn shader()->R<String> { compose(soft64::SHADER,KERNEL) }
+fn compose(shared:&str,kernel:&str)->R<String> {
+    if digest(shared.as_bytes())!=SHARED_SHA || digest(kernel.as_bytes())!=KERNEL_SHA {return Err("GPU_EXPOSURE64_SHADER_IDENTITY".into());}
+    let all=functions(shared)?;
+    if all.len()!=26 {return Err(ERROR.into());}
+    let mut reached:BTreeSet<String>=identifiers(kernel).into_iter().filter(|n|all.contains_key(*n)).map(str::to_owned).collect();
+    loop { let mut next=reached.clone(); for name in &reached { for id in identifiers(all[name]) {if all.contains_key(id){next.insert(id.to_owned());}} } if next==reached{break;} reached=next; }
+    if reached!=HELPERS.iter().map(|s|(*s).to_owned()).collect() {return Err("GPU_EXPOSURE64_HELPER_CLOSURE".into());}
+    let mut out=String::new();
+    for declaration in ["const SF_NAN:vec2<u32>=vec2<u32>(0u,0x7ff80000u);","var<private> sf_failed:u32;"] {
+        if shared.matches(declaration).count()!=1{return Err(ERROR.into());} out.push_str(declaration);out.push('\n');
+    }
+    for name in reached {out.push_str(all[&name]);out.push('\n');}
+    out.push_str(kernel);
+    for token in ["f32","f64","sf_scalar","sf_log","sf_exp_nonpositive","sf_sqrt","fma","pow","sqrt","exp","log"] {
+        if identifiers(&out).contains(token) {return Err("GPU_EXPOSURE64_FORBIDDEN_HELPER".into());}
+    }
+    Ok(out)
+}
