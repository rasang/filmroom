+//! HOST tests only. Echo/HostCompute are scheduling and byte/oracle tools, never
+//! GPU evidence. Synthetic sources below deliberately carry a test assertion;
+//! they do NOT establish original expose/log provenance. The actual GPU fixture
+//! must separately capture the real precision-f64 original producer.
+use super::*;
+use spektrafilm_core::{params::RuntimeParams, pipeline::Pipeline, profile::load_profile_by_name};
+use std::{
+    cell::Cell,
+    fs::{self, OpenOptions},
+    os::unix::fs::{OpenOptionsExt, PermissionsExt, symlink},
+    rc::Rc,
+    sync::{
+        OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+const PITCH: f32 = 36_000. / 8192.;
+static NEXT: AtomicU64 = AtomicU64::new(0);
+fn pipeline() -> &'static Pipeline {
+    static PIPE: OnceLock<Pipeline> = OnceLock::new();
+    PIPE.get_or_init(|| {
+        let data = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
+        Pipeline::new_with_spectral(
+            load_profile_by_name(&data, "kodak_portra_400").unwrap(),
+            load_profile_by_name(&data, "kodak_portra_endura").unwrap(),
+            RuntimeParams::default(),
+            &data,
+        )
+        .unwrap()
+    })
+}
+fn calibration(width: u32, height: u32) -> DirCalibration {
+    DirCalibration::from_pipeline(pipeline(), PITCH, width, height).unwrap()
+}
+fn origin(calibration: &DirCalibration) -> FixtureOrigin {
+    let synthetic =
+        digest(b"SYNTHETIC HOST SCHEDULE TEST ONLY; NOT AUTHENTIC ORIGINAL LOG CAPTURE");
+    FixtureOrigin {
+        kind: "original-log64-test-fixture-v1".into(), precision: "precision-f64".into(),
+        producer: "spektrafilm_core::stages::filming::expose".into(),
+        fixture_mode: "Synthetic host scheduling fixture; asserted tags do not authenticate original expose execution".into(),
+        build_sha256: synthetic.clone(), producer_sha256: synthetic.clone(), pipeline_sha256: synthetic.clone(),
+        profile_sha256: synthetic.clone(), runtime_params_sha256: synthetic.clone(), fixture_sha256: synthetic,
+        calibration_sha256: digest(&serde_json::to_vec(calibration).unwrap()),
+    }
+}
+fn words(width: u32, height: u32) -> Vec<[u64; 3]> {
+    (0..width * height)
+        .map(|i| {
+            [
+                (-1.25 + (i % 29) as f64 / 128. + f64::EPSILON).to_bits(),
+                (-0.75 + (i % 23) as f64 / 256.).to_bits(),
+                (-0.25 + (i % 19) as f64 / 512.).to_bits(),
+            ]
+        })
+        .collect()
+}
+struct Fixture {
+    root: PathBuf,
+    source_paths: [PathBuf; 3],
+    input: Vec<[u64; 3]>,
+}
+impl Fixture {
+    fn new(width: u32, height: u32) -> Self {
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+            "film-dir64-host-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&root).unwrap();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+        let source_paths = ["source-r.bin", "source-g.bin", "source-b.bin"].map(|s| root.join(s));
+        let input = words(width, height);
+        for (channel, path) in source_paths.iter().enumerate() {
+            let mut file = OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .mode(0o600)
+                .open(path)
+                .unwrap();
+            for row in &input {
+                file.write_all(&row[channel].to_le_bytes()).unwrap();
+            }
+            file.sync_all().unwrap();
+        }
+        Self {
+            root,
+            source_paths,
+            input,
+        }
+    }
+    fn plan(&self, cal: DirCalibration, point: u32, line: u32, name: &str) -> DirImagePlan {
+        let sources =
+            Sources::capture(self.source_paths.clone(), origin(&cal), &mut || false).unwrap();
+        DirImagePlan::new(cal, sources, Paths::new(self.root.join(name)), point, line).unwrap()
+    }
+    fn read(&self, receipt: &CandidateReceipt) -> Vec<[u64; 3]> {
+        let planes = receipt.candidate64.each_ref().map(|path| {
+            fs::read(path)
+                .unwrap()
+                .chunks_exact(8)
+                .map(|b| u64::from_le_bytes(b.try_into().unwrap()))
+                .collect::<Vec<_>>()
+        });
+        (0..self.input.len())
+            .map(|i| [planes[0][i], planes[1][i], planes[2][i]])
+            .collect()
+    }
+    fn assert_sources(&self) {
+        for (channel, path) in self.source_paths.iter().enumerate() {
+            assert_eq!(
+                fs::read(path).unwrap(),
+                self.input
+                    .iter()
+                    .flat_map(|r| r[channel].to_le_bytes())
+                    .collect::<Vec<_>>()
+            );
+        }
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
