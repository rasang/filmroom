+#[test]
+fn finite_normal_zero_domain_and_sticky_per_operation_bounds() {
+    for value in [
+        0.,
+        -0.,
+        f64::MIN_POSITIVE,
+        -f64::MIN_POSITIVE,
+        BOUND,
+        -BOUND,
+    ] {
+        assert!(admitted(value.to_bits()));
+    }
+    for bits in [
+        1,
+        (1u64 << 63) | 1,
+        f64::NAN.to_bits(),
+        f64::INFINITY.to_bits(),
+        (-f64::INFINITY).to_bits(),
+        BOUND.to_bits() + 1,
+    ] {
+        assert!(!admitted(bits));
+    }
+    let plan = Plan::new(3., 1, 1).unwrap();
+    assert!(plan.validate_input(&[]).is_err());
+    assert!(plan.validate_input(&[1]).is_err());
+    assert!(plan.validate_input(&[0, 0]).is_err());
+    let mut guard = Guard::default();
+    assert_eq!(guard.add(1f64.to_bits(), (-1f64).to_bits()), 0);
+    assert!(!guard.failed);
+    assert_eq!(guard.mul((-0f64).to_bits(), 1f64.to_bits()), 0);
+    // An invalid operand cannot be hidden by multiplying it by zero.
+    assert_eq!(guard.mul(BOUND.to_bits() + 1, 0), soft64::NAN);
+    assert!(guard.failed);
+    assert_eq!(guard.add(0, 0), soft64::NAN);
+    assert!(guard.failed, "numeric failure must never clear");
+    for (operation, rhs) in [
+        (
+            Guard::mul as fn(&mut Guard, u64, u64) -> u64,
+            2f64.to_bits(),
+        ),
+        (
+            Guard::add as fn(&mut Guard, u64, u64) -> u64,
+            BOUND.to_bits(),
+        ),
+    ] {
+        let mut guard = Guard::default();
+        assert_eq!(operation(&mut guard, BOUND.to_bits(), rhs), soft64::NAN);
+        assert!(guard.failed);
+    }
+    let mut guard = Guard::default();
+    assert_eq!(
+        guard.mul(f64::MIN_POSITIVE.to_bits(), 0.5f64.to_bits()),
+        soft64::NAN
+    );
+    assert!(guard.failed);
+    let mut guard = Guard::default();
+    assert_eq!(
+        guard.add(
+            f64::MIN_POSITIVE.to_bits() + 1,
+            (-f64::MIN_POSITIVE).to_bits()
+        ),
+        soft64::NAN
+    );
+    assert!(guard.failed);
+    // Each product and each left-associated sum is guarded even if a later
+    // term could cancel the out-of-range intermediate back to a legal result.
+    let mut guard = Guard::default();
+    let c = [1f64, 1., -1., 0.].map(f64::to_bits);
+    assert_eq!(
+        guard.step(c, BOUND.to_bits(), [BOUND.to_bits(), BOUND.to_bits(), 0]),
+        soft64::NAN
+    );
+    assert!(guard.failed);
+    let mut guard = Guard::default();
+    let c = [2f64, -2., 0., 0.].map(f64::to_bits);
+    assert_eq!(
+        guard.step(c, BOUND.to_bits(), [BOUND.to_bits(), 0, 0]),
+        soft64::NAN
+    );
+    assert!(guard.failed);
+    // A legal large source can still have an illegal b1 * state intermediate.
+    assert!(cpu_reference(&plan, &[BOUND.to_bits()]).is_err());
+}
