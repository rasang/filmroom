+    original_density_curves_sha256: String,
+});
+
+impl DirMixedCalibration {
+    pub(super) fn from_pipeline(pipe: &Pipeline, pitch: f32, width: u32, height: u32) -> R<Self> {
+        let d = &pipe.params.film_render.dir_couplers;
+        let inputs = PreparedPointScience::inputs_from_pipeline(pipe)?;
+        let gamma = pipe.params.film_render.density_curve_gamma;
+        let science = PreparedPointScience::derive(
+            &inputs,
+            gamma,
+            pitch,
+            pipe.film.is_positive(),
+            d.diffusion_size_um,
+            d.diffusion_tail_um,
+        )?;
+        let filters = derive_filters(&science, d.active, width, height)?;
+        let result = Self {
+            version: VERSION,
+            recipe: RECIPE.into(),
+            width,
+            height,
+            pitch_bits: pitch.to_bits(),
+            film_format_mm_bits: pipe.params.camera.film_format_mm.to_bits(),
+            gamma_bits: gamma.to_bits(),
+            dir_active: d.active,
+            positive: pipe.film.is_positive(),
+            diffusion_size_um_bits: d.diffusion_size_um.to_bits(),
+            diffusion_tail_um_bits: d.diffusion_tail_um.to_bits(),
+            core_sigma_bits: science.core_sigma_bits,
+            tail_decay_bits: science.tail_decay_bits,
+            tail_sigma_bits: science.tail_sigma_bits,
+            tail_weight_bits: d.diffusion_tail_weight.to_bits(),
+            fit_amplitude_bits: FIT.map(|(amplitude, _)| amplitude.to_bits()),
+            fit_ratio_bits: FIT.map(|(_, ratio)| ratio.to_bits()),
+            filters,
+            matrix_bits: science.matrix_bits,
+            density_max_bits: science.density_max_bits,
+            initial: science.initial,
+            before_dir: science.before_dir,
+            calibration_inputs: inputs,
+            original_gaussian_sha256: super::ORIGINAL_GAUSSIAN_SHA256.into(),
+            original_couplers_sha256: ORIGINAL_COUPLERS_SHA256.into(),
+            original_density_curves_sha256: ORIGINAL_DENSITY_CURVES_SHA256.into(),
+        };
+        result.validate()?;
+        Ok(result)
+    }
+
+    pub(super) fn validate(&self) -> R<()> {
+        // These are the real whole-image dimensions, independently of any
+        // point chunk or IIR complete-line batch. No resident f32 memory cap.
+        if self.version != VERSION
+            || self.recipe != RECIPE
+            || !(1..=40_000).contains(&self.width)
+            || !(1..=40_000).contains(&self.height)
+            || u64::from(self.width)
+                .checked_mul(u64::from(self.height))
+                .and_then(|n| n.checked_mul(24))
+                .is_none()
+            || self.original_gaussian_sha256 != super::ORIGINAL_GAUSSIAN_SHA256
+            || digest(super::ORIGINAL_GAUSSIAN.as_bytes()) != super::ORIGINAL_GAUSSIAN_SHA256
+            || self.original_couplers_sha256 != ORIGINAL_COUPLERS_SHA256
+            || digest(ORIGINAL_COUPLERS.as_bytes()) != ORIGINAL_COUPLERS_SHA256
+            || self.original_density_curves_sha256 != ORIGINAL_DENSITY_CURVES_SHA256
+            || digest(ORIGINAL_DENSITY_CURVES.as_bytes()) != ORIGINAL_DENSITY_CURVES_SHA256
+            || self.fit_amplitude_bits != FIT.map(|(a, _)| a.to_bits())
+            || self.fit_ratio_bits != FIT.map(|(_, r)| r.to_bits())
+        {
+            return Err(ERROR.into());
+        }
+        let format = f32::from_bits(self.film_format_mm_bits) as f64;
+        guard(format)?;
+        if format <= 0. {
+            return Err(ERROR.into());
+        }
+        guard_words(
+            [
+                &self.tail_weight_bits,
+                &self.diffusion_size_um_bits,
+                &self.diffusion_tail_um_bits,
+            ]
+            .into_iter()
+            .chain(&self.fit_amplitude_bits)
+            .chain(&self.fit_ratio_bits)
+            .chain(self.matrix_bits.iter().flatten())
+            .chain(&self.density_max_bits),
+        )?;
+        let weight = f64::from_bits(self.tail_weight_bits);
+        if !(0. ..=1.).contains(&weight) {
+            return Err(ERROR.into());
+        }
+        self.initial.validate()?;
+        self.before_dir.validate()?;
+        let science = PreparedPointScience::derive(
+            &self.calibration_inputs,
+            f32::from_bits(self.gamma_bits),
+            f32::from_bits(self.pitch_bits),
+            self.positive,
+            f64::from_bits(self.diffusion_size_um_bits),
+            f64::from_bits(self.diffusion_tail_um_bits),
+        )?;
+        let filters = derive_filters(&science, self.dir_active, self.width, self.height)?;
+        if self.core_sigma_bits != science.core_sigma_bits
+            || self.tail_decay_bits != science.tail_decay_bits
+            || self.tail_sigma_bits != science.tail_sigma_bits
+            || self.filters != filters
+            || self.matrix_bits != science.matrix_bits
+            || self.density_max_bits != science.density_max_bits
+            || self.initial != science.initial
+            || self.before_dir != science.before_dir
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+}
+
+fn guard(value: f64) -> R<()> {
+    if admitted(value.to_bits()) {
+        Ok(())
+    } else {
+        Err(DOMAIN_ERROR.into())
+    }
+}
+fn guard_words<'a>(words: impl IntoIterator<Item = &'a u64>) -> R<()> {
+    if words.into_iter().all(|&bits| admitted(bits)) {
+        Ok(())
+    } else {
+        Err(DOMAIN_ERROR.into())
+    }
+}
+
+// Canonical exact JSON transport. In particular no u64 ever passes through a
+// JSON number, f64 conversion, permissive hex parser, or native-endian byte cast.
+mod word {
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    #[derive(Clone, Copy)]
+    pub(super) struct Hex(pub u64);
+    impl Serialize for Hex {
+        fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+            format!("{:016x}", self.0).serialize(serializer)
+        }
+    }
+    impl<'de> Deserialize<'de> for Hex {
+        fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+            let text = String::deserialize(deserializer)?;
+            if text.len() != 16
+                || !text
+                    .bytes()
+                    .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+            {
+                return Err(serde::de::Error::custom(
+                    "expected exactly 16 lowercase hex digits",
+                ));
+            }
+            u64::from_str_radix(&text, 16)
+                .map(Self)
+                .map_err(serde::de::Error::custom)
+        }
+    }
+    pub(super) fn serialize<S: Serializer>(value: &u64, serializer: S) -> Result<S::Ok, S::Error> {
+        Hex(*value).serialize(serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<u64, D::Error> {
+        Ok(Hex::deserialize(deserializer)?.0)
+    }
+}
+mod word_vec {
+    use super::word::Hex;
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    pub(super) fn serialize<S: Serializer>(
+        value: &[u64],
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        value
+            .iter()
+            .copied()
+            .map(Hex)
+            .collect::<Vec<_>>()
+            .serialize(serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>>(
+        deserializer: D,
+    ) -> Result<Vec<u64>, D::Error> {
+        Ok(Vec::<Hex>::deserialize(deserializer)?
+            .into_iter()
+            .map(|word| word.0)
+            .collect())
+    }
+}
+mod word_array {
+    use super::word::Hex;
+    use serde::{Deserialize, Deserializer, Serializer};
+    pub(super) fn serialize<S: Serializer, const N: usize>(
+        value: &[u64; N],
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        super::word_vec::serialize(value, serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>, const N: usize>(
+        deserializer: D,
+    ) -> Result<[u64; N], D::Error> {
+        Vec::<Hex>::deserialize(deserializer)?
+            .into_iter()
+            .map(|word| word.0)
+            .collect::<Vec<_>>()
+            .try_into()
+            .map_err(|_| serde::de::Error::custom("wrong word-array length"))
+    }
+}
+mod word_rows {
+    use super::word::Hex;
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    pub(super) fn serialize<S: Serializer, const N: usize>(
+        value: &[[u64; N]],
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        value
+            .iter()
+            .map(|row| row.iter().copied().map(Hex).collect::<Vec<_>>())
+            .collect::<Vec<_>>()
+            .serialize(serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>, const N: usize>(
+        deserializer: D,
+    ) -> Result<Vec<[u64; N]>, D::Error> {
+        Vec::<Vec<Hex>>::deserialize(deserializer)?
+            .into_iter()
+            .map(|row| {
+                row.into_iter()
+                    .map(|word| word.0)
+                    .collect::<Vec<_>>()
+                    .try_into()
+                    .map_err(|_| serde::de::Error::custom("wrong word-row length"))
+            })
+            .collect()
+    }
+}
+mod word_matrix {
+    use serde::{Deserializer, Serializer};
+    pub(super) fn serialize<S: Serializer, const ROWS: usize, const COLS: usize>(
+        value: &[[u64; COLS]; ROWS],
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        super::word_rows::serialize(value, serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>, const ROWS: usize, const COLS: usize>(
+        deserializer: D,
+    ) -> Result<[[u64; COLS]; ROWS], D::Error> {
+        let rows: Vec<[u64; COLS]> = super::word_rows::deserialize(deserializer)?;
+        rows.try_into()
+            .map_err(|_| serde::de::Error::custom("wrong word-matrix length"))
+    }
+}
+// Unlike serde's default Option field behavior, the field must be present.
+// Explicit null identifies the original skipped-spatial branch.
+mod required_filters {
+    use super::Gaussian;
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    pub(super) fn serialize<S: Serializer>(
+        value: &Option<[Gaussian; 4]>,
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        value.serialize(serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>>(
+        deserializer: D,
+    ) -> Result<Option<[Gaussian; 4]>, D::Error> {
+        Option::<[Gaussian; 4]>::deserialize(deserializer)
+    }
+}
