+                    fs::read(boundaries.join(format!("afterExposureLog/channel-{c}.f64le")))
+                        .unwrap(),
+                    r22_reference_bytes(
+                        &reference,
+                        &format!("causal-prefix/current-gpu/gpu-log-{c}.f64le")
+                    )
+                );
+            }
+        }
+        reports.push(json!({"label":label,"boundaries":report,"stages":records,"session":stats,"pregrainExactR21Closure":true}));
+    }
+    session::request_stop(EPOCH).unwrap();
+    assert_eq!(fs::read(&f.input).unwrap(), input);
+    let mut differences = Vec::new();
+    for name in names {
+        let a = r22_read_planes(&out.join("cpu-prefix-boundaries"), name);
+        let b = r22_read_planes(&out.join("gpu-prefix-boundaries"), name);
+        differences.push(json!({"stage":name,"errors":causal_errors(a.iter().flatten().copied(),b.iter().flatten().copied())}));
