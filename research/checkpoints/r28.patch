+// Each domain fault gets a fresh process/session. A shared sticky flag in a
+// multi-fault dispatch could otherwise hide unexecuted later fault categories.
+fn invalid_word_reject_case(epoch: u64, invalid: u64) {
+    use crate::gpu_session as session;
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 1).unwrap();
+    let ticket = begin(epoch, 1);
+    let mut gpu = Probe::new(&mut || false).unwrap();
+    let p = Plan::new(f32::from_bits(0x41a757a2), 17, 1).unwrap();
+    let mut source = inputs(17, 1, 0);
+    source[0] = invalid;
+    assert!(p.validate_input(&source).is_err());
+    let error = gpu
+        .execute_inner(&p, &source, &mut || false, false)
+        .unwrap_err();
+    gpu.poison();
+    assert_eq!(error, "GPU_IIR_SOFT64_NUMERIC_DOMAIN");
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert!(gpu.execute(&p, &inputs(17, 1, 0), &mut || false).is_err());
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
