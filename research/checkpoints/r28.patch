+/// Private scheduler adapter for separately authenticated promoted GPU log words.
+/// Construction alone asserts policy, never producer provenance. The enclosing
+/// derived owner binds the complete evidence digest in origin.pipeline_sha256;
+/// origin.producer_sha256 remains the real producer shader digest.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub(super) struct DerivedMixedGraphPlan(DirMixedImagePlan);
+impl DerivedMixedGraphPlan {
+    pub(super) fn new(
+        calibration: DirMixedCalibration,
