+#[test]
+fn calibrated_original_profile_science_matches_old_plan_bit_for_bit() {
+    for positive in [false, true] {
+        let pipe = pipeline(positive);
+        assert_eq!(pipe.film.is_positive(), positive);
+        if !positive {
+            assert_eq!(
+                pipe.params.film_render.dir_couplers.gamma_samelayer_rgb,
+                [0.336, 0.319, 0.273]
+            );
+            assert_ne!(
+                pipe.params.film_render.dir_couplers.gamma_samelayer_rgb,
+                RuntimeParams::default()
+                    .film_render
+                    .dir_couplers
+                    .gamma_samelayer_rgb
+            );
+        }
+        for gamma in [1., 1.3] {
+            let mut pipe = pipe.clone();
+            pipe.params.film_render.density_curve_gamma = gamma;
+            let actual = DirCalibration::from_pipeline(&pipe, FIXTURE_PITCH, 23, 17).unwrap();
+            // Only a small-geometry comparison. The new constructor neither
+            // calls the resident old plan nor takes its numerical preflight.
+            let original = crate::research_dir::DirPlan::new(&pipe, FIXTURE_PITCH, 23, 17).unwrap();
+            assert_eq!(
+                (actual.width, actual.height),
+                (original.width, original.height)
+            );
+            assert_eq!(
+                (actual.dir_active, actual.positive),
+                (original.dir_active, original.positive)
+            );
+            assert_eq!(actual.core_sigma_bits, original.core_sigma.to_bits());
+            assert_eq!(actual.tail_decay_bits, original.tail_decay.to_bits());
+            assert_eq!(actual.tail_weight_bits, original.tail_weight.to_bits());
+            assert_eq!(
+                actual.matrix_bits,
+                original.matrix.map(|row| row.map(f64::to_bits))
+            );
+            assert_eq!(
+                actual.density_max_bits,
+                original.density_max.map(f64::to_bits)
+            );
+            curve_matches(&actual.initial, &original.initial);
+            curve_matches(&actual.before_dir, &original.before_dir);
+            let sigmas = [
+                original.core_sigma,
+                (0.5360 * original.tail_decay as f64) as f32,
+                (1.5236 * original.tail_decay as f64) as f32,
+                (2.7684 * original.tail_decay as f64) as f32,
+            ];
+            assert_eq!(
+                actual.tail_sigma_bits,
+                [sigmas[1], sigmas[2], sigmas[3]].map(f32::to_bits)
+            );
+            assert_eq!(
+                actual.coefficient_bits,
+                Some(sigmas.map(original_coefficients))
+            );
+            assert_eq!(
+                actual.fit_amplitude_bits,
+                [0.1633_f64, 0.6496, 0.1870].map(f64::to_bits)
+            );
+            actual.validate().unwrap();
+        }
+    }
+}
