+#[test]
+fn actual_default_sigmas_keep_the_existing_f32_preflight_rejection() {
+    use crate::research_spatial::{FIT, numerical_preflight_for_sigmas};
+    let params = spektrafilm_core::params::RuntimeParams::default();
+    let pitch = 36_000f32 / 8192.;
+    let bounce = (params.film_render.halation.halation_first_sigma_um[0] / pitch as f64
+        * 2f64.sqrt()) as f32;
+    let decay = (params.film_render.dir_couplers.diffusion_tail_um / pitch as f64) as f32;
+    let sigmas = [
+        bounce,
+        (FIT[1].1 * decay as f64) as f32,
+        (FIT[2].1 * decay as f64) as f32,
+    ];
+    assert_eq!(sigmas.map(f32::to_bits), REAL_SIGMA_BITS);
+    for sigma in sigmas {
+        let mut rejected = false;
+        for length in [8192, 6144] {
+            let result = numerical_preflight_for_sigmas(length, length, [sigma], &mut || false);
+            eprintln!(
+                "unchanged f32 preflight: sigma_bits={:#010x}, true_line_length={length}, result={result:?}",
+                sigma.to_bits()
+            );
+            if result == Err("GPU_OPTICS_NUMERIC_CHECK".into()) {
+                rejected = true;
+            } else {
+                assert_eq!(result, Ok(()), "unexpected preflight failure");
+            }
+        }
+        assert!(
+            rejected,
+            "the unchanged real-dimension f32 gate must remain red for sigma {:#010x}",
+            sigma.to_bits()
+        );
+        assert_eq!(
+            numerical_preflight_for_sigmas(8192, 6144, [sigma], &mut || false),
+            Err("GPU_OPTICS_NUMERIC_CHECK".into())
+        );
+    }
+}
