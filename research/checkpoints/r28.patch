+        // Validate actual complete-axis lengths, including the smaller final
+        // batch, with the correct typed ABI. No synthetic 1x1 probe is used.
+        for axis in [&schedule.rows, &schedule.columns] {
+            for lines in [axis.lines_per_batch, axis.final_batch_lines] {
