+pub(super) trait Compute {
+    /// Real owners report asynchronous device errors even between batches.
+    fn check_status(&self) -> R<()> {
+        Ok(())
+    }
+    /// The implementation must use the validated raw-only kernel, preserve the
+    /// original four multiplies / three left-associated adds and all guards,
+    /// poll cancellation, and poison/retire on error. Returning a vector means
+    /// the successful fence and unmap have already completed. No f32 conversion.
+    fn execute(
+        &mut self,
+        spec: &LineSpec,
+        values: &[u64],
+        cancelled: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>>;
+}
