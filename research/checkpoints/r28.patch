+#[test]
+fn original_full_2d_oracle_and_horizontal_low_words_survive_for_real_sigmas() {
+    struct Original;
+    impl Compute for Original {
+        fn execute(
+            &mut self,
+            spec: &LineSpec,
+            values: &[u64],
+            c: &mut impl FnMut() -> bool,
+        ) -> R<Vec<u64>> {
+            check(c)?;
+            spec.validate_input(values)?;
+            let input: Vec<f64> = values.iter().map(|&v| f64::from_bits(v)).collect();
+            let mut output = vec![0.; values.len()];
+            spektrafilm_math::gaussian::gaussian_blur_rows(
+                &input,
+                &mut output,
+                spec.length as usize,
+                f32::from_bits(spec.sigma_bits),
+            );
+            Ok(output.into_iter().map(f64::to_bits).collect())
+        }
+    }
+    for (width, height) in [(17, 31), (1, 31), (31, 1)] {
+        for kind in 0..4 {
+            let values: Vec<f64> = (0..width * height)
+                .map(|i| match kind {
+                    0 => {
+                        if i == 0 {
+                            1. + f64::EPSILON
+                        } else {
+                            0.
+                        }
+                    }
+                    1 => i as f64 / 127. + f64::EPSILON,
+                    2 => {
+                        if i % 2 == 0 {
+                            1. + f64::EPSILON
+                        } else {
+                            -0.75 - f64::EPSILON
+                        }
+                    }
+                    _ => {
+                        ((((i as u64)
+                            .wrapping_mul(6364136223846793005u64)
+                            .wrapping_add(1))
+                            % 997) as f64
+                            - 498.)
+                            / 1024.
+                    }
+                })
+                .collect();
+            let fixture = Fixture::new(&values.iter().map(|v| v.to_bits()).collect::<Vec<_>>());
+            for sigma in [3f32.to_bits(), 0x41a7_57a2, 0x428a_ae74, 0x42fb_fc66] {
+                let expected = spektrafilm_math::gaussian::gaussian_blur_channel(
+                    &values,
+                    width,
+                    height,
+                    f32::from_bits(sigma),
+                );
+                let mut previous = None;
+                for capacity in [width.max(height), CAPACITY] {
+                    let p = fixture.sigma_plan(
+                        width,
+                        height,
+                        sigma,
+                        capacity,
+                        &format!("p-{sigma}-{capacity}"),
+                    );
+                    let receipt = run(&p, &mut Original, &mut || false).unwrap();
+                    let actual = fixture.candidate(&receipt);
+                    let mut zero_sign_differences = 0;
+                    for (&a, e) in actual.iter().zip(&expected) {
+                        if *e == 0. {
+                            assert_eq!(f64::from_bits(a), 0.);
+                            zero_sign_differences += usize::from(a != e.to_bits());
+                        } else {
+                            assert_eq!(
+                                a,
+                                e.to_bits(),
+                                "{width}x{height}, kind {kind}, sigma {sigma:#x}"
+                            );
+                        }
+                    }
+                    assert_eq!(
+                        zero_sign_differences, 0,
+                        "the original oracle retains zero signs"
+                    );
+                    if let Some(previous) = previous {
+                        assert_eq!(actual, previous);
+                    }
+                    previous = Some(actual);
+                    let horizontal = fs::read(&p.paths().horizontal64).unwrap();
+                    assert!(
+                        horizontal.chunks_exact(8).any(|b| {
+                            let bits = u64::from_le_bytes(b.try_into().unwrap());
+                            let x = f64::from_bits(bits);
+                            x != 0. && (x as f32 as f64).to_bits() != bits
+                        }),
+                        "missing horizontal low-word witness"
+                    );
+                }
+            }
+        }
+    }
+}
