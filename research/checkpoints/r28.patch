+#[test]
+fn held_fd_promoted_encoding_preserves_signed_zero_and_rejects_invalid_words() {
+    let f = Fixture::new();
+    let path = &f.source_paths[0];
+    let captured = SourceIdentity::capture(path, &mut || false).unwrap();
+    captured.verify_f32_promoted(&mut || false).unwrap();
+    let bytes = fs::read(path).unwrap();
+    assert_eq!(
+        u64::from_le_bytes(bytes[..8].try_into().unwrap()),
+        0_f64.to_bits()
+    );
+    assert_eq!(
+        u64::from_le_bytes(bytes[8..16].try_into().unwrap()),
+        (-0_f64).to_bits()
+    );
+    assert_eq!(
+        captured.verify_f32_promoted(&mut || true).unwrap_err(),
+        CANCELLED
+    );
+    for bits in [
+        (1. + f64::EPSILON).to_bits(),
+        f64::INFINITY.to_bits(),
+        f64::NAN.to_bits(),
+        1,
+    ] {
+        let mut file = OpenOptions::new().write(true).open(path).unwrap();
+        file.write_all(&bits.to_le_bytes()).unwrap();
+        file.sync_all().unwrap();
+        let changed = SourceIdentity::capture(path, &mut || false).unwrap();
+        assert!(changed.verify_f32_promoted(&mut || false).is_err());
+    }
+    let mut file = OpenOptions::new().write(true).open(path).unwrap();
+    file.set_len(7).unwrap();
+    file.seek(SeekFrom::Start(0)).unwrap();
+    file.write_all(&[0; 7]).unwrap();
+    file.sync_all().unwrap();
+    let short = SourceIdentity::capture(path, &mut || false).unwrap();
+    assert!(short.verify_f32_promoted(&mut || false).is_err());
+    assert!(captured.verify_f32_promoted(&mut || false).is_err());
+}
