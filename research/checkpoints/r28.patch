+    let duplicate = encoded.replacen('{', "{\"version\":1,", 1);
+    assert!(serde_json::from_str::<Plan>(&duplicate).is_err());
+    for invalid in ["null", "[]", "{}", "{\"version\":1.5}"] {
+        assert!(serde_json::from_str::<Plan>(invalid).is_err());
