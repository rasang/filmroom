+fn after_unmap_fault(epoch: u64, cancel: bool) {
+    use std::sync::{Arc, atomic::AtomicBool};
+    let (ticket, mut gpu) = open(epoch);
+    let p = oracle::calibration();
+    let flag = Arc::new(AtomicBool::new(false));
+    gpu.after_unmap_fault = Some(if cancel {
+        AfterUnmapFault::Cancel(flag.clone())
+    } else {
+        AfterUnmapFault::DeviceError
+    });
+    let error = gpu
+        .point(
+            &p,
+            job(Operation::InitialCorrection, 0, 0),
+            &[[0; 3]; 17],
+            &mut || flag.load(Ordering::Acquire),
+        )
+        .unwrap_err();
+    assert_eq!(
+        error,
+        if cancel {
+            "CANCELLED"
+        } else {
+            "GPU_DEVICE_FAILED"
+        }
+    );
+    assert_eq!(gpu.metrics.point_dispatches, 1);
+    assert_eq!(gpu.metrics.completed_readbacks, 1);
+    assert_eq!(gpu.metrics.transient_releases, 0);
+    assert_eq!(gpu.metrics.readback_bytes, 0);
+    assert_poisoned(ticket, gpu, &p);
