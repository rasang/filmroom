+#[test]
+fn sixth_live_temporary_is_refused_before_creation_and_resource_overflow_rejects() {
+    assert!(Resources::new(u64::MAX).is_err());
+    let f = Fixture::new(3, 2);
+    let p = f.plan(calibration(3, 2), 2, 3, "candidate");
+    let mut workspace = Workspace::new(&p, None).unwrap();
+    let mut handles = Vec::new();
+    for name in [
+        "test-c.bin",
+        "test-g.bin",
+        "test-a.bin",
+        "test-h.bin",
+        "test-b.bin",
+    ] {
+        handles.push(workspace.temp(name).unwrap());
+    }
+    assert_eq!(workspace.live.len(), 5);
+    assert_eq!(workspace.highwater, 5);
+    assert_eq!(workspace.byte_highwater, 40 * p.samples());
+    assert!(
+        workspace
+            .temp("sixth-must-not-exist.bin")
+            .unwrap_err()
+            .contains("TEMP_BUDGET")
+    );
+    assert!(
+        !p.paths()
+            .private_directory
+            .join("sixth-must-not-exist.bin")
+            .exists()
+    );
+    assert_eq!(workspace.live.len(), 5);
+    assert_eq!(
+        fs::read_dir(&p.paths().private_directory).unwrap().count(),
+        5
+    );
+    // Close every associated handle before the owned workspace cleanup.
+    drop(handles);
+    drop(workspace);
+    assert!(!p.paths().private_directory.exists());
+    f.assert_sources();
+}
