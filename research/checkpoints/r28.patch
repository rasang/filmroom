+//! Test-only, output-path-scoped capture. Never compiled in production.
+use super::*;
+#[derive(Clone)]
+struct Config {output:PathBuf, root:PathBuf, split:bool, identity:bool, reject:bool, rejected:u32, continue_after_capture:bool,captured:u32,post_captured:u32}
+static CONFIG:std::sync::Mutex<Option<Config>>=std::sync::Mutex::new(None);
+pub(super) struct Scope;
+impl Drop for Scope {fn drop(&mut self){*CONFIG.lock().unwrap()=None;}}
+pub(super) fn configure(output:PathBuf,root:PathBuf)->Scope{
+ assert!(root.is_dir());let mut guard=CONFIG.lock().unwrap();assert!(guard.is_none());*guard=Some(Config{output,root,split:false,identity:false,reject:false,rejected:0,continue_after_capture:false,captured:0,post_captured:0});Scope
+}
+pub(super) fn capture(planes:&[PathBuf;3],pipe:&Pipeline,pitch:f32,w:u32,h:u32,output:&Path)->Result<()>{
+ let config=CONFIG.lock().unwrap().clone();let Some(config)=config.filter(|v|v.output==output)else{return Ok(());};
+ if config.continue_after_capture && config.captured!=0{return Err(error("TEST_GRAIN_OBSERVER_DUPLICATE","Full-chain pre-grain observation repeated"));}
+ if config.continue_after_capture {derived_chain_full::check_pregrain(output,planes).map_err(|e|error("TEST_DERIVED_PRE_GRAIN",e))?;}
+ let plan=crate::research_grain::GrainPlan::new_guarded(pipe,pitch,w,h).map_err(|e|error("TEST_GRAIN_PLAN",e))?;
+ let metadata=serde_json::json!({"testOnly":true,"width":w,"height":h,"pitch":pitch,"grainPlan":plan,"resolvedParameters":pipe.params});
+ fs::write(config.root.join("metadata.json"),serde_json::to_vec_pretty(&metadata).unwrap()).map_err(io)?;
+ for ch in 0..3{fs::copy(&planes[ch],config.root.join(format!("pre-grain-{ch}.f64le"))).map_err(io)?;}
+ if config.continue_after_capture {CONFIG.lock().unwrap().as_mut().unwrap().captured+=1;Ok(())} else {Err(error("TEST_GRAIN_CAPTURE_STOP","Captured before any grain execution"))}
+}
+
+pub(super) fn configure_split(output:PathBuf,root:PathBuf)->Scope {
+ let scope=configure(output,root);CONFIG.lock().unwrap().as_mut().unwrap().split=true;scope
+}
+pub(super) fn split_requested(output:&Path)->bool {CONFIG.lock().unwrap().as_ref().is_some_and(|v|v.split&&v.output==output)}
+pub(super) fn capture_split_log(planes:&[PathBuf;3],output:&Path)->Result<()> {
+ let config=CONFIG.lock().unwrap().clone();let Some(config)=config.filter(|v|v.split&&v.output==output)else{return Ok(());};
+ for ch in 0..3 {let dest=config.root.join(format!("gpu-log-{ch}.f64le"));let mut options=OpenOptions::new();options.write(true).create_new(true);#[cfg(unix)]{use std::os::unix::fs::OpenOptionsExt;options.mode(0o600);}let mut writer=options.open(dest).map_err(io)?;let mut reader=File::open(&planes[ch]).map_err(io)?;std::io::copy(&mut reader,&mut writer).map_err(io)?;writer.sync_all().map_err(io)?;}
+ Ok(())
+}
+
+// Identity evidence requires actual parent adoption, not only a sealed helper result.
+pub(super) fn configure_identity(output:PathBuf,root:PathBuf,split:bool,reject:bool)->Scope {
+ let scope=configure(output,root);let mut g=CONFIG.lock().unwrap();let c=g.as_mut().unwrap();c.split=split;c.identity=true;c.reject=reject;scope
+}
+pub(super) fn reject_adopted_candidate(output:&Path,has_candidate:bool)->bool {
+ let mut g=CONFIG.lock().unwrap();let Some(v)=g.as_mut().filter(|v|v.identity&&v.reject&&v.output==output&&has_candidate)else{return false;};v.rejected=v.rejected.checked_add(1).unwrap();true
+}
+pub(super) fn require_adopted_prefix(output:&Path,stages:&[(&str,&str,&str,&str,&str)])->Result<()> {
+ if !CONFIG.lock().unwrap().as_ref().is_some_and(|v|v.identity&&v.output==output){return Ok(());}
+ for (name,backend,fallback,expected_backend,expected_fallback) in stages {
+  if backend!=expected_backend||fallback!=expected_fallback{return Err(error("TEST_GPU_ADOPTION_REQUIRED",format!("Prefix stage {name} was not adopted as required")));}
+ }
+ Ok(())
+}
+
+pub(super) fn rejection_count(output:&Path)->u32 {CONFIG.lock().unwrap().as_ref().filter(|v|v.output==output).map_or(0,|v|v.rejected)}
+
+// Separate observer mode: historical stop-and-replay callers stay unchanged.
+pub(super) fn configure_continue(output:PathBuf,root:PathBuf)->Scope {
+ let scope=configure_identity(output,root,true,false);
+ CONFIG.lock().unwrap().as_mut().unwrap().continue_after_capture=true;scope
+}
+
+pub(super) fn continuation_count(output:&Path)->u32 {CONFIG.lock().unwrap().as_ref().filter(|c|c.output==output&&c.continue_after_capture).map_or(0,|c|c.captured)}
+#[test]
+fn explicit_continue_does_not_change_historical_stop_constructors() {
+ let root=std::env::temp_dir().join(format!("film-grain-capture-modes-{}",std::process::id()));fs::create_dir(&root).unwrap();let output=root.join("output");
+ {let _s=configure(output.clone(),root.clone());assert!(!CONFIG.lock().unwrap().as_ref().unwrap().continue_after_capture);}
+ {let _s=configure_split(output.clone(),root.clone());assert!(!CONFIG.lock().unwrap().as_ref().unwrap().continue_after_capture);}
+ {let _s=configure_identity(output.clone(),root.clone(),true,false);assert!(!CONFIG.lock().unwrap().as_ref().unwrap().continue_after_capture);}
+ {let _s=configure_continue(output.clone(),root.clone());assert!(CONFIG.lock().unwrap().as_ref().unwrap().continue_after_capture);assert_eq!(continuation_count(&output),0);assert_eq!(continuation_count(&root.join("other")),0);}
+ assert!(CONFIG.lock().unwrap().is_none());fs::remove_dir(root).unwrap();
+}
+
+pub(super) fn configure_cpu_observer(output:PathBuf,root:PathBuf)->Scope {let scope=configure(output,root);CONFIG.lock().unwrap().as_mut().unwrap().continue_after_capture=true;scope}
+pub(super) fn capture_post_grain(planes:&[PathBuf;3],output:&Path)->Result<()> {
+ let config=CONFIG.lock().unwrap().clone();let Some(c)=config.filter(|c|c.output==output&&c.continue_after_capture)else{return Ok(());};
+ if c.captured!=1||c.post_captured!=0{return Err(error("TEST_GRAIN_OBSERVER_ORDER","Expected one pre-grain observation and no prior post-grain observation"));}
+ for ch in 0..3 {let path=c.root.join(format!("post-grain-{ch}.f64le"));let mut options=OpenOptions::new();options.create_new(true).write(true);#[cfg(unix)]{use std::os::unix::fs::OpenOptionsExt;options.mode(0o600);}let mut out=options.open(path).map_err(io)?;let mut source=File::open(&planes[ch]).map_err(io)?;std::io::copy(&mut source,&mut out).map_err(io)?;out.sync_all().map_err(io)?;}
+ CONFIG.lock().unwrap().as_mut().unwrap().post_captured+=1;Ok(())
+}
+pub(super) fn post_grain_count(output:&Path)->u32 {CONFIG.lock().unwrap().as_ref().filter(|c|c.output==output).map_or(0,|c|c.post_captured)}
