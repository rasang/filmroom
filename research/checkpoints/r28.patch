+ if(sf_cmp(lam,vec2<u32>(0x00000000u,0x40240000u))<0){result.enlam=sf_exp_nonpositive(sf_neg(lam));return result;}
+ let slam=sf_sqrt(lam);let loglam=sf_log(lam);let b=sf_add(vec2<u32>(0x83126e98u,0x3fedcac0u),sf_mul(vec2<u32>(0xa3d70a3du,0x40043d70u),slam));let a=sf_add(sf_neg(vec2<u32>(0x7ced9168u,0x3fae353fu)),sf_mul(vec2<u32>(0x17d6b65bu,0x3f996d09u),b));
+ let invalpha=sf_add(vec2<u32>(0x90ff9724u,0x3ff1fb7eu),sf_div(vec2<u32>(0xe48e8a72u,0x3ff21ff2u),sf_sub(b,vec2<u32>(0x33333333u,0x400b3333u))));let vr=sf_sub(vec2<u32>(0xe90ff972u,0x3fedafb7u),sf_div(vec2<u32>(0xd9e83e42u,0x400cfaacu),sf_sub(b,vec2<u32>(0x00000000u,0x40000000u))));
+ return SrPoissonSetup(vec2<u32>(0u),loglam,b,a,invalpha,vr);
+}"#;
+const NEW_PREPARE:&str=r#"fn sr_prepare_poisson(lam:vec2<u32>)->SrPoissonSetup{
+ var result:SrPoissonSetup;
+ if(sf_zero(lam)){return result;}
+ if(sf_cmp(lam,vec2<u32>(0x00000000u,0x40240000u))<0){result.enlam=sf_exp_nonpositive(sf_neg(lam));return result;}
+ let slam=sf_sqrt(lam);let loglam=sf_log(lam);let b=sf_add(vec2<u32>(0x83126e98u,0x3fedcac0u),sf_mul(vec2<u32>(0xa3d70a3du,0x40043d70u),slam));let a=sf_add(sf_neg(vec2<u32>(0x7ced9168u,0x3fae353fu)),sf_mul(vec2<u32>(0x17d6b65bu,0x3f996d09u),b));
+ let invalpha=sf_add(vec2<u32>(0x90ff9724u,0x3ff1fb7eu),sf_div(vec2<u32>(0xe48e8a72u,0x3ff21ff2u),sf_sub(b,vec2<u32>(0x33333333u,0x400b3333u))));let vr=sf_sub(vec2<u32>(0xe90ff972u,0x3fedafb7u),sf_div(vec2<u32>(0xd9e83e42u,0x400cfaacu),sf_sub(b,vec2<u32>(0x00000000u,0x40000000u))));
+ return sr_poisson_cache(lam,SrPoissonSetup(vec2<u32>(0u),loglam,b,a,invalpha,vr,vec2<u32>(0u),vec2<u32>(0u),vec2<u32>(0u),0u,0u,0u));
+}"#;
+const OLD_STORE:&str=r#"fn gg_store_poisson(pixel:u32,value:SrPoissonSetup){
+ let values=array<vec2<u32>,6>(value.enlam,value.loglam,value.b,value.a,value.invalpha,value.vr);
+ for(var j=0u;j<6u;j=j+1u){gg_store64(pixel,18u+3u*j,values[j]);}
+}"#;
+const NEW_STORE:&str=r#"fn gg_store_poisson(pixel:u32,value:SrPoissonSetup){
+ let values=array<vec2<u32>,6>(value.enlam,value.loglam,value.b,value.a,value.invalpha,value.vr);
+ for(var j=0u;j<6u;j=j+1u){gg_store64(pixel,18u+3u*j,values[j]);}
+ gg_store64(pixel,36u,value.cache_lalpha);gg_store64(pixel,39u,value.cache_ealpha);gg_store64(pixel,42u,value.cache_elam);
+ grain_scratch.frames[pixel].prepared[45u]=f32(value.cache_fail_lalpha);
+ grain_scratch.frames[pixel].prepared[46u]=f32(value.cache_fail_ealpha);
+ grain_scratch.frames[pixel].prepared[47u]=f32(value.cache_fail_elam);
+}"#;
+const OLD_LOAD:&str=r#"fn gg_load_poisson(pixel:u32)->SrPoissonSetup{return SrPoissonSetup(gg_load64(pixel,18u),gg_load64(pixel,21u),gg_load64(pixel,24u),gg_load64(pixel,27u),gg_load64(pixel,30u),gg_load64(pixel,33u));}"#;
+const NEW_LOAD:&str=r#"fn gg_load_poisson(pixel:u32)->SrPoissonSetup{return SrPoissonSetup(gg_load64(pixel,18u),gg_load64(pixel,21u),gg_load64(pixel,24u),gg_load64(pixel,27u),gg_load64(pixel,30u),gg_load64(pixel,33u),gg_load64(pixel,36u),gg_load64(pixel,39u),gg_load64(pixel,42u),u32(grain_scratch.frames[pixel].prepared[45u]),u32(grain_scratch.frames[pixel].prepared[46u]),u32(grain_scratch.frames[pixel].prepared[47u]));}"#;
+const CACHE_HELPER:&str=r#"fn sr_poisson_cache(lam:vec2<u32>,input:SrPoissonSetup)->SrPoissonSetup{
+ // No global/storage/RNG side effects: sf_log/add/mul only set private sf_failed.
+ // Do not expose speculative failures until the original slow consumer path.
+ var result=input;let prior=sf_failed;
+ sf_failed=0u;result.cache_lalpha=sf_log(input.invalpha);result.cache_fail_lalpha=sf_failed;
+ sf_failed=0u;
+ result.cache_ealpha=sf_add(sf_mul(vec2<u32>(0x86a12b9bu,0x3d26849bu),sf_abs(result.cache_lalpha)),vec2<u32>(0x0c924223u,0x3bd79ca1u));
