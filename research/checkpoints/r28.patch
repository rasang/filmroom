+        for weight in [0., 0.25, 1.] {
+            let mut pipe = original384_pipeline();
+            pipe.params.film_render.dir_couplers.diffusion_tail_um = tail;
+            pipe.params.film_render.dir_couplers.diffusion_tail_weight = weight;
+            let actual = DirMixedCalibration::from_pipeline(&pipe, ORIGINAL_PITCH, 23, 17).unwrap();
+            let filters = actual.filters.as_ref().unwrap();
+            assert!(!filters[0].is_identity());
+            let decay = (tail / ORIGINAL_PITCH as f64) as f32;
+            for (filter, ratio) in filters[1..].iter().zip([0.5360, 1.5236, 2.7684]) {
+                let original = (ratio * decay as f64) as f32;
+                assert_eq!(
+                    *filter,
+                    Gaussian::Identity {
+                        sigma_bits: original.to_bits()
+                    }
+                );
+                let SpatialLine::Identity {
+                    original_sigma_bits,
+                    copy,
+                } = filter.line(23, 2).unwrap()
+                else {
+                    panic!("identity component");
+                };
+                assert_eq!(original_sigma_bits, original.to_bits());
+                assert_eq!(copy.sigma_bits, 0_f32.to_bits());
+                assert!(copy.coefficient_bits.is_empty());
+            }
+            assert_eq!(
+                actual.fit_amplitude_bits,
+                [0.1633_f64, 0.6496, 0.1870].map(f64::to_bits)
+            );
+            assert_eq!(
+                actual.fit_ratio_bits,
