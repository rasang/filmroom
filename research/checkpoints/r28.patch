+//! Closed DIR point shader composition. Shared arithmetic is never rewritten.
+use super::*;
+
+pub(super) const LAYOUT: &str =
+    "dirPacket64:read,scalarResult64:read_write,error:atomic_u32,parameters:array_vec4_u32_4";
+pub(super) const SHARED_SHA256: &str = super::SOFT64_SHA256;
+pub(super) const KERNEL_SHA256: &str =
+    "c112b18e0069d1d764f5e17c1254178a41b8b2f75b05a85416bf06ccfa99ab1a";
+const KERNEL: &str = include_str!("dir_kernel.wgsl");
+const HELPERS: [&str; 18] = [
+    "sf_abs", "sf_add", "sf_addu", "sf_cmp", "sf_cmpu", "sf_exp", "sf_fail", "sf_jam", "sf_mul",
+    "sf_neg", "sf_round", "sf_shl", "sf_shr", "sf_sig", "sf_sub", "sf_subu", "sf_valid", "sf_zero",
+];
+const ERROR: &str = "GPU_DIR64_POINT_SHADER_IDENTITY";
+
+pub(super) fn shader() -> R<String> {
+    compose(soft64::SHADER, KERNEL)
+}
+fn compose(source: &str, kernel: &str) -> R<String> {
+    if digest(source.as_bytes()) != SHARED_SHA256 || digest(kernel.as_bytes()) != KERNEL_SHA256 {
+        return Err(ERROR.into());
+    }
+    let all = functions(source)?;
+    if all.len() != 26 {
+        return Err(ERROR.into());
+    }
+    let mut reached: BTreeSet<String> = identifiers(kernel)
+        .into_iter()
+        .filter(|name| all.contains_key(*name))
+        .map(str::to_owned)
+        .collect();
+    loop {
+        let mut next = reached.clone();
+        for name in &reached {
+            for identifier in identifiers(all[name]) {
+                if all.contains_key(identifier) {
+                    next.insert(identifier.to_owned());
+                }
+            }
+        }
+        if next == reached {
+            break;
+        }
+        reached = next;
+    }
+    if reached != HELPERS.into_iter().map(str::to_owned).collect()
+        || [
+            "f32",
+            "f64",
+            "sf_scalar",
+            "sf_log",
+            "sf_exp_nonpositive",
+            "sf_div",
+            "fma",
+        ]
+        .into_iter()
+        .any(|token| identifiers(kernel).contains(token))
+    {
+        return Err(ERROR.into());
+    }
+    let mut output = String::new();
+    for declaration in [
+        "const SF_NAN:vec2<u32>=vec2<u32>(0u,0x7ff80000u);",
+        "var<private> sf_failed:u32;",
+    ] {
+        if source.matches(declaration).count() != 1 {
+            return Err(ERROR.into());
+        }
+        let at = source.find(declaration).ok_or(ERROR)?;
+        output.push_str(&source[at..at + declaration.len()]);
+        output.push('\n');
+    }
+    for name in reached {
+        output.push_str(all[&name]);
+        output.push('\n');
+    }
+    output.push_str(kernel);
+    Ok(output)
+}
+
+#[test]
+fn point_shader_uses_only_pinned_exact_integer_helpers() {
+    let composed = shader().unwrap();
+    let shared = functions(soft64::SHADER).unwrap();
+    let actual = functions(&composed).unwrap();
+    for helper in HELPERS {
+        assert_eq!(actual[helper], shared[helper], "changed helper {helper}");
+    }
+    for token in [
+        "f32",
+        "f64",
+        "sf_scalar",
+        "sf_log",
+        "sf_exp_nonpositive",
+        "sf_div",
+        "fma",
+    ] {
+        assert!(
+            !identifiers(&composed).contains(token),
+            "unexpected {token}"
+        );
+    }
+    assert!(compose(&(soft64::SHADER.to_owned() + "\n"), KERNEL).is_err());
+    assert!(compose(soft64::SHADER, &(KERNEL.to_owned() + "\n")).is_err());
+    let module = naga::front::wgsl::parse_str(&composed).unwrap();
+    naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::empty(),
+    )
+    .validate(&module)
+    .unwrap();
+}
+
+#[test]
+fn point_packet_constants_and_original_operation_order_are_fixed() {
+    assert!(LAYOUT.contains("scalarResult64"));
+    for (weight, _) in crate::research_spatial::FIT {
+        let word = weight.to_bits();
+        assert!(KERNEL.contains(&format!(
+            "0x{:08x}u, 0x{:08x}u",
+            word as u32,
+            (word >> 32) as u32
+        )));
+    }
+    let function = functions(KERNEL).unwrap();
+    let curve = function["dir_curve"];
+    assert!(
+        curve.find("let t = dir_mul(dx,").unwrap() < curve.find("let dy = dir_sub(b, a)").unwrap()
+    );
+    assert!(curve.contains("return dir_add(a, weighted)"));
+    let main = function["main"];
+    let ordered = [
+        "let p0 = dir_mul(d0,",
+        "let p1 = dir_mul(d1,",
+        "let t0 = dir_add(p0, p1)",
+        "let p2 = dir_mul(d2,",
+        "result = dir_add(t0, p2)",
+    ];
+    let mut position = 0;
+    for text in ordered {
+        let next = main[position..].find(text).unwrap() + position;
+        assert!(next >= position);
+        position = next + text.len();
+    }
+    assert!(main.contains("if (index < bounds.x)"));
+    assert!(main.contains("if (index < bounds.y)"));
+    assert!(main.contains("if (index >= count || sf_failed != 0u)"));
+    assert_eq!(super::dir_point::PREFIX_WORDS, 65_536);
+    assert_eq!(super::dir_point::POINT_CAPACITY, 65_536);
+    assert_eq!(super::dir_point::HEADER_WORDS, 64);
+}
