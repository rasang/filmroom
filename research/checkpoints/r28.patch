+fn dir_gpu_two_family_reservation_preserves_exact_pool_and_upload() {
+    assert_eq!(MAP_BYTES, 4 * 1024 * 1024 + 4);
+    assert_eq!(RESIDENT_BYTES, 12 * 1024 * 1024 + 72);
+    assert_eq!(DRIVER_BYTES, 80 * 1024 * 1024);
+    assert_eq!(COMBINED_BYTES, 228 * 1024 * 1024 + 65_536);
+    assert!(RESIDENT_BYTES + BATCH_BYTES <= DEVICE_BYTES);
+    assert_eq!(PREFIX_WORDS * 8, 512 * 1024);
+    assert_eq!(POINT_CAPACITY * 3 * 8, 1536 * 1024);
+    assert_eq!(POINT_CAPACITY * 8, 512 * 1024);
+    // Session debt is cumulative, including unrelated retained earlier buffers.
+    let mut contract =
+        crate::gpu_session_contract::SessionContract::new(95500, COMBINED_BYTES, FIXED_BYTES, 2)
+            .unwrap();
+    let prior_pool_debt = 4096;
+    contract.charge_allocation(prior_pool_debt).unwrap();
+    contract.reserve_pipeline_slots(2, DRIVER_BYTES).unwrap();
+    contract.charge_allocation(RESIDENT_BYTES).unwrap();
+    assert_eq!(
+        contract.charged_bytes(),
+        FIXED_BYTES + prior_pool_debt + DRIVER_BYTES + RESIDENT_BYTES
+    );
+    // No refund is made by this owner, and excessive older debt refuses admission.
+    assert!(contract.charge_allocation(COMBINED_BYTES).is_err());
+}
