+#[cfg(feature = "precision-f64")]
+#[test]
+fn coefficients_are_exact_original_f64_bits_at_original_sigma_boundary() {
+    assert_eq!(
+        digest(ORIGINAL_GAUSSIAN.as_bytes()),
+        ORIGINAL_GAUSSIAN_SHA256
+    );
+    let start = ORIGINAL_GAUSSIAN.find("let q = if sigma >=").unwrap();
+    let end = start
+        + ORIGINAL_GAUSSIAN[start..]
+            .find("\n    if horizontal {")
+            .unwrap();
+    let compact = |s: &str| s.chars().filter(|c| !c.is_whitespace()).collect::<String>();
+    let own_source = include_str!("core_tests.rs");
+    let function = own_source.find("fn original_coefficients(sigma:").unwrap();
+    let own_start = function + own_source[function..].find("let q = if sigma >=").unwrap();
+    let own_end = own_start
+        + own_source[own_start..]
+            .find("\n    [a, b1, b2, b3]")
+            .unwrap();
+    assert_eq!(
+        compact(&ORIGINAL_GAUSSIAN[start..end]),
+        compact(&own_source[own_start..own_end])
+    );
+    for sigma in REAL_SIGMA_BITS.into_iter().map(f32::from_bits).chain([
+        3.,
+        f32::from_bits(3f32.to_bits() + 1),
+        10_000.,
+    ]) {
+        let plan = Plan::new(sigma, 17, 1).unwrap();
+        assert_eq!(plan.sigma_bits, sigma.to_bits());
+        assert_eq!(
+            plan.coefficient_bits,
+            original_coefficients(sigma as f64).map(f64::to_bits)
+        );
+        assert_eq!(plan.coefficients().map(f64::to_bits), plan.coefficient_bits);
+        eprintln!(
+            "original coefficient bits: sigma={:#010x}, coefficients={:016x?}",
+            sigma.to_bits(),
+            plan.coefficient_bits
+        );
+    }
+}
+
+#[cfg(feature = "precision-f64")]
+fn fixture(length: usize, kind: usize) -> Vec<u64> {
+    let mut state = 0x0123_4567_89ab_cdefu64;
+    (0..length)
+        .map(|i| {
+            let x = match kind {
+                0 => 1.,
+                1 => {
+                    if i == length / 3 {
+                        16.
+                    } else {
+                        -0.25
+                    }
+                }
+                2 => {
+                    if i == 0 {
+                        16.
+                    } else if i + 1 == length {
+                        -8.
+                    } else {
+                        -0.25
+                    }
+                }
+                3 => {
+                    if i < length / 2 {
+                        -0.75
+                    } else {
+                        1.25
+                    }
+                }
+                4 => i as f64 / length as f64 - 0.5,
+                5 => {
+                    if i % 2 == 0 {
+                        -1.
+                    } else {
+                        1.
+                    }
+                }
+                6 => {
+                    state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+                    (state >> 11) as f64 / 9007199254740992. - 0.5
+                }
+                7 => {
+                    if i % 2 == 0 {
+                        -0.
+                    } else {
+                        0.
+                    }
+                }
+                _ => panic!("unknown fixture"),
+            };
+            x.to_bits()
+        })
+        .collect()
+}
+
+#[cfg(feature = "precision-f64")]
+fn assert_numeric_bits(actual: &[u64], original: &[u64], label: &str) {
+    assert_eq!(actual.len(), original.len());
+    let mut max_abs = 0f64;
+    let mut max_normalized = 0f64;
+    let mut squared = 0f64;
+    let mut worst = 0;
+    let mut zero_sign_differences = 0;
+    let mut bad = Vec::new();
+    for (index, (&a, &r)) in actual.iter().zip(original).enumerate() {
+        let (a_value, r_value) = (f64::from_bits(a), f64::from_bits(r));
+        assert!(a_value.is_finite() && r_value.is_finite());
+        let error = (a_value - r_value).abs();
+        if error > max_abs {
+            max_abs = error;
+            worst = index;
+        }
+        max_normalized = max_normalized.max(error / r_value.abs().max(1.));
+        squared += error * error;
+        if a != r {
+            if a_value == 0. && r_value == 0. {
+                zero_sign_differences += 1;
+            } else if bad.len() < 8 {
+                bad.push((index, a, r));
+            }
+        }
+    }
+    eprintln!(
+        "{label}: samples={}, max_abs={max_abs:e}, max_normalized={max_normalized:e}, rms={:e}, worst={worst}, numeric_zero_sign_differences={zero_sign_differences}, nonzero_bit_mismatches={bad:?}",
+        actual.len(),
+        (squared / actual.len() as f64).sqrt()
+    );
+    assert!(
+        bad.is_empty(),
+        "nonzero finite bits differ for {label}: {bad:?}"
+    );
+}
+
+#[cfg(feature = "precision-f64")]
+#[test]
+fn complete_lines_match_original_precision_f64_with_raw_source_and_storage() {
+    for sigma in REAL_SIGMA_BITS
+        .into_iter()
+        .map(f32::from_bits)
+        .chain([3., f32::from_bits(3f32.to_bits() + 1)])
+    {
+        for length in [1, 2, 3, 17, 6144, 8192, 40000] {
+            let plan = Plan::new(sigma, length, 1).unwrap();
+            for kind in 0..8 {
+                let input = fixture(length as usize, kind);
+                let actual = cpu_reference(&plan, &input).unwrap();
+                let original = original_reference(&plan, &input).unwrap();
+                assert_numeric_bits(
+                    &actual,
+                    &original,
+                    &format!(
+                        "sigma={:08x}, length={length}, fixture={kind}",
+                        sigma.to_bits()
+                    ),
+                );
+                narrow(&actual).unwrap();
+            }
+        }
+    }
+    let input = fixture(17, 6);
+    assert!(
+        input
+            .iter()
+            .any(|&bits| ((f64::from_bits(bits) as f32) as f64).to_bits() != bits),
+        "the raw binary64 test must contain values not representable as f32"
+    );
+}
+
+#[cfg(feature = "precision-f64")]
+#[test]
+fn each_forward_state_matches_original_order_before_backward_initialization() {
+    for sigma in REAL_SIGMA_BITS.into_iter().map(f32::from_bits) {
+        let plan = Plan::new(sigma, 8192, 1).unwrap();
+        let [a, b1, b2, b3] = original_coefficients(sigma as f64);
+        for kind in [0, 1, 4, 5, 6] {
+            let input = fixture(plan.length as usize, kind);
+            let mut state = [input[0]; 3];
+            let mut original_state = [f64::from_bits(input[0]); 3];
+            let mut guard = Guard::default();
+            let mut forward = Vec::new();
+            let mut original_forward = Vec::new();
+            for &bits in &input {
+                let value = guard.step(plan.coefficient_bits, bits, state);
+                assert!(!guard.failed);
+                let expected = a * f64::from_bits(bits)
+                    + b1 * original_state[0]
+                    + b2 * original_state[1]
+                    + b3 * original_state[2];
+                state = [value, state[0], state[1]];
+                original_state = [expected, original_state[0], original_state[1]];
+                forward.push(value);
+                original_forward.push(expected.to_bits());
+            }
+            assert_numeric_bits(
+                &forward,
+                &original_forward,
+                &format!(
+                    "forward diagnostic sigma={:08x}, kind={kind}",
+                    sigma.to_bits()
+                ),
+            );
+            let mut state = [*forward.last().unwrap(); 3];
+            for value in forward.iter_mut().rev() {
+                *value = guard.step(plan.coefficient_bits, *value, state);
+                state = [*value, state[0], state[1]];
+            }
+            assert_numeric_bits(
+                &forward,
+                &original_reference(&plan, &input).unwrap(),
+                "after backward, original public oracle",
+            );
+        }
+    }
+}
+
+#[cfg(feature = "precision-f64")]
+#[test]
+fn whole_line_batch_partition_is_invariant_without_restarts() {
+    for length in [17, 8192, 40000] {
+        let lines = CAPACITY / length;
+        let plan = Plan::new(f32::from_bits(REAL_SIGMA_BITS[2]), length, lines).unwrap();
+        let input = fixture(plan.samples(), 6);
+        let packed = cpu_reference(&plan, &input).unwrap();
+        let partition_samples = length as usize * lines.div_ceil(3) as usize;
+        for (source, expected) in input
+            .chunks(partition_samples)
+            .zip(packed.chunks(partition_samples))
+        {
+            let part = Plan::new(
+                f32::from_bits(plan.sigma_bits),
+                length,
+                (source.len() / length as usize) as u32,
+            )
+            .unwrap();
+            assert_eq!(cpu_reference(&part, source).unwrap(), expected);
+        }
+        assert_numeric_bits(
+            &packed,
+            &original_reference(&plan, &input).unwrap(),
+            &format!("max complete-line batch length={length}, lines={lines}"),
+        );
+    }
+}
