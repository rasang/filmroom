+#[test]
+fn reachable_shader_helpers_are_byte_preserved_and_drift_rejects() {
+    let output = shader().unwrap();
+    let original = functions(soft64::SHADER).unwrap();
+    let emitted = functions(&output).unwrap();
+    assert_eq!(digest(soft64::SHADER.as_bytes()), SOFT64_SHA256);
+    assert_eq!(digest(KERNEL.as_bytes()), KERNEL_SHA256);
+    for name in HELPER_NAMES {
+        assert_eq!(
+            emitted[name], original[name],
+            "modified original arithmetic {name}"
+        );
+    }
+    let retained: BTreeSet<&str> = emitted
+        .keys()
+        .filter(|name| name.starts_with("sf_"))
+        .map(String::as_str)
+        .collect();
+    assert_eq!(retained, HELPER_NAMES.into_iter().collect());
+    let mut reached = BTreeSet::from(["main".to_owned()]);
+    loop {
+        let mut next = reached.clone();
+        for name in &reached {
+            for token in identifiers(emitted[name]) {
+                if original.contains_key(token) {
+                    assert!(emitted.contains_key(token), "missing {token}");
+                }
+                if emitted.contains_key(token) {
+                    next.insert(token.to_owned());
+                }
+            }
+        }
+        if next == reached {
+            break;
+        }
+        reached = next;
+    }
+    assert_eq!(reached, emitted.keys().cloned().collect());
+    for absent in [
+        "sf_div",
+        "sf_sqrt",
+        "sf_log",
+        "sf_exp_nonpositive",
+        "sf_integer",
+        "sf_floor",
+        "sf_sub",
+        "SF_ONE",
+        "SF_TWO",
+        "SF_LN2",
+    ] {
+        assert!(
+            !identifiers(&output).contains(absent),
+            "unneeded dependency {absent}"
+        );
+    }
+    assert!(!output.contains("sf_failed = 0"));
+    assert!(!output.contains("atomicStore"));
+    assert_eq!(emitted["iir_step"].matches("iir_mul(").count(), 4);
+    assert_eq!(emitted["iir_step"].matches("iir_add(").count(), 3);
+    assert!(compose(&(soft64::SHADER.to_owned() + "\n"), KERNEL).is_err());
+    assert!(compose(soft64::SHADER, &(KERNEL.to_owned() + "\n")).is_err());
+    assert!(
+        compose(
+            &soft64::SHADER.replace("return sf_round", "return changed_round"),
+            KERNEL
+        )
+        .is_err()
+    );
+    assert!(
+        compose(
+            soft64::SHADER,
+            &KERNEL.replace("s2 = s1;", "s2 = vec2<u32>(0u);")
+        )
+        .is_err()
+    );
+    assert!(functions("fn duplicate() {} fn duplicate() {}").is_err());
+}
