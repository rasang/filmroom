+#[derive(Clone, Copy)]
+enum Behavior {
+    Echo,
+    HostExact,
+}
+#[derive(Clone, Copy)]
+enum Failure {
+    Error,
+    Short,
+    NaN,
+    Status,
+    Cancel,
+}
+struct HostCompute {
+    behavior: Behavior,
+    calls: usize,
+    poisoned: bool,
+    status_bad: bool,
+    fail: Option<(usize, Failure)>,
+    cancel: Rc<Cell<bool>>,
+    point_jobs: Vec<(Job, usize)>,
+    raw_specs: Vec<LineSpec>,
+    source_mutation: Option<PathBuf>,
+    foreign_output: Option<PathBuf>,
+}
+impl HostCompute {
+    fn new(behavior: Behavior) -> Self {
+        Self {
+            behavior,
+            calls: 0,
+            poisoned: false,
+            status_bad: false,
+            fail: None,
+            cancel: Rc::new(Cell::new(false)),
+            point_jobs: Vec::new(),
+            raw_specs: Vec::new(),
+            source_mutation: None,
+            foreign_output: None,
+        }
+    }
+    fn output(&mut self, mut words: Vec<u64>) -> R<Vec<u64>> {
+        self.calls += 1;
+        if let Some(path) = self.source_mutation.take() {
+            let mut f = OpenOptions::new().write(true).open(path).unwrap();
+            f.write_all(&7.0f64.to_bits().to_le_bytes()).unwrap();
+            f.sync_all().unwrap();
+        }
+        if let Some(path) = self.foreign_output.take() {
+            fs::remove_file(&path).unwrap();
+            let mut f = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(path)
+                .unwrap();
+            f.write_all(b"foreign-output-preserve").unwrap();
+            f.sync_all().unwrap();
+        }
+        if let Some((at, failure)) = self.fail {
+            if self.calls == at {
+                match failure {
+                    Failure::Error => return Err("HOST_INJECTED_COMPUTE_ERROR".into()),
+                    Failure::Short => {
+                        words.pop();
+                    }
+                    Failure::NaN => words[0] = f64::NAN.to_bits(),
+                    Failure::Status => self.status_bad = true,
+                    Failure::Cancel => self.cancel.set(true),
+                }
+            }
+        }
+        Ok(words)
+    }
+}
+impl Compute for HostCompute {
+    fn check_status(&self) -> R<()> {
+        if self.status_bad {
+            Err("HOST_INJECTED_DEVICE_STATUS".into())
+        } else {
+            Ok(())
+        }
+    }
+    fn point(
+        &mut self,
+        cal: &DirCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        cancel: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        self.point_jobs.push((job, values.len()));
+        let result = dir_point::evaluate(cal, job, values, cancel)?;
+        self.output(result)
+    }
+    fn raw(
+        &mut self,
+        spec: &LineSpec,
+        values: &[u64],
+        cancel: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        check(cancel)?;
+        spec.validate_input(values)?;
+        self.raw_specs.push(spec.clone());
+        let result = match self.behavior {
+            Behavior::Echo => values.to_vec(),
+            Behavior::HostExact => {
+                let plan = super::super::Plan::new(
+                    f32::from_bits(spec.sigma_bits),
+                    spec.length,
+                    spec.lines,
+                )?;
+                super::super::cpu_reference(&plan, values)?
+            }
+        };
+        self.output(result)
+    }
+    fn poison(&mut self) {
+        self.poisoned = true;
+    }
+}
+fn execute(p: &DirImagePlan, g: &mut HostCompute) -> R<CandidateReceipt> {
+    let cancel = g.cancel.clone();
+    run(p, g, &mut || cancel.get())
+}
+fn assert_failed_clean(f: &Fixture, p: &DirImagePlan, g: &HostCompute) {
+    assert!(g.poisoned);
+    assert!(!p.paths().candidate_marker.exists());
+    assert!(!p.paths().private_directory.exists());
+    f.assert_sources();
+}
+fn echo_expected(cal: &DirCalibration, input: &[[u64; 3]]) -> Vec<[u64; 3]> {
+    let mut result = vec![[0; 3]; input.len()];
+    for channel in 0..3u32 {
+        let c = dir_point::evaluate(
+            cal,
+            Job {
+                operation: Operation::InitialCorrection,
+                channel,
+                component: 0,
+            },
+            input,
+            &mut || false,
+        )
+        .unwrap();
+        let out = if !cal.dir_active {
+            c
+        } else if f32::from_bits(cal.core_sigma_bits) <= 0. {
+            let rows = input
+                .iter()
+                .zip(&c)
+                .map(|(r, &c)| [r[channel as usize], c, 0])
+                .collect::<Vec<_>>();
+            dir_point::evaluate(
+                cal,
+                Job {
+                    operation: Operation::RedevelopUnfiltered,
+                    channel,
+                    component: 0,
+                },
+                &rows,
+                &mut || false,
+            )
+            .unwrap()
+        } else {
+            let mut a = vec![0; c.len()];
+            for component in 0..3 {
+                let rows = a
+                    .iter()
+                    .zip(&c)
+                    .map(|(&a, &c)| [a, c, 0])
+                    .collect::<Vec<_>>();
+                a = dir_point::evaluate(
+                    cal,
+                    Job {
+                        operation: Operation::TailAccumulate,
+                        channel,
+                        component,
+                    },
+                    &rows,
+                    &mut || false,
+                )
+                .unwrap();
+            }
+            let rows = input
+                .iter()
+                .zip(&c)
+                .zip(&a)
+                .map(|((r, &c), &a)| [r[channel as usize], c, a])
+                .collect::<Vec<_>>();
+            dir_point::evaluate(
+                cal,
+                Job {
+                    operation: Operation::RedevelopFiltered,
+                    channel,
+                    component: 0,
+                },
+                &rows,
+                &mut || false,
+            )
+            .unwrap()
+        };
+        for (row, value) in result.iter_mut().zip(out) {
+            row[channel as usize] = value;
+        }
+    }
+    result
+}
