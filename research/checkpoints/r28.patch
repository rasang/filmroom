+#[test]
+#[cfg(feature = "precision-f64")]
+fn original_initial_coupling_and_filter_points_match_all_channels() {
+    let p = calibration();
+    let values = curve_vectors(&p.initial);
+    for channel in 0..3 {
+        let j = job(Operation::InitialCorrection, channel, 0);
+        assert_words(
+            &evaluate(&p, j, &values, &mut || false).unwrap(),
+            &original(&p, j, &values),
+            "original coupling",
+        );
+    }
+    let values: Vec<_> = (0..1024)
+        .map(|i| {
+            let x = i as f64 / 1023.;
+            [
+                (x * 6. - 3.).to_bits(),
+                (x * 0.7 - 0.03).to_bits(),
+                (x * 0.9 - 0.01).to_bits(),
+            ]
+        })
+        .collect();
+    for channel in 0..3 {
+        let j = job(Operation::RedevelopFiltered, channel, 0);
+        assert_words(
+            &evaluate(&p, j, &values, &mut || false).unwrap(),
+            &original(&p, j, &values),
+            "original redevelopment",
+        );
+    }
+    for component in 0..3 {
+        let j = job(Operation::TailAccumulate, 0, component);
+        assert_words(
+            &evaluate(&p, j, &values, &mut || false).unwrap(),
+            &original(&p, j, &values),
+            "original FIT accumulation",
+        );
+    }
+}
