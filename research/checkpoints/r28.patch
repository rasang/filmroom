+#[test]
+fn redevelopment_gamma_scales_its_own_promoted_f32_axis_and_reciprocals() {
+    let mut pipe = pipeline(false).clone();
+    pipe.params.film_render.density_curve_gamma = 1.3;
+    let actual = DirCalibration::from_pipeline(&pipe, FIXTURE_PITCH, 23, 17).unwrap();
+    let gamma = pipe.params.film_render.density_curve_gamma as f64;
+    let expected_initial: Vec<u64> = pipe
+        .film
+        .log_exposure_f64()
+        .iter()
+        .map(|&x| (x / gamma).to_bits())
+        .collect();
+    let expected_before: Vec<u64> = pipe
+        .film
+        .log_exposure_f32()
+        .iter()
+        .map(|&x| ((x as f64) / gamma).to_bits())
+        .collect();
+    assert_eq!(actual.initial.axis, expected_initial);
+    assert_eq!(actual.before_dir.axis, expected_before);
+    assert_ne!(actual.initial.axis, actual.before_dir.axis);
+    assert_ne!(actual.initial.inverse_dx, actual.before_dir.inverse_dx);
+    for curve in [&actual.initial, &actual.before_dir] {
+        for (i, pair) in curve.axis.windows(2).enumerate() {
+            assert_eq!(
+                curve.inverse_dx[i],
+                (1. / (f64::from_bits(pair[1]) - f64::from_bits(pair[0]))).to_bits()
+            );
+        }
+    }
+    let axes = vec![-2., -0.7, 0.2, 1.9];
+    let values = vec![[0.; 3], [0.3; 3], [1.; 3], [2.; 3]];
+    let near_one = CurveWords::from_original(axes.clone(), values.clone(), 1. + 5e-13).unwrap();
+    assert_eq!(
+        near_one.axis,
+        axes.iter().map(|x| x.to_bits()).collect::<Vec<_>>()
+    );
+    let outside = CurveWords::from_original(axes, values, 1. + 2e-12).unwrap();
+    assert_ne!(near_one.axis, outside.axis);
+    let mut altered = actual.clone();
+    altered.gamma_bits = 1_f32.to_bits();
+    assert!(altered.validate().is_err());
+}
