+            Err(PATH_ERROR.into())
+        }
+        pub fn identity(&self) -> R<Identity> {
+            Err(PATH_ERROR.into())
+        }
+    }
+    pub struct Workspace;
+    impl Workspace {
+        pub fn create(_: &Path, _: u64) -> R<Self> {
+            Err("GPU_DIR64_IMAGE_UNSUPPORTED_FILESYSTEM".into())
+        }
+        pub fn create_file(&mut self, _: &str) -> R<File> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn open_owned_read(&self, _: &str) -> R<File> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn open_owned_write(&self, _: &str) -> R<File> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn verify_owned(&self, _: &str) -> R<()> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn remove_owned(&mut self, _: &str) -> R<()> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn verify_all(&self) -> R<()> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn sync(&self) -> R<()> {
+            Err(PATH_ERROR.into())
+        }
+        pub fn retain(&mut self) {}
+    }
+}
