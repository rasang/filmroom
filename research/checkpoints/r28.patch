+//! Closed experiment only. No production stage or external JSON admission.
+use super::*;
+use crate::research_iir_soft64::dir_derived_mixed as derived;
+use crate::gpu_session_contract::StageTicket;
+use sha2::{Digest,Sha256};
+use serde_json::{Value,json};
+struct Config {
+ output:PathBuf,input:PathBuf,root:PathBuf,
+ exposure:Option<(f64,f64,Option<f32>)>,
+ context:Option<derived::ExperimentContext>,
+ proof:Option<derived::DerivedLogEvidence>,
+ params:Option<RuntimeParams>,
+ reject_before_adopt:bool,rejected:u32,
+}
+static CONFIG:std::sync::Mutex<Option<Config>>=std::sync::Mutex::new(None);
+pub(super) struct Scope;
+impl Drop for Scope {fn drop(&mut self){*CONFIG.lock().unwrap()=None;}}
+fn digest(b:&[u8])->String{format!("{:x}",Sha256::digest(b))}
+pub(super) fn configure(output:PathBuf,input:PathBuf,root:PathBuf)->Scope {
+ assert!(root.is_dir());let mut g=CONFIG.lock().unwrap();assert!(g.is_none());
+ *g=Some(Config{output,input,root,exposure:None,context:None,proof:None,params:None,reject_before_adopt:false,rejected:0});Scope
+}
+pub(super) fn record_exposure(input:&Path,ae:f64,exposure:f64,meter:Option<f32>)->Result<()> {
+ let mut g=CONFIG.lock().unwrap();let Some(c)=g.as_mut().filter(|c|c.input==input)else{return Ok(());};
+ if c.exposure.is_some()||!ae.is_finite()||!exposure.is_finite(){return Err(error("TEST_DERIVED_CONTEXT","Duplicate or nonfinite exposure"));}
+ c.exposure=Some((ae,exposure,meter));Ok(())
+}
+pub(super) fn prepare_context(output:&Path,pipe:&Pipeline,meter:Option<f32>,resume:u8,correction:f64,prefix_adopted:bool)->Result<()> {
+ let mut g=CONFIG.lock().unwrap();let Some(c)=g.as_mut().filter(|c|c.output==output)else{return Ok(());};
+ if resume!=0||!prefix_adopted||c.context.is_some(){return Err(error("TEST_DERIVED_CONTEXT","Expected fresh fully adopted GPU prefix"));}
+ let(ae,exposure,recorded_meter)=c.exposure.ok_or_else(||error("TEST_DERIVED_CONTEXT","Missing actual exposure scalars"))?;
+ if meter.map(f32::to_bits)!=recorded_meter.map(f32::to_bits){return Err(error("TEST_DERIVED_CONTEXT","Meter changed between exposure and log"));}
+ let(profile_sha256,params_sha256)=derived::pipeline_identities(pipe).map_err(|e|error("TEST_DERIVED_CONTEXT",e))?;
+ c.params=Some(pipe.params.clone());
+ c.context=Some(derived::ExperimentContext{
+  build_sha256:digest(&fs::read(std::env::current_exe().map_err(io)?).map_err(io)?),
+  fixture_sha256:digest(&fs::read(&c.input).map_err(io)?),profile_sha256,params_sha256,
+  prefix_records_sha256:"0".repeat(64),actual_metered_ev_bits:meter.map(f32::to_bits),
+  actual_ae_scale_promoted_bits:Some(ae.to_bits()),exposure_compensation_scale_promoted_bits:exposure.to_bits(),
+  effective_exposure_factor_bits:(ae*exposure).to_bits(),log_correction_bits:correction.to_bits(),
+  resume:derived::ExperimentResume::FreshFrame,
+ });Ok(())
+}
+#[cfg(unix)]
+fn free_bytes(path:&Path)->u64 {
+ use std::os::unix::ffi::OsStrExt;
+ let p=std::ffi::CString::new(path.as_os_str().as_bytes()).unwrap();let mut s=std::mem::MaybeUninit::<libc::statvfs>::uninit();
+ assert_eq!(unsafe{libc::statvfs(p.as_ptr(),s.as_mut_ptr())},0);let s=unsafe{s.assume_init()};(s.f_bavail as u64).checked_mul(s.f_frsize as u64).unwrap()
+}
+pub(super) fn observe_native_log(ticket:StageTicket,wire:&Value,sealed:&Value,prefix:&[Value])->Result<()> {
+ if wire["operation"]!="fullExposureLog"{return Ok(());}
+ let mut g=CONFIG.lock().unwrap();let Some(c)=g.as_mut()else{return Ok(());};
+ let mut context=c.context.take().ok_or_else(||error("TEST_DERIVED_CONTEXT","Log without prepared exact-output context"))?;
+ if c.proof.is_some(){return Err(error("TEST_DERIVED_CONTEXT","Duplicate log proof"));}
+ let operations:Vec<_>=prefix.iter().map(|v|v["operation"].as_str().unwrap()).collect();
+ if operations!=["fullAutoExposure","fullFilmExposure","fullHighlightBoost","fullCameraDiffusion","fullFilmOptics"]{return Err(error("TEST_DERIVED_CONTEXT","Unexpected prefix provenance"));}
+ if prefix.iter().any(|v|v["stageSealed"]!=true||v["summary"]["gpuUsed"]!=true){return Err(error("TEST_DERIVED_CONTEXT","Unsealed or nonGPU prefix"));}
+ context.prefix_records_sha256=digest(&serde_json::to_vec(prefix).unwrap());
+ let token=wire["token"].as_u64().unwrap();let dir=Path::new(wire["jobDir"].as_str().unwrap());
+ let plan=crate::research_global::full_stage::plan_stage(dir,token).map_err(|e|error("TEST_DERIVED_PROOF",e))?;
+ assert_eq!(plan.manifest_sha256,wire["manifestSha256"].as_str().unwrap());
+ let check=|t:StageTicket,p:&crate::research_global::full_stage::StagePlan,s:&Value,cx:derived::ExperimentContext|derived::DerivedLogEvidence::from_verified_stage(t,token,dir,p,s,cx,&mut ||false);
+ // Real successful stage, wrong witnesses. None of these can mint provenance.
+ let mut stale=ticket;stale.sequence+=1;assert!(check(stale,&plan,sealed,context.clone()).is_err());
+ let mut bad_plan=plan.clone();bad_plan.manifest_sha256="0".repeat(64);assert!(check(ticket,&bad_plan,sealed,context.clone()).is_err());
+ let mut bad_seal=sealed.clone();bad_seal["stageSealed"]=json!(false);assert!(check(ticket,&plan,&bad_seal,context.clone()).is_err());
+ let mut bad_context=context.clone();bad_context.log_correction_bits=(f64::from_bits(context.log_correction_bits)*2.).to_bits();assert!(check(ticket,&plan,sealed,bad_context).is_err());
+ let proof=check(ticket,&plan,sealed,context.clone()).map_err(|e|error("TEST_DERIVED_PROOF",e))?;
+ let budget=derived::DerivedMixedBudget::for_evidence(&proof).map_err(|e|error("TEST_DERIVED_BUDGET",e))?;
+ if free_bytes(&c.root)<budget.minimum_required_available_before_copy_bytes{return Err(error("TEST_DERIVED_BUDGET","Insufficient actual free space before private copies"));}
+ let record=json!({"testOnly":true,"actualNativeSeal":sealed,"expectedPlan":plan,"context":context,
+ "proofIdentity":proof.identity().unwrap(),"producerOutputHashes":proof.output_hashes(),"negativeWitnessesRejected":4,
+ "freshGraphBytesNotCumulative":budget.fresh_combined_bytes,"beforeCopyRequiredFree":budget.minimum_required_available_before_copy_bytes});
+ fs::write(c.root.join("authenticated-log.json"),serde_json::to_vec_pretty(&record).unwrap()).map_err(io)?;
+ c.proof=Some(proof);Ok(())
+}
+pub(super) fn take(output:&Path)->(derived::DerivedLogEvidence,RuntimeParams) {
+ let mut g=CONFIG.lock().unwrap();let c=g.as_mut().expect("scope");assert_eq!(c.output,output);
