+/// A constructor-only derived receipt. Its private storage shares the checked
+/// scheduler's fields, not the original receipt's admission or Deserialize path.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub(super) struct DerivedMixedGraphReceipt(CandidateReceiptV2);
+impl DerivedMixedGraphReceipt {
+    pub(super) fn validate_for_plan(&self, plan: &DerivedMixedGraphPlan) -> R<()> {
+        self.0
+            .validate_for_plan_policy(&plan.0, InputPolicy::DerivedGpuF32Mixed)
+    }
+    pub(super) fn into_candidate_parts(
+        self,
+        plan: &DerivedMixedGraphPlan,
+    ) -> R<DerivedMixedCandidateParts> {
+        self.validate_for_plan(plan)?;
+        Ok(self.0.into_derived_parts())
+    }
+}
+
+pub(super) fn run_derived_mixed_graph<G: Compute>(
+    plan: &DerivedMixedGraphPlan,
+    gpu: &mut G,
+    cancelled: &mut impl FnMut() -> bool,
+) -> R<DerivedMixedGraphReceipt> {
+    let result = run_inner(
+        &plan.0,
+        gpu,
+        cancelled,
+        None,
+        InputPolicy::DerivedGpuF32Mixed,
+    )
+    .map(DerivedMixedGraphReceipt);
+    if result.is_err() {
+        gpu.poison();
+    }
+    result
+}
