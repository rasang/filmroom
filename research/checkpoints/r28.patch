+//! Closed DIR point arithmetic probe. This is not a source-file or stage route.
+//! Complete calibrated word tables remain distinct from image input provenance.
+use super::dir_calibration::{CurveWords, DirCalibration};
+use super::dir_mixed_calibration::DirMixedCalibration;
+use super::{Guard, R, admitted, soft64};
+use std::cmp::Ordering;
+
+pub(super) const PREFIX_WORDS: usize = 65_536; // 512 KiB, inside the 4 MiB input.
+pub(super) const HEADER_WORDS: usize = 64;
+pub(super) const POINT_CAPACITY: usize = 65_536;
+pub(super) const PACKET_CAPACITY: usize = super::CAPACITY as usize;
+pub(super) const ERROR: &str = "GPU_DIR64_POINT_DESCRIPTOR";
+pub(super) const DOMAIN_ERROR: &str = "GPU_DIR64_POINT_NUMERIC_DOMAIN";
+
+/// Fixed closed operations, not arbitrary user-provided programs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub(super) enum Operation {
+    InitialCurve = 1,
+    BeforeCurve = 2,
+    InitialCorrection = 3,
+    TailAccumulate = 4,
+    RedevelopFiltered = 5,
+    RedevelopUnfiltered = 6,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Job {
+    pub operation: Operation,
+    pub channel: u32,
+    pub component: u32,
+}
+impl Job {
+    pub(super) fn validate(&self, p: &DirCalibration) -> R<()> {
+        self.validate_flags(p.dir_active, p.core_sigma_bits)
+    }
+    pub(super) fn validate_mixed(&self, p: &DirMixedCalibration) -> R<()> {
+        p.validate()?;
+        self.validate_flags(p.dir_active, p.core_sigma_bits)
+    }
+    fn validate_flags(&self, dir_active: bool, core_sigma_bits: u32) -> R<()> {
+        if self.channel >= 3
+            || self.component >= 3
+            || (self.operation != Operation::TailAccumulate && self.component != 0)
+        {
+            return Err(ERROR.into());
+        }
+        let filtered = dir_active && f32::from_bits(core_sigma_bits) > 0.;
+        match self.operation {
+            Operation::TailAccumulate | Operation::RedevelopFiltered if !filtered => {
+                return Err(ERROR.into());
+            }
+            Operation::RedevelopUnfiltered if !dir_active || filtered => {
+                return Err(ERROR.into());
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+}
+
+// Opaque borrowed point fields. Only these two constructors can create a view,
+// and both validate the complete calibration identity first. No mutable table,
+// unchecked JSON view, or made-up IIR calibration can enter the new path.
+struct PointView<'a> {
+    dir_active: bool,
+    positive: bool,
+    core_sigma_bits: u32,
+    tail_weight_bits: u64,
+    matrix_bits: [[u64; 3]; 3],
+    density_max_bits: [u64; 3],
+    initial: &'a CurveWords,
+    before_dir: &'a CurveWords,
+}
+impl<'a> PointView<'a> {
+    fn legacy(p: &'a DirCalibration) -> R<Self> {
+        p.validate()?;
+        Ok(Self {
+            dir_active: p.dir_active,
+            positive: p.positive,
+            core_sigma_bits: p.core_sigma_bits,
+            tail_weight_bits: p.tail_weight_bits,
+            matrix_bits: p.matrix_bits,
+            density_max_bits: p.density_max_bits,
+            initial: &p.initial,
+            before_dir: &p.before_dir,
+        })
+    }
+    fn mixed(p: &'a DirMixedCalibration) -> R<Self> {
+        p.validate()?;
+        Ok(Self {
+            dir_active: p.dir_active,
+            positive: p.positive,
+            core_sigma_bits: p.core_sigma_bits,
+            tail_weight_bits: p.tail_weight_bits,
+            matrix_bits: p.matrix_bits,
+            density_max_bits: p.density_max_bits,
+            initial: &p.initial,
+            before_dir: &p.before_dir,
+        })
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct Packet {
+    pub job: Job,
+    pub count: u32,
+    pub words: Vec<u64>,
+    pub parameters: [u32; 16],
+}
+impl Packet {
+    pub(super) fn new(p: &DirCalibration, job: Job, values: &[[u64; 3]]) -> R<Self> {
+        Self::pack(&PointView::legacy(p)?, job, values)
+    }
+    pub(super) fn new_mixed(p: &DirMixedCalibration, job: Job, values: &[[u64; 3]]) -> R<Self> {
+        Self::pack(&PointView::mixed(p)?, job, values)
+    }
+    fn pack(p: &PointView<'_>, job: Job, values: &[[u64; 3]]) -> R<Self> {
+        job.validate_flags(p.dir_active, p.core_sigma_bits)?;
+        if values.is_empty()
+            || values.len() > POINT_CAPACITY
+            || values.iter().flatten().any(|&x| !admitted(x))
+        {
+            return Err(DOMAIN_ERROR.into());
+        }
+        let initial = HEADER_WORDS;
+        let before = initial + 5 * p.initial.axis.len();
+        let end = before + 5 * p.before_dir.axis.len();
+        let payload = values.len().checked_mul(3).ok_or(ERROR)?;
+        let total = PREFIX_WORDS.checked_add(payload).ok_or(ERROR)?;
+        if end > PREFIX_WORDS || total > PACKET_CAPACITY {
+            return Err(ERROR.into());
+        }
+        let mut words = vec![0; total];
+        for row in 0..3 {
+            words[row * 3..row * 3 + 3].copy_from_slice(&p.matrix_bits[row]);
+        }
+        words[9..12].copy_from_slice(&p.density_max_bits);
+        words[12] = p.tail_weight_bits;
+        for (i, (amplitude, _)) in crate::research_spatial::FIT.into_iter().enumerate() {
+            words[13 + i] = amplitude.to_bits();
+        }
+        pack_curve(&mut words, initial, &p.initial);
+        pack_curve(&mut words, before, &p.before_dir);
+        for (i, value) in values.iter().enumerate() {
+            words[PREFIX_WORDS + 3 * i..PREFIX_WORDS + 3 * i + 3].copy_from_slice(value);
+        }
+        let parameters = [
+            job.operation as u32,
+            values.len() as u32,
+            job.channel,
+            job.component,
+            p.initial.axis.len() as u32,
+            p.before_dir.axis.len() as u32,
+            u32::from(p.positive),
+            u32::from(p.dir_active),
+            initial as u32,
+            before as u32,
+            PREFIX_WORDS as u32,
+            u32::from(p.dir_active && f32::from_bits(p.core_sigma_bits) > 0.),
+            end as u32,
+            payload as u32,
+            0,
+            0,
+        ];
+        Ok(Self {
+            job,
+            count: values.len() as u32,
+            words,
+            parameters,
+        })
+    }
+    pub(super) fn invocations(&self) -> u32 {
+        self.parameters[12].max(self.parameters[13]).max(self.count)
+    }
+}
+fn pack_curve(out: &mut [u64], base: usize, c: &CurveWords) {
+    let n = c.axis.len();
+    out[base..base + n].copy_from_slice(&c.axis);
+    out[base + n..base + 2 * n - 1].copy_from_slice(&c.inverse_dx);
+    // The unused last reciprocal stays explicit positive zero.
+    for (i, row) in c.values.iter().enumerate() {
+        out[base + 2 * n + 3 * i..base + 2 * n + 3 * i + 3].copy_from_slice(row);
+    }
+}
+fn subtract(g: &mut Guard, a: u64, b: u64) -> u64 {
+    g.operation(a, b, soft64::sub)
+}
+fn compare(g: &mut Guard, a: u64, b: u64) -> Option<Ordering> {
+    if !g.accept(a) || !g.accept(b) {
+        return None;
+    }
+    let result = soft64::cmp(a, b);
+    g.failed |= result.is_none();
+    result
+}
+fn interpolate(g: &mut Guard, c: &CurveWords, channel: usize, x: u64) -> u64 {
+    let n = c.axis.len();
+    if compare(g, x, c.axis[0]).is_some_and(|v| v.is_le()) {
+        return c.values[0][channel];
+    }
+    if compare(g, x, c.axis[n - 1]).is_some_and(|v| v.is_ge()) {
+        return c.values[n - 1][channel];
+    }
+    // Original partition_point(v <= x), not a uniform-grid assumption.
+    let (mut left, mut right) = (0, n);
+    while left < right {
+        let middle = left + (right - left) / 2;
+        match compare(g, c.axis[middle], x) {
+            Some(v) if v.is_le() => left = middle + 1,
+            Some(_) => right = middle,
+            None => return soft64::NAN,
+        }
+    }
+    if g.failed || left == 0 || left >= n {
+        g.failed = true;
+        return soft64::NAN;
+    }
+    let low = left - 1;
+    let delta_x = subtract(g, x, c.axis[low]);
+    let t = g.mul(delta_x, c.inverse_dx[low]);
+    let delta_y = subtract(g, c.values[low + 1][channel], c.values[low][channel]);
+    let weighted = g.mul(t, delta_y);
+    g.add(c.values[low][channel], weighted)
+}
+fn evaluate_inner(p: &PointView<'_>, job: Job, input: [u64; 3]) -> R<u64> {
+    let mut g = Guard::default();
+    for value in input {
+        g.accept(value);
+    }
+    let ch = job.channel as usize;
+    let result = match job.operation {
+        Operation::InitialCurve => interpolate(&mut g, &p.initial, ch, input[ch]),
+        Operation::BeforeCurve => interpolate(&mut g, &p.before_dir, ch, input[ch]),
+        Operation::InitialCorrection => {
+            let mut density = [0; 3];
+            for i in 0..3 {
+                density[i] = interpolate(&mut g, &p.initial, i, input[i]);
+                if p.dir_active && p.positive {
+                    density[i] = subtract(&mut g, p.density_max_bits[i], density[i]);
+                }
+            }
+            if p.dir_active {
+                let p0 = g.mul(density[0], p.matrix_bits[0][ch]);
+                let p1 = g.mul(density[1], p.matrix_bits[1][ch]);
+                let t0 = g.add(p0, p1);
+                let p2 = g.mul(density[2], p.matrix_bits[2][ch]);
+                g.add(t0, p2)
+            } else {
+                density[ch]
+            }
+        }
+        Operation::TailAccumulate => {
+            let amplitude = crate::research_spatial::FIT[job.component as usize]
+                .0
+                .to_bits();
+            let weighted = g.mul(amplitude, input[1]);
+            g.add(input[0], weighted)
+        }
+        Operation::RedevelopFiltered => {
+            let core_weight = subtract(&mut g, 1f64.to_bits(), p.tail_weight_bits);
+            let core = g.mul(core_weight, input[1]);
+            let tail = g.mul(p.tail_weight_bits, input[2]);
+            let correction = g.add(core, tail);
+            let log = subtract(&mut g, input[0], correction);
+            interpolate(&mut g, &p.before_dir, ch, log)
+        }
+        Operation::RedevelopUnfiltered => {
+            let log = subtract(&mut g, input[0], input[1]);
+            interpolate(&mut g, &p.before_dir, ch, log)
+        }
+    };
+    if !g.accept(result) {
+        Err(DOMAIN_ERROR.into())
+    } else {
+        Ok(result)
+    }
+}
+/// Host mirror for isolated arithmetic gates, not an image fallback.
+pub(super) fn evaluate(
+    p: &DirCalibration,
+    job: Job,
+    values: &[[u64; 3]],
+    cancelled: &mut impl FnMut() -> bool,
+) -> R<Vec<u64>> {
+    evaluate_view(&PointView::legacy(p)?, job, values, cancelled)
+}
+/// Separate mixed-calibration host oracle entry. Never a GPU image fallback.
+pub(super) fn evaluate_mixed(
+    p: &DirMixedCalibration,
+    job: Job,
+    values: &[[u64; 3]],
+    cancelled: &mut impl FnMut() -> bool,
+) -> R<Vec<u64>> {
+    evaluate_view(&PointView::mixed(p)?, job, values, cancelled)
+}
+fn evaluate_view(
+    p: &PointView<'_>,
+    job: Job,
+    values: &[[u64; 3]],
+    cancelled: &mut impl FnMut() -> bool,
+) -> R<Vec<u64>> {
+    job.validate_flags(p.dir_active, p.core_sigma_bits)?;
+    if values.is_empty() || values.len() > POINT_CAPACITY {
+        return Err(ERROR.into());
+    }
+    if cancelled() {
+        return Err("GPU_DIR64_POINT_CANCELLED".into());
+    }
+    let mut output = Vec::with_capacity(values.len());
+    for (i, &value) in values.iter().enumerate() {
+        if i % 256 == 0 && cancelled() {
+            return Err("GPU_DIR64_POINT_CANCELLED".into());
+        }
+        output.push(evaluate_inner(p, job, value)?);
+    }
+    if cancelled() {
+        return Err("GPU_DIR64_POINT_CANCELLED".into());
+    }
+    Ok(output)
+}
