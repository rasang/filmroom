+#[test]
+#[ignore = "Fresh process, precision-f64: full original Portra DIR graph with forced batches then bulk, source from original expose; 900s supervisor, internal 5s unchanged"]
+fn actual_dir64_file_graph_forced_batches_original_expose_and_warm_reuse() {
+    let f = Fixture::new(oracle::pipeline(), 13, 17);
+    activate(95601);
+    let mut old_stats: Option<session::SessionStats> = None;
+    let mut old_output = None;
+    for (generation, points, lines) in [(1, 11, 17), (2, 65_536, 524_288)] {
+        let p = f.plan(&format!("candidate-{generation}"), points, lines);
+        let ticket = begin(95601, generation);
+        let mut gpu = DirGpu::new(&mut || false).unwrap();
+        let r = dir_files::run(&p, &mut gpu, &mut || false).unwrap();
+        assert_eq!(r.temporary_plane_highwater, 5);
+        assert_eq!(r.temporary_byte_highwater, 40 * p.samples());
+        assert_eq!(gpu.metrics.point_dispatches, r.point_batches);
+        assert_eq!(gpu.metrics.raw_dispatches, r.row_batches + r.column_batches);
+        let actual = f.verify(&p, &r);
+        if let Some(ref previous) = old_output {
+            assert_eq!(&actual, previous);
+        }
+        old_output = Some(actual);
+        let stats = finish(ticket, gpu);
+        if let Some(previous) = old_stats {
+            assert_eq!(stats.pool_bytes, previous.pool_bytes);
+            assert_eq!(stats.charged_bytes, previous.charged_bytes);
+            assert_eq!(stats.pipeline_hits - previous.pipeline_hits, 2);
+            assert!(stats.buffer_hits > previous.buffer_hits);
+        }
+        old_stats = Some(stats);
+        fs::remove_dir_all(&p.paths().private_directory).unwrap();
+    }
+}
