+    assert_eq!(plan.samples(), CAPACITY as usize);
+    assert_eq!(CAPACITY as u64 * 8, BATCH_BYTES);
+    assert_eq!(CAPACITY as u64 * 4, F32_BYTES);
+    assert_eq!(DEVICE_BYTES, 20 * MIB + 65_536);
+    assert_eq!(DEVICE_BYTES - BATCH_BYTES, 16 * MIB + 65_536);
+    assert_eq!(READBACK_BYTES, 6 * MIB);
+    assert_eq!(HOST_BYTES, 64 * MIB);
+    assert_eq!(PIPELINE_BYTES, 8 * MIB);
+    assert_eq!(BOUND.to_bits(), 0x430c_6bf5_2000_0000);
+    assert!(BOUND < 1e15f64);
+    let words = plan.words();
+    assert_eq!(std::mem::size_of_val(&words), 64);
+    assert_eq!(words[..4], [8192, 64, CAPACITY, 0]);
