+#[test]
+fn late_device_errors_before_marker_and_retain_remove_owned_candidates() {
+    struct LateError {
+        status_calls: Cell<usize>,
+        fail_at: usize,
+    }
+    impl Compute for LateError {
+        fn check_status(&self) -> R<()> {
+            let call = self.status_calls.get();
+            self.status_calls.set(call + 1);
+            if call == self.fail_at {
+                Err("GPU_DEVICE_FAILED".into())
+            } else {
+                Ok(())
+            }
+        }
+        fn execute(
+            &mut self,
+            _: &LineSpec,
+            values: &[u64],
+            _: &mut impl FnMut() -> bool,
+        ) -> R<Vec<u64>> {
+            Ok(values.to_vec())
+        }
+    }
+    let fixture = Fixture::new(&pattern(17, 31));
+    let p = fixture.plan(17, 31, CAPACITY, "private");
+    let mut count = LateError {
+        status_calls: Cell::new(0),
+        fail_at: usize::MAX,
+    };
+    run(&p, &mut count, &mut || false).unwrap();
+    fs::remove_dir_all(&p.paths().private_directory).unwrap();
+    for fail_at in 0..count.status_calls.get() {
+        let mut gpu = LateError {
+            status_calls: Cell::new(0),
+            fail_at,
+        };
+        assert_eq!(
+            run(&p, &mut gpu, &mut || false).unwrap_err(),
+            "GPU_DEVICE_FAILED"
+        );
+        assert!(!p.paths().private_directory.exists());
+    }
+}
