+fn original_raw(spec: &LineSpec, words: &[u64]) -> Vec<u64> {
+    assert!(cfg!(feature = "precision-f64"));
+    let values: Vec<_> = words
+        .iter()
+        .map(|&x| f64::from_bits(x) as spektrafilm_math::precision::Scalar)
+        .collect();
+    let mut output = vec![0. as spektrafilm_math::precision::Scalar; values.len()];
+    spektrafilm_math::gaussian::gaussian_blur_rows(
+        &values,
+        &mut output,
+        spec.length as usize,
+        f32::from_bits(spec.sigma_bits),
+    );
+    output.into_iter().map(|x| (x as f64).to_bits()).collect()
+}
+#[test]
+#[ignore = "Fresh process, precision-f64: one real Context alternates point/raw at all 4 original sigmas; exact pool/two families reuse across frames"]
+fn actual_dir64_point_raw_alternation_reuses_context_pool_and_families() {
+    let epoch = 95503;
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 2).unwrap();
+    let p = oracle::calibration();
+    let coefficients = p.coefficient_bits.unwrap();
+    let sigmas = [
+        p.core_sigma_bits,
+        p.tail_sigma_bits[0],
+        p.tail_sigma_bits[1],
+        p.tail_sigma_bits[2],
+    ];
+    let mut previous_stats: Option<session::SessionStats> = None;
+    for generation in 1..=2 {
+        let ticket = begin(epoch, generation);
+        let mut gpu = DirGpu::new(&mut || false).unwrap();
+        // A second live Context is refused rather than silently created.
+        assert!(session::Context::acquire(MAP_BYTES, 3, true).is_err());
+        let mut expected_upload = 0;
+        let mut expected_readback = 0;
+        for repeat in 0..2 {
+            for (index, &sigma_bits) in sigmas.iter().enumerate() {
+                let points: Vec<_> = (0..31)
+                    .map(|i| {
+                        let x = (i as f64 - 15.) / 7. + repeat as f64 / 19.;
+                        [
+                            x.to_bits(),
+                            (x + 0.03125).to_bits(),
+                            (x - 0.046875).to_bits(),
+                        ]
+                    })
+                    .collect();
+                let j = job(Operation::InitialCorrection, (index % 3) as u32, 0);
+                let actual = gpu.point(&p, j, &points, &mut || false).unwrap();
+                oracle::assert_words(
+                    &actual,
+                    &oracle::original(&p, j, &points),
+                    "alternating point",
+                );
+                expected_upload += ((PREFIX_WORDS + 3 * points.len()) * 8 + 64) as u64;
+                expected_readback += points.len() as u64 * 8 + 4;
+                let spec = LineSpec {
+                    length: 17,
+                    lines: 3,
+                    sigma_bits,
+                    coefficient_bits: coefficients[index],
+                };
+                let source: Vec<_> = (0..spec.sample_count())
+                    .map(|i| (((i * 17 % 31) as f64 - 15.) / 23. + 2f64.powi(-40)).to_bits())
+                    .collect();
+                let result = gpu.raw(&spec, &source, &mut || false).unwrap();
+                oracle::assert_words(
+                    &result,
+                    &original_raw(&spec, &source),
+                    "alternating original raw IIR",
+                );
+                expected_upload += source.len() as u64 * 8 + 64;
+                expected_readback += source.len() as u64 * 8 + 4;
+            }
+        }
+        assert_eq!(gpu.metrics.point_dispatches, 8);
+        assert_eq!(gpu.metrics.raw_dispatches, 8);
+        assert_eq!(gpu.metrics.upload_bytes, expected_upload);
+        assert_eq!(gpu.metrics.readback_bytes, expected_readback);
+        let stats = finish(ticket, gpu);
+        if let Some(previous) = previous_stats {
+            assert_eq!(
+                stats.charged_bytes, previous.charged_bytes,
+                "retained debt is not refunded or double charged"
+            );
+            assert_eq!(stats.pipeline_hits - previous.pipeline_hits, 2);
+            assert_eq!(stats.buffer_hits - previous.buffer_hits, 20);
+            assert_eq!(stats.pool_bytes, previous.pool_bytes);
+            assert_eq!(stats.clear_submissions - previous.clear_submissions, 4);
+        }
+        previous_stats = Some(stats);
+    }
+}
