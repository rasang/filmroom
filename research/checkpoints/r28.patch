+use super::*;
+use spektrafilm_core::{params::RuntimeParams, pipeline::Pipeline, profile::load_profile_by_name};
+use spektrafilm_math::{
+    image::ImageBuf,
+    precision::{from_f64, to_f64},
+};
+
+pub(crate) fn pipeline_named(film: &str) -> Pipeline {
+    let data = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
+    Pipeline::new_with_spectral(
+        load_profile_by_name(&data, film).unwrap(),
+        load_profile_by_name(&data, "kodak_portra_endura").unwrap(),
+        RuntimeParams::default(),
+        &data,
+    )
+    .unwrap()
+}
+pub(crate) fn pipeline() -> Pipeline {
+    pipeline_named("kodak_portra_400")
+}
+pub(crate) fn calibration() -> DirCalibration {
+    DirCalibration::from_pipeline(&pipeline(), 36_000. / 8192., 8192, 6144).unwrap()
+}
+fn job(operation: Operation, channel: u32, component: u32) -> Job {
+    Job {
+        operation,
+        channel,
+        component,
+    }
+}
+fn image(values: &[[f64; 3]]) -> ImageBuf {
+    ImageBuf::from_data(
+        values.len() as u32,
+        1,
+        values.iter().flatten().map(|&x| from_f64(x)).collect(),
+    )
+}
+fn original_curve(c: &CurveWords, values: &[[f64; 3]]) -> ImageBuf {
+    let axis: Vec<_> = c.axis.iter().map(|&x| f64::from_bits(x)).collect();
+    let rows: Vec<_> = c.values.iter().map(|r| r.map(f64::from_bits)).collect();
+    // The actual original math function, not the f32 research cpu_mirror.
+    spektrafilm_math::interp::fast_interp_image_f64(&image(values), &axis, &rows)
+}
+pub(crate) fn original(p: &DirCalibration, j: Job, words: &[[u64; 3]]) -> Vec<u64> {
+    assert!(
+        cfg!(feature = "precision-f64"),
+        "original binary64 oracle requires precision-f64"
+    );
+    let values: Vec<_> = words.iter().map(|r| r.map(f64::from_bits)).collect();
+    let c = j.channel as usize;
+    match j.operation {
+        Operation::InitialCurve | Operation::BeforeCurve => {
+            let curve = if j.operation == Operation::InitialCurve {
+                &p.initial
+            } else {
+                &p.before_dir
+            };
+            let out = original_curve(curve, &values);
+            out.data
+                .chunks_exact(3)
+                .map(|r| to_f64(r[c]).to_bits())
+                .collect()
+        }
+        Operation::InitialCorrection => {
+            let density = original_curve(&p.initial, &values);
+            if !p.dir_active {
+                return density
+                    .data
+                    .chunks_exact(3)
+                    .map(|r| to_f64(r[c]).to_bits())
+                    .collect();
+            }
+            let zeros = ImageBuf::new(values.len() as u32, 1);
+            let out = spektrafilm_model::couplers::compute_exposure_correction(
+                &zeros,
+                &density,
+                p.density_max_bits.map(f64::from_bits),
+                &p.matrix_bits.map(|r| r.map(f64::from_bits)),
+                0.,
+                0.,
+                f64::from_bits(p.tail_weight_bits),
+                p.positive,
+                &spektrafilm_gpu::cpu_backend::CpuBackend,
+            );
+            // Original method outputs log-correction; with zero log, undo only sign.
+            out.data
+                .chunks_exact(3)
+                .map(|r| (-to_f64(r[c])).to_bits())
+                .collect()
+        }
+        Operation::TailAccumulate => values
+            .iter()
+            .map(|r| {
+                let weighted = crate::research_spatial::FIT[j.component as usize].0 * r[1];
+                (r[0] + weighted).to_bits()
+            })
+            .collect(),
+        Operation::RedevelopFiltered | Operation::RedevelopUnfiltered => {
+            let weight = f64::from_bits(p.tail_weight_bits);
+            let corrected: Vec<_> = values
+                .iter()
+                .map(|r| {
+                    let correction = if j.operation == Operation::RedevelopFiltered {
+                        (1. - weight) * r[1] + weight * r[2]
+                    } else {
+                        r[1]
+                    };
+                    [r[0] - correction; 3]
+                })
+                .collect();
+            let out = original_curve(&p.before_dir, &corrected);
+            out.data
+                .chunks_exact(3)
+                .map(|r| to_f64(r[c]).to_bits())
+                .collect()
+        }
+    }
+}
+pub(crate) fn assert_words(actual: &[u64], expected: &[u64], label: &str) -> usize {
+    assert_eq!(actual.len(), expected.len());
+    let mut zero_signs = 0;
+    for (i, (&a, &e)) in actual.iter().zip(expected).enumerate() {
+        if a << 1 == 0 && e << 1 == 0 {
+            zero_signs += usize::from(a != e);
+        } else {
+            assert_eq!(
+                a,
+                e,
+                "{label}: nonzero mismatch at {i}: actual={} expected={}",
+                f64::from_bits(a),
+                f64::from_bits(e)
+            );
+        }
+    }
+    zero_signs
+}
+pub(crate) fn curve_vectors(c: &CurveWords) -> Vec<[u64; 3]> {
+    let mut result = Vec::new();
+    for &bits in &c.axis {
+        let x = f64::from_bits(bits);
+        // Both adjacent binary64 values around each original scaled axis knot.
+        for value in [x.next_down(), x, x.next_up()] {
+            result.push([value.to_bits(); 3]);
+        }
+    }
+    let low = f64::from_bits(c.axis[0]);
+    let high = f64::from_bits(*c.axis.last().unwrap());
+    for i in 0..=257 {
+        let x = low - 1. + (high - low + 2.) * i as f64 / 257.;
+        result.push([
+            x.to_bits(),
+            (x + 0.03125).to_bits(),
+            (x - 0.046875).to_bits(),
+        ]);
+    }
+    result
+}
