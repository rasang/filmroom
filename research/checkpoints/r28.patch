+fn spatial_count(gpu: &MixedDirGpu) -> u64 {
+    gpu.metrics.iir_dispatches + gpu.metrics.fir_dispatches + gpu.metrics.identity_dispatches
+}
+fn metric_match(gpu: &MixedDirGpu, r: &CandidateReceipt) {
+    assert_eq!(gpu.metrics.point_dispatches, r.point_batches);
+    assert_eq!(spatial_count(gpu), r.row_batches + r.column_batches);
+    assert_eq!(
+        gpu.metrics.iir_dispatches,
+        r.iir_row_batches + r.iir_column_batches
