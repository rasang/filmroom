+            serde_json::from_slice(&fs::read(&parts.candidate_marker).unwrap()).unwrap();
+        assert_eq!(marker["operation"], OPERATION);
+        assert_eq!(marker["status"], STATUS);
+        assert!(serde_json::from_value::<dir_mixed_files::CandidateReceiptV2>(marker).is_err());
+        assert_eq!(parts.temporary_planes_remaining, 0);
+        assert!(!host.poisoned);
+        f.intact();
+    }
+}
