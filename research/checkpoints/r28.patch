+#[test]
+#[cfg(feature = "precision-f64")]
+fn original_two_gamma_curves_match_every_knot_and_neighbor() {
+    let mut pipe = pipeline();
+    for gamma in [1., 0.73, 1.27] {
+        pipe.params.film_render.density_curve_gamma = gamma;
+        let p = DirCalibration::from_pipeline(&pipe, 36_000. / 8192., 8192, 6144).unwrap();
+        for (operation, curve) in [
+            (Operation::InitialCurve, &p.initial),
+            (Operation::BeforeCurve, &p.before_dir),
+        ] {
+            let values = curve_vectors(curve);
+            for channel in 0..3 {
+                let j = job(operation, channel, 0);
+                let actual = evaluate(&p, j, &values, &mut || false).unwrap();
+                let zero = assert_words(&actual, &original(&p, j, &values), "original curve");
+                eprintln!(
+                    "DIR64 point curve={operation:?} gamma={gamma} channel={channel} comparisons={} zero_sign_differences={zero}",
+                    values.len()
+                );
+            }
+        }
+    }
+}
