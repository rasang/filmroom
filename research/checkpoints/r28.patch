+fn image_values(width: u32, height: u32, kind: u32) -> Vec<u64> {
+    (0..u64::from(width) * u64::from(height))
+        .map(|i| {
+            let x = i % u64::from(width);
+            let y = i / u64::from(width);
+            let value = match kind {
+                0 => 1. + 2f64.powi(-40),
+                1 => {
+                    if (x == 0 && y == 0)
+                        || (x == u64::from(width / 3) && y == u64::from(height / 3))
+                    {
+                        16. + 2f64.powi(-32)
+                    } else {
+                        -0.25 + 2f64.powi(-41)
+                    }
+                }
+                2 => {
+                    (if x < u64::from(width / 2) { -1. } else { 1. })
+                        + (((x * 17 + y * 13) % 37) as f64 - 18.) / 37.
+                }
+                _ => (1. + ((x * 11 + y * 7) % 13) as f64 / 13.) * 1e-40,
+            };
+            value.to_bits()
+        })
+        .collect()
+}
+fn original_2d(width: u32, height: u32, sigma_bits: u32, source: &[u64]) -> Vec<u64> {
+    assert!(
+        cfg!(feature = "precision-f64"),
+        "original full f64 two-axis oracle required"
+    );
+    let input: Vec<_> = source
+        .iter()
+        .map(|x| f64::from_bits(*x) as spektrafilm_math::precision::Scalar)
+        .collect();
+    spektrafilm_math::gaussian::gaussian_blur_channel(
+        &input,
+        width,
+        height,
+        f32::from_bits(sigma_bits),
+    )
+    .into_iter()
+    .map(|x| (x as f64).to_bits())
+    .collect()
+}
+fn assert_words_match(expected: &[u64], actual: &[u64]) {
+    assert_eq!(actual.len(), expected.len());
+    let mut zero_sign_differences = 0;
+    for (i, (&expected, &actual)) in expected.iter().zip(actual).enumerate() {
+        assert!(
+            admitted(expected) && admitted(actual),
+            "invalid result at {i}"
+        );
+        if f64::from_bits(expected) == 0. && f64::from_bits(actual) == 0. {
+            zero_sign_differences += usize::from(expected != actual);
+        } else {
+            assert_eq!(actual, expected, "full 2D nonzero word mismatch at {i}");
+        }
+    }
+    eprintln!(
+        "raw64 2D full nonzero bits match, samples={}, zero_sign_differences={zero_sign_differences}",
+        expected.len()
+    );
+}
