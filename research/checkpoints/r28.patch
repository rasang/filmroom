+const IO_ERROR: &str = "GPU_DIR_MIXED64_FILES_IO";
+const PATH_ERROR: &str = "GPU_DIR_MIXED64_FILES_PATH";
+const SOURCE_CHANGED: &str = "GPU_DIR_MIXED64_FILES_SOURCE_CHANGED";
+const CANCELLED: &str = "GPU_DIR_MIXED64_FILES_CANCELLED";
+const MIB: u64 = 1024 * 1024;
