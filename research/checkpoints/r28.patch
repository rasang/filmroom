+//! HOST identity and byte-ownership tests only. These synthetic origin tags and
+//! echo outputs do not authenticate a producer, prove DIR science, or use a GPU.
+use super::*;
+use spektrafilm_core::{params::RuntimeParams, pipeline::Pipeline, profile::load_profile_by_name};
+use std::{
+    fs::{self, OpenOptions},
+    os::unix::fs::{OpenOptionsExt, PermissionsExt},
+    sync::{
+        OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+const DERIVED: InputPolicy = InputPolicy::DerivedGpuF32Mixed;
+static NEXT: AtomicU64 = AtomicU64::new(0);
+fn calibration(active: bool) -> DirMixedCalibration {
+    static PIPE: OnceLock<Pipeline> = OnceLock::new();
+    let mut pipe = PIPE
+        .get_or_init(|| {
+            let data = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
+            Pipeline::new_with_spectral(
+                load_profile_by_name(&data, "kodak_portra_400").unwrap(),
+                load_profile_by_name(&data, "kodak_portra_endura").unwrap(),
+                RuntimeParams::default(),
+                &data,
+            )
+            .unwrap()
+        })
+        .clone();
+    pipe.params.film_render.dir_couplers.active = active;
+    DirMixedCalibration::from_pipeline(&pipe, 36_000. / 8192., 5, 2).unwrap()
+}
+fn origin(cal: &DirMixedCalibration, policy: InputPolicy) -> FixtureOrigin {
+    let synthetic = digest(b"SYNTHETIC HOST IDENTITY TEST, NOT PRODUCER AUTHENTICATION");
+    FixtureOrigin {
+        kind: policy.kind().into(),
+        precision: policy.precision().into(),
+        producer: policy.producer().into(),
+        fixture_mode: "Synthetic host identity fixture, not verified GPU execution".into(),
+        build_sha256: synthetic.clone(),
+        producer_sha256: synthetic.clone(),
+        pipeline_sha256: synthetic.clone(),
+        profile_sha256: synthetic.clone(),
+        runtime_params_sha256: synthetic.clone(),
+        fixture_sha256: synthetic,
+        calibration_sha256: digest(&serde_json::to_vec(cal).unwrap()),
+    }
+}
+struct Fixture {
+    root: PathBuf,
+    source_paths: [PathBuf; 3],
+}
+impl Fixture {
+    fn new() -> Self {
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+            "film-dir-derived-mixed64-host-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&root).unwrap();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+        let source_paths = ["r.bin", "g.bin", "b.bin"].map(|s| root.join(s));
+        for (channel, path) in source_paths.iter().enumerate() {
+            let mut file = OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .mode(0o600)
+                .open(path)
+                .unwrap();
+            for index in 0..10 {
+                let value = match index {
+                    0 => 0_f32,
+                    1 => -0_f32,
+                    _ => -1.25 + (index + channel) as f32 / 64.,
+                };
+                file.write_all(&(value as f64).to_bits().to_le_bytes())
+                    .unwrap();
+            }
+            file.sync_all().unwrap();
+        }
+        Self { root, source_paths }
+    }
+    fn sources(&self, cal: &DirMixedCalibration, policy: InputPolicy) -> Sources {
+        let planes = self.source_paths.each_ref().map(|path| {
+            let captured = SourceIdentity::capture(path, &mut || false).unwrap();
+            captured.verify_f32_promoted(&mut || false).unwrap();
+            captured
+        });
+        Sources {
+            planes,
+            origin: origin(cal, policy),
+        }
+    }
+    fn derived(&self, name: &str) -> DerivedMixedGraphPlan {
+        let cal = calibration(false);
+        DerivedMixedGraphPlan::new(
+            cal.clone(),
+            self.sources(&cal, DERIVED),
+            Paths::new(self.root.join(name)),
+            3,
+            10,
+            5,
+        )
+        .unwrap()
+    }
+    fn assert_sources_unchanged(&self, sources: &Sources) {
+        for plane in &sources.planes {
+            assert_eq!(
+                *plane,
+                SourceIdentity::capture(&plane.path, &mut || false).unwrap()
+            );
+        }
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
+#[derive(Default)]
+struct Echo {
+    calls: u64,
+    fail_at: Option<u64>,
+    poisoned: bool,
+}
+impl Compute for Echo {
+    fn check_status(&self) -> R<()> {
+        if self.poisoned {
+            Err("HOST_POISONED".into())
+        } else {
+            Ok(())
+        }
+    }
+    fn point(
+        &mut self,
+        _: &DirMixedCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        check(c)?;
+        self.calls += 1;
+        if self.fail_at == Some(self.calls) {
+            return Err("HOST_INJECTED_POINT_FAILURE".into());
+        }
+        Ok(values.iter().map(|v| v[job.channel as usize]).collect())
+    }
+    fn spatial(
+        &mut self,
+        _: &SpatialLine,
+        values: &[u64],
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        check(c)?;
+        self.calls += 1;
+        Ok(values.to_vec())
+    }
+    fn poison(&mut self) {
+        self.poisoned = true;
+    }
+}
