+// Independent original CPU per-plane oracle. No candidate calibration table is
+// used. Actual original expose ImageBuf feeds original initial develop, original
+// coupler point correction, and original Gaussian row/channel implementations.
+fn original_intermediates(
+    pipe: &Pipeline,
+    log: &ImageBuf,
+    pitch: f32,
+) -> Vec<dir_files::PlaneReceipt> {
+    use spektrafilm_math::gaussian::{gaussian_blur_channel, gaussian_blur_rows};
+    let d = &pipe.params.film_render.dir_couplers;
+    if !d.active {
+        return Vec::new();
+    }
+    let mut no_dir = pipe.params.clone();
+    no_dir.film_render.dir_couplers.active = false;
+    let density = spektrafilm_core::stages::filming::develop(log, &pipe.film, &no_dir, &CpuBackend);
+    let mut matrix = spektrafilm_model::couplers::compute_dir_couplers_matrix(
+        d.gamma_samelayer_rgb,
+        d.gamma_interlayer_r_to_gb,
+        d.gamma_interlayer_g_to_rb,
+        d.gamma_interlayer_b_to_rg,
+        d.inhibition_samelayer,
+        d.inhibition_interlayer,
+    );
+    for row in &mut matrix {
+        for value in row {
+            *value *= d.amount;
+        }
+    }
+    let raw32: Vec<[f32; 3]> = pipe
+        .film
+        .density_curves_f64()
+        .iter()
+        .map(|r| r.map(|x| x as f32))
+        .collect();
+    let maximum = spektrafilm_model::density_curves::max_density(
+        &spektrafilm_model::density_curves::normalize_density_curves(&raw32),
+    )
+    .map(|x| x as f64);
+    // -0 minus correction then unary negation recovers its exact value and
+    // zero sign, unlike using a positive-zero log in this point-only oracle.
+    let negative_zero =
+        ImageBuf::from_data(log.width, log.height, vec![from_f64(-0.); log.data.len()]);
+    let negative_c = spektrafilm_model::couplers::compute_exposure_correction(
+        &negative_zero,
+        &density,
+        maximum,
+        &matrix,
+        0.,
+        0.,
+        d.diffusion_tail_weight,
+        pipe.film.is_positive(),
+        &CpuBackend,
+    );
+    let core = (d.diffusion_size_um / pitch as f64) as f32;
+    let decay = (d.diffusion_tail_um / pitch as f64) as f32;
+    let tail_sigmas = crate::research_spatial::FIT.map(|(_, ratio)| (ratio * decay as f64) as f32);
+    let mut out = Vec::new();
+    fn record(
+        out: &mut Vec<dir_files::PlaneReceipt>,
+        channel: u32,
+        role: String,
+        words: &[spektrafilm_math::precision::Scalar],
+    ) {
+        let bytes: Vec<_> = words
+            .iter()
+            .flat_map(|&x| to_f64(x).to_bits().to_le_bytes())
+            .collect();
+        out.push(dir_files::PlaneReceipt {
+            channel,
+            role,
+            sha256: digest(&bytes),
+        });
+    }
+    for channel in 0..3 {
+        let correction: Vec<_> = negative_c
+            .data
+            .chunks_exact(3)
+            .map(|r| -r[channel])
+            .collect();
+        record(&mut out, channel as u32, "correction".into(), &correction);
+        if core <= 0. {
+            continue;
+        }
+        let mut accum = vec![from_f64(0.); correction.len()];
+        for (filter, sigma) in std::iter::once(core).chain(tail_sigmas).enumerate() {
+            let component = if sigma <= 0. {
+                let copy = correction.clone();
+                record(
+                    &mut out,
+                    channel as u32,
+                    format!("filter{filter}.identity"),
+                    &copy,
+                );
+                copy
+            } else {
+                let mut horizontal = vec![from_f64(0.); correction.len()];
+                gaussian_blur_rows(&correction, &mut horizontal, log.width as usize, sigma);
+                record(
+                    &mut out,
+                    channel as u32,
+                    format!("filter{filter}.horizontal"),
+                    &horizontal,
+                );
+                let blurred = gaussian_blur_channel(&correction, log.width, log.height, sigma);
+                record(
+                    &mut out,
+                    channel as u32,
+                    format!("filter{filter}.vertical"),
+                    &blurred,
+                );
+                blurred
+            };
+            if filter == 0 {
+                record(&mut out, channel as u32, "accumulator0".into(), &accum);
+            } else {
+                let amplitude = from_f64(crate::research_spatial::FIT[filter - 1].0);
+                for (sum, &v) in accum.iter_mut().zip(&component) {
+                    *sum += amplitude * v;
+                }
+                record(
+                    &mut out,
+                    channel as u32,
+                    format!("accumulator{filter}"),
+                    &accum,
+                );
+            }
+        }
+    }
+    out
+}
