+//! Closed full-file DIR bridge. Arithmetic remains in the R15 single owner.
+//! No original source file or partially written channel is ever adopted here.
+use super::R;
+use super::dir_calibration::DirCalibration;
+use super::dir_files::Compute;
+use super::dir_gpu::DirGpu;
+use super::dir_point::Job;
+use super::image_files::LineSpec;
+
+impl Compute for DirGpu {
+    fn check_status(&self) -> R<()> {
+        self.ready(&mut || false)
+    }
+    fn point(
+        &mut self,
+        p: &DirCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        cancelled: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        DirGpu::point(self, p, job, values, cancelled)
+    }
+    fn raw(
+        &mut self,
+        p: &LineSpec,
+        values: &[u64],
+        cancelled: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        DirGpu::raw(self, p, values, cancelled)
+    }
+    fn poison(&mut self) {
+        DirGpu::poison(self)
+    }
+}
