+fn assert_poisoned(ticket: StageTicket, mut gpu: DirGpu, p: &DirCalibration) {
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    let before = gpu.metrics.point_dispatches + gpu.metrics.raw_dispatches;
+    assert_eq!(
+        gpu.point(
+            p,
+            job(Operation::InitialCurve, 0, 0),
+            &[[0; 3]],
+            &mut || false
+        )
+        .unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    let spec = LineSpec {
+        length: 1,
+        lines: 1,
+        sigma_bits: p.core_sigma_bits,
+        coefficient_bits: p.coefficient_bits.unwrap()[0],
+    };
+    assert_eq!(
+        gpu.raw(&spec, &[0], &mut || false).unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    assert_eq!(
+        gpu.metrics.point_dispatches + gpu.metrics.raw_dispatches,
+        before
+    );
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+    assert!(session::finish_frame(ticket.epoch, ticket.generation).is_err());
+}
