--- /dev/null
+++ b/native/crates/film-engine/src/prefix_boundary_probe.rs
@@ -0,0 +1,808 @@
+//! Closed test diagnostic: copies actual adopted f64 plane bytes, not math or
+//! an independent proof of backend adoption. Lead owns exact post-adoption hooks.
+//! One serialized scope; retain it through exposure, captures and report.
+#![cfg(all(test, feature = "gpu-diffusion-research", feature = "precision-f64"))]
+use serde::Serialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    ffi::CString,
+    fs::{self, File, OpenOptions},
+    io::{Read, Write},
+    os::unix::{
+        ffi::OsStrExt,
+        fs::{DirBuilderExt, MetadataExt, OpenOptionsExt},
+    },
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+type R<T> = Result<T, String>;
+const ERROR: &str = "TEST_PREFIX_BOUNDARY_CAPTURE";
+pub(crate) const STAGES: [&str; 6] = [
+    "afterFilmExposure",
+    "afterHighlight",
+    "afterCameraDiffusion",
+    "afterFilmOptics",
+    "afterExposureLog",
+    "afterDir",
+];
+const MARGIN: u64 = 256 * 1024 * 1024;
+/// Exact values already calculated by the real pipeline. No recomputation here.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct ClosedScalars {
+    pub filming_exposure_correction: Option<f64>,
+    pub metered_ev: Option<f32>,
+    pub pixel_pitch: Option<f32>,
+}
+impl ClosedScalars {
+    fn value(self) -> R<Value> {
+        if self
+            .filming_exposure_correction
+            .is_some_and(|v| !v.is_finite())
+            || self.metered_ev.is_some_and(|v| !v.is_finite())
+            || self.pixel_pitch.is_some_and(|v| !v.is_finite())
+        {
+            return fail();
+        }
+        Ok(
+            json!({"filmingExposureCorrectionF64Bits":self.filming_exposure_correction.map(|v|format!("{:016x}",v.to_bits())),"meteredEvF32Bits":self.metered_ev.map(|v|format!("{:08x}",v.to_bits())),"pixelPitchF32Bits":self.pixel_pitch.map(|v|format!("{:08x}",v.to_bits()))}),
+        )
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Identity {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    bytes: u64,
+}
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Exposure {
+    ae_scale_f64_bits: String,
+    exposure_scale_f64_bits: String,
+    metered_ev_f32_bits: Option<String>,
+}
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct CopyRecord {
+    source: Identity,
+    copy: Identity,
+    sha256: String,
+    source_sha256_after: String,
+    copy_sha256: String,
+}
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct StageRecord {
+    index: usize,
+    name: &'static str,
+    width: u32,
+    height: u32,
+    planes: [CopyRecord; 3],
+    scalars: Option<Value>,
+}
+struct State {
+    output: PathBuf,
+    input: Identity,
+    root: Identity,
+    expected: Vec<&'static str>,
+    exposure: Option<Exposure>,
+    records: Vec<StageRecord>,
+    geometry: Option<(u32, u32)>,
+    failure: Option<String>,
+}
+static CONFIG: Mutex<Option<Arc<Mutex<State>>>> = Mutex::new(None);
+pub(crate) struct Scope(Arc<Mutex<State>>);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if let Ok(mut slot) = CONFIG.lock() {
+            if slot.as_ref().is_some_and(|v| Arc::ptr_eq(v, &self.0)) {
+                *slot = None;
+            }
+        }
+    }
+}
+fn fail<T>() -> R<T> {
+    Err(ERROR.into())
+}
+fn io<T>(r: std::io::Result<T>) -> R<T> {
+    r.map_err(|e| format!("{ERROR}: {e}"))
+}
+fn identity(path: &Path, m: &fs::Metadata) -> Identity {
+    Identity {
+        path: path.into(),
+        device: m.dev(),
+        inode: m.ino(),
+        bytes: m.len(),
+    }
+}
+fn directory(path: &Path) -> R<Identity> {
+    let m = io(fs::symlink_metadata(path))?;
+    if !path.is_absolute()
+        || io(path.canonicalize())? != path
+        || !m.is_dir()
+        || m.file_type().is_symlink()
+        || m.mode() & 0o777 != 0o700
+        || m.uid() != unsafe { libc::geteuid() }
+    {
+        return fail();
+    }
+    Ok(Identity {
+        bytes: 0,
+        ..identity(path, &m)
+    })
+}
+fn regular(path: &Path) -> R<Identity> {
+    let m = io(fs::symlink_metadata(path))?;
+    if !path.is_absolute()
+        || io(path.canonicalize())? != path
+        || !m.is_file()
+        || m.file_type().is_symlink()
+    {
+        return fail();
+    }
+    Ok(identity(path, &m))
+}
+fn stamp(m: &fs::Metadata) -> (u64, u64, u64, i64, i64, i64, i64) {
+    (
+        m.dev(),
+        m.ino(),
+        m.len(),
+        m.mtime(),
+        m.mtime_nsec(),
+        m.ctime(),
+        m.ctime_nsec(),
+    )
+}
+fn hash_open(path: &Path, expected: &Identity) -> R<String> {
+    if &regular(path)? != expected {
+        return fail();
+    }
+    let mut f = io(OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path))?;
+    let before = io(f.metadata())?;
+    if identity(path, &before) != *expected {
+        return fail();
+    }
+    let mut left = expected.bytes;
+    let mut b = [0u8; 65536];
+    let mut h = Sha256::new();
+    while left > 0 {
+        let n = left.min(b.len() as u64) as usize;
+        io(f.read_exact(&mut b[..n]))?;
+        h.update(&b[..n]);
+        left -= n as u64;
+    }
+    let after = io(f.metadata())?;
+    let current = io(fs::symlink_metadata(path))?;
+    if stamp(&before) != stamp(&after) || stamp(&after) != stamp(&current) {
+        return fail();
+    }
+    Ok(format!("{:x}", h.finalize()))
+}
+fn available(path: &Path) -> R<u64> {
+    let p = CString::new(path.as_os_str().as_bytes()).map_err(|_| ERROR)?;
+    let mut v = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    if unsafe { libc::statvfs(p.as_ptr(), v.as_mut_ptr()) } != 0 {
+        return fail();
+    }
+    let v = unsafe { v.assume_init() };
+    (v.f_bavail as u64)
+        .checked_mul(v.f_frsize as u64)
+        .ok_or_else(|| ERROR.into())
+}
+fn sync_dir(path: &Path) -> R<()> {
+    io(io(File::open(path))?.sync_all())
+}
+fn write_new(path: &Path, bytes: &[u8]) -> R<()> {
+    let mut f = io(OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path))?;
+    io(f.write_all(bytes))?;
+    io(f.sync_all())
+}
+fn validate_names(names: &[&str]) -> R<()> {
+    if names.is_empty() || names.len() > STAGES.len() {
+        return fail();
+    }
+    let mut last = None;
+    for name in names {
+        let i = STAGES.iter().position(|v| v == name).ok_or(ERROR)?;
+        if last.is_some_and(|p| i <= p) {
+            return fail();
+        }
+        last = Some(i);
+    }
+    Ok(())
+}
+pub(crate) fn configure(
+    output: PathBuf,
+    input: PathBuf,
+    root: PathBuf,
+    expected_names: Vec<&'static str>,
+) -> R<Scope> {
+    validate_names(&expected_names)?;
+    if !output.is_absolute() {
+        return fail();
+    }
+    let input = regular(&input)?;
+    let root = directory(&root)?;
+    if input.path.starts_with(&root.path) {
+        return fail();
+    }
+    for n in &expected_names {
+        if root.path.join(n).try_exists().map_err(|_| ERROR)? {
+            return fail();
+        }
+    }
+    let mut slot = CONFIG.lock().map_err(|_| ERROR)?;
+    if slot.is_some() {
+        return fail();
+    }
+    let s = Arc::new(Mutex::new(State {
+        output,
+        input,
+        root,
+        expected: expected_names,
+        exposure: None,
+        records: Vec::new(),
+        geometry: None,
+        failure: None,
+    }));
+    *slot = Some(s.clone());
+    Ok(Scope(s))
+}
+fn active() -> R<Option<Arc<Mutex<State>>>> {
+    Ok(CONFIG.lock().map_err(|_| ERROR)?.clone())
+}
+fn scoped(match_path: &Path, input: bool, f: impl FnOnce(&mut State) -> R<()>) -> R<()> {
+    let Some(s) = active()? else { return Ok(()) };
+    let mut s = s.lock().map_err(|_| ERROR)?;
+    if (if input { &s.input.path } else { &s.output }) != match_path {
+        return Ok(());
+    }
+    if s.failure.is_some() {
+        return fail();
+    }
+    let result = f(&mut s);
+    if let Err(ref e) = result {
+        s.failure = Some(e.clone());
+    }
+    result
+}
+pub(crate) fn record_exposure(
+    input: &Path,
+    ae: f64,
+    exposure: f64,
+    metered_ev: Option<f32>,
+) -> R<()> {
+    scoped(input, true, |s| {
+        if s.exposure.is_some()
+            || !s.records.is_empty()
+            || !ae.is_finite()
+            || !exposure.is_finite()
+            || metered_ev.is_some_and(|v| !v.is_finite())
+            || regular(&s.input.path)? != s.input
+        {
+            return fail();
+        }
+        s.exposure = Some(Exposure {
+            ae_scale_f64_bits: format!("{:016x}", ae.to_bits()),
+            exposure_scale_f64_bits: format!("{:016x}", exposure.to_bits()),
+            metered_ev_f32_bits: metered_ev.map(|v| format!("{:08x}", v.to_bits())),
+        });
+        Ok(())
+    })
+}
+fn copy_plane(source: &Identity, target: &Path) -> R<CopyRecord> {
+    let mut src = io(OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(&source.path))?;
+    let before = io(src.metadata())?;
+    if identity(&source.path, &before) != *source {
+        return fail();
+    }
+    let mut dst = io(OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(target))?;
+    let target_id = identity(target, &io(dst.metadata())?);
+    if (source.device, source.inode) == (target_id.device, target_id.inode) {
+        return fail();
+    }
+    let mut left = source.bytes;
+    let mut h = Sha256::new();
+    let mut buffer = [0u8; 65536];
+    while left > 0 {
+        let n = left.min(buffer.len() as u64) as usize;
+        io(src.read_exact(&mut buffer[..n]))?;
+        io(dst.write_all(&buffer[..n]))?;
+        h.update(&buffer[..n]);
+        left -= n as u64;
+    }
+    io(dst.sync_all())?;
+    let copied = identity(target, &io(dst.metadata())?);
+    drop(dst);
+    let after = io(src.metadata())?;
+    if stamp(&before) != stamp(&after)
+        || stamp(&after) != stamp(&io(fs::symlink_metadata(&source.path))?)
+    {
+        return fail();
+    }
+    drop(src);
+    if copied.bytes != source.bytes || regular(target)? != copied {
+        return fail();
+    }
+    let sha = format!("{:x}", h.finalize());
+    let source_after = hash_open(&source.path, source)?;
+    let copy_sha = hash_open(target, &copied)?;
+    if sha != source_after || sha != copy_sha {
+        return fail();
+    }
+    Ok(CopyRecord {
+        source: source.clone(),
+        copy: copied,
+        sha256: sha,
+        source_sha256_after: source_after,
+        copy_sha256: copy_sha,
+    })
+}
+fn capture_inner(
+    s: &mut State,
+    stage: &'static str,
+    paths: &[PathBuf; 3],
+    w: u32,
+    h: u32,
+    metadata: Option<ClosedScalars>,
+) -> R<()> {
+    if s.expected.get(s.records.len()).copied() != Some(stage)
+        || s.exposure.is_none()
+        || directory(&s.root.path)? != s.root
+        || w == 0
+        || h == 0
+        || s.geometry.is_some_and(|d| d != (w, h))
+    {
+        return fail();
+    }
+    let bytes = u64::from(w)
+        .checked_mul(u64::from(h))
+        .and_then(|v| v.checked_mul(8))
+        .ok_or(ERROR)?;
+    // At most six captures. No image-sized memory, just two bounded64KiB IO buffers.
+    let required = bytes
+        .checked_mul(3)
+        .and_then(|v| v.checked_add(MARGIN + 65536))
+        .ok_or(ERROR)?;
+    if available(&s.root.path)? < required {
+        return Err("TEST_PREFIX_BOUNDARY_DISK_BUDGET".into());
+    }
+    let scalars = metadata.map(ClosedScalars::value).transpose()?;
+    if let Some(m) = metadata {
+        if m.metered_ev.is_some()
+            && m.metered_ev.map(|v| format!("{:08x}", v.to_bits()))
+                != s.exposure.as_ref().ok_or(ERROR)?.metered_ev_f32_bits
+        {
+            return fail();
+        }
+    }
+    let mut sources = Vec::with_capacity(3);
+    for path in paths {
+        let id = regular(path)?;
+        if id.bytes != bytes
+            || id.path.starts_with(&s.root.path)
+            || sources
+                .iter()
+                .any(|p: &Identity| (p.device, p.inode) == (id.device, id.inode))
+        {
+            return fail();
+        }
+        sources.push(id);
+    }
+    let dir = s.root.path.join(stage);
+    io(fs::DirBuilder::new().mode(0o700).create(&dir))?;
+    let owned = directory(&dir)?;
+    let mut copied = Vec::with_capacity(3);
+    for (ch, source) in sources.iter().enumerate() {
+        copied.push(copy_plane(
+            source,
+            &dir.join(format!("channel-{ch}.f64le")),
+        )?);
+    }
+    let planes: [CopyRecord; 3] = copied.try_into().map_err(|_| ERROR)?;
+    // Recheck the entire three-plane set after copying all channels. No partial
+    // copy can become an accepted StageRecord. Retain partial diagnostics on error.
+    for p in &planes {
+        if hash_open(&p.source.path, &p.source)? != p.sha256
+            || hash_open(&p.copy.path, &p.copy)? != p.sha256
+        {
+            return fail();
+        }
+    }
+    if directory(&dir)? != owned || directory(&s.root.path)? != s.root {
+        return fail();
+    }
+    let record = StageRecord {
+        index: s.records.len(),
+        name: stage,
+        width: w,
+        height: h,
+        planes,
+        scalars,
+    };
+    let json = serde_json::to_vec_pretty(&record).map_err(|_| ERROR)?;
+    if json.len() > 65536 {
+        return fail();
+    }
+    write_new(&dir.join("capture.json"), &json)?;
+    sync_dir(&dir)?;
+    sync_dir(&s.root.path)?;
+    s.geometry = Some((w, h));
+    s.records.push(record);
+    Ok(())
+}
+pub(crate) fn capture(
+    output: &Path,
+    stage_name: &'static str,
+    planes: &[PathBuf; 3],
+    w: u32,
+    h: u32,
+    metadata: Option<ClosedScalars>,
+) -> R<()> {
+    scoped(output, false, |s| {
+        capture_inner(s, stage_name, planes, w, h, metadata)
+    })
+}
+fn report_inner(s: &State) -> R<Value> {
+    if s.failure.is_some()
+        || s.exposure.is_none()
+        || s.records.len() != s.expected.len()
+        || directory(&s.root.path)? != s.root
+    {
+        return fail();
+    }
+    for (index, record) in s.records.iter().enumerate() {
+        if record.index != index || record.name != s.expected[index] {
+            return fail();
+        }
+        for p in &record.planes {
+            if hash_open(&p.copy.path, &p.copy)? != p.sha256 {
+                return fail();
+            }
+        }
+    }
+    let disk_bytes = s.records.iter().try_fold(0u64, |sum, r| {
+        r.planes
+            .iter()
+            .try_fold(sum, |sum, p| sum.checked_add(p.copy.bytes).ok_or(ERROR))
+    })?;
+    Ok(
+        json!({"testOnly":true,"kind":"actual-adopted-prefix-boundary-byte-capture","input":s.input,"output":s.output,"expectedNames":s.expected,"captureCount":s.records.len(),"geometry":s.geometry,"actualExposure":s.exposure,"stages":s.records,"capturePlaneBytes":disk_bytes,"additionalDiskScope":"retained diagnostic copies only; independent of pipeline scratch and other experiment evidence","hostImageArithmetic":false,"proofScope":"caller-selected real post-adoption files; not independent GPU seal/backend attestation","complete":true}),
+    )
+}
+pub(crate) fn report(output: &Path) -> R<Value> {
+    let Some(s) = active()? else { return fail() };
+    let mut s = s.lock().map_err(|_| ERROR)?;
+    if s.output != output {
+        return fail();
+    }
+    let result = report_inner(&s);
+    if let Err(ref e) = result {
+        s.failure = Some(e.clone());
+    }
+    result
+}
