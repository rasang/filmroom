+    #[test]
+    fn changed_density_after_confirm_is_rejected() {
+        let (_a, b, mut s, p) = fixture();
+        let target = std::array::from_fn(|c| b.0.join(format!("density-{c}")));
+        for c in 0..3 {
+            fs::rename(&p[c], &target[c]).unwrap();
+        }
+        verify_adoption(&mut s, &target, &mut || false).unwrap();
+        fs::write(&target[1], 4f64.to_le_bytes()).unwrap();
+        assert!(verify_pregrain(&mut s, &target, &mut || false).is_err());
+        assert_eq!(s.step, Step::Confirmed);
+    }
+    #[test]
+    fn cancelled_adoption_preserves_unconfirmed_state() {
+        let (_a, b, mut s, p) = fixture();
+        let target = std::array::from_fn(|c| b.0.join(format!("density-{c}")));
+        for c in 0..3 {
+            fs::rename(&p[c], &target[c]).unwrap();
+        }
+        assert_eq!(
+            verify_adoption(&mut s, &target, &mut || true).unwrap_err(),
+            CANCELLED
+        );
+        assert_eq!(s.step, Step::Sealed);
+        assert!(s.adopted.is_none());
+    }
+    #[test]
+    fn hashes_reject_symlinks_hardlink_aliases_and_wrong_lengths() {
+        let (_a, b, s, p) = fixture();
+        let alias = b.0.join("alias");
+        std::os::unix::fs::symlink(&p[0], &alias).unwrap();
+        assert!(hash_file(&alias, 8, &mut || false).is_err());
+        assert!(hash_file(&p[0], 16, &mut || false).is_err());
+        let hard = b.0.join("hard");
+        fs::hard_link(&p[0], &hard).unwrap();
+        assert!(planes(&[p[0].clone(), hard, p[2].clone()], 8, &mut || false).is_err());
+        assert!(hash_file(&p[0], 8, &mut || true).is_err());
+        assert_eq!(
+            s.expected.unwrap()[0].sha256,
+            format!("{:x}", Sha256::digest(1f64.to_le_bytes()))
+        );
+    }
+    #[test]
+    fn private_root_mode_and_replacement_are_distinct() {
+        let t = Temp::new();
+        let id = directory(&t.0, true).unwrap();
+        fs::set_permissions(&t.0, fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(directory(&t.0, true).is_err());
+        fs::set_permissions(&t.0, fs::Permissions::from_mode(0o700)).unwrap();
+        let old = t.0.with_extension("old");
+        fs::rename(&t.0, &old).unwrap();
+        fs::create_dir(&t.0).unwrap();
+        fs::set_permissions(&t.0, fs::Permissions::from_mode(0o700)).unwrap();
+        assert_ne!(directory(&t.0, true).unwrap(), id);
+        fs::remove_dir(old).unwrap();
+    }
