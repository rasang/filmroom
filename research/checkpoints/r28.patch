+        0.,
+        f32::from_bits(3f32.to_bits() - 1),
+        -1.,
+        f32::NAN,
+        f32::INFINITY,
+        10001.,
+    ] {
+        assert!(Plan::new(sigma, 1, 1).is_err());
+    }
+    for sigma in [3., f32::from_bits(3f32.to_bits() + 1), 10000.] {
+        Plan::new(sigma, 1, 1).unwrap().validate().unwrap();
+    }
