+//! Closed test-only calibration for the original DIR's mixed spatial graph.
+//!
+//! This is a separate checked identity, not a relaxed legacy DirCalibration.
+//! Original point preparation is shared, but spatial admission and JSON are
+//! independent. Original-log64 provenance and image resources belong to the
+//! enclosing graph, not this bounded small-metadata calibration. External
+//! transport must bound bytes before decoding, as with the legacy calibration.
+#![cfg(test)]
+
+use super::dir_calibration::{CalibrationInputs, CurveWords, PreparedPointScience};
+use super::fir::FirSpec;
+use super::image_files::LineSpec;
+use super::{R, admitted, coefficients_for_sigma, digest};
+use crate::research_spatial::{FIT, Filter};
+use serde::{Deserialize, Deserializer, Serialize};
+use spektrafilm_core::pipeline::Pipeline;
+
+const VERSION: u32 = 2;
+const RECIPE: &str = "original-dir-calibration-f64-initial-f32-before-dir-mixed-v2";
+const ERROR: &str = "GPU_DIR_MIXED_SOFT64_CALIBRATION";
+const DOMAIN_ERROR: &str = "GPU_DIR_MIXED_SOFT64_CALIBRATION_DOMAIN";
+const FILTER_ERROR: &str = "GPU_DIR_MIXED_SOFT64_FILTER";
+const ORIGINAL_COUPLERS: &str = include_str!("../../../spektrafilm-model/src/couplers.rs");
+const ORIGINAL_COUPLERS_SHA256: &str =
+    "a262d3252314670a124afde3477d3aaf44abaa2735fbdac610bb20feab5d396a";
+const ORIGINAL_DENSITY_CURVES: &str =
+    include_str!("../../../spektrafilm-model/src/density_curves.rs");
+const ORIGINAL_DENSITY_CURVES_SHA256: &str =
+    "9af234bad7a575a7113efa77c7dad7b1407f531424d500fb05c69c4b53f38831";
+
+// A filter's original parameter and family remain explicit. Identity has no
+// invented coefficients; its implementation copy sigma is separately +0.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(tag = "family", rename_all = "camelCase", deny_unknown_fields)]
+pub(super) enum Gaussian {
+    Identity {
+        #[serde(rename = "sigmaBits")]
+        sigma_bits: u32,
+    },
+    Fir {
+        #[serde(rename = "sigmaBits")]
+        sigma_bits: u32,
+        radius: u32,
+        #[serde(rename = "coefficientBits", with = "word_vec")]
+        coefficient_bits: Vec<u64>,
+    },
+    Iir {
+        #[serde(rename = "sigmaBits")]
+        sigma_bits: u32,
+        #[serde(rename = "coefficientBits", with = "word_array")]
+        coefficient_bits: [u64; 4],
+    },
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "family", rename_all = "camelCase", deny_unknown_fields)]
+enum GaussianWire {
+    Identity {
+        #[serde(rename = "sigmaBits")]
+        sigma_bits: u32,
+    },
+    Fir {
+        #[serde(rename = "sigmaBits")]
+        sigma_bits: u32,
+        radius: u32,
+        #[serde(rename = "coefficientBits", with = "word_vec")]
+        coefficient_bits: Vec<u64>,
+    },
+    Iir {
+        #[serde(rename = "sigmaBits")]
+        sigma_bits: u32,
+        #[serde(rename = "coefficientBits", with = "word_array")]
+        coefficient_bits: [u64; 4],
+    },
+}
+impl<'de> Deserialize<'de> for Gaussian {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let result = match GaussianWire::deserialize(deserializer)? {
+            GaussianWire::Identity { sigma_bits } => Self::Identity { sigma_bits },
+            GaussianWire::Fir {
+                sigma_bits,
+                radius,
+                coefficient_bits,
+            } => Self::Fir {
+                sigma_bits,
+                radius,
+                coefficient_bits,
+            },
+            GaussianWire::Iir {
+                sigma_bits,
+                coefficient_bits,
+            } => Self::Iir {
+                sigma_bits,
+                coefficient_bits,
+            },
+        };
+        result.validate().map_err(serde::de::Error::custom)?;
+        Ok(result)
+    }
+}
+
+impl Gaussian {
+    pub(super) fn sigma_bits(&self) -> u32 {
+        match self {
+            Self::Identity { sigma_bits }
+            | Self::Fir { sigma_bits, .. }
+            | Self::Iir { sigma_bits, .. } => *sigma_bits,
+        }
+    }
+
+    pub(super) fn is_identity(&self) -> bool {
+        matches!(self, Self::Identity { .. })
+    }
+
+    // Intrinsic calibration validation has no synthetic geometry. FIR values
+    // are checked against the existing original coefficient preparation here;
+    // every actual axis additionally checks the complete R17 FirSpec identity.
+    fn validate(&self) -> R<()> {
+        let sigma = f32::from_bits(self.sigma_bits());
+        if !sigma.is_finite() {
+            return Err(FILTER_ERROR.into());
+        }
+        match self {
+            Self::Identity { .. } if sigma <= 0. => Ok(()),
+            Self::Fir {
+                radius,
+                coefficient_bits,
+                ..
+            } if sigma > 0. && sigma < 3. => {
+                let Filter::Fir(expected) = Filter::new(sigma)? else {
+                    return Err(FILTER_ERROR.into());
+                };
+                if *radius != (3.0 * sigma as f64 + 0.5) as u32
+                    || coefficient_bits.len() != expected.len()
+                    || coefficient_bits.iter().zip(expected).any(|(&bits, value)| {
+                        bits != value.to_bits() || !admitted(bits) || value <= 0. || value > 1.
+                    })
+                {
+                    return Err(FILTER_ERROR.into());
+                }
+                Ok(())
+            }
+            Self::Iir {
+                coefficient_bits, ..
+            } if (3. ..=10_000.).contains(&sigma) => {
+                if *coefficient_bits != coefficients_for_sigma(sigma)? {
+                    return Err(FILTER_ERROR.into());
+                }
+                Ok(())
+            }
+            _ => Err(FILTER_ERROR.into()),
+        }
+    }
+
+    // Derive FIR through R17 with the real row axis. Then independently check
+    // the real column axis. One line is actual complete-line batch geometry,
+    // not a fake resident 1x1 image or an image-sized allocation.
+    fn from_sigma(sigma: f32, width: u32, height: u32) -> R<Self> {
+        if !sigma.is_finite() {
+            return Err(FILTER_ERROR.into());
+        }
+        let result = if sigma <= 0. {
+            Self::Identity {
+                sigma_bits: sigma.to_bits(),
+            }
+        } else if sigma < 3. {
+            let row = FirSpec::new(sigma, width, 1)?;
+            Self::Fir {
+                sigma_bits: sigma.to_bits(),
+                radius: row.radius,
+                coefficient_bits: row.coefficient_bits,
+            }
+        } else {
+            Self::Iir {
+                sigma_bits: sigma.to_bits(),
+                coefficient_bits: coefficients_for_sigma(sigma)?,
+            }
+        };
+        result.line(width, 1)?;
+        result.line(height, 1)?;
+        Ok(result)
+    }
+
+    pub(super) fn line(&self, length: u32, lines: u32) -> R<SpatialLine> {
+        self.validate()?;
+        let result = match self {
+            Self::Identity { sigma_bits } => SpatialLine::Identity {
+                original_sigma_bits: *sigma_bits,
+                copy: FirSpec::new(0., length, lines)?,
+            },
+            Self::Fir {
+                sigma_bits,
+                radius,
+                coefficient_bits,
+            } => {
+                let line = FirSpec::new(f32::from_bits(*sigma_bits), length, lines)?;
+                if line.radius != *radius || line.coefficient_bits != *coefficient_bits {
+                    return Err(FILTER_ERROR.into());
+                }
+                SpatialLine::Fir(line)
+            }
+            Self::Iir {
+                sigma_bits,
+                coefficient_bits,
+            } => SpatialLine::Iir(LineSpec {
+                length,
+                lines,
+                sigma_bits: *sigma_bits,
+                coefficient_bits: *coefficient_bits,
+            }),
+        };
+        result.validate()?;
+        Ok(result)
+    }
+}
+
+// Ephemeral typed dispatch only. Its standalone FIR resources are never
+// serialized into, or mistaken for, the enclosing three-family graph budget.
+#[derive(Clone, Debug)]
+pub(super) enum SpatialLine {
+    Identity {
+        original_sigma_bits: u32,
+        copy: FirSpec,
+    },
+    Fir(FirSpec),
+    Iir(LineSpec),
+}
+impl SpatialLine {
+    pub(super) fn validate(&self) -> R<()> {
+        match self {
+            Self::Identity {
+                original_sigma_bits,
+                copy,
+            } => {
+                let sigma = f32::from_bits(*original_sigma_bits);
+                if !sigma.is_finite() || sigma > 0. || copy.sigma_bits != 0_f32.to_bits() {
+                    return Err(FILTER_ERROR.into());
+                }
+                copy.validate()
+            }
+            Self::Fir(line) => {
+                let sigma = f32::from_bits(line.sigma_bits);
+                if !sigma.is_finite() || sigma <= 0. || sigma >= 3. {
+                    return Err(FILTER_ERROR.into());
+                }
+                line.validate()
+            }
+            Self::Iir(line) => {
+                if !(3. ..=10_000.).contains(&f32::from_bits(line.sigma_bits)) {
+                    return Err(FILTER_ERROR.into());
+                }
+                line.validate()
+            }
+        }
+    }
+
+    pub(super) fn sample_count(&self) -> R<usize> {
+        self.validate()?;
+        match self {
+            Self::Identity { copy, .. } | Self::Fir(copy) => copy.sample_count(),
+            Self::Iir(line) => Ok(line.sample_count()),
+        }
+    }
+
+    pub(super) fn validate_input(&self, values: &[u64]) -> R<()> {
+        self.validate()?;
+        match self {
+            Self::Identity { copy, .. } | Self::Fir(copy) => copy.validate_input(values),
+            Self::Iir(line) => line.validate_input(values),
+        }
+    }
+}
+
+fn derive_filters(
+    science: &PreparedPointScience,
+    active: bool,
+    width: u32,
+    height: u32,
+) -> R<Option<[Gaussian; 4]>> {
+    let core = f32::from_bits(science.core_sigma_bits);
+    if !active || core <= 0. {
+        return Ok(None);
+    }
+    let [a, b, c] = science.tail_sigma_bits.map(f32::from_bits);
+    // Never collapse nonpositive tail decay or weight0 into one identity. The
+    // original three components and ordered FIT accumulation remain distinct.
+    Ok(Some([
+        Gaussian::from_sigma(core, width, height)?,
+        Gaussian::from_sigma(a, width, height)?,
+        Gaussian::from_sigma(b, width, height)?,
+        Gaussian::from_sigma(c, width, height)?,
+    ]))
+}
+
+macro_rules! validated_struct {
+    ($name:ident, $wire:ident { $($(#[$attr:meta])* $field:ident: $ty:ty),* $(,)? }) => {
+        #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        pub(super) struct $name {
+            $($(#[$attr])* pub $field: $ty,)*
+        }
+        #[derive(Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct $wire {
+            $($(#[$attr])* $field: $ty,)*
+        }
+        impl<'de> Deserialize<'de> for $name {
+            fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+                let wire = $wire::deserialize(deserializer)?;
+                let result = Self { $($field: wire.$field,)* };
+                result.validate().map_err(serde::de::Error::custom)?;
+                Ok(result)
+            }
+        }
+    };
+}
+
+validated_struct!(DirMixedCalibration, DirMixedCalibrationWire {
+    version: u32,
+    recipe: String,
+    width: u32,
+    height: u32,
+    pitch_bits: u32,
+    // Kept distinct from explicit fixture pitch. It is not used to derive it.
+    film_format_mm_bits: u32,
+    gamma_bits: u32,
+    dir_active: bool,
+    positive: bool,
+    #[serde(with = "word")]
+    diffusion_size_um_bits: u64,
+    #[serde(with = "word")]
+    diffusion_tail_um_bits: u64,
+    core_sigma_bits: u32,
+    tail_decay_bits: u32,
+    tail_sigma_bits: [u32; 3],
+    #[serde(with = "word")]
+    tail_weight_bits: u64,
+    #[serde(with = "word_array")]
+    fit_amplitude_bits: [u64; 3],
+    #[serde(with = "word_array")]
+    fit_ratio_bits: [u64; 3],
+    // Core then the three original tail components. None means no filters
+    // execute, not identity coefficients or an omitted active tail component.
+    #[serde(with = "required_filters")]
+    filters: Option<[Gaussian; 4]>,
+    #[serde(with = "word_matrix")]
+    matrix_bits: [[u64; 3]; 3],
+    #[serde(with = "word_array")]
+    density_max_bits: [u64; 3],
