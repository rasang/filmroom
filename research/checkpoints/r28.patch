+            let plan = spec(sigma, length, lines);
+            // Each complete independent line is one exhaustive sign pattern.
+            let values: Vec<u64> = (0..lines)
+                .flat_map(|mask| {
+                    (0..length).map(move |i| {
+                        if mask & (1 << i) != 0 {
+                            (-0f64).to_bits()
+                        } else {
+                            0
+                        }
+                    })
+                })
+                .collect();
+            let expected = original_reference(&plan, &values).unwrap();
+            let actual = cpu_reference(&plan, &values).unwrap();
+            assert_eq!(
+                actual,
+                expected,
+                "sigma {:08x}, length {length}",
+                sigma.to_bits()
+            );
+            if sigma == 0. {
+                assert_eq!(actual, values);
+            } else {
+                assert!(actual.iter().all(|&word| word == 0));
