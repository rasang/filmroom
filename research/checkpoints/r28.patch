+}
+#[test]
+#[ignore = "Fresh process: private coefficient fault reaches guarded addition with individually valid operands, result over T_BOUND rejects"]
+fn actual_fir_intermediate_bound_rejects_and_poison() {
+    reject_packet(96109, |p| {
+        p.words[..5].fill(1f64.to_bits());
+        p.words[super::super::fir::PREFIX_WORDS as usize..].fill(BOUND.to_bits());
+    });
+}
+
+#[test]
+#[ignore = "Fresh process: original coefficients and legal normal source cause unsupported product underflow; reject without widening arithmetic domain"]
+fn actual_fir_original_kernel_underflow_rejects_and_poison() {
+    let ticket = activate(96110);
+    let mut gpu = FirGpu::new(&mut || false).unwrap();
+    let p = FirSpec::new(0.5, 17, 1).unwrap();
+    let input = vec![f64::MIN_POSITIVE.to_bits(); 17];
