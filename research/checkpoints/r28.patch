+ let table=spektrafilm_math::numpy_rng::PreparedPoisson::new();r.upload_aux(graph::FACTORIAL_BASE as u64*4,&graph::encode((0..LOG_FACTORIAL_COUNT).map(|k|table.log_factorial(k as i64))),&mut ||false,&mut metrics).unwrap();
+ r.upload_aux(graph::PARAM_BASE as u64*4,&graph::encode((0..N).map(|i|rates[i as usize%8])),&mut ||false,&mut metrics).unwrap();
+ let mut v=params(1,1,62);v[4]=N;r.dispatch(v,&mut ||false,&mut metrics).unwrap();let raw=r.read_probe(N as u64*256*4,&mut ||false,&mut metrics).unwrap();
+ let f=floats(&raw);
+ // Validate only written halfwords, never padding, before any saturating cast.
+ for i in 0..N as usize{for half in 0..66{let value=f[256*i+half];assert!(value.is_finite()&&value>=0.&&value<=65535.&&value.fract()==0.,"invalid probe halfword lane={i} half={half}: {value}");}}
+ let word=|i:usize,slot:usize|{let at=256*i+2*slot;(f[at]as u32)|((f[at+1]as u32)<<16)};
+ let mut coverage=[[[0u32;3];4];2];
+ for i in 0..N as usize{let prior=(i/128)as u32;let mask=(i/32)%4;assert_eq!(word(i,9),prior);assert_eq!(word(i,10),prior);
+  let middle=word(i,32);
+  if rates[i%8]>=10.{let bucket=if (i/16)%2!=0{2}else if middle>0{0}else{1};coverage[prior as usize][mask][bucket]+=1;}
+  assert_eq!(word(i,31),prior|u32::from(middle>0&&mask!=0),"deferred failure lane {i}");
+  if (i/16)%2!=0&&rates[i%8]!=0.{assert_eq!(middle,0);assert_eq!(word(i,26),0);assert_eq!(word(i,27),4097);assert_eq!(word(i,28),3);}
+ }
+ for prior in 0..2{for mask in 0..4{for bucket in 0..3{
+  assert!(coverage[prior][mask][bucket]>0,"missing required prior={prior} flag={mask} path={bucket} (slow/unused/exhausted); choose additional deterministic fixtures, never relax this coverage gate");
+ }}}
