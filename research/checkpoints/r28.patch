+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Axis {
+    Rows,
+    Columns,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Batch {
+    first: u32,
+    length: u32,
+    count: u32,
+}
+fn batches(p: &Soft64ImagePlan, axis: Axis) -> R<Vec<Batch>> {
+    let (length, total) = match axis {
+        Axis::Rows => (p.0.width, p.0.height),
+        Axis::Columns => (p.0.height, p.0.width),
+    };
+    let per = p.0.sample_capacity.checked_div(length).ok_or(ERROR)?;
+    if per == 0 {
+        return Err(ERROR.into());
+    }
+    let mut result = Vec::new();
+    let mut first = 0;
+    while first < total {
+        let count = per.min(total - first);
+        result.push(Batch {
+            first,
+            length,
+            count,
+        });
+        first = first.checked_add(count).ok_or(ERROR)?;
+    }
+    Ok(result)
+}
