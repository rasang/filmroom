+ }
+ // All exact raw-word constant declarations; no unused function bodies retained.
+ for line in common.lines().filter(|l|l.starts_with("const ")){out.push_str(line);out.push('\n');}
+ for n in reached{out.push_str(all[&n]);out.push('\n');}out.push_str(phase);
+ for forbidden in ["f32","f64","sf_scalar","sf_log","sf_exp_nonpositive","sf_sqrt","fma","pow","sqrt","exp","log"]{
+  if identifiers(&out).contains(forbidden){return Err("GPU_EXPOSURE64_THREEPASS_FORBIDDEN_HELPER".into());}
+ }
+ Ok(out)
+}
diff --git a/native/crates/film-engine/src/research_exposure64_threepass/common.wgsl b/native/crates/film-engine/src/research_exposure64_threepass/common.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..b66c22b825df66361a29f6d89f403ce2a8412339
--- /dev/null
+++ b/native/crates/film-engine/src/research_exposure64_threepass/common.wgsl
@@ -0,0 +1,87 @@
+const EX_BOUND:vec2<u32>=vec2<u32>(0x20000000u,0x430c6bf5u);
+const EX_ZERO:vec2<u32>=vec2<u32>(0u);
+const EX_ONE:vec2<u32>=vec2<u32>(0u,0x3ff00000u);
+const EX_THIRD:vec2<u32>=vec2<u32>(0x55555555u,0x3fd55555u);
+const EX_SIXTH:vec2<u32>=vec2<u32>(0x55555555u,0x3fc55555u);
+const EX_EPS:vec2<u32>=vec2<u32>(0xd9d7bdbbu,0x3ddb7cdfu);
+fn ex_reject(){sf_failed=1u;atomicOr(&error,1u);}
+fn ex_accept(x:vec2<u32>)->bool{
+ if(sf_failed!=0u||!sf_valid(x)){ex_reject();return false;}
+ if(sf_cmpu(sf_abs(x),EX_BOUND)>0){ex_reject();return false;}return true;
+}
+fn ex_add(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{
+ if(!ex_accept(a)||!ex_accept(b)){return SF_NAN;}
+ if(sf_zero(a)&&sf_zero(b)){return vec2<u32>(0u,(a.y&b.y)&0x80000000u);}
+ let r=sf_add(a,b);if(!ex_accept(r)){return SF_NAN;}return r;
+}
+fn ex_sub(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{return ex_add(a,sf_neg(b));}
+fn ex_mul(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{
+ if(!ex_accept(a)||!ex_accept(b)){return SF_NAN;}
+ if(sf_zero(a)||sf_zero(b)){return vec2<u32>(0u,(a.y^b.y)&0x80000000u);}
+ let r=sf_mul(a,b);if(!ex_accept(r)){return SF_NAN;}return r;
+}
+fn ex_div(a:vec2<u32>,b:vec2<u32>)->vec2<u32>{
+ // Invalid/bounded operands and ZERO DENOMINATOR precede zero numerator.
+ if(!ex_accept(a)||!ex_accept(b)){return SF_NAN;}
+ if(sf_zero(b)){ex_reject();return SF_NAN;}
+ if(sf_zero(a)){return vec2<u32>(0u,(a.y^b.y)&0x80000000u);}
+ let r=sf_div(a,b);if(!ex_accept(r)){return SF_NAN;}return r;
+}
+fn ex_cmp(a:vec2<u32>,b:vec2<u32>)->i32{
+ if(!ex_accept(a)||!ex_accept(b)){return 0;}let r=sf_cmp(a,b);
+ if(sf_failed!=0u){ex_reject();}return r;
+}
+fn ex_clamp(a:vec2<u32>,lo:vec2<u32>,hi:vec2<u32>)->vec2<u32>{
+ if(ex_cmp(a,lo)<0){return lo;}if(ex_cmp(a,hi)>0){return hi;}return a;
+}
+fn ex_word(i:u32)->u32{return p.words[i/4u][i%4u];}
+fn ex_param(i:u32)->vec2<u32>{return vec2<u32>(ex_word(4u+2u*i),ex_word(5u+2u*i));}
+fn ex_i(i:u32)->vec2<u32>{return sf_integer(i);}
+fn ex_weight(t:vec2<u32>)->vec2<u32>{
+ let x=sf_abs(t);let b=EX_THIRD;let c=EX_THIRD;
+ if(ex_cmp(x,EX_ONE)<0){
+  let a=ex_sub(ex_sub(ex_i(12u),ex_mul(ex_i(9u),b)),ex_mul(ex_i(6u),c));
+  let d=ex_add(ex_add(sf_neg(ex_i(18u)),ex_mul(ex_i(12u),b)),ex_mul(ex_i(6u),c));
+  let e=ex_sub(ex_i(6u),ex_mul(ex_i(2u),b));
+  let cubic=ex_mul(ex_mul(ex_mul(a,x),x),x);
+  let square=ex_mul(ex_mul(d,x),x);
+  return ex_mul(EX_SIXTH,ex_add(ex_add(cubic,square),e));
+ }
+ if(ex_cmp(x,ex_i(2u))<0){
+  let a=ex_sub(sf_neg(b),ex_mul(ex_i(6u),c));
+  let d=ex_add(ex_mul(ex_i(6u),b),ex_mul(ex_i(30u),c));
+  let e=ex_sub(ex_mul(sf_neg(ex_i(12u)),b),ex_mul(ex_i(48u),c));
+  let f=ex_add(ex_mul(ex_i(8u),b),ex_mul(ex_i(24u),c));
+  let cubic=ex_mul(ex_mul(ex_mul(a,x),x),x);
+  let square=ex_mul(ex_mul(d,x),x);
+  return ex_mul(EX_SIXTH,ex_add(ex_add(ex_add(cubic,square),ex_mul(e,x)),f));
+ }
+ return EX_ZERO;
+}
+fn ex_row(base:u32,r:vec2<u32>,g:vec2<u32>,b_in:vec2<u32>)->vec2<u32>{
+ let a=ex_mul(ex_param(base),r);let b=ex_mul(ex_param(base+1u),g);
+ let ab=ex_add(a,b);let c=ex_mul(ex_param(base+2u),b_in);return ex_add(ab,c);
+}
+fn ex_reflect(index:i32,side:u32)->u32{
+ if(index<0){return u32(-index);}if(index>=i32(side)){return u32(2*(i32(side)-1)-index);}return u32(index);
+}
+fn ex_index(x:vec2<u32>,side:u32)->u32{
+ if(!ex_accept(x)||ex_cmp(x,EX_ZERO)<0||ex_cmp(x,ex_i(side-1u))>0){ex_reject();return 0u;}
+ if(ex_cmp(x,ex_i(side-1u))>=0){return side-2u;}
+ let index=sf_floor(x);if(sf_failed!=0u||index<0||index>=i32(side-1u)){ex_reject();return 0u;}return u32(index);
+}
+// Raw geometry ABI shared only by weight/interpolation phases.
+const GEOM_TAG:u32=0x45583633u;
+fn ex_geometry(base:u32,side:u32)->bool{
+ let state=work[base+4u];
+ if(state.x>1u||state.y!=GEOM_TAG){ex_reject();return false;}
+ for(var i=5u;i<8u;i++){if(any(work[base+i]!=EX_ZERO)){ex_reject();return false;}}
+ if(state.x==0u){
+  for(var i=0u;i<4u;i++){if(any(work[base+i]!=EX_ZERO)){ex_reject();return false;}}
+  return true;
+ }
+ let brightness=work[base];let fx=work[base+1u];let fy=work[base+2u];let cell=work[base+3u];
+ if(!ex_accept(brightness)||!ex_accept(fx)||!ex_accept(fy)){return false;}
+ if(ex_cmp(brightness,EX_EPS)<=0||ex_cmp(fx,EX_ZERO)<0||ex_cmp(fx,EX_ONE)>0||ex_cmp(fy,EX_ZERO)<0||ex_cmp(fy,EX_ONE)>0||cell.x>side-2u||cell.y>side-2u){ex_reject();return false;}
+ return true;
+}
diff --git a/native/crates/film-engine/src/research_exposure64_threepass/geometry.wgsl b/native/crates/film-engine/src/research_exposure64_threepass/geometry.wgsl
new file mode 100644
index 0000000000000000000000000000000000000000..182ce23f78053e65c637c7a83caa42f7df0371d6
--- /dev/null
+++ b/native/crates/film-engine/src/research_exposure64_threepass/geometry.wgsl
@@ -0,0 +1,47 @@
+// A: original geometry only. No weights, table, interpolation or narrowing.
+struct ExposureParams { words: array<vec4<u32>,16>, }
+@group(0) @binding(0) var<uniform> p:ExposureParams;
+@group(0) @binding(1) var<storage,read> input:array<vec2<u32>>;
+@group(0) @binding(2) var<storage,read_write> work:array<vec2<u32>>;
+@group(0) @binding(3) var<storage,read_write> error:atomic<u32>;
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>){
+ if(atomicLoad(&error)!=0u){return;}
+ let count=ex_word(0u);let side=ex_word(1u);let cap=ex_word(2u);
+ if(count==0u||cap==0u||cap>65536u||count>cap||side<2u||side>1024u||ex_word(3u)!=0u){ex_reject();return;}
+ if(arrayLength(&input)!=3u*cap||arrayLength(&work)!=16u*cap){ex_reject();return;}
+ for(var i=44u;i<64u;i++){if(ex_word(i)!=0u){ex_reject();return;}}
+ for(var i=0u;i<20u;i++){if(!ex_accept(ex_param(i))){return;}}
+ if(ex_cmp(ex_param(0u),EX_ZERO)<=0||ex_cmp(ex_param(1u),EX_ZERO)<=0){ex_reject();return;}
+ let pixel=gid.x;if(pixel>=count){return;}
+ let at=3u*pixel;let base=16u*pixel;
+ let rgb0=ex_mul(ex_mul(input[at],ex_param(0u)),ex_param(1u));
+ let rgb1=ex_mul(ex_mul(input[at+1u],ex_param(0u)),ex_param(1u));
+ let rgb2=ex_mul(ex_mul(input[at+2u],ex_param(0u)),ex_param(1u));
+ let native0=ex_row(2u,rgb0,rgb1,rgb2);
+ let native1=ex_row(5u,rgb0,rgb1,rgb2);
+ let native2=ex_row(8u,rgb0,rgb1,rgb2);
+ let xyz0=ex_row(11u,native0,native1,native2);
+ let xyz1=ex_row(14u,native0,native1,native2);
+ let xyz2=ex_row(17u,native0,native1,native2);
+ let brightness=ex_add(ex_add(xyz0,xyz1),xyz2);
+ if(sf_failed!=0u){return;}
+ if(ex_cmp(brightness,EX_EPS)<=0){
+  for(var i=0u;i<8u;i++){work[base+i]=EX_ZERO;}
+  work[base+4u]=vec2<u32>(0u,GEOM_TAG);return;
+ }
+ let x=ex_div(xyz0,brightness);let y=ex_div(xyz1,brightness);
+ let one_minus_x=ex_sub(EX_ONE,x);
+ let tx=ex_clamp(ex_mul(one_minus_x,one_minus_x),EX_ZERO,EX_ONE);
+ var den=one_minus_x;if(ex_cmp(den,EX_EPS)<0){den=EX_EPS;}
+ let ty=ex_clamp(ex_div(y,den),EX_ZERO,EX_ONE);
+ let maximum=ex_i(side-1u);
+ let xf=ex_clamp(ex_mul(tx,maximum),EX_ZERO,maximum);
+ let yf=ex_clamp(ex_mul(ty,maximum),EX_ZERO,maximum);
+ let xi=ex_index(xf,side);let yi=ex_index(yf,side);
+ let fx=ex_sub(xf,ex_i(xi));let fy=ex_sub(yf,ex_i(yi));
+ if(sf_failed!=0u){return;}
+ work[base]=brightness;work[base+1u]=fx;work[base+2u]=fy;
+ work[base+3u]=vec2<u32>(xi,yi);work[base+4u]=vec2<u32>(1u,GEOM_TAG);
+ work[base+5u]=EX_ZERO;work[base+6u]=EX_ZERO;work[base+7u]=EX_ZERO;
+}
diff --git a/native/crates/film-engine/src/research_exposure64_threepass/gpu.rs b/native/crates/film-engine/src/research_exposure64_threepass/gpu.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5b6ee78a18791ff7434a5d8bee0735309464cce8
--- /dev/null
+++ b/native/crates/film-engine/src/research_exposure64_threepass/gpu.rs
@@ -0,0 +1,342 @@
+//! Test-only, one-batch, three-pass typed binary64 exposure. The caller owns the real
+//! session/frame/stage and must drop this call's resources before sealing it.
+//! No session activation, standalone fallback, reset, files, JNI or full chain.
+#![cfg(test)]
+use crate::research_exposure64::Packet;
+use sha2::{Digest, Sha256};
+use crate::{gpu_session as session, gpu_phase_diagnostics::{self as trace, Phase}};
+use std::{sync::{atomic::{AtomicU64, Ordering}, mpsc}, time::{Duration, Instant}};
+
+type R<T> = Result<T, String>;
+const MIB: u64 = 1024 * 1024;
+const HOST_BYTES: u64 = 96 * MIB;
+const FIXED_BYTES: u64 = HOST_BYTES + 64 * MIB; // Host payload + isolated helper.
+const FAMILY_BYTES: u64 = 64 * MIB; // Whole driver/compiler family, not a cheap slot.
+const DEVICE_BYTES: u64 = 64 * MIB; // Pool AND queued upload staging.
+const COMBINED_BYTES: u64 = FIXED_BYTES + 3 * FAMILY_BYTES + DEVICE_BYTES;
+const DEVICE_MARGIN: u64 = 64 * 1024;
+const HOST_METADATA_MARGIN: u64 = 64 * 1024;
+
+#[derive(Debug)]
+pub(crate) struct Stats {
+    pub adapter: String,
+    pub compile_ms: f64,
+    pub compile_family_ms: [f64; 3],
+    pub source_sha256: [String; 3],
+    pub intermediate_bytes: u64,
+    pub device_margin_bytes: u64,
+    pub known_host_payload_bytes: u64,
+    // Candidate submission only; Context pool-clear submissions are caller telemetry.
+    pub submissions: u64,
+    pub upload_ms: f64,
+    pub dispatch_readback_ms: f64,
+    pub resident_bytes: u64,
+    pub upload_bytes: u64,
+    pub upload_staging_bytes: u64,
+    pub reserved_combined_bytes: u64,
+    pub dispatches: u64,
+    pub readbacks: u64,
+    pub releases: u64,
+    pub host_image_arithmetic: bool,
+    // Actual cache counters are available only from caller's post-seal stats.
+    pub pipeline_cache_hits: Option<u64>,
+    pub pipeline_count: u64,
+}
+#[derive(Debug)]
+pub(crate) struct Output {
+    pub raw64: Vec<u64>,
+    pub stats: Stats,
+}
+// Disjoint diagnostic-token range; these never become session epochs.
+static NEXT_TRACE_TOKEN: AtomicU64 = AtomicU64::new(7_300_000_000_000_000_000);
+fn emit_json(value: serde_json::Value) -> bool {
+    use std::io::Write;
+    let Ok(mut line) = serde_json::to_vec(&value) else { return false; };
+    line.push(b'\n');
+    let stderr = std::io::stderr(); let mut sink = stderr.lock();
+    sink.write_all(&line).and_then(|_| sink.flush()).is_ok()
+}
+fn edge(event: &str, family: Option<&str>) {
+    let _ = emit_json(serde_json::json!({"exposure64_threepass_event": event, "family": family, "observationOnly":true}));
+}
+fn layout(kinds: &[Option<bool>]) -> Vec<wgpu::BindGroupLayoutEntry> {
+    kinds.iter().enumerate().map(|(i, kind)| wgpu::BindGroupLayoutEntry {
+        binding: i as u32, visibility: wgpu::ShaderStages::COMPUTE,
+        ty: wgpu::BindingType::Buffer {
+            ty: match kind { None => wgpu::BufferBindingType::Uniform,
+                Some(read_only) => wgpu::BufferBindingType::Storage { read_only: *read_only } },
+            has_dynamic_offset: false,
+            min_binding_size: wgpu::BufferSize::new(if i == 0 { 256 } else if i == kinds.len() - 1 { 4 } else { 8 }),
+        }, count: None,
+    }).collect()
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err("CANCELLED".into()) } else { Ok(()) }
+}
+fn sum(parts: &[u64]) -> R<u64> {
+    parts.iter().try_fold(0u64, |a, b| a.checked_add(*b).ok_or_else(|| "GPU_EXPOSURE64_THREEPASS_BUDGET".into()))
+}
+fn bytes(n: usize, width: u64) -> R<u64> {
+    u64::try_from(n).ok().and_then(|n| n.checked_mul(width)).ok_or_else(|| "GPU_EXPOSURE64_THREEPASS_BUDGET".into())
+}
+fn healthy(context: &session::Context, epoch: u64, c: &mut impl FnMut() -> bool) -> R<()> {
+    check(c)?;
+    if context.error.load(Ordering::Acquire) || session::is_cancelled(epoch) {
+        return Err("GPU_DEVICE_FAILED".into());
+    }
+    Ok(())
+}
+
+/// Exactly one bounded batch in the caller's already-begun session. Failures
+/// retire that epoch; neither cancellation nor partial results permit reuse.
+pub(crate) fn run(packet: &Packet, epoch: u64, c: &mut impl FnMut() -> bool) -> R<Output> {
+    let result = run_inner(packet, epoch, c);
+    if result.is_err() { session::retire_current(); }
+    result
+}
+// Exact-size pool reuse only. Never silently admit another allocation shape in
+// this thread's epoch, nor erase accumulated debt. Session is worker-confined.
+thread_local! {
+    static SHAPE: std::cell::Cell<Option<(u64, u64, u64)>> = const { std::cell::Cell::new(None) };
+}
+fn run_inner(packet: &Packet, epoch: u64, c: &mut impl FnMut() -> bool) -> R<Output> {
+    check(c)?;
+    packet.validate()?;
+    // This preflight must precede acquire: acquire alone permits standalone use.
+    session::validate_fixed_reserve(epoch, FIXED_BYTES)?;
+    if session::is_cancelled(epoch) { return Err("GPU_DEVICE_FAILED".into()); }
+    if !cfg!(target_endian = "little") { return Err("GPU_EXPOSURE64_THREEPASS_ENDIAN".into()); }
+    let pixels = packet.input.len() / 3;
+    if packet.input.is_empty() || packet.input.len() % 3 != 0
+        || packet.chunk_cap == 0 || packet.chunk_cap > 65536
+        || pixels > packet.chunk_cap as usize {
+        return Err("GPU_EXPOSURE64_THREEPASS_CHUNK".into());
+    }
+    let input_bytes = bytes(packet.input.len(), 8)?;
+    let table_bytes = bytes(packet.descriptor.table.len(), 8)?;
+    let capacity_bytes = u64::from(packet.chunk_cap).checked_mul(24).ok_or("GPU_EXPOSURE64_THREEPASS_BUDGET")?;
+    let intermediate_bytes = u64::from(packet.chunk_cap).checked_mul(128).ok_or("GPU_EXPOSURE64_THREEPASS_BUDGET")?;
+    let map_bytes = sum(&[capacity_bytes, 4])?;
+    let mapped_bytes = sum(&[input_bytes, 4])?;
+    let shape = (epoch, capacity_bytes, table_bytes);
+    SHAPE.with(|v| match v.get() {
+        None => { v.set(Some(shape)); Ok(()) },
+        Some(old) if old == shape => Ok(()),
+        _ => Err("GPU_EXPOSURE64_THREEPASS_ALLOCATION_SHAPE_CHANGED".to_string()),
+    })?;
+    let resident_bytes = sum(&[capacity_bytes, table_bytes, intermediate_bytes, capacity_bytes, map_bytes, 4, 256])?;
+    let upload_bytes = sum(&[capacity_bytes, table_bytes, 256])?;
+    if table_bytes == 0 || sum(&[resident_bytes, upload_bytes, DEVICE_MARGIN])? > DEVICE_BYTES {
+        return Err("GPU_EXPOSURE64_THREEPASS_BUDGET".into());
+    }
+    // Reserve the original host vectors, serialized uploads and decoded output
+    // simultaneously. Capacities count too; the 96 MiB is not just input size.
+    let host_bytes = sum(&[bytes(packet.input.capacity(), 8)?,
+        bytes(packet.descriptor.table.capacity(), 8)?, upload_bytes, input_bytes, HOST_METADATA_MARGIN])?;
+    if host_bytes > HOST_BYTES { return Err("GPU_EXPOSURE64_THREEPASS_HOST_BUDGET".into()); }
+    let sources = trace::phase_result(Phase::Prepare, super::shaders)?;
+    let source_bytes = sum(&sources.iter().map(|s| bytes(s.capacity(), 1)).collect::<R<Vec<_>>>()?)?;
+    // Only runner-owned and supplied Packet payloads are visible here. Caller
+    // must reconcile retained oracle/fixture allocations before calling run.
+    let known_host_payload_bytes = sum(&[host_bytes, source_bytes])?;
+    if known_host_payload_bytes > HOST_BYTES {
+        return Err("GPU_EXPOSURE64_THREEPASS_HOST_BUDGET".into());
+    }
+    check(c)?;
+    let context = trace::phase_result(Phase::Device, || {
+        session::Context::acquire(map_bytes.max(table_bytes).max(intermediate_bytes).max(256), 4, true)
+    })?;
+    // All GPU resources live inside this closure, and die before Context does.
+    let result = (|| {
+        healthy(&context, epoch, c)?;
+        // Each one-source call pays a full 64 MiB family on a cache miss.
+        let layouts = [layout(&[None, Some(true), Some(false), Some(false)]),
+            layout(&[None, Some(false), Some(false)]),
+            layout(&[None, Some(true), Some(true), Some(false), Some(false)])];
+        let source_sha256: [String; 3] = std::array::from_fn(|i| format!("{:x}", Sha256::digest(sources[i].as_bytes())));
+        let mut pipelines = Vec::with_capacity(3);
+        let mut compile_family_ms = [0.; 3];
+        for i in 0..3 {
+            healthy(&context, epoch, c)?;
+            let family = ["A", "B", "C"][i];
+            let hash = source_sha256[i].clone();
+            let token = NEXT_TRACE_TOKEN.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+                |n| n.checked_add(1)).map_err(|_| "GPU_EXPOSURE64_THREEPASS_TRACE_TOKEN")?;
+            let mut scope = trace::TaskScope::for_test(token, 8, move |snapshot| {
+                emit_json(serde_json::json!({"exposure64_threepass_family": family,
+                    "source_sha256": hash, "snapshot": snapshot, "observationOnly":true}))
+            });
+            edge("family_begin", Some(family));
+            let compile_at = Instant::now();
+            let compiled = trace::phase_result(Phase::Pipeline,
+                || context.pipelines(&[&sources[i]], Some(&layouts[i])));
+            compile_family_ms[i] = compile_at.elapsed().as_secs_f64() * 1000.;
+            scope.finish(&compiled);
+            edge(if compiled.is_ok() { "family_end" } else { "family_error" }, Some(family));
+            drop(scope); // Restore the caller's diagnostic task, not the epoch.
+            let (mut one, _) = compiled?;
+            if one.len() != 1 { return Err("GPU_EXPOSURE64_THREEPASS_PIPELINE_COUNT".into()); }
+            pipelines.push(one.pop().ok_or("GPU_EXPOSURE64_THREEPASS_PIPELINE")?);
+        }
+        let compile_ms = compile_family_ms.iter().sum();
+        healthy(&context, epoch, c)?;
+        let upload_phase = trace::PhaseGuard::begin(Phase::Upload);
+        edge("upload_begin", None);
+        let at = Instant::now();
+        // Preflight accounted these exact serialized sizes before allocation.
+        // Reserve full capacity up front, avoiding resize's geometric growth.
+        let mut input_words = Vec::with_capacity((capacity_bytes / 4) as usize);
+        input_words.extend(packet.input.iter().flat_map(|v| [*v as u32, (*v >> 32) as u32]));
+        let mut table_words = Vec::with_capacity((table_bytes / 4) as usize);
+        table_words.extend(packet.descriptor.table.iter().flat_map(|v| {
+            let b = v.to_bits(); [b as u32, (b >> 32) as u32]
+        }));
+        let params = packet.params();
+        if bytes(input_words.len(), 4)? != input_bytes { return Err("GPU_EXPOSURE64_THREEPASS_INPUT".into()); }
+        input_words.resize((capacity_bytes / 4) as usize, 0);
+        if bytes(input_words.len(), 4)? != capacity_bytes || bytes(table_words.len(), 4)? != table_bytes
+            || sum(&[bytes(packet.input.capacity(), 8)?, bytes(packet.descriptor.table.capacity(), 8)?,
+                bytes(input_words.capacity(), 4)?, bytes(table_words.capacity(), 4)?, 256,
+                input_bytes, source_bytes, HOST_METADATA_MARGIN])? > HOST_BYTES {
