+        channel: 0,
+        component: 0,
+    };
+    let input = [[0; 3]];
+    let mut wrong = new.clone();
+    wrong.initial.axis[0] ^= 1;
+    assert!(Packet::new_mixed(&wrong, job, &input).is_err());
+    let mut wrong = new.clone();
+    wrong.before_dir.inverse_dx[0] ^= 1;
+    assert!(Packet::new_mixed(&wrong, job, &input).is_err());
+    let mut wrong = new.clone();
+    if let Gaussian::Fir {
+        coefficient_bits, ..
+    } = &mut wrong.filters.as_mut().unwrap()[0]
+    {
+        coefficient_bits[0] ^= 1;
+    } else {
+        panic!("fixture must be FIR");
+    }
+    assert!(Packet::new_mixed(&wrong, job, &input).is_err());
+    assert!(Packet::new_mixed(&new, job, &[[0, f64::NAN.to_bits(), 0]]).is_err());
+}
+#[test]
+fn mixed_point_view_preserves_point_only_job_domain_and_cancellation() {
+    let mut pipe = tests::pipeline();
+    pipe.params.film_render.dir_couplers.diffusion_size_um = 0.;
+    let new = DirMixedCalibration::from_pipeline(&pipe, 10., 17, 13).unwrap();
+    let filtered = Job {
+        operation: Operation::RedevelopFiltered,
+        channel: 0,
+        component: 0,
+    };
+    assert!(Packet::new_mixed(&new, filtered, &[[0; 3]]).is_err());
+    let unfiltered = Job {
+        operation: Operation::RedevelopUnfiltered,
+        channel: 0,
+        component: 0,
+    };
+    assert!(Packet::new_mixed(&new, unfiltered, &[[0; 3]]).is_ok());
+    assert_eq!(
+        evaluate_mixed(&new, unfiltered, &[[0; 3]], &mut || true).unwrap_err(),
+        "GPU_DIR64_POINT_CANCELLED"
+    );
+}
