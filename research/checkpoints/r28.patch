+        ("pipelineBytes", serde_json::json!(PIPELINE_BYTES - 1)),
+        ("pipelineCount", serde_json::json!(2)),
+        ("diskBytes", serde_json::json!(1)),
+        ("layout", serde_json::json!("array_vec2_uniform")),
+        ("errorPolicy", serde_json::json!("accept_zero_on_failure")),
+        ("zeroPolicy", serde_json::json!("all_bits_identical")),
+        ("librarySha256", serde_json::json!("changed")),
+        ("kernelSha256", serde_json::json!("changed")),
+        ("shaderSha256", serde_json::json!("changed")),
+    ] {
+        let mut changed = value.clone();
+        changed[field] = replacement;
+        let decoded: Plan = serde_json::from_value(changed).unwrap();
+        assert!(
+            decoded.validate().is_err(),
+            "accepted changed field {field}"
