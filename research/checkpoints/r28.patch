+#[test]
+fn cancellation_after_marker_creation_removes_all_candidates() {
+    let f = Fixture::new(3, 2);
+    let p = f.plan(calibration(3, 2), 6, 6, "cancel-at-marker");
+    let mut gpu = HostCompute::new(Behavior::Echo);
+    let marker = p.paths().candidate_marker.clone();
+    let error = run(&p, &mut gpu, &mut || marker.exists()).unwrap_err();
+    assert!(error.contains("CANCELLED"));
+    assert_failed_clean(&f, &p, &gpu);
+}
