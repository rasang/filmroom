+const OPERATION: &str = "closed-dir-mixed-from-original-log64";
+const LAYOUT: &str = "raw64-dir-log-mixed-graph-v2";
+
+// Only the separately typed entrances select a policy. No serialized bypass
+// flag can admit derived evidence through the original graph or receipt.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum InputPolicy {
+    Original,
+    DerivedGpuF32Mixed,
+}
+impl InputPolicy {
+    fn kind(self) -> &'static str {
+        match self {
+            Self::Original => "original-log64-test-fixture-v1",
+            Self::DerivedGpuF32Mixed => "gpu-f32-log-promoted",
+        }
+    }
+    fn precision(self) -> &'static str {
+        match self {
+            Self::Original => "precision-f64",
+            Self::DerivedGpuF32Mixed => "gpu-f32-promoted-to-binary64",
+        }
+    }
+    fn producer(self) -> &'static str {
+        match self {
+            Self::Original => "spektrafilm_core::stages::filming::expose",
+            Self::DerivedGpuF32Mixed => "verified-native-fullExposureLog",
+        }
+    }
+    fn operation(self) -> &'static str {
+        match self {
+            Self::Original => OPERATION,
+            Self::DerivedGpuF32Mixed => "closed-dir-mixed-from-gpu-f32-log-promoted",
+        }
+    }
+    fn layout(self) -> &'static str {
+        match self {
+            Self::Original => LAYOUT,
+            Self::DerivedGpuF32Mixed => "raw64-dir-derived-gpu-f32-log-mixed-v2",
+        }
+    }
+    fn status(self) -> &'static str {
+        match self {
+            Self::Original => "privateMixedCandidateReadyRequiresOuterSealOrConfirmedHelperDeath",
+            Self::DerivedGpuF32Mixed => {
+                "privateDerivedMixedCandidateReadyRequiresOuterSealOrConfirmedHelperDeath"
+            }
+        }
+    }
+}
