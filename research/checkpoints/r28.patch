+fn causal_trace_layer(out:&Path,plan:&crate::research_grain::GrainPlan,ch:usize,sl:usize,a:&[f64],b:&[f64])->Value{
+ use std::io::{BufWriter,Write};use spektrafilm_math::numpy_rng::{rk_poisson,rk_binomial};
+ let layer=&plan.layers[ch][sl];let n=a.len();assert_eq!(n,b.len());
+ let mapped:[Vec<f64>;2]=[a,b].map(|v|v.iter().map(|&v|layer.mapped_f64(v,plan.positive)).collect());
+ let probabilities:[Vec<f64>;2]=std::array::from_fn(|j|mapped[j].iter().map(|v|(v/layer.density_max).clamp(1e-6,1.-1e-6)).collect());
+ let sat:[Vec<f64>;2]=std::array::from_fn(|j|probabilities[j].iter().map(|&p|1.-p*layer.uniformity*(1.-1e-6)).collect());
+ let mut rng=[CausalMt::new(layer.seed),CausalMt::new(layer.seed)];let mut particles=[vec![0u64;n],vec![0;n]];let mut developed=[vec![0u64;n],vec![0;n]];let mut records=Vec::new();
+ for phase in ["poisson","binomial"]{
+  let mut files:[BufWriter<File>;2]=std::array::from_fn(|j|BufWriter::new(File::create(out.join(format!("ch{ch}-layer{sl}-{phase}-{}.count-cursor.u64le",["cpu-input","gpu-input"][j]))).unwrap()));
+  let mut first_count=None;let mut first_cursor=None;let mut changed_counts=0u64;let mut changed_cursors=0u64;
+  let begin=[rng[0].words,rng[1].words];
+  for i in 0..n{
+   let before=[rng[0].words,rng[1].words];let mut value=[0u64;2];
+   for j in 0..2{value[j]=if phase=="poisson"{let v=rk_poisson(&mut rng[j],layer.particles/sat[j][i]);particles[j][i]=v;v}else{let v=rk_binomial(&mut rng[j],particles[j][i],probabilities[j][i]);developed[j][i]=v;v};files[j].write_all(&value[j].to_le_bytes()).unwrap();files[j].write_all(&rng[j].words.to_le_bytes()).unwrap();}
+   let witness=||json!({"index":i,"xy":[i%plan.width as usize,i/plan.width as usize],"mappedBits":[mapped[0][i].to_bits(),mapped[1][i].to_bits()],"probabilityBits":[probabilities[0][i].to_bits(),probabilities[1][i].to_bits()],"lambdaBits":[(layer.particles/sat[0][i]).to_bits(),(layer.particles/sat[1][i]).to_bits()],"counts":value,"beforeWords":before,"afterWords":[rng[0].words,rng[1].words]});
+   if value[0]!=value[1]{changed_counts+=1;if first_count.is_none(){first_count=Some(witness());}}
+   if rng[0].words!=rng[1].words{changed_cursors+=1;if first_cursor.is_none(){first_cursor=Some(witness());}}
+  }
+  for f in &mut files{f.flush().unwrap();}
+  records.push(json!({"phase":phase,"beginWords":begin,"endWords":[rng[0].words,rng[1].words],"next624WordSha256":[rng[0].fingerprint(),rng[1].fingerprint()],"countMismatchPixels":changed_counts,"cursorMismatchPixels":changed_cursors,"firstCountMismatch":first_count,"firstCursorMismatch":first_cursor}));
+ }
+ // Independent same-input control: the counted original sampler must reproduce
+ // the uninstrumented original complete unblurred layer bit for bit.
+ for j in 0..2{let expected=spektrafilm_model::grain::layer_particle_model(&mapped[j],plan.width,plan.height,layer.density_max,layer.particles,layer.uniformity,layer.seed,0.,None);for i in 0..n{let value=developed[j][i]as f64*(layer.density_max/layer.particles)*sat[j][i];assert_eq!(value.to_bits(),expected[i].to_bits(),"same-input original trace ch{ch} layer{sl} input{j} pixel{i}");}}
+ json!({"channel":ch,"layer":sl,"seed":layer.seed,"phases":records})
+}
