+#[test]
+fn real_fifty_megapixel_geometry_and_explicit_36mm_pitch_are_not_35mm_format() {
+    let pipe = pipeline(false);
+    assert_eq!(
+        pipe.params.camera.film_format_mm.to_bits(),
+        35_f32.to_bits()
+    );
+    let recorded = DirCalibration::from_pipeline(pipe, FIXTURE_PITCH, 8192, 6144).unwrap();
+    assert_eq!(
+        u64::from(recorded.width) * u64::from(recorded.height),
+        50_331_648
+    );
+    assert_eq!(recorded.pitch_bits, 4.39453125_f32.to_bits());
+    assert_eq!(recorded.film_format_mm_bits, 35_f32.to_bits());
+    let actual_format_pitch = pipe.params.camera.film_format_mm * 1000. / 8192.;
+    let actual_format =
+        DirCalibration::from_pipeline(pipe, actual_format_pitch, 8192, 6144).unwrap();
+    assert_ne!(recorded.pitch_bits, actual_format.pitch_bits);
+    assert_ne!(recorded.core_sigma_bits, actual_format.core_sigma_bits);
+    assert_ne!(recorded.tail_sigma_bits, actual_format.tail_sigma_bits);
+    let d = &pipe.params.film_render.dir_couplers;
+    for calibration in [&recorded, &actual_format] {
+        let pitch = f32::from_bits(calibration.pitch_bits);
+        let core = (d.diffusion_size_um / pitch as f64) as f32;
+        let decay = (d.diffusion_tail_um / pitch as f64) as f32;
+        let sigmas = [
+            core,
+            (0.5360 * decay as f64) as f32,
+            (1.5236 * decay as f64) as f32,
+            (2.7684 * decay as f64) as f32,
+        ];
+        assert_eq!(
+            calibration.coefficient_bits,
+            Some(sigmas.map(original_coefficients))
+        );
+        calibration.validate().unwrap();
+    }
+    // Calibration allocates only bounded original tables, never 50MP planes.
+    assert_eq!(recorded.initial, fixture().initial);
+    assert_eq!(recorded.before_dir, fixture().before_dir);
+}
