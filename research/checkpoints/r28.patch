+fn raw_image_final_map_fault(epoch: u64, cancel: bool) {
+    use crate::gpu_session as session;
+    use std::sync::{Arc, atomic::AtomicBool};
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 1).unwrap();
+    let ticket = begin(epoch, 1);
+    let mut gpu = RawGpu::new(&mut || false).unwrap();
+    let flag = Arc::new(AtomicBool::new(false));
+    gpu.after_unmap_fault = Some(if cancel {
+        AfterUnmapFault::Cancel(flag.clone())
+    } else {
+        AfterUnmapFault::DeviceError
+    });
+    let f = Fixture::new(17, 31, 0x41a757a2, CAPACITY, image_values(17, 31, 2));
+    let result = gpu.run_files(&f.plan, &mut || flag.load(Ordering::Acquire));
+    assert_eq!(
+        result.unwrap_err(),
+        if cancel {
+            "CANCELLED"
+        } else {
+            "GPU_DEVICE_FAILED"
+        }
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert_eq!(gpu.metrics.completed_readbacks, 1);
+    assert_eq!(gpu.metrics.transient_releases, 0);
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    f.assert_no_candidate();
+    let spec = LineSpec {
+        length: 17,
+        lines: 1,
+        sigma_bits: 0x41a757a2,
+        coefficient_bits: coefficients_for_sigma(f32::from_bits(0x41a757a2)).unwrap(),
+    };
+    assert_eq!(
+        gpu.execute(&spec, &f.values[..17], &mut || false)
+            .unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+}
