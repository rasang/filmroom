+use super::super::BOUND;
+use super::super::dir_point::{Operation, POINT_CAPACITY, PREFIX_WORDS, tests as oracle};
+use super::*;
+use crate::{gpu_session as session, gpu_session_contract::StageTicket};
+
+const POINT_BATCH: usize = 256;
+
+fn job(operation: Operation, channel: u32, component: u32) -> Job {
+    Job {
+        operation,
+        channel,
+        component,
+    }
+}
+fn begin(epoch: u64, generation: u64) -> StageTicket {
+    let ticket = StageTicket {
+        epoch,
+        generation,
+        sequence: generation,
+    };
+    session::begin_frame(epoch, generation).unwrap();
+    session::begin_stage(ticket, DRIVER_BYTES).unwrap();
+    ticket
+}
+fn open(epoch: u64) -> (StageTicket, DirGpu) {
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 2).unwrap();
+    let ticket = begin(epoch, 1);
+    let gpu = DirGpu::new(&mut || false).unwrap();
+    (ticket, gpu)
+}
+fn finish(ticket: StageTicket, gpu: DirGpu) -> session::SessionStats {
+    assert_eq!(
+        gpu.metrics.completed_readbacks,
+        gpu.metrics.point_dispatches + gpu.metrics.raw_dispatches
+    );
+    assert_eq!(
+        gpu.metrics.completed_readbacks,
+        gpu.metrics.transient_releases
+    );
+    assert!(
+        session::complete_stage(ticket).is_err(),
+        "a live owner cannot seal"
+    );
+    eprintln!("DIR64 isolated point/raw metrics: {:?}", gpu.metrics);
+    drop(gpu);
+    let stats = session::complete_stage(ticket).unwrap();
+    assert_eq!(stats.pipeline_slots, 2);
+    assert_eq!(stats.pool_bytes, RESIDENT_BYTES);
+    assert_eq!(
+        stats.charged_bytes,
+        FIXED_BYTES + DRIVER_BYTES + RESIDENT_BYTES
+    );
+    assert!(stats.charged_bytes + BATCH_BYTES <= COMBINED_BYTES);
+    session::finish_frame(ticket.epoch, ticket.generation).unwrap();
+    stats
+}
+fn compare_points(gpu: &mut DirGpu, p: &DirCalibration, j: Job, values: &[[u64; 3]]) {
+    let mut zero_sign_differences = 0;
+    let mut compared = 0;
+    for part in values.chunks(POINT_BATCH) {
+        let expected = oracle::original(p, j, part);
+        let actual = gpu.point(p, j, part, &mut || false).unwrap();
+        assert!(actual.iter().chain(&expected).all(|&x| admitted(x)));
+        zero_sign_differences += oracle::assert_words(&actual, &expected, "actual DIR64 point");
+        compared += part.len();
+    }
+    assert_eq!(compared, values.len());
+    eprintln!(
+        "DIR64 original oracle operation={:?} channel={} component={} compared={} zero_sign_differences={zero_sign_differences}",
+        j.operation, j.channel, j.component, compared
+    );
+}
+fn point_values() -> Vec<[u64; 3]> {
+    let mut values: Vec<_> = (0..513)
+        .map(|i| {
+            let x = i as f64 / 512.;
+            [
+                (6. * x - 3.).to_bits(),
+                (0.7 * x - 0.03).to_bits(),
+                (0.9 * x - 0.01).to_bits(),
+            ]
+        })
+        .collect();
+    values.extend([
+        [0, 0, 0],
+        [(-0f64).to_bits(); 3],
+        [0, (-0f64).to_bits(), 0],
+        [(-1f64).to_bits(), 1f64.to_bits(), (-1f64).to_bits()],
+    ]);
+    values
+}
