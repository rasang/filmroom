+    for i in 0..16 {
+        let mut corrupt = packet.clone();
+        corrupt.parameters[i] ^= 1;
+        assert!(corrupt.validate(&plan).is_err(), "uniform word {i}");
+    }
+    for i in 0..PREFIX_WORDS as usize {
+        for replacement in [
+            1u64,
+            (-0f64).to_bits(),
+            f64::NAN.to_bits(),
+            super::super::BOUND.to_bits() + 1,
+        ] {
+            let mut corrupt = packet.clone();
+            corrupt.words[i] = replacement;
+            assert!(corrupt.validate(&plan).is_err(), "prefix word {i}");
+        }
+    }
+    for i in 0..plan.coefficient_bits.len() {
+        for replacement in [0, plan.coefficient_bits[i] ^ 1] {
+            let mut corrupt = packet.clone();
+            corrupt.words[i] = replacement;
+            assert!(corrupt.validate(&plan).is_err(), "coefficient word {i}");
+        }
+    }
+    for bad in [
+        1,
+        f64::INFINITY.to_bits(),
+        super::super::BOUND.to_bits() + 1,
+    ] {
+        let mut corrupt = packet.clone();
+        *corrupt.words.last_mut().unwrap() = bad;
+        assert!(corrupt.validate(&plan).is_err());
+    }
+    for count in [0, 31, 33, u32::MAX] {
+        let mut corrupt = packet.clone();
+        corrupt.invocations = count;
+        assert!(corrupt.validate(&plan).is_err());
+    }
+    for size in [0, 1, 31, 32, packet.words.len() - 1] {
+        let mut corrupt = packet.clone();
+        corrupt.words.truncate(size);
+        assert!(corrupt.validate(&plan).is_err());
+    }
+    let mut extra = packet;
+    extra.words.push(0);
+    assert!(extra.validate(&plan).is_err());
+}
