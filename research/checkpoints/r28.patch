+#[test]
+fn original_all_iir_fields_and_legacy_wire_identity_remain_exact() {
+    for positive in [false, true] {
+        for gamma in [1., 1.3] {
+            let mut pipe = pipeline(positive).clone();
+            pipe.params.film_render.density_curve_gamma = gamma;
+            let legacy = DirCalibration::from_pipeline(&pipe, LEGACY_PITCH, 23, 17).unwrap();
+            let mixed = DirMixedCalibration::from_pipeline(&pipe, LEGACY_PITCH, 23, 17).unwrap();
+            assert_original_point(&mixed, &pipe);
+            assert_eq!(mixed.initial, legacy.initial);
+            assert_eq!(mixed.before_dir, legacy.before_dir);
+            assert_eq!(mixed.matrix_bits, legacy.matrix_bits);
+            assert_eq!(mixed.density_max_bits, legacy.density_max_bits);
+            let filters = mixed.filters.as_ref().unwrap();
+            for (filter, coefficients) in filters.iter().zip(legacy.coefficient_bits.unwrap()) {
+                let Gaussian::Iir {
+                    sigma_bits,
+                    coefficient_bits,
+                } = filter
+                else {
+                    panic!("expected legacy IIR");
+                };
+                assert_eq!(*coefficient_bits, coefficients);
+                assert_eq!(*coefficient_bits, original_iir(f32::from_bits(*sigma_bits)));
+            }
+            let legacy_value = serde_json::to_value(&legacy).unwrap();
+            assert_eq!(
+                legacy_value["recipe"],
+                json!("original-dir-calibration-f64-initial-f32-before-dir-v1")
+            );
+            assert_eq!(legacy_value["version"], json!(1));
+            assert!(legacy_value.get("filters").is_none());
+            assert!(legacy_value["coefficientBits"][0][0].is_string());
+            // The entire preexisting wire field set and values, not a selected
+            // point-table subset, must survive the factoring unchanged.
+            let mut projected = serde_json::to_value(&mixed).unwrap();
+            let object = projected.as_object_mut().unwrap();
+            object.remove("filters");
+            object.remove("originalGaussianSha256");
+            object.remove("originalCouplersSha256");
+            object.remove("originalDensityCurvesSha256");
+            object.insert(
+                "coefficientBits".into(),
+                legacy_value["coefficientBits"].clone(),
+            );
+            object.insert("recipe".into(), legacy_value["recipe"].clone());
+            object.insert("version".into(), json!(1));
+            assert_eq!(projected, legacy_value);
+            let text = serde_json::to_string(&legacy).unwrap();
+            assert_eq!(
+                serde_json::from_str::<DirCalibration>(&text).unwrap(),
+                legacy
+            );
+            assert!(serde_json::from_str::<DirMixedCalibration>(&text).is_err());
+            let duplicate = text.replacen("\"width\":23", "\"width\":23,\"width\":23", 1);
+            assert!(serde_json::from_str::<DirCalibration>(&duplicate).is_err());
+            let mut malformed = legacy_value.clone();
+            malformed["filters"] = json!(null);
+            assert!(serde_json::from_value::<DirCalibration>(malformed).is_err());
+            let mut malformed = legacy_value;
+            malformed.as_object_mut().unwrap().remove("coefficientBits");
