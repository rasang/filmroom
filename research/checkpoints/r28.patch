+//! Standalone closed original-f64 FIR complete-line probe, not a rendering route.
+//! Only the small coefficient table is prepared on the CPU. Image arithmetic
+//! uses the unchanged guarded integer-soft64 operations, without an f32 cast.
+//! These resources describe one standalone family, not the three-family DIR
+//! owner. No source provenance, file graph, or production integration is claimed.
+#![cfg(test)]
+
+use super::{Guard, R, admitted, digest, fir_kernel};
+use serde::{Deserialize, Deserializer, Serialize};
+
+pub(super) const PREFIX_WORDS: u32 = 32;
+pub(super) const CAPACITY: u32 = super::CAPACITY - PREFIX_WORDS;
+pub(super) const MAX_KERNEL: u32 = 19;
+pub(super) const MAP_BYTES: u64 = super::BATCH_BYTES + 4;
+pub(super) const POOL_BYTES: u64 = 2 * super::BATCH_BYTES + MAP_BYTES + 4 + 64;
+pub(super) const UPLOAD_BYTES: u64 = super::BATCH_BYTES;
+pub(super) const DEVICE_BYTES: u64 = 20 * super::MIB + 65_536;
+pub(super) const HOST_BYTES: u64 = 64 * super::MIB;
+pub(super) const HELPER_BYTES: u64 = 64 * super::MIB;
+pub(super) const DRIVER_BYTES: u64 = 72 * super::MIB;
+pub(super) const COMBINED_BYTES: u64 = DEVICE_BYTES + HOST_BYTES + HELPER_BYTES + DRIVER_BYTES;
+pub(super) const ERROR: &str = "GPU_FIR_SOFT64_DESCRIPTOR";
+pub(super) const DOMAIN_ERROR: &str = "GPU_FIR_SOFT64_NUMERIC_DOMAIN";
+const VERSION: u32 = 1;
+const OPERATION: &str = "standalone_original_f64_fir_complete_lines";
+const COEFFICIENT_SOURCE: &str = "original_make_gaussian_kernel_ordered_f64_from_f32_sigma";
+const REFLECTION: &str = "half_sample_symmetric_repeated_period_2_length";
+const ERROR_POLICY: &str = "request_sticky_reject_nonfinite_subnormal_or_per_operation_bound";
+const ZERO_POLICY: &str =
+    "identity_copy_preserves_signed_zero_positive_sigma_fir_sum_starts_positive_zero";
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Resources {
+    source_bytes: u64,
+    result_bytes: u64,
+    readback_bytes: u64,
+    error_bytes: u64,
+    uniform_bytes: u64,
+    pool_bytes: u64,
+    upload_allowance_bytes: u64,
+    device_headroom_bytes: u64,
+    device_reservation_bytes: u64,
+    host_bytes: u64,
+    helper_bytes: u64,
+    driver_bytes: u64,
+    combined_reservation_bytes: u64,
+    pipeline_count: u32,
+    disk_bytes: u64,
+}
+impl Resources {
+    fn standalone() -> Self {
+        Self {
+            source_bytes: super::BATCH_BYTES,
+            result_bytes: super::BATCH_BYTES,
+            readback_bytes: MAP_BYTES,
+            error_bytes: 4,
+            uniform_bytes: 64,
+            pool_bytes: POOL_BYTES,
+            upload_allowance_bytes: UPLOAD_BYTES,
+            device_headroom_bytes: DEVICE_BYTES - POOL_BYTES - UPLOAD_BYTES,
+            device_reservation_bytes: DEVICE_BYTES,
+            host_bytes: HOST_BYTES,
+            helper_bytes: HELPER_BYTES,
+            driver_bytes: DRIVER_BYTES,
+            combined_reservation_bytes: COMBINED_BYTES,
+            pipeline_count: 1,
+            disk_bytes: 0,
+        }
+    }
+}
+
+// One field list defines the serializable checked value and its private wire
+// shape. Unknown, duplicate, missing, and inconsistent fields fail at decoding.
+macro_rules! validated_spec {
+    ($($(#[$attr:meta])* $visibility:vis $field:ident: $ty:ty),* $(,)?) => {
+        #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        pub(super) struct FirSpec {
+            $($(#[$attr])* $visibility $field: $ty,)*
+        }
+        #[derive(Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct FirSpecWire {
+            $($(#[$attr])* $field: $ty,)*
+        }
+        impl<'de> Deserialize<'de> for FirSpec {
+            fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+                let wire = FirSpecWire::deserialize(deserializer)?;
+                let spec = Self { $($field: wire.$field,)* };
+                spec.validate().map_err(serde::de::Error::custom)?;
+                Ok(spec)
+            }
+        }
+    };
+}
+validated_spec! {
+    version: u32,
+    operation: String,
+    mode: u32,
+    coefficient_source: String,
+    pub(super) sigma_bits: u32,
+    pub(super) length: u32,
+    pub(super) lines: u32,
+    pub(super) radius: u32,
+    #[serde(with = "word_vec")]
+    pub(super) coefficient_bits: Vec<u64>,
+    prefix_words: u32,
+    sample_capacity: u32,
+    maximum_kernel_words: u32,
+    source_scalar_bytes: u32,
+    result_scalar_bytes: u32,
+    reflection: String,
+    error_policy: String,
+    zero_policy: String,
+    #[serde(with = "word")]
+    bound_bits: u64,
+    layout: String,
+    original_gaussian_sha256: String,
+    shared_library_sha256: String,
+    kernel_sha256: String,
+    composed_shader_sha256: String,
+    resources: Resources,
+}
+
+impl FirSpec {
+    pub(super) fn new(sigma: f32, length: u32, lines: u32) -> R<Self> {
+        let (mode, radius, coefficient_bits) = calibration(sigma)?;
+        let spec = Self {
+            version: VERSION,
+            operation: OPERATION.into(),
+            mode,
+            coefficient_source: COEFFICIENT_SOURCE.into(),
+            sigma_bits: sigma.to_bits(),
+            length,
+            lines,
+            radius,
+            coefficient_bits,
+            prefix_words: PREFIX_WORDS,
+            sample_capacity: CAPACITY,
+            maximum_kernel_words: MAX_KERNEL,
+            source_scalar_bytes: 8,
+            result_scalar_bytes: 8,
+            reflection: REFLECTION.into(),
+            error_policy: ERROR_POLICY.into(),
+            zero_policy: ZERO_POLICY.into(),
+            bound_bits: super::BOUND.to_bits(),
+            layout: fir_kernel::LAYOUT.into(),
+            original_gaussian_sha256: super::ORIGINAL_GAUSSIAN_SHA256.into(),
+            shared_library_sha256: super::SOFT64_SHA256.into(),
+            kernel_sha256: fir_kernel::KERNEL_SHA256.into(),
+            composed_shader_sha256: digest(fir_kernel::shader()?.as_bytes()),
+            resources: Resources::standalone(),
+        };
+        spec.validate()?;
+        Ok(spec)
+    }
+
+    pub(super) fn validate(&self) -> R<()> {
+        self.sample_count()?;
+        let (mode, radius, coefficients) = calibration(f32::from_bits(self.sigma_bits))?;
+        if self.version != VERSION
+            || self.operation != OPERATION
+            || self.mode != mode
+            || self.coefficient_source != COEFFICIENT_SOURCE
+            || self.radius != radius
+            || self.coefficient_bits != coefficients
+            || self.prefix_words != PREFIX_WORDS
+            || self.sample_capacity != CAPACITY
+            || self.maximum_kernel_words != MAX_KERNEL
+            || self.source_scalar_bytes != 8
+            || self.result_scalar_bytes != 8
+            || self.reflection != REFLECTION
+            || self.error_policy != ERROR_POLICY
+            || self.zero_policy != ZERO_POLICY
+            || self.bound_bits != super::BOUND.to_bits()
+            || self.layout != fir_kernel::LAYOUT
+            || self.original_gaussian_sha256 != super::ORIGINAL_GAUSSIAN_SHA256
+            || digest(super::ORIGINAL_GAUSSIAN.as_bytes()) != super::ORIGINAL_GAUSSIAN_SHA256
+            || self.shared_library_sha256 != super::SOFT64_SHA256
+            || self.kernel_sha256 != fir_kernel::KERNEL_SHA256
+            || self.composed_shader_sha256 != digest(fir_kernel::shader()?.as_bytes())
+            || self.resources != Resources::standalone()
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+
+    /// Checked geometry only; execution entry points also validate the identity.
+    pub(super) fn sample_count(&self) -> R<usize> {
+        let count = self.length.checked_mul(self.lines).ok_or(ERROR)?;
+        if !(1..=40_000).contains(&self.length) || self.lines == 0 || count > CAPACITY {
+            return Err(ERROR.into());
+        }
+        usize::try_from(count).map_err(|_| ERROR.into())
+    }
+
+    pub(super) fn validate_input(&self, values: &[u64]) -> R<()> {
+        self.validate()?;
+        if values.len() != self.sample_count()? || values.iter().any(|&bits| !admitted(bits)) {
+            return Err(DOMAIN_ERROR.into());
+        }
+        Ok(())
+    }
+
+    fn parameters(&self) -> R<[u32; 16]> {
+        let mut parameters = [0; 16];
+        parameters[0] = self.length;
+        parameters[1] = self.lines;
+        parameters[2] = u32::try_from(self.sample_count()?).map_err(|_| ERROR)?;
+        parameters[3] = self.mode;
+        parameters[4] = self.radius;
+        parameters[5] = u32::try_from(self.coefficient_bits.len()).map_err(|_| ERROR)?;
+        parameters[6] = PREFIX_WORDS;
+        Ok(parameters)
+    }
+
+    pub(super) fn packet(&self, values: &[u64]) -> R<Packet> {
+        self.validate_input(values)?;
+        let total = (PREFIX_WORDS as usize)
+            .checked_add(values.len())
+            .ok_or(ERROR)?;
+        if total > super::CAPACITY as usize {
+            return Err(ERROR.into());
+        }
+        let mut words = vec![0; total];
+        words[..self.coefficient_bits.len()].copy_from_slice(&self.coefficient_bits);
+        words[PREFIX_WORDS as usize..].copy_from_slice(values);
+        let packet = Packet {
+            words,
+            parameters: self.parameters()?,
+            invocations: (self.sample_count()? as u32).max(PREFIX_WORDS),
+        };
+        packet.validate(self)?;
+        Ok(packet)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct Packet {
+    pub(super) words: Vec<u64>,
+    pub(super) parameters: [u32; 16],
+    pub(super) invocations: u32,
+}
+impl Packet {
+    /// Revalidate immediately before upload. Unused prefix words are data too:
+    /// they must be positive zero, not a hidden coefficient or negative zero.
+    pub(super) fn validate(&self, spec: &FirSpec) -> R<()> {
+        spec.validate()?;
+        let count = spec.sample_count()?;
+        let total = (PREFIX_WORDS as usize).checked_add(count).ok_or(ERROR)?;
+        if self.words.len() != total
+            || self.parameters != spec.parameters()?
+            || self.invocations != (count as u32).max(PREFIX_WORDS)
+            || self.words[..spec.coefficient_bits.len()] != spec.coefficient_bits
+            || self.words[spec.coefficient_bits.len()..PREFIX_WORDS as usize]
+                .iter()
+                .any(|&word| word != 0)
+            || self.words[PREFIX_WORDS as usize..]
+                .iter()
+                .any(|&word| !admitted(word))
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+}
+
+/// Preserve the exact original f64 expression and iteration order. In
+/// particular, positive f32 subnormal sigma widens to normal f64 and remains
+/// valid; it has radius zero and computes one coefficient, rather than copying.
+fn calibration(sigma: f32) -> R<(u32, u32, Vec<u64>)> {
+    if !sigma.is_finite() || sigma < 0. || sigma >= 3. {
+        return Err(ERROR.into());
+    }
+    if sigma == 0. {
+        return Ok((0, 0, Vec::new()));
+    }
+    let sigma = sigma as f64;
+    let radius = (3.0 * sigma + 0.5) as u32;
+    let size = 2 * radius + 1;
+    if size > MAX_KERNEL {
+        return Err(ERROR.into());
+    }
+    let s2 = 2.0 * sigma * sigma;
+    let mut kernel = Vec::with_capacity(size as usize);
+    for i in 0..size {
+        let x = i as f64 - radius as f64;
+        kernel.push((-x * x / s2).exp());
+    }
+    let sum: f64 = kernel.iter().sum();
+    for value in &mut kernel {
+        *value /= sum;
+    }
+    if kernel
+        .iter()
+        .any(|&v| !admitted(v.to_bits()) || v <= 0. || v > 1.)
+    {
+        return Err(DOMAIN_ERROR.into());
+    }
+    Ok((1, radius, kernel.into_iter().map(f64::to_bits).collect()))
+}
+
+fn reflect_index(index: isize, length: usize) -> usize {
+    if length <= 1 {
+        return 0;
+    }
+    let period = 2 * length as isize;
+    let folded = index.rem_euclid(period);
+    if folded >= length as isize {
+        (period - 1 - folded) as usize
+    } else {
+        folded as usize
+    }
+}
+
+/// Test mirror, never a CPU image fallback. It checks every multiplication and
+/// addition, including zero-valued inputs, in the original ascending order.
+pub(super) fn cpu_reference(spec: &FirSpec, values: &[u64]) -> R<Vec<u64>> {
+    spec.validate_input(values)?;
+    if spec.mode == 0 {
+        return Ok(values.to_vec());
+    }
+    let mut output = vec![0; values.len()];
+    let mut guard = Guard::default();
+    for (src, dst) in values
+        .chunks_exact(spec.length as usize)
+        .zip(output.chunks_exact_mut(spec.length as usize))
+    {
+        for (x, target) in dst.iter_mut().enumerate() {
+            let mut sum = 0;
+            for (ki, &coefficient) in spec.coefficient_bits.iter().enumerate() {
+                let sx = reflect_index(x as isize + ki as isize - spec.radius as isize, src.len());
+                let product = guard.mul(src[sx], coefficient);
+                sum = guard.add(sum, product);
+                if guard.failed {
+                    return Err(DOMAIN_ERROR.into());
+                }
+            }
+            *target = sum;
+        }
+    }
+    Ok(output)
+}
+
+#[cfg(feature = "precision-f64")]
+pub(super) fn original_reference(spec: &FirSpec, values: &[u64]) -> R<Vec<u64>> {
+    spec.validate_input(values)?;
+    let source: Vec<f64> = values.iter().map(|&word| f64::from_bits(word)).collect();
+    let mut output = vec![0f64; source.len()];
+    spektrafilm_math::gaussian::gaussian_blur_rows(
+        &source,
+        &mut output,
+        spec.length as usize,
+        f32::from_bits(spec.sigma_bits),
+    );
+    Ok(output.into_iter().map(f64::to_bits).collect())
+}
+
+mod word {
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+    pub(super) struct Hex(pub u64);
+    impl Serialize for Hex {
+        fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+            serializer.serialize_str(&format!("{:016x}", self.0))
+        }
+    }
+    impl<'de> Deserialize<'de> for Hex {
+        fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+            let text = String::deserialize(deserializer)?;
+            if text.len() != 16
+                || !text
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+            {
+                return Err(serde::de::Error::custom(
+                    "expected exactly 16 lowercase hex digits",
+                ));
+            }
+            u64::from_str_radix(&text, 16)
+                .map(Self)
+                .map_err(serde::de::Error::custom)
+        }
+    }
+    pub(super) fn serialize<S: Serializer>(value: &u64, serializer: S) -> Result<S::Ok, S::Error> {
+        Hex(*value).serialize(serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<u64, D::Error> {
+        Ok(Hex::deserialize(deserializer)?.0)
+    }
+}
+mod word_vec {
+    use super::word::Hex;
+    use serde::{Deserializer, Serialize, Serializer};
+    pub(super) fn serialize<S: Serializer>(
+        value: &[u64],
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        value
+            .iter()
+            .copied()
+            .map(Hex)
+            .collect::<Vec<_>>()
+            .serialize(serializer)
+    }
+    pub(super) fn deserialize<'de, D: Deserializer<'de>>(
+        deserializer: D,
+    ) -> Result<Vec<u64>, D::Error> {
+        struct Words;
+        impl<'de> serde::de::Visitor<'de> for Words {
+            type Value = Vec<u64>;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                write!(f, "at most {} exact binary64 hex words", super::MAX_KERNEL)
+            }
+            fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: A,
+            ) -> Result<Self::Value, A::Error> {
+                let mut words = Vec::with_capacity(super::MAX_KERNEL as usize);
+                while let Some(word) = seq.next_element::<Hex>()? {
+                    if words.len() == super::MAX_KERNEL as usize {
+                        return Err(serde::de::Error::custom("too many FIR coefficients"));
+                    }
+                    words.push(word.0);
+                }
+                Ok(words)
+            }
+        }
+        deserializer.deserialize_seq(Words)
+    }
+}
+
+#[cfg(test)]
+mod tests;
