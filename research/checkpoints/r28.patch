+#[cfg(feature = "precision-f64")]
+fn assert_original_exact(plan: &FirSpec, input: &[u64]) {
+    let expected = original_reference(plan, input).unwrap();
+    let actual = cpu_reference(plan, input).unwrap();
+    assert_eq!(actual.len(), expected.len());
+    let mut zero_count = 0usize;
+    for (i, (&actual, &expected)) in actual.iter().zip(&expected).enumerate() {
+        if expected & 0x7fff_ffff_ffff_ffff == 0 {
+            zero_count += 1;
+            assert_eq!(
+                actual, expected,
+                "zero sign at {i}, sigma {:08x}",
+                plan.sigma_bits
+            );
+        } else {
+            assert_eq!(
+                actual, expected,
+                "nonzero raw word at {i}, sigma {:08x}, length {}",
+                plan.sigma_bits, plan.length
+            );
+        }
+    }
+    assert!(zero_count <= input.len());
+}
