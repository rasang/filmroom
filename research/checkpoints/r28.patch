@@ -0,0 +1,23 @@
+// B: exactly one original Mitchell weight per invocation, no reduction.
+struct ExposureParams { words: array<vec4<u32>,16>, }
+@group(0) @binding(0) var<uniform> p:ExposureParams;
+@group(0) @binding(1) var<storage,read_write> work:array<vec2<u32>>;
+@group(0) @binding(2) var<storage,read_write> error:atomic<u32>;
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>){
+ if(atomicLoad(&error)!=0u){return;}
+ let count=ex_word(0u);let side=ex_word(1u);let cap=ex_word(2u);
+ if(count==0u||cap==0u||cap>65536u||count>cap||side<2u||side>1024u||ex_word(3u)!=0u||arrayLength(&work)!=16u*cap){ex_reject();return;}
+ let index=gid.x;if(index>=8u*count){return;}
+ let pixel=index/8u;let slot=index%8u;let base=16u*pixel;
+ if(!ex_geometry(base,side)){return;}
+ if(work[base+4u].x==0u){work[base+8u+slot]=EX_ZERO;return;}
+ var fraction=work[base+1u];if(slot>=4u){fraction=work[base+2u];}
+ let offset=slot%4u;var t=fraction;
+ if(offset==0u){t=ex_add(fraction,EX_ONE);}
+ if(offset==2u){t=ex_sub(fraction,EX_ONE);}
+ if(offset==3u){t=ex_sub(fraction,ex_i(2u));}
+ let value=ex_weight(t);
+ if(!ex_accept(value)){return;}
+ work[base+8u+slot]=value;
+}
