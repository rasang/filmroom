@@ -0,0 +1,93 @@
+//! Original FIR raw-only shader composition. Existing shared arithmetic is byte-preserved.
+use super::*;
+
+pub(super) const LAYOUT: &str =
+    "firPrefixAndSource64:read,rawResult64:read_write,error:atomic_u32,parameters:array_vec4_u32_4";
+pub(super) const SHARED_SHA256: &str = super::SOFT64_SHA256;
+pub(super) const KERNEL_SHA256: &str =
+    "23cafdc95f62fc4f58a5124a665b1023eae8f5d74d015cdd2223f1e1a9d94f09";
+const FIR_KERNEL: &str = include_str!("fir_kernel.wgsl");
+
+pub(super) fn shader() -> R<String> {
+    compose_fir(soft64::SHADER, FIR_KERNEL)
+}
+fn compose_fir(source: &str, kernel: &str) -> R<String> {
+    if digest(source.as_bytes()) != SHARED_SHA256 || digest(kernel.as_bytes()) != KERNEL_SHA256 {
+        return Err("GPU_FIR64_SHADER_IDENTITY".into());
+    }
+    let all = functions(source)?;
+    if all.len() != 26 {
+        return Err("GPU_FIR64_SHADER_IDENTITY".into());
+    }
+    let mut reached: BTreeSet<String> = identifiers(kernel)
+        .into_iter()
+        .filter(|name| all.contains_key(*name))
+        .map(str::to_owned)
+        .collect();
+    loop {
+        let mut next = reached.clone();
+        for name in &reached {
+            for identifier in identifiers(all[name]) {
+                if all.contains_key(identifier) {
+                    next.insert(identifier.to_owned());
+                }
+            }
+        }
+        if next == reached {
+            break;
+        }
+        reached = next;
+    }
+    let expected: BTreeSet<String> = HELPER_NAMES
+        .into_iter()
+        .filter(|name| *name != "sf_scalar")
+        .map(str::to_owned)
+        .collect();
+    if reached != expected
+        || identifiers(kernel).contains("sf_scalar")
+        || identifiers(kernel).contains("f32")
+    {
+        return Err("GPU_FIR64_SHADER_IDENTITY".into());
+    }
+    let mut output = String::new();
+    for declaration in [
+        "const SF_NAN:vec2<u32>=vec2<u32>(0u,0x7ff80000u);",
+        "var<private> sf_failed:u32;",
+    ] {
+        if source.matches(declaration).count() != 1 {
+            return Err("GPU_FIR64_SHADER_IDENTITY".into());
+        }
+        let start = source
+            .find(declaration)
+            .ok_or("GPU_FIR64_SHADER_IDENTITY")?;
+        output.push_str(&source[start..start + declaration.len()]);
+        output.push('\n');
+    }
+    for name in reached {
+        output.push_str(all[&name]);
+        output.push('\n');
+    }
+    output.push_str(kernel);
+    Ok(output)
+}
+
+#[test]
+fn fir_shader_is_pinned_original_arithmetic_without_narrowing() {
+    let composed = shader().unwrap();
+    assert!(!identifiers(&composed).contains("sf_scalar"));
+    assert!(!identifiers(&composed).contains("f32"));
+    let shared = functions(soft64::SHADER).unwrap();
+    let actual = functions(&composed).unwrap();
+    for name in HELPER_NAMES.into_iter().filter(|name| *name != "sf_scalar") {
+        assert_eq!(shared[name], actual[name], "changed shared helper {name}");
+    }
+    assert!(compose_fir(soft64::SHADER, &(FIR_KERNEL.to_owned() + "\n")).is_err());
+    assert!(compose_fir(&(soft64::SHADER.to_owned() + "\n"), FIR_KERNEL).is_err());
+    let module = naga::front::wgsl::parse_str(&composed).unwrap();
+    naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::empty(),
+    )
+    .validate(&module)
+    .unwrap();
+}
