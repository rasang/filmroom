+//! Closed test-only preparation of the original DIR's small calibration tables.
+//!
+//! This object does not authenticate an image, establish original-CPU log64
+//! provenance, admit resources, or run any image arithmetic/preflight. A caller
+//! must separately bind the calibrated Pipeline and immutable input source.
+//! Original intentional f32 calibration boundaries are retained. No old
+//! resident DirPlan or synthetic geometry participates in construction.
+//! The test-only decoder validates semantic lengths after decoding. Any future
+//! external transport must bound bytes before serde and separately budget this
+//! descriptor, including its original-input tables; no 64 KiB claim is made.
+#![cfg(test)]
+
+use super::{R, admitted, coefficients_for_sigma};
+use crate::research_spatial::FIT;
+use serde::{Deserialize, Deserializer, Serialize};
+use spektrafilm_core::pipeline::Pipeline;
+
+const VERSION: u32 = 1;
+const RECIPE: &str = "original-dir-calibration-f64-initial-f32-before-dir-v1";
+const ERROR: &str = "GPU_DIR_SOFT64_CALIBRATION";
+const DOMAIN_ERROR: &str = "GPU_DIR_SOFT64_CALIBRATION_DOMAIN";
+const TABLE_ERROR: &str = "GPU_DIR_SOFT64_CALIBRATION_TABLE";
+const FILTER_ERROR: &str = "GPU_DIR_SOFT64_EXECUTED_IIR_ONLY";
+const MAX_KNOTS: usize = 4096;
+
+// Deserialize into a private unchecked wire shape, then validate before exposing
+// a value. Derive's map visitor rejects duplicate fields as well as unknown
+// fields. The same field list defines both shapes, so they cannot drift.
+macro_rules! validated_struct {
+    ($name:ident, $wire:ident { $($(#[$attr:meta])* $field:ident: $ty:ty),* $(,)? }) => {
+        #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        pub(super) struct $name {
+            $($(#[$attr])* pub $field: $ty,)*
+        }
+        #[derive(Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct $wire {
+            $($(#[$attr])* $field: $ty,)*
+        }
+        impl<'de> Deserialize<'de> for $name {
+            fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+                let wire = $wire::deserialize(deserializer)?;
+                let result = Self { $($field: wire.$field,)* };
+                result.validate().map_err(serde::de::Error::custom)?;
+                Ok(result)
+            }
+        }
+    };
+}
+
+validated_struct!(CurveWords, CurveWordsWire {
+    #[serde(with = "word_vec")]
+    axis: Vec<u64>,
+    #[serde(with = "word_vec")]
+    inverse_dx: Vec<u64>,
+    #[serde(with = "word_rows")]
+    values: Vec<[u64; 3]>,
+});
+
+impl CurveWords {
+    pub(super) fn len(&self) -> usize {
+        self.axis.len()
+    }
+
+    fn from_original(axis: Vec<f64>, values: Vec<[f64; 3]>, gamma: f64) -> R<Self> {
+        guard(gamma)?;
+        if gamma <= 0. {
+            return Err(TABLE_ERROR.into());
+        }
+        let axis: Vec<u64> = axis
+            .into_iter()
+            .map(|x| {
+                guard(x)?;
+                // Exactly the original CPU backend's near-one branch.
+                let scaled = if (gamma - 1.).abs() < 1e-12 {
+                    x
+                } else {
+                    x / gamma
+                };
+                guard(scaled)?;
+                Ok(scaled.to_bits())
+            })
+            .collect::<R<_>>()?;
+        let inverse_dx = axis
+            .windows(2)
+            .map(|pair| reciprocal(pair[0], pair[1]))
+            .collect::<R<_>>()?;
+        let result = Self {
+            axis,
+            inverse_dx,
+            values: values
+                .into_iter()
+                .map(|row| row.map(f64::to_bits))
+                .collect(),
+        };
+        result.validate()?;
+        Ok(result)
+    }
+
+    pub(super) fn validate(&self) -> R<()> {
+        if !(2..=MAX_KNOTS).contains(&self.len())
+            || self.values.len() != self.len()
+            || self.inverse_dx.len().checked_add(1) != Some(self.len())
+        {
+            return Err(TABLE_ERROR.into());
+        }
+        guard_words(
+            self.axis
+                .iter()
+                .chain(&self.inverse_dx)
+                .chain(self.values.iter().flatten()),
+        )?;
+        for (i, pair) in self.axis.windows(2).enumerate() {
+            if reciprocal(pair[0], pair[1])? != self.inverse_dx[i] {
+                return Err(TABLE_ERROR.into());
+            }
+        }
+        Ok(())
+    }
+}
+
+fn reciprocal(low: u64, high: u64) -> R<u64> {
+    guard_words([&low, &high])?;
+    let (low, high) = (f64::from_bits(low), f64::from_bits(high));
+    // The original allows a zero-spacing branch. This closed domain does not.
+    if high <= low {
+        return Err(TABLE_ERROR.into());
+    }
+    let dx = high - low;
+    guard(dx)?;
+    let inverse = 1. / dx;
+    guard(inverse)?;
+    Ok(inverse.to_bits())
+}
+
+// Bounded original small inputs allow validate() to recompute all derived
+// science, rather than accepting arbitrary normalized curves with a recipe tag.
+// They are not a full profile identity or proof that a Pipeline was calibrated.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct CalibrationInputs {
+    #[serde(with = "word_vec")]
+    profile_axis: Vec<u64>,
+    #[serde(with = "word_rows")]
+    profile_values: Vec<[u64; 3]>,
+    #[serde(with = "word_array")]
+    gamma_samelayer: [u64; 3],
+    #[serde(with = "word_matrix")]
+    gamma_interlayer: [[u64; 2]; 3],
+    #[serde(with = "word")]
+    inhibition_samelayer: u64,
+    #[serde(with = "word")]
+    inhibition_interlayer: u64,
+    #[serde(with = "word")]
+    amount: u64,
+}
+
+impl CalibrationInputs {
+    fn from_pipeline(pipe: &Pipeline) -> R<Self> {
+        let data = &pipe.film.data;
+        if !pipe.film.is_film()
+            || !pipe.film.is_filming()
+            || !pipe.film.is_color()
+            || !(pipe.film.is_negative() || pipe.film.is_positive())
+            || !(2..=MAX_KNOTS).contains(&data.log_exposure.len())
+            || data.log_exposure.len() != data.density_curves.len()
+            || data.density_curves.iter().any(|row| row.len() != 3)
+        {
+            return Err(TABLE_ERROR.into());
+        }
+        let d = &pipe.params.film_render.dir_couplers;
+        let result = Self {
+            profile_axis: pipe
+                .film
+                .log_exposure_f64()
+                .into_iter()
+                .map(f64::to_bits)
+                .collect(),
+            profile_values: pipe
+                .film
+                .density_curves_f64()
+                .into_iter()
+                .map(|row| row.map(f64::to_bits))
+                .collect(),
+            gamma_samelayer: d.gamma_samelayer_rgb.map(f64::to_bits),
+            gamma_interlayer: [
+                d.gamma_interlayer_r_to_gb,
+                d.gamma_interlayer_g_to_rb,
+                d.gamma_interlayer_b_to_rg,
+            ]
+            .map(|row| row.map(f64::to_bits)),
+            inhibition_samelayer: d.inhibition_samelayer.to_bits(),
+            inhibition_interlayer: d.inhibition_interlayer.to_bits(),
+            amount: d.amount.to_bits(),
+        };
+        result.validate()?;
+        Ok(result)
+    }
+
+    fn validate(&self) -> R<()> {
+        if !(2..=MAX_KNOTS).contains(&self.profile_axis.len())
+            || self.profile_axis.len() != self.profile_values.len()
+        {
+            return Err(TABLE_ERROR.into());
+        }
+        guard_words(
+            self.profile_axis
+                .iter()
+                .chain(self.profile_values.iter().flatten())
+                .chain(&self.gamma_samelayer)
+                .chain(self.gamma_interlayer.iter().flatten())
+                .chain([
+                    &self.inhibition_samelayer,
+                    &self.inhibition_interlayer,
+                    &self.amount,
+                ]),
+        )?;
+        for pair in self.profile_axis.windows(2) {
+            let (a, b) = (f64::from_bits(pair[0]), f64::from_bits(pair[1]));
+            // Redevelopment starts from the intentional f32 profile axis, so
+            // reject original tables that collapse at that boundary as well.
+            if b <= a || b as f32 <= a as f32 {
+                return Err(TABLE_ERROR.into());
+            }
+        }
+        Ok(())
+    }
+}
+
+validated_struct!(DirCalibration, DirCalibrationWire {
+    version: u32,
+    recipe: String,
+    width: u32,
+    height: u32,
+    pitch_bits: u32,
+    // Kept distinct from explicit fixture pitch. It is not used to derive it.
+    film_format_mm_bits: u32,
+    gamma_bits: u32,
+    dir_active: bool,
+    positive: bool,
+    #[serde(with = "word")]
+    diffusion_size_um_bits: u64,
+    #[serde(with = "word")]
+    diffusion_tail_um_bits: u64,
+    core_sigma_bits: u32,
+    tail_decay_bits: u32,
+    tail_sigma_bits: [u32; 3],
+    #[serde(with = "word")]
+    tail_weight_bits: u64,
+    #[serde(with = "word_array")]
+    fit_amplitude_bits: [u64; 3],
+    #[serde(with = "word_array")]
+    fit_ratio_bits: [u64; 3],
+    // Core then the three original tail components. None means no filters
+    // execute, not identity coefficients or an omitted active tail component.
+    #[serde(with = "optional_word_matrix")]
+    coefficient_bits: Option<[[u64; 4]; 4]>,
+    #[serde(with = "word_matrix")]
+    matrix_bits: [[u64; 3]; 3],
+    #[serde(with = "word_array")]
+    density_max_bits: [u64; 3],
+    initial: CurveWords,
+    before_dir: CurveWords,
+    calibration_inputs: CalibrationInputs,
+});
+
+impl DirCalibration {
+    pub(super) fn from_pipeline(pipe: &Pipeline, pitch: f32, width: u32, height: u32) -> R<Self> {
+        let d = &pipe.params.film_render.dir_couplers;
+        let inputs = CalibrationInputs::from_pipeline(pipe)?;
+        let gamma = pipe.params.film_render.density_curve_gamma;
+        let science = Science::derive(
+            &inputs,
+            gamma,
+            pitch,
+            d.active,
+            pipe.film.is_positive(),
+            d.diffusion_size_um,
+            d.diffusion_tail_um,
+        )?;
+        let result = Self {
+            version: VERSION,
+            recipe: RECIPE.into(),
+            width,
+            height,
+            pitch_bits: pitch.to_bits(),
+            film_format_mm_bits: pipe.params.camera.film_format_mm.to_bits(),
+            gamma_bits: gamma.to_bits(),
+            dir_active: d.active,
+            positive: pipe.film.is_positive(),
+            diffusion_size_um_bits: d.diffusion_size_um.to_bits(),
+            diffusion_tail_um_bits: d.diffusion_tail_um.to_bits(),
+            core_sigma_bits: science.core_sigma_bits,
+            tail_decay_bits: science.tail_decay_bits,
+            tail_sigma_bits: science.tail_sigma_bits,
+            tail_weight_bits: d.diffusion_tail_weight.to_bits(),
+            fit_amplitude_bits: FIT.map(|(amplitude, _)| amplitude.to_bits()),
+            fit_ratio_bits: FIT.map(|(_, ratio)| ratio.to_bits()),
+            coefficient_bits: science.coefficient_bits,
+            matrix_bits: science.matrix_bits,
+            density_max_bits: science.density_max_bits,
+            initial: science.initial,
+            before_dir: science.before_dir,
+            calibration_inputs: inputs,
+        };
+        result.validate()?;
+        Ok(result)
+    }
+
+    pub(super) fn validate(&self) -> R<()> {
+        // These are the real whole-image dimensions, independently of any
+        // point chunk or IIR complete-line batch. No resident f32 memory cap.
+        if self.version != VERSION
+            || self.recipe != RECIPE
+            || !(1..=40_000).contains(&self.width)
+            || !(1..=40_000).contains(&self.height)
+            || u64::from(self.width)
+                .checked_mul(u64::from(self.height))
+                .and_then(|n| n.checked_mul(24))
+                .is_none()
+            || self.fit_amplitude_bits != FIT.map(|(a, _)| a.to_bits())
+            || self.fit_ratio_bits != FIT.map(|(_, r)| r.to_bits())
+        {
+            return Err(ERROR.into());
+        }
+        let format = f32::from_bits(self.film_format_mm_bits) as f64;
+        guard(format)?;
+        if format <= 0. {
+            return Err(ERROR.into());
+        }
+        guard_words(
+            [
+                &self.tail_weight_bits,
+                &self.diffusion_size_um_bits,
+                &self.diffusion_tail_um_bits,
+            ]
+            .into_iter()
+            .chain(&self.fit_amplitude_bits)
+            .chain(&self.fit_ratio_bits)
+            .chain(self.matrix_bits.iter().flatten())
+            .chain(&self.density_max_bits),
+        )?;
+        let weight = f64::from_bits(self.tail_weight_bits);
+        if !(0. ..=1.).contains(&weight) {
+            return Err(ERROR.into());
+        }
+        self.initial.validate()?;
+        self.before_dir.validate()?;
+        let science = Science::derive(
+            &self.calibration_inputs,
+            f32::from_bits(self.gamma_bits),
+            f32::from_bits(self.pitch_bits),
+            self.dir_active,
+            self.positive,
+            f64::from_bits(self.diffusion_size_um_bits),
+            f64::from_bits(self.diffusion_tail_um_bits),
+        )?;
+        if self.core_sigma_bits != science.core_sigma_bits
+            || self.tail_decay_bits != science.tail_decay_bits
+            || self.tail_sigma_bits != science.tail_sigma_bits
+            || self.coefficient_bits != science.coefficient_bits
+            || self.matrix_bits != science.matrix_bits
+            || self.density_max_bits != science.density_max_bits
+            || self.initial != science.initial
+            || self.before_dir != science.before_dir
+        {
+            return Err(ERROR.into());
+        }
+        if let Some(coefficients) = &self.coefficient_bits {
+            guard_words(coefficients.iter().flatten())?;
+        }
+        Ok(())
+    }
+}
+
+struct Science {
+    core_sigma_bits: u32,
+    tail_decay_bits: u32,
+    tail_sigma_bits: [u32; 3],
+    coefficient_bits: Option<[[u64; 4]; 4]>,
+    matrix_bits: [[u64; 3]; 3],
+    density_max_bits: [u64; 3],
+    initial: CurveWords,
+    before_dir: CurveWords,
+}
+
+impl Science {
+    fn derive(
+        inputs: &CalibrationInputs,
+        gamma: f32,
+        pitch: f32,
+        active: bool,
+        positive: bool,
+        diffusion_size: f64,
+        diffusion_tail: f64,
+    ) -> R<Self> {
+        let prepared = PreparedPointScience::derive(
+            inputs,
+            gamma,
+            pitch,
+            positive,
+            diffusion_size,
+            diffusion_tail,
+        )?;
+        let core_sigma = f32::from_bits(prepared.core_sigma_bits);
+        let tail_sigma = prepared.tail_sigma_bits.map(f32::from_bits);
+        let coefficient_bits = if active && core_sigma > 0. {
+            let mut result = [[0; 4]; 4];
+            for (i, sigma) in std::iter::once(core_sigma).chain(tail_sigma).enumerate() {
+                if !(3. ..=10_000.).contains(&sigma) {
+                    // Reject every executed FIR and identity tail, even at
+                    // tail weight zero: the original still executes the tail.
+                    return Err(FILTER_ERROR.into());
+                }
+                result[i] = coefficients_for_sigma(sigma)?;
+            }
+            Some(result)
+        } else {
+            None
+        };
+        Ok(Self {
+            core_sigma_bits: prepared.core_sigma_bits,
+            tail_decay_bits: prepared.tail_decay_bits,
+            tail_sigma_bits: prepared.tail_sigma_bits,
+            coefficient_bits,
+            matrix_bits: prepared.matrix_bits,
+            density_max_bits: prepared.density_max_bits,
+            initial: prepared.initial,
+            before_dir: prepared.before_dir,
+        })
+    }
+}
