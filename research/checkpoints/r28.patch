+}
+fn fixture_sigmas() -> [f32; 4] {
+    // Unchanged original384 fixture: 5 um core, 2 um tail, 10 um pitch.
+    // The original tail first rounds decay to f32, widens it, then multiplies
+    // each f64 FIT ratio and narrows exactly once for gaussian_blur_rows.
+    let decay = 0.2f32;
+    let tails = crate::research_spatial::FIT.map(|(_, ratio)| (ratio * decay as f64) as f32);
+    [0.5, tails[0], tails[1], tails[2]]
+}
+fn sigmas() -> Vec<f32> {
