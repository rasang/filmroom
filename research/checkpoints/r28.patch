+fn actual_poisson_cache_middle_and_deferred_failure_probe(){
+ let mut rp=spektrafilm_core::params::RuntimeParams::default();rp.film_render.halation.active=false;
+ let spatial=spatial::FilmOpticsPlan::new(&rp,20.,1,1).unwrap();
+ let admission=graph::opcode_families::shaders().unwrap().into_iter().find(|(ops,_)|ops.contains(&67)).unwrap();
+ let families=vec![(vec![67],admission.1),(vec![62],shader().unwrap())];
+ let(r,mut metrics)=Runner::new_with_grain_shader_families(&spatial,true,&families,GrainScratchConfig::new(256).unwrap()).unwrap();
+ let expected=graph::code_admission::expected_words().unwrap();r.upload_aux(0,&expected,&mut ||false,&mut metrics).unwrap();
+ let mut v=params(1,1,67);v[4]=1;v[12]=graph::code_admission::VERSION;v[13]=graph::code_admission::ID[0];v[14]=graph::code_admission::ID[1];r.dispatch(v,&mut ||false,&mut metrics).unwrap();assert_eq!(r.read_error_flag(&mut ||false,&mut metrics).unwrap(),0);
