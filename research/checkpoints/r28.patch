+        } else {
+            assert!(records.is_empty());
+            None
+        };
+        for c in 0..3 {
+            let density = fs::read(boundaries.join(format!("afterDir/channel-{c}.f64le"))).unwrap();
+            assert_eq!(
+                density,
+                fs::read(root.join(format!("pre-grain-{c}.f64le"))).unwrap()
+            );
+            assert_eq!(
+                density,
+                r22_reference_bytes(
+                    &reference,
+                    &format!("causal-prefix/{old_label}/pre-grain-{c}.f64le")
