+            paths,
+            point_capacity,
+            iir_line_capacity,
+            fir_line_capacity,
+            InputPolicy::DerivedGpuF32Mixed,
+        )
+        .map(Self)
+    }
+    pub(super) fn validate(&self) -> R<()> {
+        self.0.validate_for(InputPolicy::DerivedGpuF32Mixed)
+    }
+    pub(super) fn identity(&self) -> R<String> {
+        self.validate()?;
+        self.0.identity()
+    }
+    pub(super) fn sources(&self) -> &Sources {
+        self.0.sources()
+    }
+    pub(super) fn calibration(&self) -> &DirMixedCalibration {
+        self.0.calibration()
+    }
