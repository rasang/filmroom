+// Closed R22: observe adopted prefix boundaries and replay the unchanged CPU
+// grain on the already captured R21 inputs. Never changes science or admission.
+fn r22_reference() -> PathBuf {
+    let p = PathBuf::from(
+        std::env::var_os("FILM_GPU_R21_REFERENCE_ROOT")
+            .expect("explicit completed R21 evidence required"),
+    );
+    assert!(p.is_absolute());
+    assert_eq!(p.canonicalize().unwrap(), p);
+    use sha2::{Digest, Sha256};
+    let index_bytes = fs::read(p.join("R21_VALIDATION_INDEX.json")).unwrap();
+    assert_eq!(
+        format!("{:x}", Sha256::digest(&index_bytes)),
+        "b34148ae83157e0a05c4fc72b814a121d957c94f60e109cadeb3fa3a90ae8c5b"
+    );
+    let index: Value = serde_json::from_slice(&index_bytes).unwrap();
+    assert_eq!(
+        index["binarySha256"],
+        "94851567317db46b32f20c2d075bd732f84a9ea15668464a58c838e090ba82ae"
+    );
+    assert_eq!(
+        index["sourcePatchSha256"],
+        "6b302ee9d6c06317892dc35bf2aa1b0af32eed254ccca4633b300ab9a0bd8884"
+    );
+    assert_eq!(
+        index["status"],
+        "COMPLETE_EXPERIMENT_FAIL_ORIGINAL_FINAL_QUALITY"
+    );
+    assert_eq!(index["qualityGatePassed"], false);
+    p
+}
+fn r22_reference_bytes(root: &Path, relative: &str) -> Vec<u8> {
+    use sha2::{Digest, Sha256};
+    assert!(!relative.contains("..") && !relative.starts_with('/'));
+    let index_bytes = fs::read(root.join("R21_VALIDATION_INDEX.json")).unwrap();
+    assert_eq!(format!("{:x}", Sha256::digest(&index_bytes)), "b34148ae83157e0a05c4fc72b814a121d957c94f60e109cadeb3fa3a90ae8c5b");
+    let index: Value = serde_json::from_slice(&index_bytes).unwrap();
+    let expected = &index["files"][relative];
+    assert!(expected.is_object(), "missing indexed reference {relative}");
+    let bytes = fs::read(root.join(relative)).unwrap();
+    assert_eq!(expected["bytes"].as_u64().unwrap(), bytes.len() as u64);
+    assert_eq!(
+        expected["sha256"].as_str().unwrap(),
+        format!("{:x}", Sha256::digest(&bytes))
+    );
+    bytes
+}
+fn r22_private(path: &Path) {
+    fs::create_dir(path).unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(path, fs::Permissions::from_mode(0o700)).unwrap();
+    }
+}
+fn r22_read_planes(root: &Path, label: &str) -> [Vec<f64>; 3] {
+    std::array::from_fn(|ch| {
+        let b = fs::read(root.join(label).join(format!("channel-{ch}.f64le"))).unwrap();
+        assert_eq!(b.len(), 384 * 512 * 8);
+        b.chunks_exact(8)
+            .map(|v| {
+                let x = f64::from_le_bytes(v.try_into().unwrap());
+                assert!(x.is_finite());
+                x
+            })
+            .collect()
+    })
+}
