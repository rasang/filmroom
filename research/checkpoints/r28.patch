@@ -0,0 +1,180 @@
+// Closed original DIR scalar-output point operations on raw binary64 words.
+// One output channel per invocation; no transcendentals or narrowing.
+struct DirParameters { words: array<vec4<u32>, 4>, }
+@group(0) @binding(0) var<storage, read> dir_source: array<vec2<u32>>;
+@group(0) @binding(1) var<storage, read_write> dir_result: array<vec2<u32>>;
+@group(0) @binding(2) var<storage, read_write> dir_error: atomic<u32>;
+@group(0) @binding(3) var<uniform> dir_parameters: DirParameters;
+const DIR_BOUND: vec2<u32> = vec2<u32>(0x20000000u, 0x430c6bf5u);
+const DIR_ONE: vec2<u32> = vec2<u32>(0u, 0x3ff00000u);
+const DIR_FIT_0: vec2<u32> = vec2<u32>(0xafb7e910u, 0x3fc4e703u);
+const DIR_FIT_1: vec2<u32> = vec2<u32>(0xf06f6944u, 0x3fe4c985u);
+const DIR_FIT_2: vec2<u32> = vec2<u32>(0xb22d0e56u, 0x3fc7ef9du);
+
+fn dir_reject() { sf_failed = 1u; atomicOr(&dir_error, 1u); }
+fn dir_accept(x: vec2<u32>) -> bool {
+    if (sf_failed != 0u || !sf_valid(x)) { dir_reject(); return false; }
+    if (sf_cmpu(sf_abs(x), DIR_BOUND) > 0) { dir_reject(); return false; }
+    return true;
+}
+fn dir_read(index: u32) -> vec2<u32> {
+    if (index >= arrayLength(&dir_source)) { dir_reject(); return SF_NAN; }
+    let value = dir_source[index];
+    if (!dir_accept(value)) { return SF_NAN; }
+    return value;
+}
+fn dir_mul(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!dir_accept(a) || !dir_accept(b)) { return SF_NAN; }
+    let result = sf_mul(a, b);
+    if (!dir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn dir_add(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!dir_accept(a) || !dir_accept(b)) { return SF_NAN; }
+    let result = sf_add(a, b);
+    if (!dir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn dir_sub(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!dir_accept(a) || !dir_accept(b)) { return SF_NAN; }
+    let result = sf_sub(a, b);
+    if (!dir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn dir_cmp(a: vec2<u32>, b: vec2<u32>) -> i32 {
+    if (!dir_accept(a) || !dir_accept(b)) { return 0; }
+    let result = sf_cmp(a, b);
+    if (sf_failed != 0u) { dir_reject(); }
+    return result;
+}
+fn dir_curve(base: u32, n: u32, channel: u32, x: vec2<u32>) -> vec2<u32> {
+    if (dir_cmp(x, dir_read(base)) <= 0) { return dir_read(base + 2u*n + channel); }
+    if (dir_cmp(x, dir_read(base + n - 1u)) >= 0) {
+        return dir_read(base + 2u*n + 3u*(n - 1u) + channel);
+    }
+    var left = 0u;
+    var right = n;
+    loop {
+        if (left >= right || sf_failed != 0u) { break; }
+        let middle = left + (right - left)/2u;
+        if (dir_cmp(dir_read(base + middle), x) <= 0) { left = middle + 1u; }
+        else { right = middle; }
+    }
+    if (sf_failed != 0u || left == 0u || left >= n) { dir_reject(); return SF_NAN; }
+    let low = left - 1u;
+    let dx = dir_sub(x, dir_read(base + low));
+    let t = dir_mul(dx, dir_read(base + n + low));
+    let a = dir_read(base + 2u*n + 3u*low + channel);
+    let b = dir_read(base + 2u*n + 3u*(low + 1u) + channel);
+    let dy = dir_sub(b, a);
+    let weighted = dir_mul(t, dy);
+    return dir_add(a, weighted);
+}
+fn dir_validate_curve_word(index: u32, base: u32, n: u32) {
+    if (index >= base && index < base + n - 1u) {
+        if (dir_cmp(dir_read(index), dir_read(index + 1u)) >= 0) { dir_reject(); }
+    }
+    if (index == base + 2u*n - 1u) {
+        if (any(dir_source[index] != vec2<u32>(0u))) { dir_reject(); }
+    }
+}
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    // Never reset the request-wide error; no candidate is accepted before all
+    // invocations and final mapped error checks have completed.
+    if (atomicLoad(&dir_error) != 0u) { return; }
+    let command = dir_parameters.words[0];
+    let sizes = dir_parameters.words[1];
+    let offsets = dir_parameters.words[2];
+    let bounds = dir_parameters.words[3];
+    let operation = command.x;
+    let count = command.y;
+    let channel = command.z;
+    let component = command.w;
+    let initial_n = sizes.x;
+    let before_n = sizes.y;
+    if (operation < 1u || operation > 6u || count == 0u || count > 65536u ||
+        channel >= 3u || component >= 3u || (operation != 4u && component != 0u) ||
+        initial_n < 2u || initial_n > 4096u || before_n < 2u || before_n > 4096u ||
+        sizes.z > 1u || sizes.w > 1u || offsets.w > 1u || offsets.w > sizes.w ||
+        offsets.x != 64u || offsets.y != 64u + 5u*initial_n || offsets.z != 65536u ||
+        bounds.x != 64u + 5u*(initial_n + before_n) || bounds.x > offsets.z ||
+        bounds.y != 3u*count || bounds.z != 0u || bounds.w != 0u ||
+        offsets.z + bounds.y > arrayLength(&dir_source) || count > arrayLength(&dir_result)) {
+        dir_reject(); return;
+    }
+    if (((operation == 4u || operation == 5u) && offsets.w != 1u) ||
+        (operation == 6u && (sizes.w != 1u || offsets.w != 0u))) {
+        dir_reject(); return;
+    }
+    let index = gid.x;
+    // Every table word and every input lane is validated, even if an endpoint
+    // clamp or inactive branch does not consume that word for image arithmetic.
+    // These checks share the dispatch; private output may be written before an
+    // unrelated lane fails, but the request-wide flag rejects the whole result.
+    if (index < bounds.x) {
+        if (!dir_accept(dir_source[index])) { return; }
+        if (index >= 16u && index < 64u && any(dir_source[index] != vec2<u32>(0u))) {
+            dir_reject(); return;
+        }
+        dir_validate_curve_word(index, offsets.x, initial_n);
+        dir_validate_curve_word(index, offsets.y, before_n);
+        if (index == 12u && (dir_cmp(dir_source[index], vec2<u32>(0u)) < 0 ||
+                            dir_cmp(dir_source[index], DIR_ONE) > 0)) { dir_reject(); }
+        if (index == 13u && any(dir_source[index] != DIR_FIT_0)) { dir_reject(); }
+        if (index == 14u && any(dir_source[index] != DIR_FIT_1)) { dir_reject(); }
+        if (index == 15u && any(dir_source[index] != DIR_FIT_2)) { dir_reject(); }
+    }
+    if (index < bounds.y) {
+        if (!dir_accept(dir_source[offsets.z + index])) { return; }
+    }
+    if (index >= count || sf_failed != 0u) { return; }
+    let at = offsets.z + 3u*index;
+    let x0 = dir_read(at);
+    let x1 = dir_read(at + 1u);
+    let x2 = dir_read(at + 2u);
+    var result = SF_NAN;
+    if (operation == 1u) {
+        result = dir_curve(offsets.x, initial_n, channel, dir_read(at + channel));
+    } else if (operation == 2u) {
+        result = dir_curve(offsets.y, before_n, channel, dir_read(at + channel));
+    } else if (operation == 3u) {
+        // Fixed scalar donors. Do not add a dynamically indexed RGB register
+        // program or alter the original multiplication/addition sequence.
+        var d0 = dir_curve(offsets.x, initial_n, 0u, x0);
+        var d1 = dir_curve(offsets.x, initial_n, 1u, x1);
+        var d2 = dir_curve(offsets.x, initial_n, 2u, x2);
+        if (sizes.w == 1u) {
+            if (sizes.z == 1u) {
+                d0 = dir_sub(dir_read(9u), d0);
+                d1 = dir_sub(dir_read(10u), d1);
+                d2 = dir_sub(dir_read(11u), d2);
+            }
+            let p0 = dir_mul(d0, dir_read(channel));
+            let p1 = dir_mul(d1, dir_read(3u + channel));
+            let t0 = dir_add(p0, p1);
+            let p2 = dir_mul(d2, dir_read(6u + channel));
+            result = dir_add(t0, p2);
+        } else {
+            if (channel == 0u) { result = d0; }
+            else if (channel == 1u) { result = d1; }
+            else { result = d2; }
+        }
+    } else if (operation == 4u) {
+        let weighted = dir_mul(dir_read(13u + component), x1);
+        result = dir_add(x0, weighted);
+    } else if (operation == 5u) {
+        let weight = dir_read(12u);
+        let core_weight = dir_sub(DIR_ONE, weight);
+        let core = dir_mul(core_weight, x1);
+        let tail = dir_mul(weight, x2);
+        let correction = dir_add(core, tail);
+        let log_value = dir_sub(x0, correction);
+        result = dir_curve(offsets.y, before_n, channel, log_value);
+    } else {
+        let log_value = dir_sub(x0, x1);
+        result = dir_curve(offsets.y, before_n, channel, log_value);
+    }
+    if (!dir_accept(result)) { return; }
+    dir_result[index] = result;
+}
