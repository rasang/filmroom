+    let f = Fixture::new(3, 2);
+    let baseline = f.plan(calibration(3, 2), 2, 3, "baseline");
+    let mut good = HostCompute::new(Behavior::Echo);
+    execute(&baseline, &mut good).unwrap();
+    let p = f.plan(calibration(3, 2), 2, 3, "failed");
+    let mut bad = HostCompute::new(Behavior::Echo);
+    bad.fail = Some((good.calls, Failure::Error));
+    assert!(execute(&p, &mut bad).is_err());
+    assert_failed_clean(&f, &p, &bad);
+    assert!(baseline.paths().candidate_marker.exists());
+}
+#[test]
+fn explicit_output_and_marker_write_failures_remove_only_owned_candidates() {
+    for fault in [
+        Fault::OutputWrite,
+        Fault::BeforeMarker,
+        Fault::MarkerWrite,
+        Fault::MarkerHash,
+    ] {
+        let f = Fixture::new(3, 2);
+        let p = f.plan(calibration(3, 2), 2, 3, "candidate");
+        let checkpoint = f.root.join("prior-checkpoint");
+        fs::write(&checkpoint, b"prior").unwrap();
+        let mut g = HostCompute::new(Behavior::Echo);
+        assert!(run_with_fault(&p, &mut g, &mut || false, Some(fault)).is_err());
+        assert_failed_clean(&f, &p, &g);
+        assert_eq!(fs::read(checkpoint).unwrap(), b"prior");
+    }
+}
+#[test]
+fn immediate_cancellation_poisoned_without_file_creation() {
+    let f = Fixture::new(3, 2);
+    let p = f.plan(calibration(3, 2), 2, 3, "candidate");
+    let mut g = HostCompute::new(Behavior::Echo);
+    assert!(run(&p, &mut g, &mut || true).is_err());
+    assert_failed_clean(&f, &p, &g);
+    assert_eq!(g.calls, 0);
+}
+#[test]
+fn marker_writer_enforces_actual_serialized_limit() {
+    let f = Fixture::new(3, 2);
+    let p = f.plan(calibration(3, 2), 2, 3, "candidate");
+    let mut g = HostCompute::new(Behavior::Echo);
+    let mut r = execute(&p, &mut g).unwrap();
+    assert!(serialize_marker(&r).unwrap().len() as u64 <= METADATA_BYTES);
+    r.status = "x".repeat(METADATA_BYTES as usize);
+    assert!(serialize_marker(&r).is_err());
+}
+
+#[test]
+fn each_of_43_owned_creations_has_whole_graph_failure_cleanup() {
+    // Three reserved outputs + thirteen scratch creations per receiver + marker.
+    // This is a host lifecycle fault matrix, not an execution/GPU quality gate.
+    let f = Fixture::new(3, 2);
+    let cal = calibration(3, 2);
+    let checkpoint = f.root.join("retained-checkpoint");
+    fs::write(&checkpoint, b"keep the previous checkpoint").unwrap();
+    for creation in 1..=43 {
+        let p = f.plan(cal.clone(), 6, 6, &format!("failure-{creation}"));
+        let mut g = HostCompute::new(Behavior::Echo);
+        let error = run_with_fault(
+            &p,
+            &mut g,
+            &mut || false,
+            Some(Fault::AfterCreate(creation)),
+        )
+        .unwrap_err();
+        assert!(error.contains("CREATE"), "creation {creation}: {error}");
+        assert_failed_clean(&f, &p, &g);
+        assert_eq!(
+            fs::read(&checkpoint).unwrap(),
+            b"keep the previous checkpoint"
+        );
+    }
+}
+
+#[test]
+fn full_column_gather_and_scatter_preserve_coordinate_word_order() {
+    let f = Fixture::new(5, 3);
+    let p = f.plan(calibration(5, 3), 5, 15, "unused");
+    let mut source = File::open(&f.source_paths[0]).unwrap();
+    let gathered = gather(&mut source, &p, Axis::Columns, 0, 3, 5, &mut || false).unwrap();
+    let mut expected = Vec::new();
+    for x in 0..5 {
+        for y in 0..3 {
+            expected.push(f.input[y * 5 + x][0]);
+        }
+    }
+    assert_eq!(gathered, expected);
+    let output_path = f.root.join("scatter.bin");
+    let mut output = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&output_path)
+        .unwrap();
+    output.set_len(15 * 8).unwrap();
+    scatter(
+        &mut output,
+        &p,
+        Axis::Columns,
+        0,
+        3,
+        5,
+        &gathered,
+        &mut || false,
+    )
+    .unwrap();
+    drop(output);
+    assert_eq!(
+        fs::read(output_path).unwrap(),
+        fs::read(&f.source_paths[0]).unwrap()
+    );
+    let rows = gather(&mut source, &p, Axis::Rows, 1, 5, 2, &mut || false).unwrap();
+    assert_eq!(rows, f.input[5..].iter().map(|r| r[0]).collect::<Vec<_>>());
+}
