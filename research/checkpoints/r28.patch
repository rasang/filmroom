+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    struct Temp(PathBuf);
+    impl Temp {
+        fn new() -> Self {
+            let p = std::env::temp_dir().join(format!(
+                "derived-full-state-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&p).unwrap();
+            fs::set_permissions(&p, fs::Permissions::from_mode(0o700)).unwrap();
+            Self(p)
+        }
+    }
+    impl Drop for Temp {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+    fn state(root: &Path) -> State {
+        State {
+            output: root.join("out"),
+            root: directory(root, true).unwrap(),
+            epoch: 9,
+            generation: 3,
+            provider: None,
+            step: Step::Configured,
+            failure: None,
+            width: 1,
+            height: 1,
+            expected: None,
+            adopted: None,
+            grain: None,
+            pregrain_checked: false,
+            grain_after_checked: false,
+            record: json!({}),
+        }
+    }
+    fn fixture() -> (Temp, Temp, State, [PathBuf; 3]) {
+        let a = Temp::new();
+        let b = Temp::new();
+        let mut s = state(&a.0);
+        let p = std::array::from_fn(|c| {
+            let p = a.0.join(format!("candidate-{c}"));
+            fs::write(&p, (c as f64 + 1.).to_le_bytes()).unwrap();
+            p
+        });
+        s.expected = Some(planes(&p, 8, &mut || false).unwrap());
+        s.step = Step::Sealed;
+        (a, b, s, p)
+    }
+    #[test]
+    fn transition_rejects_skips_duplicates_and_failed_states() {
+        let t = Temp::new();
+        let mut s = state(&t.0);
+        assert!(transition(&mut s, Step::Sealed, Step::Confirmed).is_err());
+        assert_eq!(s.step, Step::Configured);
+        for (a, b) in [
+            (Step::Configured, Step::Running),
+            (Step::Running, Step::Sealed),
+            (Step::Sealed, Step::Confirmed),
+            (Step::Confirmed, Step::Pregrain),
+            (Step::Pregrain, Step::GrainBefore),
+            (Step::GrainBefore, Step::GrainAfter),
+        ] {
+            transition(&mut s, a, b).unwrap();
+            assert!(transition(&mut s, a, b).is_err());
+        }
+        s.step = Step::Failed;
+        assert!(transition(&mut s, Step::Sealed, Step::Confirmed).is_err());
+    }
+    #[test]
+    fn tickets_require_same_frame_epoch_and_new_sequence() {
+        let p = StageTicket {
+            epoch: 9,
+            generation: 3,
+            sequence: 6,
+        };
+        let t = StageTicket { sequence: 7, ..p };
+        validate_ticket(t, p, 9, 3).unwrap();
+        for bad in [
+            p,
+            StageTicket { sequence: 5, ..t },
+            StageTicket { epoch: 10, ..t },
+            StageTicket { generation: 4, ..t },
+        ] {
+            assert!(validate_ticket(bad, p, 9, 3).is_err());
+        }
+        assert!(validate_ticket(t, StageTicket { sequence: 0, ..p }, 9, 3).is_err());
+        assert!(validate_ticket(t, p, 9, 4).is_err());
+    }
+    #[test]
+    fn exact_three_renames_confirm_then_pregrain_once() {
+        let (_a, b, mut s, p) = fixture();
+        let target = std::array::from_fn(|c| b.0.join(format!("density-{c}")));
+        for c in 0..3 {
+            fs::rename(&p[c], &target[c]).unwrap();
+        }
+        verify_adoption(&mut s, &target, &mut || false).unwrap();
+        assert!(verify_adoption(&mut s, &target, &mut || false).is_err());
+        verify_pregrain(&mut s, &target, &mut || false).unwrap();
+        assert!(verify_pregrain(&mut s, &target, &mut || false).is_err());
+    }
+    #[test]
+    fn sealed_but_rejected_before_adoption_cannot_reach_grain() {
+        let (_a, _b, mut s, p) = fixture();
+        assert!(verify_pregrain(&mut s, &p, &mut || false).is_err());
+        assert_eq!(s.step, Step::Sealed);
+    }
+    #[test]
+    fn copied_or_partial_adoption_does_not_install_state() {
+        let (_a, b, mut s, p) = fixture();
+        let target = std::array::from_fn(|c| b.0.join(format!("density-{c}")));
+        for c in 0..3 {
+            fs::copy(&p[c], &target[c]).unwrap();
+        }
+        assert!(verify_adoption(&mut s, &target, &mut || false).is_err());
+        assert!(s.adopted.is_none());
+        for c in 0..3 {
+            fs::remove_file(&target[c]).unwrap();
+        }
