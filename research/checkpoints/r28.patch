+}
+
+fn io<T>(result: std::io::Result<T>) -> R<T> {
+    result.map_err(|e| format!("{IO_ERROR}: {e}"))
+}
+fn mul(a: u64, b: u64) -> R<u64> {
+    a.checked_mul(b).ok_or_else(|| ERROR.into())
+}
+fn add(a: u64, b: u64) -> R<u64> {
+    a.checked_add(b).ok_or_else(|| ERROR.into())
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err(CANCELLED.into()) } else { Ok(()) }
+}
+fn valid_digest(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn plain_absolute(path: &Path) -> R<()> {
+    let text = path.to_str().ok_or(PATH_ERROR)?;
+    if !path.is_absolute()
+        || text == "/"
+        || text.as_bytes().contains(&0)
+        || text[1..]
+            .split('/')
+            .any(|p| p.is_empty() || p == "." || p == "..")
+    {
+        return Err(PATH_ERROR.into());
+    }
+    Ok(())
+}
+fn exact_size(file: &File, expected: u64) -> R<()> {
+    let metadata = io(file.metadata())?;
+    if !metadata.is_file() || metadata.len() != expected {
+        return Err(IO_ERROR.into());
+    }
+    Ok(())
+}
+fn hash_file(file: &mut File, expected: u64, c: &mut impl FnMut() -> bool) -> R<String> {
+    check(c)?;
+    exact_size(file, expected)?;
+    io(file.seek(SeekFrom::Start(0)))?;
+    let mut hasher = Sha256::new();
+    let mut bytes = vec![0u8; HASH_BUFFER_BYTES];
+    let mut remaining = expected;
+    while remaining != 0 {
+        check(c)?;
+        let count = remaining.min(bytes.len() as u64) as usize;
+        io(file.read_exact(&mut bytes[..count]))?;
+        check(c)?;
+        hasher.update(&bytes[..count]);
+        remaining -= count as u64;
+    }
+    // Size alone is not a substitute for reading the complete committed bytes.
+    let mut extra = [0u8; 1];
+    if io(file.read(&mut extra))? != 0 {
+        return Err(IO_ERROR.into());
+    }
+    exact_size(file, expected)?;
+    check(c)?;
+    Ok(format!("{:x}", hasher.finalize()))
+}
+fn range(start: u64, count: usize, samples: u64, capacity: u32) -> R<(u64, usize)> {
+    if count > capacity as usize || add(start, count as u64)? > samples {
+        return Err(IO_ERROR.into());
+    }
+    let bytes = usize::try_from(mul(count as u64, 8)?).map_err(|_| IO_ERROR)?;
+    Ok((mul(start, 8)?, bytes))
+}
+fn read_words(
+    file: &mut File,
+    start: u64,
+    count: usize,
+    p: &Soft64ImagePlan,
+    c: &mut impl FnMut() -> bool,
+) -> R<Vec<u64>> {
+    let (offset, bytes) = range(start, count, p.0.samples, p.0.sample_capacity)?;
+    check(c)?;
+    io(file.seek(SeekFrom::Start(offset)))?;
+    let mut raw = vec![0u8; bytes];
+    io(file.read_exact(&mut raw))?;
+    check(c)?;
+    let words = raw
+        .chunks_exact(8)
+        .map(|b| u64::from_le_bytes(b.try_into().unwrap()))
+        .collect();
+    check(c)?;
+    Ok(words)
+}
+fn write_bytes(writer: &mut impl Write, bytes: &[u8]) -> R<()> {
+    io(writer.write_all(bytes))
+}
+fn write_words(
+    file: &mut File,
+    start: u64,
+    values: &[u64],
+    p: &Soft64ImagePlan,
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    let (offset, bytes) = range(start, values.len(), p.0.samples, p.0.sample_capacity)?;
+    check(c)?;
+    io(file.seek(SeekFrom::Start(offset)))?;
+    let mut raw = Vec::with_capacity(bytes);
+    for word in values {
+        raw.extend_from_slice(&word.to_le_bytes());
+    }
+    write_bytes(file, &raw)?;
+    check(c)
+}
+fn gather(
+    file: &mut File,
+    p: &Soft64ImagePlan,
+    axis: Axis,
+    b: Batch,
+    c: &mut impl FnMut() -> bool,
+) -> R<Vec<u64>> {
+    check(c)?;
+    if axis == Axis::Rows {
+        return read_words(
+            file,
+            mul(b.first as u64, p.0.width as u64)?,
+            b.length.checked_mul(b.count).ok_or(ERROR)? as usize,
+            p,
+            c,
+        );
+    }
+    let mut packed = vec![0; b.length.checked_mul(b.count).ok_or(ERROR)? as usize];
+    for y in 0..b.length {
+        let row = read_words(
+            file,
+            add(mul(y as u64, p.0.width as u64)?, b.first as u64)?,
+            b.count as usize,
+            p,
+            c,
+        )?;
+        for (x, word) in row.into_iter().enumerate() {
+            let index = x
+                .checked_mul(b.length as usize)
+                .and_then(|n| n.checked_add(y as usize))
+                .ok_or(ERROR)?;
+            packed[index] = word;
+        }
+    }
+    check(c)?;
+    Ok(packed)
+}
+fn scatter(
+    file: &mut File,
+    p: &Soft64ImagePlan,
+    axis: Axis,
+    b: Batch,
+    values: &[u64],
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    check(c)?;
+    if values.len() != b.length.checked_mul(b.count).ok_or(ERROR)? as usize {
+        return Err(IO_ERROR.into());
+    }
+    if axis == Axis::Rows {
+        return write_words(file, mul(b.first as u64, p.0.width as u64)?, values, p, c);
+    }
+    let mut row = vec![0; b.count as usize];
+    for y in 0..b.length {
+        for (x, word) in row.iter_mut().enumerate() {
+            let index = x
+                .checked_mul(b.length as usize)
+                .and_then(|n| n.checked_add(y as usize))
+                .ok_or(ERROR)?;
+            *word = values[index];
+        }
+        write_words(
+            file,
+            add(mul(y as u64, p.0.width as u64)?, b.first as u64)?,
+            &row,
+            p,
+            c,
+        )?;
+    }
+    check(c)
+}
+
+/// A successful return retains ONLY this helper's private complete candidate.
+/// The outer owner still must seal successfully or confirm helper death before
+/// adoption/lease release/fallback; this function cannot certify its own death.
+pub(super) fn run<G: Compute>(
+    p: &Soft64ImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+) -> R<CandidateReceipt> {
+    run_inner(p, gpu, c, None)
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum InjectFailure {
+    CandidateWrite,
+    BeforeMarker,
+}
+fn run_inner<G: Compute>(
+    p: &Soft64ImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+    inject: Option<InjectFailure>,
+) -> R<CandidateReceipt> {
+    p.validate()?;
+    check(c)?;
+    let mut source = secure::Source::open(&p.0.source.path)?;
+    exact_size(&source.file, p.0.source.byte_length)?;
+    let source_before = hash_file(&mut source.file, p.0.source.byte_length, c)?;
+    if source_before != p.0.source.sha256 {
+        return Err(SOURCE_CHANGED.into());
+    }
+    source.unchanged()?;
+    check(c)?;
+    // The fd-based free-space check precedes mkdir/allocation. Sparse set_len
+    // below is never accepted as proof of available physical space.
+    let mut workspace = secure::Workspace::create(
+        &p.0.paths.private_directory,
+        p.0.resources.required_available_disk_bytes,
+    )?;
+    let receipt = (|| -> R<CandidateReceipt> {
+        let mut horizontal = workspace.create_file(HORIZONTAL_NAME)?;
+        let mut candidate = workspace.create_file(CANDIDATE_NAME)?;
+        io(horizontal.set_len(p.0.source.byte_length))?;
+        io(candidate.set_len(p.0.source.byte_length))?;
+        check(c)?;
+        for b in batches(p, Axis::Rows)? {
+            let values = gather(&mut source.file, p, Axis::Rows, b, c)?;
+            let spec = p.line_spec(b.length, b.count);
+            spec.validate_input(&values)?;
+            check(c)?;
+            let output = gpu.execute(&spec, &values, c)?;
+            gpu.check_status()?;
+            check(c)?; // after successful fence/unmap, before accepting words
+            spec.validate_input(&output)?;
+            scatter(&mut horizontal, p, Axis::Rows, b, &output, c)?;
+        }
+        check(c)?;
+        io(horizontal.sync_all())?;
+        exact_size(&horizontal, p.0.source.byte_length)?;
+        let horizontal_hash = hash_file(&mut horizontal, p.0.source.byte_length, c)?;
+        drop(horizontal);
+        // No column can see a partially completed horizontal axis. Reopen it
+        // read-only and verify the same exclusive-owned inode.
+        let mut horizontal = workspace.open_owned_read(HORIZONTAL_NAME)?;
+        for b in batches(p, Axis::Columns)? {
+            let values = gather(&mut horizontal, p, Axis::Columns, b, c)?;
+            let spec = p.line_spec(b.length, b.count);
+            spec.validate_input(&values)?;
+            check(c)?;
+            let output = gpu.execute(&spec, &values, c)?;
+            gpu.check_status()?;
+            check(c)?;
+            spec.validate_input(&output)?;
+            if inject == Some(InjectFailure::CandidateWrite) {
+                return Err("GPU_IIR64_IMAGE_INJECTED_WRITE_FAILURE".into());
+            }
+            scatter(&mut candidate, p, Axis::Columns, b, &output, c)?;
+        }
+        check(c)?;
+        io(candidate.sync_all())?;
+        let candidate_hash = hash_file(&mut candidate, p.0.source.byte_length, c)?;
+        if hash_file(&mut horizontal, p.0.source.byte_length, c)? != horizontal_hash {
+            return Err(IO_ERROR.into());
+        }
+        let source_after = hash_file(&mut source.file, p.0.source.byte_length, c)?;
+        source.unchanged()?;
+        if source_after != source_before {
+            return Err(SOURCE_CHANGED.into());
+        }
+        workspace.verify_owned(HORIZONTAL_NAME)?;
+        workspace.verify_owned(CANDIDATE_NAME)?;
+        drop(candidate);
+        drop(horizontal);
+        // Close the immutable source and its directory handle before marker.
+        drop(source);
+        let receipt = CandidateReceipt {
+            version: VERSION,
+            status: COMPLETE.into(),
+            plan_sha256: p.identity()?,
+            width: p.0.width,
+            height: p.0.height,
+            encoding: "binary64le".into(),
+            source_sha256_before: source_before,
+            source_sha256_after: source_after,
+            horizontal_sha256: horizontal_hash,
+            candidate_sha256: candidate_hash,
+            plane_byte_length: p.0.source.byte_length,
+            candidate64: p.0.paths.candidate64.clone(),
+            candidate_marker: p.0.paths.candidate_marker.clone(),
+            row_batches: p.0.row_batch_count,
+            column_batches: p.0.column_batch_count,
+            requires_outer_seal_or_confirmed_helper_death: true,
+        };
+        check(c)?;
+        if inject == Some(InjectFailure::BeforeMarker) {
+            return Err("GPU_IIR64_IMAGE_INJECTED_PREPUBLICATION_FAILURE".into());
+        }
+        let metadata = serde_json::to_vec(&receipt).map_err(|_| ERROR)?;
+        if metadata.len() as u64 > METADATA_BYTES {
+            return Err(ERROR.into());
+        }
+        gpu.check_status()?;
+        let mut marker = workspace.create_file(MARKER_NAME)?;
+        check(c)?;
+        write_bytes(&mut marker, &metadata)?;
+        check(c)?;
+        io(marker.sync_all())?;
+        drop(marker);
+        workspace.verify_all()?;
+        check(c)?;
+        workspace.sync()?;
+        check(c)?;
+        gpu.check_status()?;
+        Ok(receipt)
+    })()?;
+    gpu.check_status()?;
+    check(c)?;
+    workspace.retain();
+    // Dropping workspace closes all directory handles before this returns.
+    drop(workspace);
+    Ok(receipt)
+}
