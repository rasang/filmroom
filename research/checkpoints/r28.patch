+            );
+            let original_sum = (0_f64 + 0.1633 * 1.) + 0.6496 * 1. + 0.1870 * 1.;
+            assert_ne!(original_sum.to_bits(), 1_f64.to_bits());
+            assert_eq!(actual.tail_weight_bits, weight.to_bits());
+            assert!(DirCalibration::from_pipeline(&pipe, ORIGINAL_PITCH, 23, 17).is_err());
+        }
+    }
