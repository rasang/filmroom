+        pub(super) fn verify_owned(&self, _: &str) -> R<()> {
+            Err(PATH_ERROR.into())
+        }
+        pub(super) fn verify_all(&self) -> R<()> {
+            Err(PATH_ERROR.into())
+        }
+        pub(super) fn sync(&self) -> R<()> {
+            Err(PATH_ERROR.into())
