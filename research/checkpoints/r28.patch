+#[test]
+fn short_writes_are_retried_but_zero_or_error_writes_reject() {
+    struct Writer {
+        bytes: Vec<u8>,
+        zero_after: usize,
+        error: bool,
+    }
+    impl Write for Writer {
+        fn write(&mut self, input: &[u8]) -> std::io::Result<usize> {
+            if self.error {
+                return Err(std::io::Error::other("injected write error"));
+            }
+            if self.bytes.len() >= self.zero_after {
+                return Ok(0);
+            }
+            let count = input.len().min(3).min(self.zero_after - self.bytes.len());
+            self.bytes.extend_from_slice(&input[..count]);
+            Ok(count)
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let expected = [0x5a; 37];
+    let mut writer = Writer {
+        bytes: vec![],
+        zero_after: usize::MAX,
+        error: false,
+    };
+    write_bytes(&mut writer, &expected).unwrap();
+    assert_eq!(writer.bytes, expected);
+    assert!(
+        write_bytes(
+            &mut Writer {
+                bytes: vec![],
+                zero_after: 5,
+                error: false
+            },
+            &expected
+        )
+        .is_err()
+    );
+    assert!(
+        write_bytes(
+            &mut Writer {
+                bytes: vec![],
+                zero_after: usize::MAX,
+                error: true
+            },
+            &expected
+        )
+        .is_err()
+    );
+}
