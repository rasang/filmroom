+#[test]
+fn final_narrowing_is_explicit_and_never_accepts_underflow() {
+    assert_eq!(narrow(&[(-0f64).to_bits(), 0]).unwrap(), [0., 0.]);
+    assert_eq!(narrow(&[(-0f64).to_bits()]).unwrap()[0].to_bits(), 0);
+    for value in [f32::MIN_POSITIVE as f64, -(f32::MIN_POSITIVE as f64), BOUND] {
+        assert_eq!(narrow(&[value.to_bits()]).unwrap()[0], value as f32);
+    }
+    for value in [
+        f64::MIN_POSITIVE,
+        f32::MIN_POSITIVE as f64 * 0.5,
+        f64::from_bits((f32::MIN_POSITIVE as f64).to_bits() - 1),
+        f64::INFINITY,
+        f64::NAN,
+    ] {
+        assert!(narrow(&[value.to_bits()]).is_err());
+    }
+    for value in [
+        1. + 2f64.powi(-24),
+        1. + 3. * 2f64.powi(-24),
+        -1. - 3. * 2f64.powi(-24),
+    ] {
+        assert_eq!(
+            narrow(&[value.to_bits()]).unwrap()[0].to_bits(),
+            (value as f32).to_bits()
+        );
+    }
+}
