+        "kodak_portra_endura",
+        true,
+    );
+    let input = fs::read(&f.input).unwrap();
+    let (stop, _) = flags();
+    let final_ref: Value = serde_json::from_slice(&r22_reference_bytes(
+        &reference,
+        "causal-prefix/threeway-final.json",
+    ))
+    .unwrap();
+    assert_eq!(
+        format!("{:x}", Sha256::digest(&input)),
