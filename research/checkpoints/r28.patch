+            2 => changed.producer_shader_sha256 = "0".repeat(64),
+            3 => changed.input_plane_sha256[2] = "invalid".into(),
+            _ => changed.output_plane_sha256[1] = "invalid".into(),
+        }
+        assert!(changed.validate().is_err());
+    }
+}
