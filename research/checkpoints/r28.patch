+fn rejected(ticket: StageTicket, gpu: DirGpu, f: &Fixture, p: &DirImagePlan) {
+    f.assert_no_candidates(p);
+    assert!(gpu.context.error.load(Ordering::Relaxed));
+    assert!(gpu.ready(&mut || false).is_err());
+    assert!(session::complete_stage(ticket).is_err());
+    drop(gpu);
+    assert!(
+        session::complete_stage(ticket).is_err(),
+        "faulted request cannot seal after resource drop"
+    );
+}
+struct FailSecondChannel {
+    gpu: DirGpu,
+    fired: bool,
+}
+impl Compute for FailSecondChannel {
+    fn check_status(&self) -> R<()> {
+        self.gpu.ready(&mut || false)
+    }
+    fn point(
+        &mut self,
+        p: &DirCalibration,
+        j: Job,
+        v: &[[u64; 3]],
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        if j.operation == Operation::InitialCorrection && j.channel == 1 {
+            self.fired = true;
+            return Err("DIR64_TEST_SECOND_CHANNEL_FAILURE".into());
+        }
+        self.gpu.point(p, j, v, c)
+    }
+    fn raw(&mut self, p: &LineSpec, v: &[u64], c: &mut impl FnMut() -> bool) -> R<Vec<u64>> {
+        self.gpu.raw(p, v, c)
+    }
+    fn poison(&mut self) {
+        self.gpu.poison();
+    }
+}
