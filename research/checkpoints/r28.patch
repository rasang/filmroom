+++ b/native/crates/film-engine/src/research_iir_soft64/gpu.rs
@@ -0,0 +1,717 @@
+//! Test-only typed binary64 IIR probe. This is not a production or file route.
+use super::*;
+use crate::gpu_phase_diagnostics::{self as trace, Phase as GpuPhase};
+use std::{
+    sync::{atomic::Ordering, mpsc},
+    time::{Duration, Instant},
+};
+
+const OUTPUT32_BYTES: u64 = BATCH_BYTES / 2;
+const MAP_BYTES: u64 = BATCH_BYTES + OUTPUT32_BYTES + 4;
+// Exact-size pool allocations, excluding queue-owned upload staging.
+const RESIDENT_BYTES: u64 = 2 * BATCH_BYTES + OUTPUT32_BYTES + MAP_BYTES + 4 + 64;
+const FIXED_BYTES: u64 = 2 * HOST_BYTES; // Host buffers plus isolated-helper allowance.
+const DRIVER_BYTES: u64 = 72 * 1024 * 1024; // 64 MiB driver base + one 8 MiB family.
+const COMBINED_BYTES: u64 = DEVICE_BYTES + FIXED_BYTES + DRIVER_BYTES;
+
+#[derive(Debug, Default)]
+struct Metrics {
+    dispatches: u64,
+    completed_readbacks: u64,
+    transient_releases: u64,
+    upload_bytes: u64,
+    readback_bytes: u64,
+    upload_ms: f64,
+    wait_readback_ms: f64,
+    adapter: String,
+}
+#[derive(Debug)]
+struct Output {
+    binary64: Vec<u64>,
+    narrowed: Vec<f32>,
+}
+// Private fault injection for deterministic final-check tests. This entire
+// module is cfg(test); normal probe construction leaves the hook absent.
+enum AfterUnmapFault {
+    Cancel(std::sync::Arc<std::sync::atomic::AtomicBool>),
+    DeviceError,
+}
+struct Probe {
+    source: wgpu::Buffer,
+    result64: wgpu::Buffer,
+    result32: wgpu::Buffer,
+    error: wgpu::Buffer,
+    readback: wgpu::Buffer,
+    pipeline: wgpu::ComputePipeline,
+    metrics: Metrics,
+    after_unmap_fault: Option<AfterUnmapFault>,
+    // Last: releasing the Context cannot precede releasing any GPU resource.
+    context: crate::gpu_session::Context,
+}
+impl Probe {
+    fn new(c: &mut impl FnMut() -> bool) -> R<Self> {
+        check(c)?;
+        let source = shader()?;
+        let context = trace::phase_result(GpuPhase::Device, || {
+            crate::gpu_session::Context::acquire(MAP_BYTES, 4, true)
+        })?;
+        let result = (|| {
+            let entries: Vec<_> = (0..5)
+                .map(|index| wgpu::BindGroupLayoutEntry {
+                    binding: index,
+                    visibility: wgpu::ShaderStages::COMPUTE,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: if index == 4 {
+                            wgpu::BufferBindingType::Uniform
+                        } else {
+                            wgpu::BufferBindingType::Storage {
+                                read_only: index == 0,
+                            }
+                        },
+                        has_dynamic_offset: false,
+                        min_binding_size: wgpu::BufferSize::new(match index {
+                            0 | 1 => 8,
+                            4 => 64,
+                            _ => 4,
+                        }),
+                    },
+                    count: None,
+                })
+                .collect();
+            check(c)?;
+            let (mut pipelines, _) = trace::phase_result(GpuPhase::Pipeline, || {
+                context.pipelines(&[&source], Some(&entries))
+            })?;
+            let pipeline = pipelines.pop().ok_or("GPU_IIR_SOFT64_PIPELINE")?;
+            let storage = wgpu::BufferUsages::STORAGE
+                | wgpu::BufferUsages::COPY_SRC
+                | wgpu::BufferUsages::COPY_DST;
+            let make = |label, size, usage| {
+                context.buffer(
+                    &wgpu::BufferDescriptor {
+                        label: Some(label),
+                        size,
+                        usage,
+                        mapped_at_creation: false,
+                    },
+                    false,
+                )
+            };
+            let source = make("closed IIR binary64 input", BATCH_BYTES, storage)?;
+            let result64 = make(
+                "closed IIR full forward/backward words",
+                BATCH_BYTES,
+                storage,
+            )?;
+            let result32 = make("closed IIR final f32 conversion", OUTPUT32_BYTES, storage)?;
+            // Context zeroes a checkout. Never reset during a probe's lifetime.
+            let error = make("closed IIR sticky numeric rejection", 4, storage)?;
+            let readback = make(
+                "closed IIR typed words and conversion witness",
+                MAP_BYTES,
+                wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            )?;
+            check(c)?;
+            Ok((source, result64, result32, error, readback, pipeline))
+        })();
+        let (source, result64, result32, error, readback, pipeline) = match result {
+            Ok(value) => value,
+            Err(error) => {
+                context.error.store(true, Ordering::Release);
+                crate::gpu_session::retire_current();
+                return Err(error);
+            }
+        };
+        let metrics = Metrics {
+            adapter: context.info.name.clone(),
+            ..Default::default()
+        };
+        Ok(Self {
+            source,
+            result64,
+            result32,
+            error,
+            readback,
+            pipeline,
+            metrics,
+            after_unmap_fault: None,
+            context,
+        })
+    }
+    fn poison(&self) {
+        self.context.error.store(true, Ordering::Release);
+        crate::gpu_session::retire_current();
+    }
+    fn execute(&mut self, p: &Plan, values: &[u64], c: &mut impl FnMut() -> bool) -> R<Output> {
+        let result = self.execute_inner(p, values, c, true);
+        if result.is_err() {
+            self.poison();
+        }
+        result
+    }
+    fn execute_inner(
+        &mut self,
+        p: &Plan,
+        values: &[u64],
+        c: &mut impl FnMut() -> bool,
+        validate_input: bool,
+    ) -> R<Output> {
+        // The false flag is reachable only from this test module's device fault
+        // fixture. No exported caller can bypass input validation.
+        if self.context.error.load(Ordering::Acquire) {
+            return Err("GPU_DEVICE_FAILED".into());
+        }
+        check(c)?;
+        p.validate()?;
+        if values.len() != p.samples() {
+            return Err("GPU_IIR_SOFT64_INPUT".into());
+        }
+        if validate_input {
+            p.validate_input(values)?;
+        }
+        let size64 = (values.len() as u64)
+            .checked_mul(8)
+            .ok_or("GPU_IIR_SOFT64_INPUT")?;
+        let size32 = size64 / 2;
+        let mapped_size = size64 + size32 + 4;
+        if size64 > BATCH_BYTES || mapped_size > MAP_BYTES {
+            return Err("GPU_IIR_SOFT64_BUDGET".into());
+        }
+        let at = Instant::now();
+        let bytes: Vec<u8> = values.iter().flat_map(|x| x.to_le_bytes()).collect();
+        self.context.queue.write_buffer(&self.source, 0, &bytes);
+        let words = p.words();
+        let uniform = self.context.buffer_init(
+            &wgpu::util::BufferInitDescriptor {
+                label: Some("closed IIR immutable typed descriptor"),
+                contents: bytemuck::cast_slice(&words),
+                usage: wgpu::BufferUsages::UNIFORM,
+            },
+            true,
+        )?;
+        self.metrics.upload_bytes += size64 + 64;
+        self.metrics.upload_ms += at.elapsed().as_secs_f64() * 1000.;
+        drop(bytes);
+        let entries = [
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: self.source.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 1,
+                resource: self.result64.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: self.result32.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 3,
+                resource: self.error.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 4,
+                resource: uniform.as_entire_binding(),
+            },
+        ];
+        let group = self
+            .context
+            .device
+            .create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("closed binary64 IIR probe"),
+                layout: &self.pipeline.get_bind_group_layout(0),
+                entries: &entries,
+            });
+        let mut encoder = self
+            .context
+            .device
+            .create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+                label: Some("original complete-line binary64 IIR"),
+                timestamp_writes: None,
+            });
+            pass.set_pipeline(&self.pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(p.lines.div_ceil(64), 1, 1);
+        }
+        encoder.copy_buffer_to_buffer(&self.result64, 0, &self.readback, 0, size64);
+        encoder.copy_buffer_to_buffer(&self.result32, 0, &self.readback, size64, size32);
+        encoder.copy_buffer_to_buffer(&self.error, 0, &self.readback, size64 + size32, 4);
+        check(c)?;
+        self.context.queue.submit([encoder.finish()]);
+        self.metrics.dispatches += 1;
+        let (tx, rx) = mpsc::channel();
+        self.readback
+            .slice(0..mapped_size)
+            .map_async(wgpu::MapMode::Read, move |r| {
+                let _ = tx.send(r);
+            });
+        let start = Instant::now();
+        let result = (|| {
+            loop {
+                check(c)?;
+                if self.context.error.load(Ordering::Acquire) {
+                    return Err("GPU_DEVICE_FAILED".into());
+                }
+                let _ = self.context.device.poll(wgpu::Maintain::Poll);
+                match rx.try_recv() {
+                    Ok(Ok(())) => break,
+                    Ok(Err(_)) | Err(mpsc::TryRecvError::Disconnected) => {
+                        return Err("GPU_IIR_SOFT64_READBACK".into());
+                    }
+                    Err(mpsc::TryRecvError::Empty) => {}
+                }
+                // Same bound as the existing full-line implementation.
+                if start.elapsed() > Duration::from_secs(5) {
+                    return Err("GPU_IIR_SOFT64_TIMEOUT".into());
+                }
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            let mapped = self.readback.slice(0..mapped_size).get_mapped_range();
+            let flag = u32::from_le_bytes(mapped[(size64 + size32) as usize..].try_into().unwrap());
+            if flag != 0 {
+                return Err("GPU_IIR_SOFT64_NUMERIC_DOMAIN".into());
+            }
+            let binary64: Vec<u64> = mapped[..size64 as usize]
+                .chunks_exact(8)
+                .map(|x| u64::from_le_bytes(x.try_into().unwrap()))
+                .collect();
+            let narrowed: Vec<f32> = mapped[size64 as usize..(size64 + size32) as usize]
+                .chunks_exact(4)
+                .map(|x| f32::from_le_bytes(x.try_into().unwrap()))
+                .collect();
+            if binary64.iter().any(|x| !f64::from_bits(*x).is_finite())
+                || narrowed.iter().any(|x| !x.is_finite())
+            {
+                return Err("GPU_IIR_SOFT64_NONFINITE_OUTPUT".into());
+            }
+            Ok(Output { binary64, narrowed })
+        })();
+        // No mapped view escapes the closure, including all error paths.
+        self.readback.unmap();
+        self.metrics.wait_readback_ms += start.elapsed().as_secs_f64() * 1000.;
+        if result.is_ok() {
+            self.metrics.completed_readbacks += 1;
+            // Faults occur only after a successful map, full decode, view drop
+            // and unmap. Neither poll count nor timing selects this boundary.
+            if let Some(fault) = self.after_unmap_fault.take() {
+                match fault {
+                    AfterUnmapFault::Cancel(flag) => flag.store(true, Ordering::Release),
+                    AfterUnmapFault::DeviceError => {
+                        self.context.error.store(true, Ordering::Release)
+                    }
+                }
+            }
+            // Cancellation/device loss can arrive after map completion or
+            // during CPU decoding. Do not accept or return handles to the pool
+            // without rechecking after the mapped view has been released.
+            check(c)?;
+            if self.context.error.load(Ordering::Acquire) {
+                return Err("GPU_DEVICE_FAILED".into());
+            }
+            // Map success is a queue-completion fence, not a helper stage seal.
+            self.context.release_transients_after_fence()?;
+            self.metrics.transient_releases += 1;
+            self.metrics.readback_bytes += mapped_size;
+        }
+        result
+    }
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err("CANCELLED".into()) } else { Ok(()) }
+}
+
+fn inputs(length: u32, lines: u32, kind: u32) -> Vec<u64> {
+    (0..u64::from(length) * u64::from(lines))
+        .map(|i| {
+            let j = i % u64::from(length);
+            let line = i / u64::from(length);
+            let value = match kind {
+                0 => 1.,
+                1 => {
+                    if j == u64::from(length / 3) {
+                        16.
+                    } else {
+                        -0.25
+                    }
+                }
+                _ => {
+                    let step = if j < u64::from(length / 2) { -1. } else { 1. };
+                    step + (((j * 17 + line * 13) % 37) as f64 - 18.) / 32.
+                }
+            };
+            value.to_bits()
+        })
+        .collect()
+}
+fn original_reference(p: &Plan, input: &[u64]) -> Vec<f64> {
+    assert!(
+        cfg!(feature = "precision-f64"),
+        "independent original f64 reference required"
+    );
+    let source: Vec<_> = input
+        .iter()
+        .map(|x| f64::from_bits(*x) as spektrafilm_math::precision::Scalar)
+        .collect();
+    let mut output = vec![0. as spektrafilm_math::precision::Scalar; source.len()];
+    spektrafilm_math::gaussian::gaussian_blur_rows(
+        &source,
+        &mut output,
+        p.length as usize,
+        f32::from_bits(p.sigma_bits),
+    );
+    output.into_iter().map(|x| x as f64).collect()
+}
+fn verify(p: &Plan, source: &[u64], actual: &Output) {
+    let expected = original_reference(p, source);
+    assert_eq!(actual.binary64.len(), expected.len());
+    assert_eq!(actual.narrowed.len(), expected.len());
+    let mut zero_sign_differences = 0usize;
+    let mut max = 0f64;
+    let mut sum = 0.;
+    for (i, (&r, &bits)) in expected.iter().zip(&actual.binary64).enumerate() {
+        let a = f64::from_bits(bits);
+        assert!(r.is_finite() && a.is_finite());
+        if r == 0. && a == 0. {
+            zero_sign_differences += usize::from(r.to_bits() != bits);
+        } else {
+            assert_eq!(
+                bits,
+                r.to_bits(),
+                "binary64 index={i} sigma=0x{:08x} length={}",
+                p.sigma_bits,
+                p.length
+            );
+        }
+        let converted = r as f32;
+        if converted != 0. || actual.narrowed[i] != 0. {
+            assert_eq!(
+                actual.narrowed[i].to_bits(),
+                converted.to_bits(),
+                "final f32 index={i}"
+            );
+        }
+        let error = (f64::from(actual.narrowed[i]) - r).abs();
+        max = max.max(error);
+        sum += error * error;
+        assert!(error <= crate::research_spatial::NUMERIC_TOLERANCE * r.abs().max(1.));
+    }
+    eprintln!(
+        "soft64 probe sigma=0x{:08x} length={} lines={} full_nonzero_bits_match=true zero_sign_differences={} final_f32_max_abs={} rms={}",
+        p.sigma_bits,
+        p.length,
+        p.lines,
+        zero_sign_differences,
+        max,
+        (sum / expected.len() as f64).sqrt()
+    );
+}
+fn begin(epoch: u64, generation: u64) -> crate::gpu_session_contract::StageTicket {
+    use crate::{gpu_session as session, gpu_session_contract::StageTicket};
+    let t = StageTicket {
+        epoch,
+        generation,
+        sequence: generation,
+    };
+    session::begin_frame(epoch, generation).unwrap();
+    session::begin_stage(t, DRIVER_BYTES).unwrap();
+    t
+}
