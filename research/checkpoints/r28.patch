+#[test]
+fn mixed_point_view_revalidates_curves_and_spatial_identity_before_packet() {
+    let mut pipe = tests::pipeline();
+    pipe.params.film_render.dir_couplers.diffusion_size_um = 5.;
+    pipe.params.film_render.dir_couplers.diffusion_tail_um = 2.;
+    let new = DirMixedCalibration::from_pipeline(&pipe, 10., 17, 13).unwrap();
+    let job = Job {
