+fn prerequisite_1024(e:&Evidence){
+ let p=root_env("FILM_GPU_EXPOSURE64_REAL_CAP1024_RECEIPT");
+ assert!(fs::metadata(&p).unwrap().len()<128*1024);
+ let v:Value=serde_json::from_slice(&fs::read(&p).unwrap()).unwrap();
+ assert_eq!(v["status"],"PASS_EXACT_SCOPED");assert_eq!(v["case"],"gpu-real1024");
+ assert_eq!(v["binarySha256"],binary_sha());assert_eq!(v["chunkCap"],1024);
+ assert_eq!(v["r23IndexSha256"],R23_SHA);assert_eq!(v["r22IndexSha256"],R22_SHA);
+ assert_eq!(v["inputSha256"],INPUT_SHA);assert_eq!(v["tableSha256"],table_sha(&e.descriptor));
+ assert_eq!(v["batches"].as_array().unwrap().len(),1);
+ assert_eq!(v["batches"][0]["range"],json!([0,1024]));
+ for a in v["artifacts"].as_array().unwrap(){
+  let name=a["file"].as_str().unwrap();assert!(!name.contains('/')&&!name.contains(".."));
+  let f=p.parent().unwrap().join(name);assert_eq!(fs::metadata(&f).unwrap().len(),a["bytes"].as_u64().unwrap());assert_eq!(hash_file(&f),a["sha256"].as_str().unwrap());
+ }
+ let b=&v["batches"][0];assert_eq!(b["candidate"]["sha256"],b["originalCpu"]["sha256"]);assert_eq!(b["candidate"]["sha256"],b["reference"]["sha256"]);
+ for key in ["candidate","originalCpu","reference"]{assert!(v["artifacts"].as_array().unwrap().contains(&b[key]));assert_eq!(b[key]["bytes"],1024*24);}
+}
+fn bounded(root:&Path,cap:u32,lengths:&[usize],require_1024:bool)->Value{
+ assert!(cap==1024||cap==4096);assert!(!lengths.is_empty());assert!(lengths.iter().all(|&n|n>0&&n<=cap as usize));
+ let mut diagnostics=trace::TaskScope::for_test(0x4558503643415053,27,|snapshot|{
+  let Ok(mut line)=serde_json::to_vec(&json!({"event":"real_cap_phase","observationOnly":true,"snapshot":snapshot}))else{return false;};line.push(b'\n');let stderr=std::io::stderr();let mut sink=stderr.lock();sink.write_all(&line).and_then(|_|sink.flush()).is_ok()
+ });
+ let prep=trace::PhaseGuard::begin(Phase::Prepare);let e=evidence();host_receipt(&e);if require_1024{prerequisite_1024(&e);}persist_identity(root,&e);
+ let mut artifacts=vec![artifact(root,"descriptor.json"),artifact(root,"input-full384.rgb.f32le"),artifact(root,"table.f64le"),artifact(root,"provenance.json")];
+ let epoch=0x4558503643410000+cap as u64;session::activate(epoch,TOTAL,FIXED,3).unwrap();session::begin_frame(epoch,1).unwrap();prep.finish();
+ let mut batches=Vec::new();let mut prior:Option<session::SessionStats>=None;let mut offset=0usize;
+ for (batch,&count) in lengths.iter().enumerate(){
