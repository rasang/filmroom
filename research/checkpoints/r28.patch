+/// Every configured family is scheduled independently. FIR and Identity share
+/// the prefix-bearing ABI, never the larger prefix-free IIR capacity.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct BatchGeometry {
+    length: u32,
+    total_lines: u32,
+    lines_per_batch: u32,
+    batch_count: u32,
+    final_batch_lines: u32,
+}
+impl BatchGeometry {
+    fn new(length: u32, total_lines: u32, capacity: u32) -> R<Self> {
+        if length == 0 || total_lines == 0 || capacity < length {
+            return Err(ERROR.into());
+        }
+        let lines_per_batch = (capacity / length).min(total_lines);
+        let batch_count = total_lines.div_ceil(lines_per_batch);
+        let final_batch_lines = total_lines - (batch_count - 1) * lines_per_batch;
+        Ok(Self {
+            length,
+            total_lines,
+            lines_per_batch,
+            batch_count,
+            final_batch_lines,
+        })
+    }
