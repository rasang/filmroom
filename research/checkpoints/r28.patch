+#[test]
+fn original384_parameters_admit_unchanged_with_exact_four_fir_components() {
+    let pipe = original384_pipeline();
+    let calibration = fixture();
+    assert_eq!((calibration.width, calibration.height), (384, 512));
+    assert_eq!(calibration.pitch_bits, 10_f32.to_bits());
+    assert_eq!(calibration.diffusion_size_um_bits, 5_f64.to_bits());
+    assert_eq!(calibration.diffusion_tail_um_bits, 2_f64.to_bits());
+    assert_eq!(calibration.core_sigma_bits, 0.5_f32.to_bits());
+    let decay = (2_f64 / 10_f32 as f64) as f32;
+    assert_eq!(calibration.tail_decay_bits, decay.to_bits());
+    let sigmas = [
+        0.5,
+        (0.5360 * decay as f64) as f32,
+        (1.5236 * decay as f64) as f32,
+        (2.7684 * decay as f64) as f32,
+    ];
+    assert_eq!(
+        calibration.tail_sigma_bits,
+        [sigmas[1], sigmas[2], sigmas[3]].map(f32::to_bits)
+    );
+    for ((filter, sigma), expected_radius) in calibration
+        .filters
+        .as_ref()
+        .unwrap()
+        .iter()
+        .zip(sigmas)
+        .zip([2, 0, 1, 2])
+    {
+        let Gaussian::Fir {
+            sigma_bits,
+            radius,
+            coefficient_bits,
+        } = filter
+        else {
+            panic!("original384 must remain FIR");
+        };
+        assert_eq!(*sigma_bits, sigma.to_bits());
+        assert_eq!(*radius, expected_radius);
+        assert_eq!((*radius, coefficient_bits.clone()), original_fir(sigma));
+        assert!(!filter.is_identity());
+    }
+    assert_original_point(&calibration, &pipe);
+    assert!(DirCalibration::from_pipeline(&pipe, ORIGINAL_PITCH, 384, 512).is_err());
+}
