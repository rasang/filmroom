+#[test]
+fn composed_shader_naga_validates_the_five_typed_bindings_and_uniform() {
+    let source = shader().unwrap();
+    let module = naga::front::wgsl::parse_str(&source)
+        .unwrap_or_else(|error| panic!("{}", error.emit_to_string(&source)));
+    naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::empty(),
+    )
+    .validate(&module)
+    .unwrap();
+    assert_eq!(module.entry_points.len(), 1);
+    assert_eq!(module.entry_points[0].workgroup_size, [64, 1, 1]);
+    let bindings: BTreeMap<u32, &naga::GlobalVariable> = module
+        .global_variables
+        .iter()
+        .filter_map(|(_, global)| {
+            global.binding.as_ref().map(|binding| {
+                assert_eq!(binding.group, 0);
+                (binding.binding, global)
+            })
+        })
+        .collect();
+    assert_eq!(
+        bindings.keys().copied().collect::<Vec<_>>(),
+        [0, 1, 2, 3, 4]
+    );
+    for (binding, stride, expected) in [(0, 8, "vec2"), (1, 8, "vec2"), (2, 4, "f32")] {
+        let naga::TypeInner::Array {
+            base,
+            size,
+            stride: actual,
+        } = &module.types[bindings[&binding].ty].inner
+        else {
+            panic!("not an array");
+        };
+        assert_eq!(*actual, stride);
+        assert_eq!(*size, naga::ArraySize::Dynamic);
+        match (&module.types[*base].inner, expected) {
+            (
+                naga::TypeInner::Vector {
+                    size: naga::VectorSize::Bi,
+                    scalar,
+                },
+                "vec2",
+            ) => assert_eq!(
+                *scalar,
+                naga::Scalar {
+                    kind: naga::ScalarKind::Uint,
+                    width: 4
+                }
+            ),
+            (naga::TypeInner::Scalar(scalar), "f32") => assert_eq!(
+                *scalar,
+                naga::Scalar {
+                    kind: naga::ScalarKind::Float,
+                    width: 4
+                }
+            ),
+            _ => panic!("wrong scalar type"),
+        }
+    }
+    assert_eq!(
+        bindings[&0].space,
+        naga::AddressSpace::Storage {
+            access: naga::StorageAccess::LOAD
+        }
+    );
+    for index in [1, 2, 3] {
+        assert_eq!(
+            bindings[&index].space,
+            naga::AddressSpace::Storage {
+                access: naga::StorageAccess::LOAD | naga::StorageAccess::STORE
+            }
+        );
+    }
+    assert!(matches!(
+        module.types[bindings[&3].ty].inner,
+        naga::TypeInner::Atomic(naga::Scalar {
+            kind: naga::ScalarKind::Uint,
+            width: 4
+        })
+    ));
+    assert_eq!(bindings[&4].space, naga::AddressSpace::Uniform);
+    let naga::TypeInner::Struct { members, span } = &module.types[bindings[&4].ty].inner else {
+        panic!("not uniform struct");
+    };
+    assert_eq!(*span, 64);
+    assert_eq!(members.len(), 1);
+    assert_eq!(members[0].offset, 0);
+    let naga::TypeInner::Array {
+        base,
+        size: naga::ArraySize::Constant(count),
+        stride,
+    } = &module.types[members[0].ty].inner
+    else {
+        panic!("not uniform vec4 array");
+    };
+    assert_eq!(count.get(), 4);
+    assert_eq!(*stride, 16);
+    assert!(matches!(
+        module.types[*base].inner,
+        naga::TypeInner::Vector {
+            size: naga::VectorSize::Quad,
+            scalar: naga::Scalar {
+                kind: naga::ScalarKind::Uint,
+                width: 4
+            }
+        }
+    ));
+}
