+fn after_unmap_fault_case(epoch: u64, cancel: bool) {
+    use crate::gpu_session as session;
+    use std::sync::{Arc, atomic::AtomicBool};
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 1).unwrap();
+    let ticket = begin(epoch, 1);
+    let mut gpu = Probe::new(&mut || false).unwrap();
+    let flag = Arc::new(AtomicBool::new(false));
+    gpu.after_unmap_fault = Some(if cancel {
+        AfterUnmapFault::Cancel(flag.clone())
+    } else {
+        AfterUnmapFault::DeviceError
+    });
+    let p = Plan::new(f32::from_bits(0x41a757a2), 17, 1).unwrap();
+    let source = inputs(17, 1, 2);
+    let result = gpu.execute(&p, &source, &mut || flag.load(Ordering::Acquire));
+    assert_eq!(
+        result.unwrap_err(),
+        if cancel {
+            "CANCELLED"
+        } else {
+            "GPU_DEVICE_FAILED"
+        }
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert_eq!(
+        gpu.metrics.completed_readbacks, 1,
+        "real map, decode and unmap completed before the fault"
+    );
+    assert_eq!(
+        gpu.metrics.transient_releases, 0,
+        "failed final check must not return transient buffers for reuse"
+    );
+    assert_eq!(
+        gpu.metrics.readback_bytes, 0,
+        "decoded output was not accepted"
+    );
+    assert!(
+        gpu.after_unmap_fault.is_none(),
+        "deterministic hook was reached"
+    );
+    assert_eq!(flag.load(Ordering::Acquire), cancel);
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    assert_eq!(
+        gpu.execute(&p, &source, &mut || false).unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    assert_eq!(
+        gpu.metrics.dispatches, 1,
+        "poisoned owner must not submit again"
+    );
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+}
+#[test]
+#[ignore = "One fresh process: cancellation injected after actual successful unmap must fail the final check"]
+fn actual_after_unmap_cancel_forbids_reuse_and_seal() {
+    after_unmap_fault_case(95309, true);
+}
