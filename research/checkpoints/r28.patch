+// Shared checked point preparation only. This type chooses no spatial filter
+// and grants no execution admission. Keep the original ordered expressions and
+// the two independently gamma-scaled axes at their original precision boundaries.
+pub(super) struct PreparedPointScience {
+    pub(super) core_sigma_bits: u32,
+    pub(super) tail_decay_bits: u32,
+    pub(super) tail_sigma_bits: [u32; 3],
+    pub(super) matrix_bits: [[u64; 3]; 3],
+    pub(super) density_max_bits: [u64; 3],
+    pub(super) initial: CurveWords,
+    pub(super) before_dir: CurveWords,
+}
+
+impl PreparedPointScience {
+    pub(super) fn inputs_from_pipeline(pipe: &Pipeline) -> R<CalibrationInputs> {
+        CalibrationInputs::from_pipeline(pipe)
+    }
+
+    pub(super) fn derive(
+        inputs: &CalibrationInputs,
+        gamma: f32,
+        pitch: f32,
+        positive: bool,
+        diffusion_size: f64,
+        diffusion_tail: f64,
+    ) -> R<Self> {
+        inputs.validate()?;
+        for value in [gamma as f64, pitch as f64, diffusion_size, diffusion_tail] {
+            guard(value)?;
+        }
+        if gamma <= 0. || pitch <= 0. {
+            return Err(DOMAIN_ERROR.into());
+        }
+        let profile_axis: Vec<f64> = inputs
+            .profile_axis
+            .iter()
+            .copied()
+            .map(f64::from_bits)
+            .collect();
+        let profile_curves: Vec<[f64; 3]> = inputs
+            .profile_values
+            .iter()
+            .map(|row| row.map(f64::from_bits))
+            .collect();
+        let initial = CurveWords::from_original(
+            profile_axis.clone(),
+            spektrafilm_model::density_curves::normalize_density_curves_f64(&profile_curves),
+            gamma as f64,
+        )?;
+        let [r, g, b] = inputs.gamma_interlayer.map(|row| row.map(f64::from_bits));
+        let mut matrix = spektrafilm_model::couplers::compute_dir_couplers_matrix(
+            inputs.gamma_samelayer.map(f64::from_bits),
+            r,
+            g,
+            b,
+            f64::from_bits(inputs.inhibition_samelayer),
+            f64::from_bits(inputs.inhibition_interlayer),
+        );
+        for row in &mut matrix {
+            for value in row {
+                guard(*value)?;
+                *value *= f64::from_bits(inputs.amount);
+                guard(*value)?;
+            }
+        }
+        // These f32 boundaries are original science, not a shortcut. In
+        // particular normalize(f64) then cast is NOT normalize(cast(f64)).
+        let axis32: Vec<f32> = profile_axis.iter().map(|&value| value as f32).collect();
+        let curves32: Vec<[f32; 3]> = profile_curves
+            .iter()
+            .map(|row| row.map(|value| value as f32))
+            .collect();
+        let norm32 = spektrafilm_model::density_curves::normalize_density_curves(&curves32);
+        for &value in norm32.iter().flatten() {
+            guard(value as f64)?;
+        }
+        let before32 = spektrafilm_model::couplers::compute_curves_before_dir(
+            &norm32,
+            &axis32,
+            &matrix.map(|row| row.map(|value| value as f32)),
+            positive,
+        );
+        // A second independent gamma scaling and reciprocal preparation. Never
+        // borrow the initial f64 axis or its reciprocal spacings here.
+        let before_dir = CurveWords::from_original(
+            axis32.iter().map(|&value| value as f64).collect(),
+            before32
+                .iter()
+                .map(|row| row.map(|value| value as f64))
+                .collect(),
+            gamma as f64,
+        )?;
+        let density_max_bits = spektrafilm_model::density_curves::max_density(&norm32)
+            .map(|value| (value as f64).to_bits());
+        guard_words(&density_max_bits)?;
+        let core_sigma = if diffusion_size > 0. {
+            let quotient = diffusion_size / pitch as f64;
+            guard(quotient)?;
+            quotient as f32
+        } else {
+            // Original image code skips both filters and blend for nonpositive
+            // core; canonical +0 matches the original small DirPlan preparation.
+            0.
+        };
+        let tail_quotient = diffusion_tail / pitch as f64;
+        guard(tail_quotient)?;
+        let tail_decay = tail_quotient as f32;
+        let tail_sigma = FIT.map(|(_, ratio)| (ratio * tail_decay as f64) as f32);
+        for sigma in [core_sigma, tail_decay].into_iter().chain(tail_sigma) {
+            guard(sigma as f64)?;
+        }
+        Ok(Self {
+            core_sigma_bits: core_sigma.to_bits(),
+            tail_decay_bits: tail_decay.to_bits(),
+            tail_sigma_bits: tail_sigma.map(f32::to_bits),
+            matrix_bits: matrix.map(|row| row.map(f64::to_bits)),
+            density_max_bits,
+            initial,
+            before_dir,
+        })
+    }
+}
+
+fn guard(value: f64) -> R<()> {
+    if admitted(value.to_bits()) {
+        Ok(())
+    } else {
+        Err(DOMAIN_ERROR.into())
+    }
+}
+fn guard_words<'a>(words: impl IntoIterator<Item = &'a u64>) -> R<()> {
+    if words.into_iter().all(|&bits| admitted(bits)) {
+        Ok(())
+    } else {
+        Err(DOMAIN_ERROR.into())
+    }
+}
