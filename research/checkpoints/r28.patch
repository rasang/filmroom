@@ -0,0 +1,113 @@
+// Closed, test-only full-line binary64 recurrence. No production dispatcher.
+// Source and forward/backward storage contain both original binary64 words.
+struct IirParameters { words: array<vec4<u32>, 4>, }
+@group(0) @binding(0) var<storage, read> iir_source: array<vec2<u32>>;
+@group(0) @binding(1) var<storage, read_write> iir_result: array<vec2<u32>>;
+@group(0) @binding(2) var<storage, read_write> iir_output: array<f32>;
+@group(0) @binding(3) var<storage, read_write> iir_error: atomic<u32>;
+@group(0) @binding(4) var<uniform> iir_parameters: IirParameters;
+
+// Exact binary64 lift of T_BOUND = 1e15f32, not the wider 1e15f64.
+const IIR_BOUND: vec2<u32> = vec2<u32>(0x20000000u, 0x430c6bf5u);
+const IIR_F32_MIN_NORMAL: vec2<u32> = vec2<u32>(0u, 0x38100000u);
+
+fn iir_reject() {
+    sf_failed = 1u;
+    atomicOr(&iir_error, 1u);
+}
+fn iir_accept(x: vec2<u32>) -> bool {
+    if (sf_failed != 0u || !sf_valid(x)) { iir_reject(); return false; }
+    if (sf_cmpu(sf_abs(x), IIR_BOUND) > 0) { iir_reject(); return false; }
+    return true;
+}
+fn iir_mul(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!iir_accept(a) || !iir_accept(b)) { return SF_NAN; }
+    let result = sf_mul(a, b);
+    if (!iir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn iir_add(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!iir_accept(a) || !iir_accept(b)) { return SF_NAN; }
+    let result = sf_add(a, b);
+    if (!iir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn iir_step(x: vec2<u32>, s1: vec2<u32>, s2: vec2<u32>, s3: vec2<u32>,
+            a: vec2<u32>, b1: vec2<u32>, b2: vec2<u32>, b3: vec2<u32>) -> vec2<u32> {
+    let p0 = iir_mul(a, x);
+    let p1 = iir_mul(b1, s1);
+    let t0 = iir_add(p0, p1);
+    let p2 = iir_mul(b2, s2);
+    let t1 = iir_add(t0, p2);
+    let p3 = iir_mul(b3, s3);
+    return iir_add(t1, p3);
+}
+fn iir_narrow(x: vec2<u32>) -> f32 {
+    if (!iir_accept(x)) { return 0.0; }
+    // Explicitly reject any nonzero input below f32 normal range, even if
+    // a boundary case could round upward. No device flush-to-zero acceptance.
+    if (!sf_zero(x) && sf_cmpu(sf_abs(x), IIR_F32_MIN_NORMAL) < 0) {
+        iir_reject(); return 0.0;
+    }
+    let result = sf_scalar(x);
+    if (sf_failed != 0u) { iir_reject(); return 0.0; }
+    let magnitude = bitcast<u32>(result) & 0x7fffffffu;
+    if (magnitude >= 0x7f800000u || (magnitude != 0u && magnitude < 0x00800000u)) {
+        iir_reject(); return 0.0;
+    }
+    return result;
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    // The request-wide flag is never cleared by a shader invocation or batch.
+    if (atomicLoad(&iir_error) != 0u) { return; }
+    let dimensions = iir_parameters.words[0];
+    let length = dimensions.x;
+    let lines = dimensions.y;
+    let total = dimensions.z;
+    if (length == 0u || length > 40000u || lines == 0u || dimensions.w != 0u ||
+        any(iir_parameters.words[3] != vec4<u32>(0u))) { iir_reject(); return; }
+    if (lines > 524288u / length) { iir_reject(); return; }
+    if (total != length * lines || total > arrayLength(&iir_source) ||
+        total > arrayLength(&iir_result) || total > arrayLength(&iir_output)) {
+        iir_reject(); return;
+    }
+    let line = gid.x;
+    if (line >= lines) { return; }
+    let a = iir_parameters.words[1].xy;
+    let b1 = iir_parameters.words[1].zw;
+    let b2 = iir_parameters.words[2].xy;
+    let b3 = iir_parameters.words[2].zw;
+    if (!iir_accept(a) || !iir_accept(b1) || !iir_accept(b2) || !iir_accept(b3)) { return; }
+    let base = line * length;
+    for (var i = 0u; i < length; i = i + 1u) {
+        if (!iir_accept(iir_source[base + i])) { return; }
+    }
+    var s1 = iir_source[base];
+    var s2 = s1;
+    var s3 = s1;
+    for (var i = 0u; i < length; i = i + 1u) {
+        let value = iir_step(iir_source[base + i], s1, s2, s3, a, b1, b2, b3);
+        if (sf_failed != 0u) { iir_reject(); return; }
+        iir_result[base + i] = value;
+        s3 = s2; s2 = s1; s1 = value;
+    }
+    // All three backward states are the final full-precision forward value.
+    s1 = iir_result[base + length - 1u];
+    s2 = s1;
+    s3 = s1;
+    for (var remaining = length; remaining > 0u; remaining = remaining - 1u) {
+        let i = remaining - 1u;
+        let value = iir_step(iir_result[base + i], s1, s2, s3, a, b1, b2, b3);
+        if (sf_failed != 0u) { iir_reject(); return; }
+        iir_result[base + i] = value;
+        s3 = s2; s2 = s1; s1 = value;
+    }
+    // Diagnostic f32 output is a separate last step. Raw results remain intact.
+    for (var i = 0u; i < length; i = i + 1u) {
+        let value = iir_narrow(iir_result[base + i]);
+        if (sf_failed != 0u) { iir_reject(); return; }
+        iir_output[base + i] = value;
+    }
+}
