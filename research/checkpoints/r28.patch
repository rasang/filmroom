@@ -0,0 +1,1113 @@
+//! Closed R23 counterfactual diagnostic: measure each actual operator output,
+//! then replace only private work bytes with pinned original-CPU boundary bytes.
+//! This is not a continuous all-GPU prefix or a production quality repair.
+#![cfg(all(test, feature = "gpu-diffusion-research", feature = "precision-f64"))]
+use serde::Serialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    ffi::CString,
+    fs::{self, File, OpenOptions},
+    io::{Read, Seek, SeekFrom, Write},
+    os::unix::{
+        ffi::OsStrExt,
+        fs::{DirBuilderExt, MetadataExt, OpenOptionsExt},
+    },
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+type R<T> = Result<T, String>;
+const ERROR: &str = "TEST_SAME_INPUT_OPERATOR";
+pub(crate) const STAGES: [&str; 6] = [
+    "afterFilmExposure",
+    "afterHighlight",
+    "afterCameraDiffusion",
+    "afterFilmOptics",
+    "afterExposureLog",
+    "afterDir",
+];
+const WIDTH: u32 = 384;
+const HEIGHT: u32 = 512;
+const PLANE_BYTES: u64 = WIDTH as u64 * HEIGHT as u64 * 8;
+const MARGIN: u64 = 256 * 1024 * 1024;
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Identity {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    bytes: u64,
+}
+#[derive(Clone, Debug, Serialize)]
+struct Pinned {
+    id: Identity,
+    sha256: String,
+}
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Errors {
+    samples: u64,
+    word_mismatches: u64,
+    zero_sign_mismatches: u64,
+    max_abs: f64,
+    squared_sum: f64,
+    rms: f64,
+}
+impl Errors {
+    fn push(&mut self, a: f64, b: f64) -> R<()> {
+        if !a.is_finite() || !b.is_finite() {
+            return fail();
+        }
+        self.samples += 1;
+        if a.to_bits() != b.to_bits() {
+            self.word_mismatches += 1;
+            if a == 0. && b == 0. {
+                self.zero_sign_mismatches += 1;
+            }
+        }
+        let d = (a - b).abs();
+        self.max_abs = self.max_abs.max(d);
+        self.squared_sum += d * d;
+        if !self.squared_sum.is_finite() {
+            return fail();
+        }
+        Ok(())
+    }
+    fn finish(&mut self) {
+        self.rms = (self.squared_sum / self.samples.max(1) as f64).sqrt();
+    }
+}
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Channel {
+    work: Identity,
+    reference: Identity,
+    reference_sha256: String,
+    local_output_sha256: String,
+    captured: Identity,
+    captured_sha256: String,
+    errors: Errors,
+}
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Boundary {
+    index: usize,
+    name: &'static str,
+    adopted_gpu_witness: bool,
+    channels: [Channel; 3],
+    errors: Errors,
+    reset_performed: bool,
+    reset_sha256: Option<[String; 3]>,
+}
+struct State {
+    output: PathBuf,
+    input: Pinned,
+    scratch: PathBuf,
+    scratch_parent: Identity,
+    scratch_identity: Option<Identity>,
+    root: Identity,
+    references: [[Pinned; 3]; 6],
+    cpu_ae: f64,
+    cpu_exposure: f64,
+    require_cpu_exact: bool,
+    exposure: Option<Value>,
+    records: Vec<Boundary>,
+    failure: Option<String>,
+    // Deterministic closed host fault; normal configure always leaves None.
+    reset_fault_channel: Option<usize>,
+}
+static CONFIG: Mutex<Option<Arc<Mutex<State>>>> = Mutex::new(None);
+pub(crate) struct Scope(Arc<Mutex<State>>);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if let Ok(mut c) = CONFIG.lock() {
+            if c.as_ref().is_some_and(|v| Arc::ptr_eq(v, &self.0)) {
+                *c = None;
+            }
+        }
+    }
+}
+fn fail<T>() -> R<T> {
+    Err(ERROR.into())
+}
+fn io<T>(r: std::io::Result<T>) -> R<T> {
+    r.map_err(|e| format!("{ERROR}: {e}"))
+}
+fn id(path: &Path, m: &fs::Metadata) -> Identity {
+    Identity {
+        path: path.into(),
+        device: m.dev(),
+        inode: m.ino(),
+        bytes: m.len(),
+    }
+}
+fn stamp(m: &fs::Metadata) -> (u64, u64, u64, i64, i64, i64, i64) {
+    (
+        m.dev(),
+        m.ino(),
+        m.len(),
+        m.mtime(),
+        m.mtime_nsec(),
+        m.ctime(),
+        m.ctime_nsec(),
+    )
+}
+fn dir(path: &Path, private: bool) -> R<Identity> {
+    let m = io(fs::symlink_metadata(path))?;
+    if !path.is_absolute()
+        || io(path.canonicalize())? != path
+        || !m.is_dir()
+        || m.file_type().is_symlink()
+        || m.uid() != unsafe { libc::geteuid() }
+        || (private && m.mode() & 0o777 != 0o700)
+    {
+        return fail();
+    }
+    Ok(Identity {
+        bytes: 0,
+        ..id(path, &m)
+    })
+}
+fn regular(path: &Path, single: bool) -> R<Identity> {
+    let m = io(fs::symlink_metadata(path))?;
+    if !path.is_absolute()
+        || io(path.canonicalize())? != path
+        || !m.is_file()
+        || m.file_type().is_symlink()
+        || (single && m.nlink() != 1)
+    {
+        return fail();
+    }
+    Ok(id(path, &m))
+}
+fn open_checked(expected: &Identity, write: bool, single: bool) -> R<File> {
+    if regular(&expected.path, single)? != *expected {
+        return fail();
+    }
+    let f = io(OpenOptions::new()
+        .read(true)
+        .write(write)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(&expected.path))?;
+    let m = io(f.metadata())?;
+    if id(&expected.path, &m) != *expected || (single && m.nlink() != 1) {
+        return fail();
+    }
+    Ok(f)
+}
+fn hash_id(expected: &Identity, single: bool) -> R<String> {
+    let mut f = open_checked(expected, false, single)?;
+    let before = io(f.metadata())?;
+    let mut left = expected.bytes;
+    let mut buf = [0u8; 65536];
+    let mut h = Sha256::new();
+    while left > 0 {
+        let n = left.min(buf.len() as u64) as usize;
+        io(f.read_exact(&mut buf[..n]))?;
+        h.update(&buf[..n]);
+        left -= n as u64;
+    }
+    let after = io(f.metadata())?;
+    if stamp(&before) != stamp(&after)
+        || stamp(&after) != stamp(&io(fs::symlink_metadata(&expected.path))?)
+    {
+        return fail();
+    }
+    Ok(format!("{:x}", h.finalize()))
+}
+fn valid_sha(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn available(path: &Path) -> R<u64> {
+    let p = CString::new(path.as_os_str().as_bytes()).map_err(|_| ERROR)?;
+    let mut v = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    if unsafe { libc::statvfs(p.as_ptr(), v.as_mut_ptr()) } != 0 {
+        return fail();
+    }
+    let v = unsafe { v.assume_init() };
+    (v.f_bavail as u64)
+        .checked_mul(v.f_frsize as u64)
+        .ok_or_else(|| ERROR.into())
+}
+fn create(path: &Path) -> R<File> {
+    io(OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path))
+}
+fn sync_dir(path: &Path) -> R<()> {
+    io(io(File::open(path))?.sync_all())
+}
+fn same_inode(a: &Identity, b: &Identity) -> bool {
+    (a.device, a.inode) == (b.device, b.inode)
+}
+fn active() -> R<Option<Arc<Mutex<State>>>> {
+    Ok(CONFIG.lock().map_err(|_| ERROR)?.clone())
+}
+fn scoped<T>(path: &Path, is_input: bool, inactive: T, f: impl FnOnce(&mut State) -> R<T>) -> R<T> {
+    let Some(s) = active()? else {
+        return Ok(inactive);
+    };
+    let mut s = s.lock().map_err(|_| ERROR)?;
+    if (if is_input {
+        &s.input.id.path
+    } else {
+        &s.output
+    }) != path
+    {
+        return Ok(inactive);
+    }
+    if s.failure.is_some() {
+        return fail();
+    }
+    let result = f(&mut s);
+    if let Err(ref e) = result {
+        s.failure = Some(e.clone());
+    }
+    result
+}
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn configure(
+    output: PathBuf,
+    input: PathBuf,
+    scratch_root: PathBuf,
+    evidence_root: PathBuf,
+    references: [[PathBuf; 3]; 6],
+    expected_sha: [[String; 3]; 6],
+    cpu_ae: f64,
+    cpu_exposure: f64,
+    require_cpu_exact: bool,
+) -> R<Scope> {
+    if !output.is_absolute()
+        || !scratch_root.is_absolute()
+        || !cpu_ae.is_finite()
+        || !cpu_exposure.is_finite()
+        || cpu_ae <= 0.
+        || cpu_exposure <= 0.
+    {
+        return fail();
+    }
+    let parent = scratch_root.parent().ok_or(ERROR)?;
+    let scratch_parent = dir(parent, false)?;
+    let name = scratch_root.file_name().ok_or(ERROR)?;
+    if scratch_root != scratch_parent.path.join(name)
+        || scratch_root.try_exists().map_err(|_| ERROR)?
+    {
+        return fail();
+    }
+    let root = dir(&evidence_root, true)?;
+    if root.path.starts_with(&scratch_root) || scratch_root.starts_with(&root.path) {
+        return fail();
+    }
+    for n in STAGES {
+        if root.path.join(n).try_exists().map_err(|_| ERROR)? {
+            return fail();
+        }
+    }
+    let input_id = regular(&input, false)?;
+    if input_id.bytes != u64::from(WIDTH) * u64::from(HEIGHT) * 12
+        || input_id.path.starts_with(&root.path)
+        || input_id.path.starts_with(&scratch_root)
+    {
+        return fail();
+    }
+    let input = Pinned {
+        sha256: hash_id(&input_id, false)?,
+        id: input_id,
+    };
+    let mut pins = Vec::new();
+    for i in 0..6 {
+        for ch in 0..3 {
+            if !valid_sha(&expected_sha[i][ch]) {
+                return fail();
+            }
+            let r = regular(&references[i][ch], false)?;
+            if r.bytes != PLANE_BYTES
+                || r.path.starts_with(&root.path)
+                || r.path.starts_with(&scratch_root)
+                || same_inode(&r, &input.id)
+                || pins.iter().any(|p: &Pinned| same_inode(&r, &p.id))
+            {
+                return fail();
+            }
+            let sha = hash_id(&r, false)?;
+            if sha != expected_sha[i][ch] {
+                return fail();
+            }
+            pins.push(Pinned { id: r, sha256: sha });
+        }
+    }
+    let mut groups: Vec<[Pinned; 3]> = Vec::new();
+    for part in pins.chunks_exact(3) {
+        groups.push(part.to_vec().try_into().map_err(|_| ERROR)?);
+    }
+    let references: [[Pinned; 3]; 6] = groups.try_into().map_err(|_| ERROR)?;
+    let mut c = CONFIG.lock().map_err(|_| ERROR)?;
+    if c.is_some() {
+        return fail();
+    }
+    let s = Arc::new(Mutex::new(State {
+        output,
+        input,
+        scratch: scratch_root,
+        scratch_parent,
+        scratch_identity: None,
+        root,
+        references,
+        cpu_ae,
+        cpu_exposure,
+        require_cpu_exact,
+        exposure: None,
+        records: Vec::new(),
+        failure: None,
+        reset_fault_channel: None,
+    }));
+    *c = Some(s.clone());
+    Ok(Scope(s))
+}
+fn exposure_inner(
+    s: &mut State,
+    actual_ae: f64,
+    actual_exposure: f64,
+    meter: Option<f32>,
+) -> R<f64> {
+    if s.exposure.is_some()
+        || !s.records.is_empty()
+        || !actual_ae.is_finite()
+        || !actual_exposure.is_finite()
+        || meter.is_some_and(|v| !v.is_finite())
+        || actual_exposure.to_bits() != s.cpu_exposure.to_bits()
+        || hash_id(&s.input.id, false)? != s.input.sha256
+    {
+        return fail();
+    }
+    if s.require_cpu_exact && actual_ae.to_bits() != s.cpu_ae.to_bits() {
+        return fail();
+    }
+    s.exposure = Some(
+        json!({"observedAeF64Bits":format!("{:016x}",actual_ae.to_bits()),"appliedAeF64Bits":format!("{:016x}",s.cpu_ae.to_bits()),"observedExposureF64Bits":format!("{:016x}",actual_exposure.to_bits()),"appliedExposureF64Bits":format!("{:016x}",s.cpu_exposure.to_bits()),"observedMeteredEvF32Bits":meter.map(|v|format!("{:08x}",v.to_bits())),"aeOverridden":actual_ae.to_bits()!=s.cpu_ae.to_bits(),"counterfactual":!s.require_cpu_exact,"meterIsNotRecomputed":true}),
+    );
+    Ok(s.cpu_ae)
+}
+pub(crate) fn exposure(
+    input: &Path,
+    actual_ae: f64,
+    actual_exposure: f64,
+    meter: Option<f32>,
+) -> R<f64> {
+    scoped(input, true, actual_ae, |s| {
+        exposure_inner(s, actual_ae, actual_exposure, meter)
+    })
+}
+fn checked_work(s: &mut State, paths: &[PathBuf; 3], bytes: u64) -> R<[Identity; 3]> {
+    if dir(&s.scratch_parent.path, false)? != s.scratch_parent || dir(&s.root.path, true)? != s.root
+    {
+        return fail();
+    }
+    let current = dir(&s.scratch, false)?;
+    if s.scratch_identity.as_ref().is_some_and(|p| p != &current) {
+        return fail();
+    }
+    s.scratch_identity = Some(current);
+    let mut work = Vec::new();
+    for path in paths {
+        let w = regular(path, true)?;
+        if !w.path.starts_with(&s.scratch)
+            || w.path == s.scratch
+            || w.bytes != bytes
+            || same_inode(&w, &s.input.id)
+            || s.references.iter().flatten().any(|r| same_inode(&w, &r.id))
+            || s.records
+                .iter()
+                .flat_map(|r| r.channels.iter())
+                .any(|r| same_inode(&w, &r.captured))
+            || work.iter().any(|p| same_inode(&w, p))
+        {
+            return fail();
+        }
+        work.push(w);
+    }
+    work.try_into().map_err(|_| ERROR.into())
+}
+fn capture_channel(work: &Identity, reference: &Pinned, target: &Path) -> R<Channel> {
+    let mut source = open_checked(work, false, true)?;
+    let sb = io(source.metadata())?;
+    let mut reference_file = open_checked(&reference.id, false, false)?;
+    let rb = io(reference_file.metadata())?;
+    let mut output = create(target)?;
+    let mut left = work.bytes;
+    let (mut a, mut b) = ([0u8; 65536], [0u8; 65536]);
+    let (mut local_h, mut ref_h) = (Sha256::new(), Sha256::new());
+    let mut errors = Errors::default();
+    while left > 0 {
+        let n = left.min(a.len() as u64) as usize;
+        io(source.read_exact(&mut a[..n]))?;
+        io(reference_file.read_exact(&mut b[..n]))?;
+        io(output.write_all(&a[..n]))?;
+        local_h.update(&a[..n]);
+        ref_h.update(&b[..n]);
+        for (x, y) in a[..n].chunks_exact(8).zip(b[..n].chunks_exact(8)) {
+            errors.push(
+                f64::from_le_bytes(x.try_into().map_err(|_| ERROR)?),
+                f64::from_le_bytes(y.try_into().map_err(|_| ERROR)?),
+            )?;
+        }
+        left -= n as u64;
+    }
+    io(output.sync_all())?;
+    let captured = id(target, &io(output.metadata())?);
+    drop(output);
+    errors.finish();
+    let sha = format!("{:x}", local_h.finalize());
+    let rsha = format!("{:x}", ref_h.finalize());
+    if stamp(&sb) != stamp(&io(source.metadata())?)
+        || stamp(&rb) != stamp(&io(reference_file.metadata())?)
+        || rsha != reference.sha256
+        || hash_id(work, true)? != sha
+        || hash_id(&reference.id, false)? != reference.sha256
+        || hash_id(&captured, true)? != sha
+    {
+        return fail();
+    }
+    Ok(Channel {
+        work: work.clone(),
+        reference: reference.id.clone(),
+        reference_sha256: rsha,
+        local_output_sha256: sha.clone(),
+        captured,
+        captured_sha256: sha,
+        errors,
+    })
+}
+fn reset_work(work: &[Identity; 3], references: &[Pinned; 3]) -> R<[String; 3]> {
+    reset_work_with_fault(work, references, None)
+}
+fn reset_work_with_fault(
+    work: &[Identity; 3],
+    references: &[Pinned; 3],
+    fault_channel: Option<usize>,
+) -> R<[String; 3]> {
+    // All destination handles are checked/opened before mutation. No truncation,
+    // rename, hardlink, reference write or size change. Failure is whole-run fatal;
+    // there is no rollback or claim of atomic multi-file replacement.
+    let mut outputs = work
+        .iter()
+        .map(|p| open_checked(p, true, true))
+        .collect::<R<Vec<_>>>()?;
+    for ch in 0..3 {
+        let metadata = io(outputs[ch].metadata())?;
+        if metadata.nlink() != 1
+            || id(&work[ch].path, &metadata) != work[ch]
+            || work
+                .iter()
+                .enumerate()
+                .any(|(other, p)| other != ch && same_inode(&work[ch], p))
+            || references.iter().any(|r| same_inode(&work[ch], &r.id))
+        {
+            return fail();
+        }
+    }
+    for ch in 0..3 {
+        if hash_id(&references[ch].id, false)? != references[ch].sha256 {
+            return fail();
+        }
+    }
+    for ch in 0..3 {
+        let mut source = open_checked(&references[ch].id, false, false)?;
+        let before = io(source.metadata())?;
+        let out = &mut outputs[ch];
+        io(out.seek(SeekFrom::Start(0)))?;
+        let mut left = work[ch].bytes;
+        let mut buffer = [0u8; 65536];
+        let mut h = Sha256::new();
+        while left > 0 {
+            let n = left.min(buffer.len() as u64) as usize;
+            io(source.read_exact(&mut buffer[..n]))?;
+            if fault_channel == Some(ch) {
+                io(out.write_all(&buffer[..n / 2]))?;
+                io(out.sync_all())?;
+                return Err("TEST_SAME_INPUT_INJECTED_MIDWRITE".into());
+            }
+            io(out.write_all(&buffer[..n]))?;
+            h.update(&buffer[..n]);
+            left -= n as u64;
+        }
+        io(out.sync_all())?;
+        if stamp(&before) != stamp(&io(source.metadata())?)
+            || format!("{:x}", h.finalize()) != references[ch].sha256
+            || id(&work[ch].path, &io(out.metadata())?) != work[ch]
+        {
+            return fail();
+        }
+    }
+    drop(outputs);
+    let mut hashes = Vec::new();
+    for ch in 0..3 {
+        let hash = hash_id(&work[ch], true)?;
+        if hash != references[ch].sha256
+            || hash_id(&references[ch].id, false)? != references[ch].sha256
+        {
+            return fail();
+        }
+        hashes.push(hash);
+    }
+    hashes.try_into().map_err(|_| ERROR.into())
+}
+fn boundary_attempt(
+    s: &mut State,
+    name: &'static str,
+    paths: &[PathBuf; 3],
+    w: u32,
+    h: u32,
+    adopted_gpu: bool,
+) -> R<()> {
+    let index = s.records.len();
+    if index >= 6
+        || STAGES[index] != name
+        || s.exposure.is_none()
+        || (w, h) != (WIDTH, HEIGHT)
+        || adopted_gpu == s.require_cpu_exact
+    {
+        return fail();
+    }
+    let work = checked_work(s, paths, PLANE_BYTES)?;
+    if available(&s.root.path)? < PLANE_BYTES * 3 + MARGIN + 65536 {
+        return Err("TEST_SAME_INPUT_OPERATOR_DISK_BUDGET".into());
+    }
+    let stage = s.root.path.join(name);
+    io(fs::DirBuilder::new().mode(0o700).create(&stage))?;
+    let stage_id = dir(&stage, true)?;
+    let mut channels = Vec::new();
+    for ch in 0..3 {
+        channels.push(capture_channel(
+            &work[ch],
+            &s.references[index][ch],
+            &stage.join(format!("channel-{ch}.f64le")),
+        )?);
+    }
+    let channels: [Channel; 3] = channels.try_into().map_err(|_| ERROR)?;
+    if s.require_cpu_exact
+        && channels
+            .iter()
+            .any(|c| c.local_output_sha256 != c.reference_sha256 || c.errors.word_mismatches != 0)
+    {
+        return Err("TEST_SAME_INPUT_CPU_REFERENCE_MISMATCH".into());
+    }
+    // Recheck all adopted local outputs before any reset can obscure a mismatch.
+    for ch in 0..3 {
+        if hash_id(&work[ch], true)? != channels[ch].local_output_sha256
+            || hash_id(&channels[ch].captured, true)? != channels[ch].local_output_sha256
+        {
+            return fail();
+        }
+    }
+    let mut errors = Errors::default();
+    for c in &channels {
+        errors.samples += c.errors.samples;
+        errors.word_mismatches += c.errors.word_mismatches;
+        errors.zero_sign_mismatches += c.errors.zero_sign_mismatches;
+        errors.max_abs = errors.max_abs.max(c.errors.max_abs);
+        errors.squared_sum += c.errors.squared_sum;
+    }
+    if !errors.squared_sum.is_finite() {
+        return fail();
+    }
+    errors.finish();
+    let reset_sha256 = if index < 5 {
+        Some(reset_work_with_fault(
+            &work,
+            &s.references[index],
+            s.reset_fault_channel,
+        )?)
+    } else {
+        None
+    };
+    if dir(&stage, true)? != stage_id
+        || dir(&s.root.path, true)? != s.root
+        || checked_work(s, paths, PLANE_BYTES)? != work
+    {
+        return fail();
+    }
+    let record = Boundary {
+        index,
+        name,
+        adopted_gpu_witness: adopted_gpu,
+        channels,
+        errors,
+        reset_performed: index < 5,
+        reset_sha256,
+    };
+    let bytes = serde_json::to_vec_pretty(&record).map_err(|_| ERROR)?;
+    if bytes.len() > 65536 {
+        return fail();
+    }
+    let mut file = create(&stage.join("boundary.json"))?;
+    io(file.write_all(&bytes))?;
+    io(file.sync_all())?;
+    drop(file);
+    sync_dir(&stage)?;
+    sync_dir(&s.root.path)?;
+    s.records.push(record);
+    Ok(())
+}
+fn boundary_inner(
+    s: &mut State,
+    name: &'static str,
+    paths: &[PathBuf; 3],
+    w: u32,
+    h: u32,
+    adopted_gpu: bool,
+) -> R<()> {
+    if s.failure.is_some() {
+        return fail();
+    }
+    let result = boundary_attempt(s, name, paths, w, h, adopted_gpu);
+    if let Err(ref e) = result {
+        s.failure = Some(e.clone());
+    }
+    result
+}
+pub(crate) fn boundary(
+    output: &Path,
+    name: &'static str,
+    paths: &[PathBuf; 3],
+    w: u32,
+    h: u32,
+    adopted_gpu: bool,
+) -> R<()> {
+    scoped(output, false, (), |s| {
+        boundary_inner(s, name, paths, w, h, adopted_gpu)
+    })
+}
+fn report_inner(s: &State) -> R<Value> {
+    if s.failure.is_some()
+        || s.exposure.is_none()
+        || s.records.len() != 6
+        || dir(&s.root.path, true)? != s.root
+        || hash_id(&s.input.id, false)? != s.input.sha256
+    {
+        return fail();
+    }
+    for (index, r) in s.records.iter().enumerate() {
+        if r.index != index
+            || r.name != STAGES[index]
+            || r.reset_performed != (index < 5)
+            || r.adopted_gpu_witness == s.require_cpu_exact
+        {
+            return fail();
+        }
+        for ch in 0..3 {
+            if hash_id(&r.channels[ch].captured, true)? != r.channels[ch].captured_sha256
+                || hash_id(&s.references[index][ch].id, false)? != s.references[index][ch].sha256
+            {
+                return fail();
+            }
+        }
+    }
+    Ok(
+        json!({"testOnly":true,"kind":"same-input-single-operator-counterfactual","width":WIDTH,"height":HEIGHT,"input":s.input,"scratchRoot":s.scratch,"evidenceRoot":s.root,"requireCpuExact":s.require_cpu_exact,"exposure":s.exposure,"boundaries":s.records,"boundaryCount":6,"resetCount":5,"retainedPlaneBytes":PLANE_BYTES*18,"sameInputScope":"fixed original-CPU prior boundary bytes per operator; not a continuous all-GPU prefix","backendWitnessScope":"caller actual adopted-backend boolean; not an independent seal proof","diagnosticArithmeticOnly":true,"allGpuEndToEnd":false,"productionQualityRepair":false,"complete":true}),
+    )
+}
+pub(crate) fn report(output: &Path) -> R<Value> {
+    let Some(s) = active()? else { return fail() };
+    let mut s = s.lock().map_err(|_| ERROR)?;
+    if s.output != output {
+        return fail();
+    }
+    let result = report_inner(&s);
+    if let Err(ref e) = result {
+        s.failure = Some(e.clone());
+    }
+    result
+}
