+fn context(pipe: &Pipeline) -> ExperimentContext {
+    let (profile_sha256, params_sha256) = pipeline_identities(pipe).unwrap();
+    ExperimentContext {
+        build_sha256: digest(b"SYNTHETIC HOST TEST BUILD; NO EXECUTION PROOF"),
+        fixture_sha256: digest(b"SYNTHETIC HOST PROMOTED LOG"),
+        profile_sha256,
+        params_sha256,
+        prefix_records_sha256: digest(b"SYNTHETIC NO REAL PREFIX"),
+        actual_metered_ev_bits: Some(0f32.to_bits()),
+        actual_ae_scale_promoted_bits: Some(1f64.to_bits()),
+        exposure_compensation_scale_promoted_bits: 1f64.to_bits(),
+        effective_exposure_factor_bits: 1f64.to_bits(),
+        log_correction_bits: 1f64.to_bits(),
+        resume: ExperimentResume::FreshFrame,
+    }
+}
+fn proof(width: u32, height: u32, pipe: &Pipeline, hashes: [String; 3]) -> DerivedLogEvidence {
+    dir_log_provenance::synthetic_evidence_for_test(width, height, context(pipe), hashes)
+}
+struct Fixture {
+    root: PathBuf,
+    paths: [PathBuf; 3],
+    bytes: [Vec<u8>; 3],
+    evidence: DerivedLogEvidence,
+    pipe: Pipeline,
+}
+impl Fixture {
+    fn new(w: u32, h: u32) -> Self {
+        let values = (0..w * h)
+            .map(|i| {
+                [
+                    (-1.25f32 + (i % 17) as f32 / 32.) as f64,
+                    (-0.75f32 + (i % 13) as f32 / 64.) as f64,
+                    (-0.25f32 + (i % 11) as f32 / 128.) as f64,
+                ]
+                .map(f64::to_bits)
+            })
+            .collect();
+        Self::with_words(w, h, values, pipeline())
+    }
+    fn with_words(w: u32, h: u32, values: Vec<[u64; 3]>, pipe: Pipeline) -> Self {
+        assert_eq!(values.len(), (w * h) as usize);
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+            "film-derived-mixed-host-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&root).unwrap();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+        let paths = ["copy-r.bin", "copy-g.bin", "copy-b.bin"].map(|x| root.join(x));
+        let bytes: [Vec<u8>; 3] =
+            std::array::from_fn(|c| values.iter().flat_map(|r| r[c].to_le_bytes()).collect());
+        for (p, b) in paths.iter().zip(&bytes) {
+            let mut f = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(p)
+                .unwrap();
+            f.write_all(b).unwrap();
+            f.sync_all().unwrap();
+        }
+        let evidence = proof(w, h, &pipe, bytes.each_ref().map(|b| digest(b)));
+        Self {
+            root,
+            paths,
+            bytes,
+            evidence,
+            pipe,
+        }
+    }
+    fn sources(&self) -> DerivedMixedSources {
+        DerivedMixedSources::capture(self.paths.clone(), self.evidence.clone(), &mut || false)
+            .unwrap()
+    }
+    fn plan(&self) -> DerivedMixedDirImagePlan {
+        let (w, h) = self.evidence.geometry();
+        DerivedMixedDirImagePlan::from_pipeline(
+            &self.pipe,
+            10.,
+            w,
+            h,
+            self.sources(),
+            self.root.join("candidate"),
+            2,
+            w.max(h),
+            w.max(h),
+        )
+        .unwrap()
+    }
+    fn intact(&self) {
+        for (p, b) in self.paths.iter().zip(&self.bytes) {
+            assert_eq!(fs::read(p).unwrap(), *b);
+        }
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
+struct Host {
+    calls: u64,
+    poisoned: bool,
+    fail_at: Option<u64>,
+}
+impl Host {
+    fn new() -> Self {
+        Self {
+            calls: 0,
+            poisoned: false,
+            fail_at: None,
+        }
+    }
+    fn called(&mut self) -> R<()> {
+        self.calls += 1;
+        if self.fail_at == Some(self.calls) {
+            Err("DERIVED_MIXED_HOST_FAILURE".into())
+        } else {
+            Ok(())
+        }
+    }
+}
+impl Compute for Host {
+    fn check_status(&self) -> R<()> {
+        if self.poisoned {
+            Err("DERIVED_MIXED_HOST_POISON".into())
+        } else {
+            Ok(())
+        }
+    }
+    fn point(
+        &mut self,
+        p: &DirMixedCalibration,
+        j: dir_point::Job,
+        v: &[[u64; 3]],
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        self.called()?;
+        dir_point::evaluate_mixed(p, j, v, c)
+    }
+    fn spatial(&mut self, p: &SpatialLine, v: &[u64], c: &mut impl FnMut() -> bool) -> R<Vec<u64>> {
+        check(c)?;
+        self.called()?;
+        match p {
+            SpatialLine::Identity { copy, .. } | SpatialLine::Fir(copy) => {
+                super::super::fir::cpu_reference(copy, v)
+            }
+            SpatialLine::Iir(line) => {
+                let p = super::super::Plan::new(
+                    f32::from_bits(line.sigma_bits),
+                    line.length,
+                    line.lines,
+                )?;
+                super::super::cpu_reference(&p, v)
+            }
+        }
+    }
+    fn poison(&mut self) {
+        self.poisoned = true;
+    }
+}
