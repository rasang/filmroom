+// Closed R23 counterfactual: CPU reference bytes are deliberately reinstalled
+// after each adopted operator. This is NOT a normal full-GPU frame or provenance.
+const R23_R22_INDEX: &str = "3b5029911bb7aa262141b74f1115e8bb05d2be7d938ee75d9f0f56ffba4feada";
+const R23_CAPTURE: &str =
+    "executions/actual_vulkan_original384_prefix_boundary_capture-c7166f1a-retry1/causal-prefix";
+fn r23_index(root: &Path) -> Value {
+    use sha2::{Digest, Sha256};
+    let b = fs::read(root.join("R22_VALIDATION_INDEX.json")).unwrap();
+    assert_eq!(format!("{:x}", Sha256::digest(&b)), R23_R22_INDEX);
+    let v: Value = serde_json::from_slice(&b).unwrap();
+    assert_eq!(
+        v["binarySha256"],
+        "fdfb93e4f744ce3440196f1dd6d878399d30b0e0471fa63947e7a13db45df459"
+    );
+    assert_eq!(
+        v["sourcePatchSha256"],
+        "6bdb01e94dd91851868bad50dd4f1f6af91c8e5d25e1d244eb05c282ef07fbd0"
+    );
+    v
+}
+fn r23_bytes(root: &Path, rel: &str) -> Vec<u8> {
+    use sha2::{Digest, Sha256};
+    assert!(!rel.starts_with('/') && !rel.contains(".."));
+    let i = r23_index(root);
+    let e = &i["files"][rel];
+    assert!(e.is_object());
+    let b = fs::read(root.join(rel)).unwrap();
+    assert_eq!(e["bytes"].as_u64().unwrap(), b.len() as u64);
+    assert_eq!(
+        e["sha256"].as_str().unwrap(),
+        format!("{:x}", Sha256::digest(&b))
+    );
+    b
+}
+struct R23Delegate {
+    inner: NativeDelegate,
+    expected: [[String; 3]; 6],
+    original_input_sha: String,
+    ae_bits: u64,
+    exposure_bits: u64,
+    observations: Arc<Mutex<Vec<Value>>>,
+}
+impl GpuDiffusionDelegate for R23Delegate {
+    fn available_disk_bytes(&mut self) -> Option<u64> {
+        self.inner.available_disk_bytes()
+    }
+    fn begin(&mut self, wire: &str) -> Option<bool> {
+        use sha2::{Digest, Sha256};
+        let w: Value = serde_json::from_str(wire).unwrap();
+        let operation = w["operation"].as_str().unwrap_or_else(|| {
+            assert!(w.get("operation").is_none(), "invalid explicit operation");
+            "fullCameraDiffusion"
+        });
+        let dir = Path::new(w["jobDir"].as_str().unwrap());
+        let manifest_bytes = fs::read(dir.join("manifest.json")).unwrap();
+        assert_eq!(
+            format!("{:x}", Sha256::digest(&manifest_bytes)),
+            w["manifestSha256"].as_str().unwrap()
+        );
+        let manifest: Value = serde_json::from_slice(&manifest_bytes).unwrap();
+        assert_eq!(
+            manifest["operation"], operation,
+            "wire/default must match real manifest"
+        );
+        let mut input_hashes = Vec::new();
+        let mut paths = Vec::new();
+        let boundary = match operation {
+            "fullAutoExposure" => {
+                paths.push((
+                    dir.join("source.meter.f32le"),
+                    manifest["meterSourceSha256"].as_str().unwrap().to_string(),
+                ));
+                None
+            }
+            "fullFilmExposure" => {
+                assert_eq!(
+                    manifest["autoExposureBits"],
+                    format!("{:016x}", self.ae_bits)
+                );
+                assert_eq!(
+                    manifest["exposureBits"],
+                    format!("{:016x}", self.exposure_bits)
+                );
+                paths.push((
+                    dir.join("source.rgb.f32le"),
+                    self.original_input_sha.clone(),
+                ));
+                None
+            }
+            "fullHighlightBoost" => Some(0),
+            "fullCameraDiffusion" => Some(1),
+            "fullFilmOptics" => Some(2),
+            "fullExposureLog" => Some(3),
+            "fullFilmDirDensity" => Some(4),
+            other => panic!("unexpected same-input operation {other}"),
+        };
+        if let Some(i) = boundary {
+            for c in 0..3 {
+                paths.push((
+                    dir.join(format!("source-{c}.f64le")),
+                    self.expected[i][c].clone(),
+                ));
+            }
+        }
+        for (path, expected) in &paths {
+            let bytes = fs::read(path).unwrap();
+            if operation == "fullAutoExposure" {
+                assert_eq!(
+                    bytes.len() as u64,
+                    manifest["global"]["sampleWidth"].as_u64().unwrap()
+                        * manifest["global"]["sampleHeight"].as_u64().unwrap()
+                        * 28
+                );
+            } else {
+                assert_eq!(
+                    bytes.len(),
+                    if operation == "fullFilmExposure" {
+                        384 * 512 * 12
+                    } else {
+                        384 * 512 * 8
+                    }
+                );
+            }
+            let hash = format!("{:x}", Sha256::digest(&bytes));
+            assert_eq!(
+                &hash,
+                expected,
+                "actual packet input mismatch {operation}: {}",
+                path.display()
+            );
+            input_hashes.push(json!({"file":path.file_name().unwrap().to_str().unwrap(),"bytes":bytes.len(),"sha256":hash}));
+        }
+        let before = self.inner.audit.lock().unwrap().records.len();
+        let result = self.inner.begin(wire);
+        assert_eq!(result, Some(true));
+        let ticket = self.inner.ticket.unwrap();
+        assert_eq!(Some(ticket.token), w["token"].as_u64());
+        let records = self.inner.audit.lock().unwrap();
+        assert_eq!(records.records.len(), before + 1);
+        let stage = records.records.last().unwrap();
+        assert_eq!(stage["operation"], operation);
+        assert_eq!(stage["epoch"].as_u64(), Some(ticket.epoch));
+        assert_eq!(stage["generation"].as_u64(), Some(ticket.generation));
+        assert_eq!(stage["sequence"].as_u64(), Some(ticket.sequence));
+        assert_eq!(stage["stageSealed"], true);
+        assert_eq!(stage["token"].as_u64(), Some(ticket.token));
+        assert_eq!(stage["summary"]["manifestSha256"], w["manifestSha256"]);
+        assert_eq!(
+            format!(
+                "{:x}",
+                Sha256::digest(fs::read(dir.join("manifest.json")).unwrap())
+            ),
+            w["manifestSha256"].as_str().unwrap()
+        );
+        assert_eq!(stage["summary"]["gpuUsed"], true);
+        assert!(stage["summary"]["dispatches"].as_u64().unwrap() > 0);
+        for (path, expected) in &paths {
+            assert_eq!(
+                format!("{:x}", Sha256::digest(fs::read(path).unwrap())),
+                *expected,
+                "packet mutated during GPU stage"
+            );
+        }
+        self.observations.lock().unwrap().push(json!({"operation":operation,"epoch":ticket.epoch,"generation":ticket.generation,"sequence":ticket.sequence,"token":ticket.token,"manifestSha256":w["manifestSha256"],"manifest":manifest,"inputs":input_hashes,"stageSealed":true,"sourceReferenceBoundaryIndex":boundary}));
+        result
+    }
+    fn poll(&mut self, t: u64) -> Option<String> {
+        self.inner.poll(t)
+    }
+    fn cancel(&mut self, t: u64) {
+        self.inner.cancel(t)
+    }
+    fn session_ticket(&self) -> Option<GpuSessionTicket> {
+        self.inner.session_ticket()
+    }
+}
+fn r23_requests(
+    f: &Fixture,
+    audit: &Arc<Mutex<Audit>>,
+    expected: &[[String; 3]; 6],
+    original_input_sha: &str,
+    ae_bits: u64,
+    exposure_bits: u64,
+    observations: &Arc<Mutex<Vec<Value>>>,
+) -> GpuStageRequests {
+    let request = |token| GpuDiffusionRequest {
+        parent_handle: 1,
+        token,
+        stage_dir: Some(f.root.join(format!("gpu-stage-{token}"))),
+        delegate: Some(Box::new(R23Delegate {
+            inner: NativeDelegate {
+                audit: audit.clone(),
+                ticket: None,
+                poll: None,
+            },
+            expected: expected.clone(),
+            original_input_sha: original_input_sha.into(),
+            ae_bits,
+            exposure_bits,
+            observations: observations.clone(),
+        })),
+    };
+    GpuStageRequests {
+        route: ScienceRoute::Preview,
+        diffusion: Some(request(1000)),
+        exposure: Some(request(1001)),
+        optical: Some(request(1002)),
+        dir: Some(request(1003)),
+        scanner: Some(request(1004)),
+        science: ScienceKind::ALL
+            .into_iter()
+            .enumerate()
+            .map(|(i, k)| (k, request(1010 + i as u64)))
+            .collect(),
+    }
+}
+
+#[test]
+#[ignore = "actual same-input counterfactual per-operator CPU/GPU comparison; no grain; one fresh process"]
+fn actual_vulkan_original384_same_input_operators() {
+    use crate::streamed::{grain_causal_probe as observer, same_input_operator_probe as probe};
+    use sha2::{Digest, Sha256};
+    let reference = PathBuf::from(
+        std::env::var_os("FILM_GPU_R22_REFERENCE_ROOT").expect("explicit audited R22 required"),
+    );
+    assert_eq!(reference.canonicalize().unwrap(), reference);
+    let _ = r23_index(&reference);
+    let report: Value = serde_json::from_slice(&r23_bytes(
+        &reference,
+        &format!("{R23_CAPTURE}/prefix-boundaries.json"),
+    ))
+    .unwrap();
+    let (_, original, params) = causal_report();
+    let old_params: RuntimeParams =
+        serde_json::from_value(report["sourceParameters"].clone()).unwrap();
+    assert_eq!(
+        serde_json::to_value(&params).unwrap(),
+        serde_json::to_value(old_params).unwrap()
+    );
+    let cpu = &report["runs"][0];
+    assert_eq!(cpu["label"], "cpu-prefix");
+    let ae_bits = u64::from_str_radix(
+        cpu["boundaries"]["actualExposure"]["aeScaleF64Bits"]
+            .as_str()
+            .unwrap(),
+        16,
+    )
+    .unwrap();
+    let exp_bits = u64::from_str_radix(
+        cpu["boundaries"]["actualExposure"]["exposureScaleF64Bits"]
+            .as_str()
+            .unwrap(),
+        16,
+    )
+    .unwrap();
+    assert_eq!(ae_bits, 0x3fd3863780000000);
+    assert_eq!(exp_bits, 1f64.to_bits());
+    let names = [
+        "afterFilmExposure",
+        "afterHighlight",
+        "afterCameraDiffusion",
+        "afterFilmOptics",
+        "afterExposureLog",
+        "afterDir",
+    ];
+    let references: [[PathBuf; 3]; 6] = std::array::from_fn(|i| {
+        std::array::from_fn(|c| {
+            reference.join(format!(
+                "{R23_CAPTURE}/cpu-prefix-boundaries/{}/channel-{c}.f64le",
+                names[i]
+            ))
+        })
+    });
+    let hashes: [[String; 3]; 6] = std::array::from_fn(|i| {
+        std::array::from_fn(|c| {
+            let rel = references[i][c]
+                .strip_prefix(&reference)
+                .unwrap()
+                .to_str()
+                .unwrap();
+            let bytes = r23_bytes(&reference, rel);
+            assert_eq!(bytes.len(), 384 * 512 * 8);
+            format!("{:x}", Sha256::digest(bytes))
+        })
+    });
+    let f = Fixture::sized(
+        384,
+        512,
+        42,
+        "kodak_portra_400",
+        "kodak_portra_endura",
+        true,
+    );
+    let input = fs::read(&f.input).unwrap();
+    // Pin the actual initial image to independently verified R21, not only seed.
+    let r21 = r22_reference();
+    let final_ref: Value = serde_json::from_slice(&r22_reference_bytes(
+        &r21,
+        "causal-prefix/threeway-final.json",
+    ))
+    .unwrap();
+    assert_eq!(
+        format!("{:x}", Sha256::digest(&input)),
+        final_ref["originalInputSha256"].as_str().unwrap()
+    );
+    let out = causal_root();
+    r22_private(&out);
+    causal_json(&out.join("original-report.json"), &original);
+    let audit = Arc::new(Mutex::new(Audit {
+        generation: 1,
+        rng_mode: crate::research_grain::RngMode::SequentialMt19937,
+        sequence: 0,
+        records: Vec::new(),
+    }));
+    let (stop, _) = flags();
+    let mut runs = Vec::new();
+    let observations = Arc::new(Mutex::new(Vec::new()));
+    for (gpu, label) in [(false, "cpu-same-input"), (true, "gpu-same-input")] {
+        let output = f.root.join(label);
+        let evidence = out.join(label);
+        r22_private(&evidence);
+        let obs = out.join(format!("{label}-pregrain"));
+        r22_private(&obs);
+        let _scope = probe::configure(
+            output.clone(),
+            f.input.clone(),
+            f.root.join(format!("work-{label}")),
+            evidence.clone(),
+            references.clone(),
+            hashes.clone(),
+            f64::from_bits(ae_bits),
+            f64::from_bits(exp_bits),
+            !gpu,
+        )
+        .unwrap();
+        let _stop = if gpu {
+            observer::configure_identity(output.clone(), obs.clone(), true, false)
+        } else {
+            observer::configure(output.clone(), obs.clone())
+        };
+        let req = if gpu {
+            session::activate(EPOCH, PREPAID, FIXED, 256).unwrap();
+            session::begin_frame(EPOCH, 1).unwrap();
+            r23_requests(
+                &f,
+                &audit,
+                &hashes,
+                &format!("{:x}", Sha256::digest(&input)),
+                ae_bits,
+                exp_bits,
+                &observations,
+            )
+        } else {
+            GpuStageRequests {
+                route: ScienceRoute::Preview,
+                ..GpuStageRequests::default()
+            }
+        };
+        let error = f
+            .run_requests(label, params.clone(), None, req, stop.clone())
+            .unwrap_err();
+        assert_eq!(error.code, "TEST_GRAIN_CAPTURE_STOP");
+        assert!(!output.exists());
+        let observed = probe::report(&output).unwrap();
+        let stages = audit.lock().unwrap().records.clone();
+        let stats = if gpu {
+            assert_eq!(
+                stages
+                    .iter()
+                    .map(|v| v["operation"].as_str().unwrap())
+                    .collect::<Vec<_>>(),
+                vec![
+                    "fullAutoExposure",
+                    "fullFilmExposure",
+                    "fullHighlightBoost",
+                    "fullCameraDiffusion",
+                    "fullFilmOptics",
+                    "fullExposureLog",
+                    "fullFilmDirDensity"
+                ]
+            );
+            for v in &stages {
+                assert_eq!(v["stageSealed"], true);
+                assert_eq!(v["summary"]["gpuUsed"], true);
+                assert!(v["summary"]["dispatches"].as_u64().unwrap() > 0);
+            }
+            Some(session::finish_frame(EPOCH, 1).unwrap())
+        } else {
+            assert!(stages.is_empty());
+            None
+        };
+        runs.push(json!({"label":label,"operators":observed,"stages":stages,"session":stats}));
+    }
+    assert_eq!(observations.lock().unwrap().len(), 7);
+    session::request_stop(EPOCH).unwrap();
+    assert_eq!(fs::read(&f.input).unwrap(), input);
+    // Check retained references again after every experimental write.
+    for i in 0..6 {
+        for c in 0..3 {
+            let b = r23_bytes(
+                &reference,
+                references[i][c]
+                    .strip_prefix(&reference)
+                    .unwrap()
+                    .to_str()
+                    .unwrap(),
+            );
+            assert_eq!(format!("{:x}", Sha256::digest(b)), hashes[i][c]);
+        }
+    }
+    causal_json(
+        &out.join("same-input-operators.json"),
+        &json!({"testOnly":true,"counterfactual":true,"grainExecuted":false,"referenceIndexSha256":R23_R22_INDEX,"parameters":params,"runs":runs,"actualPacketInputsAndSeals":observations.lock().unwrap().clone(),"interpretation":"Each GPU operator receives original CPU reference input; AE scale forced to CPU observed bits. Local operator differences, not unmodified full-frame quality or a production fix."}),
+    );
+}
