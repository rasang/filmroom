+    let mut values = image_values(17, 31, 2);
+    values[30 * 17..].fill((BOUND / 2.).to_bits());
+    let f = Fixture::new(17, 31, 0x41a757a2, 31, values);
+    let result = gpu.run_files(&f.plan, &mut || false);
+    assert_eq!(result.unwrap_err(), "GPU_IIR64_IMAGE_NUMERIC_DOMAIN");
+    assert_eq!(
+        gpu.metrics.dispatches, 31,
+        "must actually reach the final row, not a sampled-only check"
+    );
