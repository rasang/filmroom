+            .unwrap_err();
+        assert_eq!(e.code, "TEST_GRAIN_CAPTURE_STOP");
+        assert!(!output.exists());
+        let report = probe::report(&output).unwrap();
+        let records = audit.lock().unwrap().records.clone();
+        let stats = if gpu {
+            assert_eq!(
+                records
+                    .iter()
+                    .map(|v| v["operation"].as_str().unwrap())
