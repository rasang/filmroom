+#[test]
+fn exact_three_positive_radius_zero_and_every_family_axis_are_distinct() {
+    for sigma in [
+        -10.,
+        -0.,
+        0.,
+        f32::from_bits(1),
+        0.1,
+        0.5,
+        f32::from_bits(3_f32.to_bits() - 1),
+        3.,
+        7.,
+        10_000.,
+    ] {
+        let filter = Gaussian::from_sigma(sigma, 384, 512).unwrap();
+        assert_eq!(filter.sigma_bits(), sigma.to_bits());
+        match &filter {
+            Gaussian::Identity { .. } => assert!(sigma <= 0.),
+            Gaussian::Fir {
+                radius,
+                coefficient_bits,
+                ..
+            } => {
+                assert!(sigma > 0. && sigma < 3.);
+                assert_eq!((*radius, coefficient_bits.clone()), original_fir(sigma));
+                if sigma < 0.15 {
+                    assert_eq!(*radius, 0);
+                    assert_eq!(coefficient_bits, &[1_f64.to_bits()]);
+                }
+            }
+            Gaussian::Iir {
+                coefficient_bits, ..
+            } => {
+                assert!(sigma >= 3.);
+                assert_eq!(*coefficient_bits, original_iir(sigma));
+            }
+        }
+        for (length, lines) in [
+            (384, 3),
+            (512, 2),
+            (1, 7),
+            (8192, 3),
+            (6144, 3),
+            (40_000, 1),
+        ] {
+            let line = filter.line(length, lines).unwrap();
+            assert_eq!(
+                line.sample_count().unwrap(),
+                length as usize * lines as usize
+            );
+            match &line {
+                SpatialLine::Identity { copy, .. } | SpatialLine::Fir(copy) => {
+                    assert_eq!((copy.length, copy.lines), (length, lines))
+                }
+                SpatialLine::Iir(copy) => assert_eq!((copy.length, copy.lines), (length, lines)),
+            }
+            let source = vec![(-0_f64).to_bits(); line.sample_count().unwrap()];
+            line.validate_input(&source).unwrap();
+            assert!(line.validate_input(&source[..source.len() - 1]).is_err());
+        }
+    }
+    assert!(matches!(
+        Gaussian::from_sigma(3., 384, 512).unwrap(),
+        Gaussian::Iir { .. }
+    ));
+    for sigma in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY, 10_001.] {
+        assert!(Gaussian::from_sigma(sigma, 384, 512).is_err());
+    }
