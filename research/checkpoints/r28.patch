+//! Adapter evidence only. Independent original calibration preparation and full
+//! original develop oracles live in mixed calibration/graph tests respectively.
+use super::super::dir_mixed_calibration::Gaussian;
+use super::*;
+
+fn operations() -> [Operation; 6] {
+    [
+        Operation::InitialCurve,
+        Operation::BeforeCurve,
+        Operation::InitialCorrection,
+        Operation::TailAccumulate,
+        Operation::RedevelopFiltered,
+        Operation::RedevelopUnfiltered,
+    ]
+}
+#[test]
+fn mixed_point_view_matches_legacy_exact_packets_on_common_iir_domain() {
+    for stock in ["kodak_portra_400", "fujifilm_provia_100f"] {
+        let mut pipe = tests::pipeline_named(stock);
+        for gamma in [1., f32::from_bits(1f32.to_bits() + 1), 0.8] {
+            pipe.params.film_render.density_curve_gamma = gamma;
+            let old = DirCalibration::from_pipeline(&pipe, 36000. / 8192., 17, 13).unwrap();
+            let new = DirMixedCalibration::from_pipeline(&pipe, 36000. / 8192., 17, 13).unwrap();
+            assert_eq!(old.initial, new.initial);
+            assert_eq!(old.before_dir, new.before_dir);
+            let input = [
+                [(-1f64).to_bits(), 0, 1f64.to_bits()],
+                [(-2f64).to_bits(), 1f64.to_bits(), 0],
+            ];
+            for operation in operations() {
+                for channel in 0..3 {
+                    let components = if operation == Operation::TailAccumulate {
+                        3
+                    } else {
+                        1
+                    };
+                    for component in 0..components {
+                        let job = Job {
+                            operation,
+                            channel,
+                            component,
+                        };
+                        assert_eq!(job.validate(&old).is_ok(), job.validate_mixed(&new).is_ok());
+                        if job.validate(&old).is_err() {
+                            continue;
+                        }
+                        let a = Packet::new(&old, job, &input).unwrap();
+                        let b = Packet::new_mixed(&new, job, &input).unwrap();
+                        assert_eq!(a.words, b.words);
+                        assert_eq!(a.parameters, b.parameters);
+                        assert_eq!(a.count, b.count);
+                        assert_eq!(a.invocations(), b.invocations());
+                        assert_eq!(
+                            evaluate(&old, job, &input, &mut || false),
+                            evaluate_mixed(&new, job, &input, &mut || false)
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
