+#[test]
+fn strict_gaussian_wire_rejects_missing_duplicate_unknown_and_wrong_family_fields() {
+    for sigma in [-0., 0.5, 3.] {
+        let filter = Gaussian::from_sigma(sigma, 23, 17).unwrap();
+        let text = serde_json::to_string(&filter).unwrap();
+        assert_eq!(serde_json::from_str::<Gaussian>(&text).unwrap(), filter);
+        let value = serde_json::to_value(&filter).unwrap();
+        for field in value.as_object().unwrap().keys() {
+            let mut missing = value.clone();
+            missing.as_object_mut().unwrap().remove(field);
+            assert!(
+                serde_json::from_value::<Gaussian>(missing).is_err(),
+                "{field}"
+            );
+            let duplicate = text.replacen("{", &format!("{{\"{field}\":{},", value[field]), 1);
+            assert!(
+                serde_json::from_str::<Gaussian>(&duplicate).is_err(),
+                "duplicate {field}"
+            );
+        }
+        let mut unknown = value.clone();
+        unknown["unexpected"] = json!(0);
+        assert!(serde_json::from_value::<Gaussian>(unknown).is_err());
+        for family in ["identity", "fir", "iir", "FIR", "unknown"] {
+            if value["family"] == json!(family) {
+                continue;
+            }
+            let mut changed = value.clone();
+            changed["family"] = json!(family);
+            assert!(serde_json::from_value::<Gaussian>(changed).is_err());
+        }
+        for invalid in [f32::NAN, f32::INFINITY] {
+            let mut changed = value.clone();
+            changed["sigmaBits"] = json!(invalid.to_bits());
+            assert!(serde_json::from_value::<Gaussian>(changed).is_err());
+        }
+        if !filter.is_identity() {
+            for bad in [
+                json!(0),
+                json!("3FF0000000000000"),
+                json!("3ff000000000000"),
+                json!("03ff0000000000000"),
+                json!("0x3ff00000000000"),
+                json!("3ff000000000000g"),
+            ] {
+                let mut changed = value.clone();
+                changed["coefficientBits"][0] = bad;
+                assert!(serde_json::from_value::<Gaussian>(changed).is_err());
+            }
+            let mut changed = value.clone();
+            changed["coefficientBits"].as_array_mut().unwrap().pop();
+            assert!(serde_json::from_value::<Gaussian>(changed).is_err());
+            let mut changed = value;
+            let bits =
+                u64::from_str_radix(changed["coefficientBits"][0].as_str().unwrap(), 16).unwrap();
+            changed["coefficientBits"][0] = hex(bits ^ 1);
+            assert!(serde_json::from_value::<Gaussian>(changed).is_err());
+        }
+    }
