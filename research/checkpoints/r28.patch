+fn confirmed_default_f32_rejections_are_diagnosed_without_relabeling_support() {
+    for sigma_bits in [0x41a757a2, 0x428aae74, 0x42fbfc66] {
+        let filter = crate::research_spatial::Filter::new(f32::from_bits(sigma_bits)).unwrap();
+        let mut rejected = false;
+        for length in [8192, 6144] {
+            for kind in [0, 1] {
+                let values = inputs(length, 1, kind);
+                let input: Vec<f64> = values.iter().map(|x| f64::from_bits(*x)).collect();
+                let original = filter.line_f64(&input);
+                let f32_result =
+                    filter.line_f32(&input.iter().map(|x| *x as f32).collect::<Vec<_>>());
+                let verdict = crate::research_spatial::compare_lines(&original, &f32_result);
+                rejected |= verdict.is_err();
+                let (at, absolute, normalized) = original
+                    .iter()
+                    .zip(&f32_result)
+                    .enumerate()
+                    .map(|(i, (r, a))| {
+                        (
+                            i,
+                            (*r - f64::from(*a)).abs(),
+                            (*r - f64::from(*a)).abs() / r.abs().max(1.),
+                        )
+                    })
+                    .max_by(|a, b| a.2.total_cmp(&b.2))
+                    .unwrap();
+                eprintln!(
+                    "old f32 diagnosis sigma_bits=0x{sigma_bits:08x} length={length} kind={kind} worst_index={at} max_abs_at_normalized_worst={absolute} max_normalized={normalized} verdict={verdict:?}"
+                );
+            }
+        }
+        assert!(
+            rejected,
+            "historical default f32 rejection disappeared; investigate source drift"
+        );
+    }
