+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct PlaneReceipt {
+    pub channel: u32,
+    pub role: String,
+    pub sha256: String,
+}
+macro_rules! checked_receipt {
+    ($($field:ident: $ty:ty),* $(,)?) => {
+        #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        pub(super) struct CandidateReceiptV2 { $(pub $field: $ty,)* }
+        // Readout only, with no Deserialize or conversion to an original receipt.
+        #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        pub(super) struct DerivedMixedCandidateParts { $(pub $field: $ty,)* }
+        impl CandidateReceiptV2 {
+            fn into_derived_parts(self) -> DerivedMixedCandidateParts {
+                DerivedMixedCandidateParts { $($field: self.$field,)* }
+            }
+        }
+        #[derive(Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct CandidateReceiptWire { $($field: $ty,)* }
+        impl<'de> Deserialize<'de> for CandidateReceiptV2 {
+            fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+                let wire = CandidateReceiptWire::deserialize(d)?;
+                let result = Self { $($field: wire.$field,)* };
+                result.validate().map_err(serde::de::Error::custom)?;
+                Ok(result)
+            }
+        }
+    };
+}
+checked_receipt! {
+    version: u32,
+    status: String,
+    operation: String,
+    layout: String,
+    plan_sha256: String,
+    width: u32,
+    height: u32,
+    encoding: String,
+    source_sha256_before: [String; 3],
+    source_sha256_after: [String; 3],
+    candidate_sha256: [String; 3],
+    plane_byte_length: u64,
+    candidate64: [PathBuf; 3],
+    candidate_marker: PathBuf,
+    point_batches: u64,
+    row_batches: u64,
+    column_batches: u64,
+    identity_row_batches: u64,
+    identity_column_batches: u64,
+    fir_row_batches: u64,
+    fir_column_batches: u64,
+    iir_row_batches: u64,
+    iir_column_batches: u64,
+    temporary_plane_highwater: u32,
+    temporary_byte_highwater: u64,
+    temporary_planes_remaining: u32,
+    intermediate_hashes: Vec<PlaneReceipt>,
+    requires_outer_seal_or_confirmed_helper_death: bool,
+}
+impl CandidateReceiptV2 {
+    fn validate(&self) -> R<()> {
+        self.validate_for(InputPolicy::Original)
+    }
+    fn validate_for(&self, policy: InputPolicy) -> R<()> {
+        if self.version != VERSION
+            || self.status != policy.status()
+            || self.operation != policy.operation()
+            || self.layout != policy.layout()
+            || !valid_digest(&self.plan_sha256)
+            || self.width == 0
+            || self.height == 0
+            || self.encoding != "threePlanarBinary64LittleEndian"
+            || self.plane_byte_length != mul(mul(self.width as u64, self.height as u64)?, 8)?
+            || self.source_sha256_before != self.source_sha256_after
+            || self
+                .source_sha256_before
+                .iter()
+                .chain(&self.candidate_sha256)
+                .any(|s| !valid_digest(s))
+            || self.identity_column_batches != 0
+            || self.row_batches
+                != add(
+                    add(self.identity_row_batches, self.fir_row_batches)?,
+                    self.iir_row_batches,
+                )?
+            || self.column_batches != add(self.fir_column_batches, self.iir_column_batches)?
+            || self.temporary_plane_highwater > 5
+            || self.temporary_planes_remaining != 0
+            || self.temporary_byte_highwater
+                != mul(
+                    self.temporary_plane_highwater as u64,
+                    self.plane_byte_length,
+                )?
+            || !self.requires_outer_seal_or_confirmed_helper_death
+            || self
+                .intermediate_hashes
+                .iter()
+                .any(|p| p.channel >= 3 || p.role.is_empty() || !valid_digest(&p.sha256))
+        {
+            return Err(ERROR.into());
+        }
+        for path in self.candidate64.iter().chain([&self.candidate_marker]) {
+            plain_absolute(path)?;
+        }
+        let parent = self.candidate_marker.parent().ok_or(ERROR)?;
+        let expected = Paths::new(parent.to_owned());
+        if self.candidate64 != expected.candidate64
+            || self.candidate_marker != expected.candidate_marker
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+    /// This checks the receipt's acceptance identity, not a filesystem-atomic
+    /// publication or outer stage seal. Disk ownership is checked by the runner.
+    pub(super) fn validate_for_plan(&self, p: &DirMixedImagePlan) -> R<()> {
+        self.validate_for_plan_policy(p, InputPolicy::Original)
+    }
+    fn validate_for_plan_policy(&self, p: &DirMixedImagePlan, policy: InputPolicy) -> R<()> {
+        self.validate_for(policy)?;
+        p.validate_for(policy)?;
+        let mut expected = Counts::default();
+        let point_passes = if !p.0.calibration.dir_active {
+            1
+        } else if p.0.filters.is_none() {
+            2
+        } else {
+            5
+        };
+        expected.point = mul(
+            mul(3, point_passes)?,
+            p.0.samples.div_ceil(p.0.point_capacity as u64),
+        )?;
+        if let Some(filters) = &p.0.filters {
+            for filter in filters {
+                let rows = mul(3, filter.rows.batch_count as u64)?;
+                let columns = mul(
+                    3,
+                    filter.columns.as_ref().map_or(0, |g| g.batch_count) as u64,
+                )?;
+                expected.rows = add(expected.rows, rows)?;
+                expected.columns = add(expected.columns, columns)?;
+                match filter.family {
+                    Family::Identity => {
+                        expected.identity_rows = add(expected.identity_rows, rows)?;
+                    }
+                    Family::Fir => {
+                        expected.fir_rows = add(expected.fir_rows, rows)?;
+                        expected.fir_columns = add(expected.fir_columns, columns)?;
+                    }
+                    Family::Iir => {
+                        expected.iir_rows = add(expected.iir_rows, rows)?;
+                        expected.iir_columns = add(expected.iir_columns, columns)?;
+                    }
+                }
+            }
+        }
+        if self.plan_sha256 != p.identity()?
+            || self.width != p.0.calibration.width
+            || self.height != p.0.calibration.height
+            || self.candidate64 != p.0.paths.candidate64
+            || self.candidate_marker != p.0.paths.candidate_marker
+            || self.source_sha256_before != p.0.sources.planes.each_ref().map(|s| s.sha256.clone())
+            || self.point_batches != expected.point
+            || self.row_batches != expected.rows
+            || self.column_batches != expected.columns
+            || self.identity_row_batches != expected.identity_rows
+            || self.fir_row_batches != expected.fir_rows
+            || self.fir_column_batches != expected.fir_columns
+            || self.iir_row_batches != expected.iir_rows
+            || self.iir_column_batches != expected.iir_columns
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+}
+#[derive(Default)]
+struct Counts {
+    point: u64,
+    rows: u64,
+    columns: u64,
+    identity_rows: u64,
+    identity_columns: u64,
+    fir_rows: u64,
+    fir_columns: u64,
+    iir_rows: u64,
+    iir_columns: u64,
+}
+struct Plane {
+    name: &'static str,
+    sha256: String,
+}
+struct Workspace {
+    secure: secure::Workspace,
+    plane_bytes: u64,
+    live: Vec<&'static str>,
+    highwater: u32,
+    byte_highwater: u64,
+    audit: Vec<PlaneReceipt>,
+    creates: u32,
+    fault: Option<Fault>,
+}
+impl Workspace {
+    fn new(p: &DirMixedImagePlan, fault: Option<Fault>) -> R<Self> {
+        Ok(Self {
+            secure: secure::Workspace::create(
+                &p.0.paths.private_directory,
+                p.0.resources.required_available_disk_bytes,
+            )?,
+            plane_bytes: p.0.plane_byte_length,
+            live: Vec::new(),
+            highwater: 0,
+            byte_highwater: 0,
+            audit: Vec::new(),
+            creates: 0,
+            fault,
+        })
+    }
+    fn after_create(&mut self, file: File) -> R<File> {
+        self.creates = self.creates.checked_add(1).ok_or(ERROR)?;
+        if self.fault == Some(Fault::AfterCreate(self.creates)) {
+            return Err("GPU_DIR_MIXED64_FILES_INJECTED_AFTER_CREATE".into());
+        }
+        Ok(file)
+    }
+    fn create_output(&mut self, name: &str) -> R<File> {
+        let file = self.secure.create_file(name)?;
+        io(file.set_len(self.plane_bytes))?;
+        self.after_create(file)
+    }
+    fn temp(&mut self, name: &'static str) -> R<File> {
+        let count = self.live.len().checked_add(1).ok_or(ERROR)?;
+        let bytes = mul(count as u64, self.plane_bytes)?;
+        if count > 5 || bytes > mul(5, self.plane_bytes)? || self.live.contains(&name) {
+            return Err("GPU_DIR_MIXED64_FILES_TEMP_BUDGET".into());
+        }
+        let file = self.secure.create_file(name)?;
+        self.live.push(name);
+        self.highwater = self.highwater.max(count as u32);
+        self.byte_highwater = self.byte_highwater.max(bytes);
+        io(file.set_len(self.plane_bytes))?;
+        self.after_create(file)
+    }
+    fn finish(
+        &mut self,
+        name: &'static str,
+        mut file: File,
+        channel: u32,
+        role: String,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Plane> {
+        check(c)?;
+        io(file.sync_all())?;
+        let sha256 = hash_file(&mut file, self.plane_bytes, c)?;
+        drop(file);
+        self.secure.verify_owned(name)?;
+        self.audit.push(PlaneReceipt {
+            channel,
+            role,
+            sha256: sha256.clone(),
+        });
+        Ok(Plane { name, sha256 })
+    }
+    fn read(&self, plane: &Plane) -> R<File> {
+        self.secure.open_owned_read(plane.name)
+    }
+    fn checked_close(&self, plane: &Plane, mut file: File, c: &mut impl FnMut() -> bool) -> R<()> {
+        if hash_file(&mut file, self.plane_bytes, c)? != plane.sha256 {
+            return Err(IO_ERROR.into());
+        }
+        drop(file);
+        self.secure.verify_owned(plane.name)
+    }
+    fn release<G: Compute>(
+        &mut self,
+        plane: Plane,
+        gpu: &G,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<()> {
+        // The graph calls this only after closing every associated file handle.
+        // Compute successful return already certifies no submission/map pending.
+        gpu.check_status()?;
+        check(c)?;
+        let index = self
+            .live
+            .iter()
+            .position(|&n| n == plane.name)
+            .ok_or(PATH_ERROR)?;
+        self.secure.remove_owned(plane.name)?;
+        self.live.remove(index);
+        Ok(())
+    }
+}
+
+fn io<T>(result: std::io::Result<T>) -> R<T> {
+    result.map_err(|e| format!("{IO_ERROR}: {e}"))
+}
+fn mul(a: u64, b: u64) -> R<u64> {
+    a.checked_mul(b).ok_or_else(|| ERROR.into())
+}
+fn add(a: u64, b: u64) -> R<u64> {
+    a.checked_add(b).ok_or_else(|| ERROR.into())
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err(CANCELLED.into()) } else { Ok(()) }
+}
+fn valid_digest(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn plain_absolute(path: &Path) -> R<()> {
+    let text = path.to_str().ok_or(PATH_ERROR)?;
+    if text.len() > 4096
+        || !path.is_absolute()
+        || text == "/"
+        || text.as_bytes().contains(&0)
+        || text[1..]
+            .split('/')
+            .any(|p| p.is_empty() || p == "." || p == "..")
+    {
+        return Err(PATH_ERROR.into());
+    }
+    Ok(())
+}
+fn exact_size(file: &File, expected: u64) -> R<()> {
+    let m = io(file.metadata())?;
+    if !m.is_file() || m.len() != expected {
+        return Err(IO_ERROR.into());
+    }
+    Ok(())
+}
+fn hash_file(file: &mut File, expected: u64, c: &mut impl FnMut() -> bool) -> R<String> {
+    check(c)?;
+    exact_size(file, expected)?;
+    io(file.seek(SeekFrom::Start(0)))?;
+    let mut hash = Sha256::new();
+    let mut bytes = vec![0; HASH_BUFFER_BYTES];
+    let mut left = expected;
+    while left != 0 {
+        check(c)?;
+        let n = left.min(bytes.len() as u64) as usize;
+        io(file.read_exact(&mut bytes[..n]))?;
+        check(c)?;
+        hash.update(&bytes[..n]);
+        left -= n as u64;
+    }
+    let mut extra = [0];
+    if io(file.read(&mut extra))? != 0 {
+        return Err(IO_ERROR.into());
+    }
+    exact_size(file, expected)?;
+    check(c)?;
+    Ok(format!("{:x}", hash.finalize()))
+}
+fn bounds(p: &DirMixedImagePlan, start: u64, count: usize, capacity: u32) -> R<u64> {
+    if count > capacity as usize || add(start, count as u64)? > p.0.samples {
+        return Err(IO_ERROR.into());
+    }
+    mul(start, 8)
+}
+// Byte buffer is fixed 64 KiB, never a second full image or line allocation.
+fn read_lane(
+    file: &mut File,
+    p: &DirMixedImagePlan,
+    start: u64,
+    rows: &mut [[u64; 3]],
+    lane: usize,
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    let offset = bounds(p, start, rows.len(), p.0.point_capacity)?;
+    check(c)?;
+    io(file.seek(SeekFrom::Start(offset)))?;
+    let mut bytes = vec![0; HASH_BUFFER_BYTES];
+    for chunk in rows.chunks_mut(HASH_BUFFER_BYTES / 8) {
+        check(c)?;
+        io(file.read_exact(&mut bytes[..chunk.len() * 8]))?;
+        for (row, b) in chunk.iter_mut().zip(bytes.chunks_exact(8)) {
+            row[lane] = u64::from_le_bytes(b.try_into().unwrap());
+        }
+    }
+    check(c)
+}
+fn write_words(
+    file: &mut File,
+    p: &DirMixedImagePlan,
+    start: u64,
+    words: &[u64],
+    capacity: u32,
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    let offset = bounds(p, start, words.len(), capacity)?;
+    check(c)?;
+    io(file.seek(SeekFrom::Start(offset)))?;
+    let mut bytes = vec![0; HASH_BUFFER_BYTES];
+    for chunk in words.chunks(HASH_BUFFER_BYTES / 8) {
+        check(c)?;
+        for (word, b) in chunk.iter().zip(bytes.chunks_exact_mut(8)) {
+            b.copy_from_slice(&word.to_le_bytes());
+        }
+        io(file.write_all(&bytes[..chunk.len() * 8]))?;
+    }
+    check(c)
+}
+fn point<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    job: Job,
+    mut inputs: [Option<&mut File>; 3],
+    output: &mut File,
+    counts: &mut Counts,
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    job.validate_mixed(&p.0.calibration)?;
+    let mut start = 0;
+    while start < p.0.samples {
+        check(c)?;
+        gpu.check_status()?;
+        let n = (p.0.samples - start).min(p.0.point_capacity as u64) as usize;
+        let mut rows = vec![[0u64; 3]; n];
+        for (lane, file) in inputs.iter_mut().enumerate() {
+            if let Some(file) = file {
+                read_lane(file, p, start, &mut rows, lane, c)?;
+            }
+        }
+        if rows.iter().flatten().any(|&w| !admitted(w)) {
+            return Err(dir_point::DOMAIN_ERROR.into());
+        }
+        let result = gpu.point(&p.0.calibration, job, &rows, c)?;
+        gpu.check_status()?;
+        check(c)?;
+        if result.len() != n || result.iter().any(|&w| !admitted(w)) {
+            return Err(dir_point::DOMAIN_ERROR.into());
+        }
+        write_words(output, p, start, &result, p.0.point_capacity, c)?;
+        counts.point = add(counts.point, 1)?;
+        start = add(start, n as u64)?;
+    }
+    Ok(())
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Axis {
+    Rows,
+    Columns,
+}
+fn gather(
+    file: &mut File,
+    p: &DirMixedImagePlan,
+    axis: Axis,
+    first: u32,
+    length: u32,
+    count: u32,
+    capacity: u32,
+    c: &mut impl FnMut() -> bool,
+) -> R<Vec<u64>> {
+    let n = length.checked_mul(count).ok_or(ERROR)? as usize;
+    if n > capacity as usize {
+        return Err(ERROR.into());
+    }
+    let mut words = vec![0; n];
+    let mut bytes = vec![0; HASH_BUFFER_BYTES];
+    match axis {
+        Axis::Rows => {
+            let offset = bounds(p, mul(first as u64, length as u64)?, n, capacity)?;
+            io(file.seek(SeekFrom::Start(offset)))?;
+            for chunk in words.chunks_mut(HASH_BUFFER_BYTES / 8) {
+                check(c)?;
+                io(file.read_exact(&mut bytes[..chunk.len() * 8]))?;
+                for (word, b) in chunk.iter_mut().zip(bytes.chunks_exact(8)) {
+                    *word = u64::from_le_bytes(b.try_into().unwrap());
+                }
+            }
+        }
+        Axis::Columns => {
+            for y in 0..length {
+                let offset = bounds(
+                    p,
+                    add(mul(y as u64, p.0.calibration.width as u64)?, first as u64)?,
+                    count as usize,
+                    capacity,
+                )?;
+                io(file.seek(SeekFrom::Start(offset)))?;
+                let mut x = 0usize;
+                while x < count as usize {
+                    check(c)?;
+                    let take = (count as usize - x).min(HASH_BUFFER_BYTES / 8);
+                    io(file.read_exact(&mut bytes[..take * 8]))?;
+                    for (i, b) in bytes[..take * 8].chunks_exact(8).enumerate() {
+                        words[(x + i) * length as usize + y as usize] =
+                            u64::from_le_bytes(b.try_into().unwrap());
+                    }
+                    x += take;
+                }
+            }
+        }
+    }
+    check(c)?;
+    Ok(words)
+}
+fn scatter(
+    file: &mut File,
+    p: &DirMixedImagePlan,
+    axis: Axis,
+    first: u32,
+    length: u32,
+    count: u32,
+    words: &[u64],
+    capacity: u32,
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    if words.len() != length.checked_mul(count).ok_or(ERROR)? as usize {
+        return Err(IO_ERROR.into());
+    }
+    if axis == Axis::Rows {
+        return write_words(
+            file,
+            p,
+            mul(first as u64, length as u64)?,
+            words,
+            capacity,
+            c,
+        );
+    }
+    let mut bytes = vec![0; HASH_BUFFER_BYTES];
+    for y in 0..length {
+        let offset = bounds(
+            p,
+            add(mul(y as u64, p.0.calibration.width as u64)?, first as u64)?,
+            count as usize,
+            capacity,
+        )?;
+        io(file.seek(SeekFrom::Start(offset)))?;
+        let mut x = 0usize;
+        while x < count as usize {
+            check(c)?;
+            let take = (count as usize - x).min(HASH_BUFFER_BYTES / 8);
+            for (i, b) in bytes[..take * 8].chunks_exact_mut(8).enumerate() {
+                b.copy_from_slice(&words[(x + i) * length as usize + y as usize].to_le_bytes());
+            }
+            io(file.write_all(&bytes[..take * 8]))?;
+            x += take;
+        }
+    }
+    check(c)
+}
+fn axis<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    input: &mut File,
+    output: &mut File,
+    axis: Axis,
+    filter: usize,
+    counts: &mut Counts,
+    c: &mut impl FnMut() -> bool,
+) -> R<()> {
+    let filter =
+        p.0.filters
+            .as_ref()
+            .and_then(|filters| filters.get(filter))
+            .ok_or(ERROR)?;
+    let geometry = if axis == Axis::Rows {
+        &filter.rows
+    } else {
+        filter.columns.as_ref().ok_or(ERROR)?
+    };
+    let length = geometry.length;
+    let total = geometry.total_lines;
+    let per = geometry.lines_per_batch;
+    let capacity = filter.sample_capacity;
+    let mut first = 0;
+    while first < total {
+        check(c)?;
+        gpu.check_status()?;
+        let count = per.min(total - first);
+        let spec = filter.gaussian.line(length, count)?;
+        let words = gather(input, p, axis, first, length, count, capacity, c)?;
+        spec.validate_input(&words)?;
+        let output_words = gpu.spatial(&spec, &words, c)?;
+        gpu.check_status()?;
+        check(c)?;
+        spec.validate_input(&output_words)?;
+        // Identity is a raw copy, not an arithmetic approximation; verify every
+        // word, including negative zero, before publishing the component plane.
+        if filter.family == Family::Identity && output_words != words {
+            return Err("GPU_DIR_MIXED64_FILES_IDENTITY_COPY".into());
+        }
+        scatter(
+            output,
+            p,
+            axis,
+            first,
+            length,
+            count,
+            &output_words,
+            capacity,
+            c,
+        )?;
+        let (axis_total, family_total) = match (axis, filter.family) {
+            (Axis::Rows, Family::Identity) => (&mut counts.rows, &mut counts.identity_rows),
+            (Axis::Columns, Family::Identity) => return Err(ERROR.into()),
+            (Axis::Rows, Family::Fir) => (&mut counts.rows, &mut counts.fir_rows),
+            (Axis::Columns, Family::Fir) => (&mut counts.columns, &mut counts.fir_columns),
+            (Axis::Rows, Family::Iir) => (&mut counts.rows, &mut counts.iir_rows),
+            (Axis::Columns, Family::Iir) => (&mut counts.columns, &mut counts.iir_columns),
+        };
+        *axis_total = add(*axis_total, 1)?;
+        *family_total = add(*family_total, 1)?;
+        first = first.checked_add(count).ok_or(ERROR)?;
+    }
+    Ok(())
+}
+fn blur<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    w: &mut Workspace,
+    source: &Plane,
+    target: &'static str,
+    channel: u32,
+    filter: usize,
+    counts: &mut Counts,
+    c: &mut impl FnMut() -> bool,
+) -> R<Plane> {
+    let scheduled =
+        p.0.filters
+            .as_ref()
+            .and_then(|filters| filters.get(filter))
+            .ok_or(ERROR)?;
+    if scheduled.family == Family::Identity {
+        // One GPU raw-copy pass writes the component directly. The caller still
+        // performs each of the three original ordered FIT accumulations.
+        let mut input = w.read(source)?;
+        let mut output = w.temp(target)?;
+        axis(
+            p,
+            gpu,
+            &mut input,
+            &mut output,
+            Axis::Rows,
+            filter,
+            counts,
+            c,
+        )?;
+        w.checked_close(source, input, c)?;
+        let result = w.finish(
+            target,
+            output,
+            channel,
+            format!("filter{filter}.identity"),
+            c,
+        )?;
+        if result.sha256 != source.sha256 {
+            return Err("GPU_DIR_MIXED64_FILES_IDENTITY_HASH".into());
+        }
+        return Ok(result);
+    }
+    let mut input = w.read(source)?;
+    let mut horizontal = w.temp(H)?;
+    axis(
+        p,
+        gpu,
+        &mut input,
+        &mut horizontal,
+        Axis::Rows,
+        filter,
+        counts,
+        c,
+    )?;
+    w.checked_close(source, input, c)?;
+    let horizontal = w.finish(
+        H,
+        horizontal,
+        channel,
+        format!("filter{filter}.horizontal"),
+        c,
+    )?;
+    let mut input = w.read(&horizontal)?;
+    let mut output = w.temp(target)?;
+    axis(
+        p,
+        gpu,
+        &mut input,
+        &mut output,
+        Axis::Columns,
+        filter,
+        counts,
+        c,
+    )?;
+    w.checked_close(&horizontal, input, c)?;
+    let result = w.finish(
+        target,
+        output,
+        channel,
+        format!("filter{filter}.vertical"),
+        c,
+    )?;
+    w.release(horizontal, gpu, c)?;
+    Ok(result)
+}
+
+pub(super) fn run<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+) -> R<CandidateReceiptV2> {
+    run_with_fault(p, gpu, c, None)
+}
+/// Explicit fault-only entry for closed test gates. The normal runner never
+/// accepts a fault selector, and this entire module is cfg(test).
+pub(super) fn run_with_test_fault<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+    fault: Fault,
+) -> R<CandidateReceiptV2> {
+    run_with_fault(p, gpu, c, Some(fault))
+}
+fn run_with_fault<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+    fault: Option<Fault>,
+) -> R<CandidateReceiptV2> {
+    let result = run_inner(p, gpu, c, fault, InputPolicy::Original);
+    if result.is_err() {
+        gpu.poison();
+    }
+    result
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum Fault {
+    AfterCreate(u32),
+    OutputWrite,
+    BeforeMarker,
+    MarkerWrite,
+    MarkerHash,
+}
+fn run_inner<G: Compute>(
+    p: &DirMixedImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+    fault: Option<Fault>,
+    policy: InputPolicy,
+) -> R<CandidateReceiptV2> {
+    p.validate_for(policy)?;
+    check(c)?;
+    gpu.check_status()?;
+    let mut sources: Vec<secure::Source> = Vec::with_capacity(3);
+    let mut before = Vec::with_capacity(3);
+    for identity in &p.0.sources.planes {
+        let mut source = secure::Source::open(&identity.path)?;
+        identity.matches(&source)?;
+        let hash = hash_file(&mut source.file, identity.byte_length, c)?;
+        identity.matches(&source)?;
+        if hash != identity.sha256 {
+            return Err(SOURCE_CHANGED.into());
+        }
+        before.push(hash);
+        sources.push(source);
+    }
+    let mut sources: [secure::Source; 3] = sources.try_into().map_err(|_| ERROR)?;
+    let before: [String; 3] = before.try_into().map_err(|_| ERROR)?;
+    let mut workspace = Workspace::new(p, fault)?;
+    let result = (|| -> R<CandidateReceiptV2> {
+        // Reserve all three candidates before any arithmetic. Sparse lengths are
+        // logical reservations only; fstatvfs admission included physical safety.
+        for name in CANDIDATES {
+            let f = workspace.create_output(name)?;
+            drop(f);
+        }
+        let mut counts = Counts::default();
+        for channel in 0..3u32 {
+            check(c)?;
+            gpu.check_status()?;
+            // Reopen writing through the recorded inode, never a path-based create.
+            let mut candidate = workspace
+                .secure
+                .open_owned_write(CANDIDATES[channel as usize])?;
+            let job = Job {
+                operation: Operation::InitialCorrection,
+                channel,
+                component: 0,
+            };
+            if !p.0.calibration.dir_active {
+                let [s0, s1, s2] = &mut sources;
+                point(
+                    p,
+                    gpu,
+                    job,
+                    [Some(&mut s0.file), Some(&mut s1.file), Some(&mut s2.file)],
+                    &mut candidate,
+                    &mut counts,
+                    c,
+                )?;
+            } else {
+                let mut correction = workspace.temp(C)?;
+                let [s0, s1, s2] = &mut sources;
+                point(
+                    p,
+                    gpu,
+                    job,
+                    [Some(&mut s0.file), Some(&mut s1.file), Some(&mut s2.file)],
+                    &mut correction,
+                    &mut counts,
+                    c,
+                )?;
+                let correction =
+                    workspace.finish(C, correction, channel, "correction".into(), c)?;
+                if f32::from_bits(p.0.calibration.core_sigma_bits) > 0. {
+                    let core = blur(
+                        p,
+                        gpu,
+                        &mut workspace,
+                        &correction,
+                        G,
+                        channel,
+                        0,
+                        &mut counts,
+                        c,
+                    )?;
+                    // Newly extended exclusive files read as positive-zero words.
+                    let zero = workspace.temp(A[0])?;
+                    let mut accumulator =
+                        workspace.finish(A[0], zero, channel, "accumulator0".into(), c)?;
+                    for component in 0..3u32 {
+                        let tail = blur(
+                            p,
+                            gpu,
+                            &mut workspace,
+                            &correction,
+                            B,
+                            channel,
+                            component as usize + 1,
+                            &mut counts,
+                            c,
+                        )?;
+                        let next = A[(component as usize + 1) % 2];
+                        let mut next_file = workspace.temp(next)?;
+                        let mut old_file = workspace.read(&accumulator)?;
+                        let mut tail_file = workspace.read(&tail)?;
+                        point(
+                            p,
+                            gpu,
+                            Job {
+                                operation: Operation::TailAccumulate,
+                                channel,
+                                component,
+                            },
+                            [Some(&mut old_file), Some(&mut tail_file), None],
+                            &mut next_file,
+                            &mut counts,
+                            c,
+                        )?;
+                        workspace.checked_close(&accumulator, old_file, c)?;
+                        workspace.checked_close(&tail, tail_file, c)?;
+                        let new_accumulator = workspace.finish(
+                            next,
+                            next_file,
+                            channel,
+                            format!("accumulator{}", component + 1),
+                            c,
+                        )?;
+                        workspace.release(accumulator, gpu, c)?;
+                        workspace.release(tail, gpu, c)?;
+                        accumulator = new_accumulator;
+                    }
+                    let mut core_file = workspace.read(&core)?;
+                    let mut accumulator_file = workspace.read(&accumulator)?;
+                    point(
+                        p,
+                        gpu,
+                        Job {
+                            operation: Operation::RedevelopFiltered,
+                            channel,
+                            component: 0,
+                        },
+                        [
+                            Some(&mut sources[channel as usize].file),
+                            Some(&mut core_file),
+                            Some(&mut accumulator_file),
+                        ],
+                        &mut candidate,
+                        &mut counts,
+                        c,
+                    )?;
+                    workspace.checked_close(&core, core_file, c)?;
+                    workspace.checked_close(&accumulator, accumulator_file, c)?;
+                    workspace.release(core, gpu, c)?;
+                    workspace.release(accumulator, gpu, c)?;
+                } else {
+                    let mut correction_file = workspace.read(&correction)?;
+                    point(
+                        p,
+                        gpu,
+                        Job {
+                            operation: Operation::RedevelopUnfiltered,
+                            channel,
+                            component: 0,
+                        },
+                        [
+                            Some(&mut sources[channel as usize].file),
+                            Some(&mut correction_file),
+                            None,
+                        ],
+                        &mut candidate,
+                        &mut counts,
+                        c,
+                    )?;
+                    workspace.checked_close(&correction, correction_file, c)?;
+                }
+                workspace.release(correction, gpu, c)?;
+            }
+            if fault == Some(Fault::OutputWrite) {
+                return Err("GPU_DIR_MIXED64_FILES_INJECTED_WRITE".into());
+            }
+            io(candidate.sync_all())?;
+            exact_size(&candidate, p.0.plane_byte_length)?;
+            drop(candidate);
+            workspace
+                .secure
+                .verify_owned(CANDIDATES[channel as usize])?;
+        }
+        if !workspace.live.is_empty() {
+            return Err("GPU_DIR_MIXED64_FILES_TEMP_LIFETIME".into());
+        }
+        let mut after = Vec::with_capacity(3);
+        for (source, identity) in sources.iter_mut().zip(&p.0.sources.planes) {
+            identity.matches(source)?;
+            let hash = hash_file(&mut source.file, identity.byte_length, c)?;
+            identity.matches(source)?;
+            if hash != identity.sha256 {
+                return Err(SOURCE_CHANGED.into());
+            }
+            after.push(hash);
+        }
+        // Held source file and directory handles close before private publication.
+        drop(sources);
+        let mut output_hashes = Vec::with_capacity(3);
+        for name in CANDIDATES {
+            let mut f = workspace.secure.open_owned_read(name)?;
+            output_hashes.push(hash_file(&mut f, p.0.plane_byte_length, c)?);
+            drop(f);
+            workspace.secure.verify_owned(name)?;
+        }
+        gpu.check_status()?;
+        check(c)?;
+        let receipt = CandidateReceiptV2 {
+            version: VERSION,
+            status: policy.status().into(),
+            operation: policy.operation().into(),
+            layout: policy.layout().into(),
+            plan_sha256: p.identity()?,
+            width: p.0.calibration.width,
+            height: p.0.calibration.height,
+            encoding: "threePlanarBinary64LittleEndian".into(),
+            source_sha256_before: before,
+            source_sha256_after: after.try_into().map_err(|_| ERROR)?,
+            candidate_sha256: output_hashes.try_into().map_err(|_| ERROR)?,
+            plane_byte_length: p.0.plane_byte_length,
+            candidate64: p.0.paths.candidate64.clone(),
+            candidate_marker: p.0.paths.candidate_marker.clone(),
+            point_batches: counts.point,
+            row_batches: counts.rows,
+            column_batches: counts.columns,
+            identity_row_batches: counts.identity_rows,
+            identity_column_batches: counts.identity_columns,
+            fir_row_batches: counts.fir_rows,
+            fir_column_batches: counts.fir_columns,
+            iir_row_batches: counts.iir_rows,
+            iir_column_batches: counts.iir_columns,
+            temporary_plane_highwater: workspace.highwater,
+            temporary_byte_highwater: workspace.byte_highwater,
+            temporary_planes_remaining: workspace.live.len() as u32,
+            intermediate_hashes: std::mem::take(&mut workspace.audit),
+            requires_outer_seal_or_confirmed_helper_death: true,
+        };
+        receipt.validate_for_plan_policy(p, policy)?;
+        if fault == Some(Fault::BeforeMarker) {
+            return Err("GPU_DIR_MIXED64_FILES_INJECTED_BEFORE_MARKER".into());
+        }
+        let bytes = serialize_marker_for(&receipt, policy)?;
+        check(c)?;
+        gpu.check_status()?;
+        let marker = workspace.secure.create_file(MARKER)?;
+        let mut marker = workspace.after_create(marker)?;
+        if fault == Some(Fault::MarkerWrite) {
+            io(marker.write_all(&bytes[..bytes.len() / 2]))?;
+            return Err("GPU_DIR_MIXED64_FILES_INJECTED_MARKER_WRITE".into());
+        }
+        io(marker.write_all(&bytes))?;
+        check(c)?;
+        io(marker.sync_all())?;
+        if fault == Some(Fault::MarkerHash) {
+            io(marker.seek(SeekFrom::Start(0)))?;
+            io(marker.write_all(&[bytes[0] ^ 1]))?;
+            io(marker.sync_all())?;
+        }
+        if hash_file(&mut marker, bytes.len() as u64, c)? != digest(&bytes) {
+            return Err(IO_ERROR.into());
+        }
+        drop(marker);
+        workspace.secure.verify_all()?;
+        workspace.secure.sync()?;
+        gpu.check_status()?;
+        check(c)?;
+        Ok(receipt)
+    })();
+    // Retire the shared owner before best-effort owned-file cleanup on failure.
+    // Outstanding GPU retirement/death remains the outer lifecycle authority.
+    if result.is_err() {
+        gpu.poison();
+    } else {
+        workspace.secure.retain();
+    }
+    drop(workspace);
+    result
+}
+fn serialize_marker(receipt: &CandidateReceiptV2) -> R<Vec<u8>> {
+    serialize_marker_for(receipt, InputPolicy::Original)
+}
+fn serialize_marker_for(receipt: &CandidateReceiptV2, policy: InputPolicy) -> R<Vec<u8>> {
+    receipt.validate_for(policy)?;
+    let bytes = serde_json::to_vec(receipt).map_err(|_| ERROR)?;
+    // Enforced at the actual writer, not a theoretical schema estimate.
+    if bytes.len() as u64 > METADATA_BYTES {
+        return Err("GPU_DIR_MIXED64_FILES_MARKER_BUDGET".into());
+    }
+    Ok(bytes)
+}
