+//! Private held-directory I/O for the closed DIR graph, copied from the frozen
+//! raw64 spool rather than weakening its guards. Linux/Android only.
+//!
+//! Cleanup is best effort for recorded owned inodes, never recursive. A same-UID
+//! adversary can race verification and unlink/rename: these checks are not an
+//! atomic ownership transaction. Failure after create but before identity capture
+//! can leave unrecorded residue; deleting an unverified name would be less safe.
+//! No unconditional zero-residue or adversarial-immutability claim is made.
+#![cfg(test)]
+
+use super::*;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Identity {
+    pub device: u64,
+    pub inode: u64,
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+mod platform {
+    use super::*;
+    use std::{
+        ffi::CString,
+        os::{
+            fd::{AsRawFd, FromRawFd},
+            unix::fs::MetadataExt,
+        },
+    };
+
+    fn private(metadata: &std::fs::Metadata) -> bool {
+        // SAFETY: geteuid reads the process identity and takes no pointers.
+        let effective_uid = unsafe { libc::geteuid() };
+        metadata.mode() & 0o077 == 0 && metadata.uid() == effective_uid
+    }
+    fn identity(file: &File) -> R<Identity> {
+        let m = io(file.metadata())?;
+        if m.is_file() && (m.nlink() != 1 || !private(&m)) {
+            return Err(PATH_ERROR.into());
+        }
+        Ok(Identity {
+            device: m.dev(),
+            inode: m.ino(),
+        })
+    }
+    fn name(name: &str) -> R<CString> {
+        if name.is_empty() || name == "." || name == ".." || name.contains('/') {
+            return Err(PATH_ERROR.into());
+        }
+        CString::new(name).map_err(|_| PATH_ERROR.into())
+    }
+    fn from_fd(fd: libc::c_int) -> R<File> {
+        if fd < 0 {
+            return io(Err(std::io::Error::last_os_error()));
+        }
+        // SAFETY: a successful open/openat returns a fresh, owned descriptor.
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+    fn open_at(dir: &File, name: &CString, flags: libc::c_int, mode: libc::mode_t) -> R<File> {
+        // SAFETY: CString is NUL terminated; dir is held open for this call.
+        from_fd(unsafe {
+            libc::openat(
+                dir.as_raw_fd(),
+                name.as_ptr(),
+                flags | libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK,
+                mode,
+            )
+        })
+    }
+    fn directory(path: &Path) -> R<File> {
+        if !path.is_absolute() {
+            return Err(PATH_ERROR.into());
+        }
+        let root = CString::new("/").map_err(|_| PATH_ERROR)?;
+        // SAFETY: fixed NUL-terminated root path, no mutable memory access.
+        let mut current = from_fd(unsafe {
+            libc::open(
+                root.as_ptr(),
+                libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+            )
+        })?;
+        for part in path.components().skip(1) {
+            let std::path::Component::Normal(part) = part else {
+                return Err(PATH_ERROR.into());
+            };
+            current = open_at(
+                &current,
+                &name(part.to_str().ok_or(PATH_ERROR)?)?,
+                libc::O_RDONLY | libc::O_DIRECTORY,
+                0,
+            )?;
+        }
+        // Canonical equality is additional validation, never the only guard.
+        if io(path.canonicalize())? != path {
+            return Err(PATH_ERROR.into());
+        }
+        Ok(current)
+    }
+    fn parent_and_name(path: &Path) -> R<(File, CString)> {
+        plain_absolute(path)?;
+        Ok((
+            directory(path.parent().ok_or(PATH_ERROR)?)?,
+            name(
+                path.file_name()
+                    .and_then(|s| s.to_str())
+                    .ok_or(PATH_ERROR)?,
+            )?,
+        ))
+    }
+    fn same_at(parent: &File, path: &CString, expected: Identity, is_directory: bool) -> R<()> {
+        let flags = if is_directory {
+            libc::O_RDONLY | libc::O_DIRECTORY
+        } else {
+            libc::O_RDONLY
+        };
+        let current = open_at(parent, path, flags, 0)?;
+        if identity(&current)? != expected {
+            return Err(PATH_ERROR.into());
+        }
+        let metadata = io(current.metadata())?;
+        if (is_directory && !metadata.is_dir()) || (!is_directory && !metadata.is_file()) {
+            return Err(PATH_ERROR.into());
+        }
+        Ok(())
+    }
+    fn available(dir: &File) -> R<u64> {
+        let mut out = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+        // SAFETY: fstatvfs writes the struct on success; fd stays open.
+        if unsafe { libc::fstatvfs(dir.as_raw_fd(), out.as_mut_ptr()) } != 0 {
+            return io(Err(std::io::Error::last_os_error()));
+        }
+        // SAFETY: the successful call initialized the struct.
+        let out = unsafe { out.assume_init() };
+        mul(out.f_bavail as u64, out.f_frsize as u64)
+    }
+    pub struct Source {
+        pub file: File,
+        parent: File,
+        name: CString,
+        id: Identity,
+        path: PathBuf,
+    }
+    impl Source {
+        pub fn open(path: &Path) -> R<Self> {
+            let (parent, name) = parent_and_name(path)?;
+            let file = open_at(&parent, &name, libc::O_RDONLY, 0)?;
+            if !io(file.metadata())?.is_file() {
+                return Err(PATH_ERROR.into());
+            }
+            let id = identity(&file)?;
+            let out = Self {
+                file,
+                parent,
+                name,
+                id,
+                path: path.to_owned(),
+            };
+            out.unchanged()?;
+            Ok(out)
+        }
+        pub fn identity(&self) -> R<Identity> {
+            self.unchanged()?;
+            Ok(self.id)
+        }
+        pub fn unchanged(&self) -> R<()> {
+            if identity(&self.file)? != self.id {
+                return Err(SOURCE_CHANGED.into());
+            }
+            same_at(&self.parent, &self.name, self.id, false)?;
+            let current = Source::open_path_only(&self.path)?;
+            if identity(&current)? != self.id {
+                return Err(SOURCE_CHANGED.into());
+            }
+            Ok(())
+        }
+        fn open_path_only(path: &Path) -> R<File> {
+            let (parent, name) = parent_and_name(path)?;
+            open_at(&parent, &name, libc::O_RDONLY, 0)
+        }
+    }
+    pub struct Workspace {
+        parent: File,
+        name: CString,
+        directory: File,
+        directory_id: Identity,
+        path: PathBuf,
+        owned: Vec<(CString, Identity)>,
+        retained: bool,
+    }
+    impl Workspace {
+        pub fn create(path: &Path, required_available: u64) -> R<Self> {
+            let (parent, name) = parent_and_name(path)?;
+            if available(&parent)? < required_available {
+                return Err("GPU_DIR64_IMAGE_DISK_ADMISSION".into());
+            }
+            // SAFETY: held parent and NUL-terminated leaf; mkdirat is exclusive.
+            if unsafe { libc::mkdirat(parent.as_raw_fd(), name.as_ptr(), 0o700) } != 0 {
+                return io(Err(std::io::Error::last_os_error()));
+            }
+            // If open fails, do not unlink an unverified path: a raced foreign
+            // replacement must never be deleted under the guise of cleanup.
+            let directory = open_at(&parent, &name, libc::O_RDONLY | libc::O_DIRECTORY, 0)?;
+            let metadata = io(directory.metadata())?;
+            if !metadata.is_dir() || !private(&metadata) {
+                return Err(PATH_ERROR.into());
+            }
+            let directory_id = identity(&directory)?;
+            let result = Self {
+                parent,
+                name,
+                directory,
+                directory_id,
+                path: path.to_owned(),
+                owned: Vec::new(),
+                retained: false,
+            };
+            result.verify_directory()?;
+            Ok(result)
+        }
+        fn verify_directory(&self) -> R<()> {
+            let metadata = io(self.directory.metadata())?;
+            if !metadata.is_dir() || !private(&metadata) {
+                return Err(PATH_ERROR.into());
+            }
+            same_at(&self.parent, &self.name, self.directory_id, true)?;
+            let current = directory(&self.path)?;
+            if identity(&current)? != self.directory_id {
+                return Err(PATH_ERROR.into());
+            }
+            Ok(())
+        }
+        pub fn create_file(&mut self, leaf: &str) -> R<File> {
+            self.verify_directory()?;
+            let leaf = name(leaf)?;
+            let file = open_at(
+                &self.directory,
+                &leaf,
+                libc::O_RDWR | libc::O_CREAT | libc::O_EXCL,
+                0o600,
+            )?;
+            let id = identity(&file)?;
+            self.owned.push((leaf, id));
+            Ok(file)
+        }
+        pub fn verify_owned(&self, leaf: &str) -> R<()> {
+            self.verify_directory()?;
+            let leaf = name(leaf)?;
+            let (_, id) = self
+                .owned
+                .iter()
+                .find(|(name, _)| name == &leaf)
+                .ok_or(PATH_ERROR)?;
+            same_at(&self.directory, &leaf, *id, false)
+        }
+        pub fn open_owned_read(&self, leaf: &str) -> R<File> {
+            self.verify_owned(leaf)?;
+            let leaf = name(leaf)?;
+            let file = open_at(&self.directory, &leaf, libc::O_RDONLY, 0)?;
+            let (_, expected) = self
+                .owned
+                .iter()
+                .find(|(name, _)| name == &leaf)
+                .ok_or(PATH_ERROR)?;
+            if identity(&file)? != *expected {
+                return Err(PATH_ERROR.into());
+            }
+            Ok(file)
+        }
+        pub fn open_owned_write(&self, leaf: &str) -> R<File> {
+            self.verify_owned(leaf)?;
+            let leaf = name(leaf)?;
+            let file = open_at(&self.directory, &leaf, libc::O_RDWR, 0)?;
+            let (_, expected) = self
+                .owned
+                .iter()
+                .find(|(name, _)| name == &leaf)
+                .ok_or(PATH_ERROR)?;
+            if identity(&file)? != *expected {
+                return Err(PATH_ERROR.into());
+            }
+            Ok(file)
+        }
+        /// Caller must first close every handle for this plane and ensure its
+        /// compute operation has fenced/unmapped. This method cannot establish
+        /// those facts; the graph's scoped file handles enforce that contract.
+        pub fn remove_owned(&mut self, leaf: &str) -> R<()> {
+            self.verify_owned(leaf)?;
+            let leaf = name(leaf)?;
+            let index = self
+                .owned
+                .iter()
+                .position(|(name, _)| name == &leaf)
+                .ok_or(PATH_ERROR)?;
+            // SAFETY: held directory and NUL-terminated verified owned leaf.
+            // Same-UID rename between verification and unlink is not atomic.
+            if unsafe { libc::unlinkat(self.directory.as_raw_fd(), leaf.as_ptr(), 0) } != 0 {
+                return io(Err(std::io::Error::last_os_error()));
+            }
+            self.owned.remove(index);
+            Ok(())
+        }
+        pub fn verify_all(&self) -> R<()> {
+            self.verify_directory()?;
+            for (leaf, id) in &self.owned {
+                same_at(&self.directory, leaf, *id, false)?;
+            }
+            Ok(())
+        }
+        pub fn sync(&self) -> R<()> {
+            io(self.directory.sync_all())?;
+            io(self.parent.sync_all())
+        }
+        pub fn retain(&mut self) {
+            self.retained = true;
+        }
+    }
+    impl Drop for Workspace {
+        fn drop(&mut self) {
+            if self.retained {
+                return;
+            }
+            for (leaf, id) in self.owned.iter().rev() {
+                if same_at(&self.directory, leaf, *id, false).is_ok() {
+                    // SAFETY: held fd and NUL-terminated previously verified leaf.
+                    // The check/unlink pair is not atomic against same-UID races.
+                    let _ = unsafe { libc::unlinkat(self.directory.as_raw_fd(), leaf.as_ptr(), 0) };
+                }
+            }
+            if same_at(&self.parent, &self.name, self.directory_id, true).is_ok() {
+                // Never remove_dir_all: unknown content/replacements survive.
+                let _ = unsafe {
+                    libc::unlinkat(
+                        self.parent.as_raw_fd(),
+                        self.name.as_ptr(),
+                        libc::AT_REMOVEDIR,
+                    )
+                };
+            }
+        }
+    }
+}
+#[cfg(not(any(target_os = "linux", target_os = "android")))]
+mod platform {
