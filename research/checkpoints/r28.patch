+#[test]
+fn exact_hex_roundtrip_and_strict_malformed_descriptor_rejection() {
+    let valid = fixture();
+    let text = serde_json::to_string(&valid).unwrap();
+    assert_eq!(
+        serde_json::from_str::<DirCalibration>(&text).unwrap(),
+        valid
+    );
+    let value = serde_json::to_value(&valid).unwrap();
+    assert!(
+        value["tailWeightBits"]
+            .as_str()
+            .is_some_and(|s| s.len() == 16)
+    );
+    assert!(value["coefficientBits"][0][0].is_string());
+    for bad in [
+        "3ff000000000000",
+        "03ff0000000000000",
+        "3FF0000000000000",
+        "0x3ff00000000000",
+        "3ff000000000000g",
+    ] {
+        let mut changed = value.clone();
+        changed["tailWeightBits"] = serde_json::json!(bad);
+        assert!(
+            serde_json::from_value::<DirCalibration>(changed).is_err(),
+            "{bad}"
+        );
+    }
+    let mut changed = value.clone();
+    changed["tailWeightBits"] = serde_json::json!(valid.tail_weight_bits);
+    assert!(serde_json::from_value::<DirCalibration>(changed).is_err());
+    let mut changed = value.clone();
+    changed["unknown"] = serde_json::json!(0);
+    assert!(serde_json::from_value::<DirCalibration>(changed).is_err());
+    let mut changed = value.clone();
+    changed["initial"]["unknown"] = serde_json::json!(0);
+    assert!(serde_json::from_value::<DirCalibration>(changed).is_err());
+    let mut changed = value.clone();
