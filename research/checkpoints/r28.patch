+    let mut g = HostCompute::new(Behavior::Echo);
+    let receipt = execute(&p, &mut g).unwrap();
+    assert!(!g.poisoned);
+    assert_eq!(f.read(&receipt), echo_expected(p.calibration(), &f.input));
+    assert_eq!(receipt.temporary_plane_highwater, 5);
+    assert_eq!(receipt.temporary_byte_highwater, 5 * 21 * 8);
+    assert_eq!(receipt.temporary_planes_remaining, 0);
+    assert_eq!(receipt.point_batches, 3 * 5 * 6);
+    assert_eq!(receipt.row_batches, 3 * 4 * 3);
+    assert_eq!(receipt.column_batches, 3 * 4 * 4);
+    assert!(g.point_jobs.iter().all(|(_, n)| *n <= 4));
+    assert!(
+        g.spatial_specs
+            .iter()
+            .all(|s| s.sample_count().unwrap() <= 7)
+    );
+    let cal = p.calibration();
+    let expected = [
+        cal.core_sigma_bits,
+        cal.tail_sigma_bits[0],
+        cal.tail_sigma_bits[1],
+        cal.tail_sigma_bits[2],
+    ];
+    for (filter, sigma) in expected.into_iter().enumerate() {
+        let selected = g
+            .spatial_specs
+            .iter()
+            .filter(|s| spatial_sigma(s) == sigma)
+            .collect::<Vec<_>>();
+        assert_eq!(selected.len(), 3 * 7);
+        assert!(
+            selected
+                .iter()
+                .all(|s| matches!(s, SpatialLine::Iir(line) if matches!(&cal.filters.as_ref().unwrap()[filter], Gaussian::Iir { coefficient_bits, .. } if line.coefficient_bits == *coefficient_bits)))
+        );
+    }
+    let entries = fs::read_dir(&p.paths().private_directory)
