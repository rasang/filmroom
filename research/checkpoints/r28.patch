+        .map(|e| e.unwrap().file_name().to_str().unwrap().to_owned())
+        .collect::<Vec<_>>();
+    assert_eq!(entries.len(), 4);
+    for name in CANDIDATES.into_iter().chain([MARKER]) {
+        assert!(entries.iter().any(|e| e == name));
+    }
+    assert_eq!(receipt.source_sha256_before, receipt.source_sha256_after);
+    assert!(receipt.requires_outer_seal_or_confirmed_helper_death);
+    assert!(fs::metadata(&receipt.candidate_marker).unwrap().len() <= METADATA_BYTES);
+    assert_eq!(
+        serde_json::from_slice::<CandidateReceiptV2>(&fs::read(&receipt.candidate_marker).unwrap())
+            .unwrap(),
+        receipt
+    );
+    f.assert_sources();
+}
