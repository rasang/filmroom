+fn assert_event_schedule(p: &DirMixedImagePlan, observed: &[Event]) {
+    // Independently derive expected batching from actual dimensions/capacities,
+    // not the scheduler's saved FilterSchedule geometries.
+    let mut expected = Vec::new();
+    for channel in 0..3 {
+        let mut point = |operation, component| {
+            let mut left = p.samples();
+            while left > 0 {
+                let take = left.min(p.0.point_capacity as u64);
+                expected.push(Event::Point(
+                    Job {
+                        operation,
+                        channel,
+                        component,
+                    },
+                    take as usize,
+                ));
+                left -= take;
+            }
+        };
+        point(Operation::InitialCorrection, 0);
+        if let Some(filters) = &p.calibration().filters {
+            for (index, filter) in filters.iter().enumerate() {
+                let family = Family::of(filter);
+                let capacity = if family == Family::Iir {
+                    p.0.iir_line_capacity
+                } else {
+                    p.0.fir_line_capacity
+                };
+                let axes = if family == Family::Identity { 1 } else { 2 };
+                for (length, total) in [
+                    (p.calibration().width, p.calibration().height),
+                    (p.calibration().height, p.calibration().width),
+                ]
+                .into_iter()
+                .take(axes)
+                {
+                    let mut left = total;
+                    while left > 0 {
+                        let take = left.min(capacity / length);
+                        expected.push(Event::Spatial(family, length, take));
+                        left -= take;
+                    }
+                }
+                if index > 0 {
+                    let mut left = p.samples();
+                    while left > 0 {
+                        let take = left.min(p.0.point_capacity as u64);
+                        expected.push(Event::Point(
+                            Job {
+                                operation: Operation::TailAccumulate,
+                                channel,
+                                component: index as u32 - 1,
+                            },
+                            take as usize,
+                        ));
+                        left -= take;
+                    }
+                }
+            }
+            let mut left = p.samples();
+            while left > 0 {
+                let take = left.min(p.0.point_capacity as u64);
+                expected.push(Event::Point(
+                    Job {
+                        operation: Operation::RedevelopFiltered,
+                        channel,
+                        component: 0,
+                    },
+                    take as usize,
+                ));
+                left -= take;
+            }
+        } else if p.calibration().dir_active {
+            let mut left = p.samples();
+            while left > 0 {
+                let take = left.min(p.0.point_capacity as u64);
+                expected.push(Event::Point(
+                    Job {
+                        operation: Operation::RedevelopUnfiltered,
+                        channel,
+                        component: 0,
+                    },
+                    take as usize,
+                ));
+                left -= take;
+            }
+        }
+    }
+    assert_eq!(observed, expected);
+}
