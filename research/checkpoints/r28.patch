+        );
+        for component in 0..3 {
+            compare_points(
+                &mut gpu,
+                &p,
+                job(Operation::TailAccumulate, channel, component),
+                &points,
+            );
+        }
+    }
+    // Original FIT order across three actual dispatches; no host soft64 mirror.
+    let mut actual_accumulator = vec![0; 129];
+    let mut expected_accumulator = actual_accumulator.clone();
+    for component in 0..3 {
+        let j = job(Operation::TailAccumulate, 0, component);
+        let values: Vec<_> = actual_accumulator
+            .iter()
+            .enumerate()
+            .map(|(i, &a)| {
+                [
+                    a,
+                    ((i as f64 - 64.) * (component + 1) as f64 / 97.).to_bits(),
+                    0,
+                ]
+            })
+            .collect();
+        let expected_values: Vec<_> = values
+            .iter()
+            .zip(&expected_accumulator)
+            .map(|(v, &a)| [a, v[1], v[2]])
+            .collect();
+        expected_accumulator = oracle::original(&p, j, &expected_values);
+        actual_accumulator = gpu.point(&p, j, &values, &mut || false).unwrap();
+        oracle::assert_words(
+            &actual_accumulator,
+            &expected_accumulator,
