+//! Closed test-only original log64 -> DIR density64 file graph. All image
+//! arithmetic belongs to one borrowed Compute owner; host work is calibration,
+//! bounds, byte movement, hashing and lifecycle control. A ready marker is NOT
+//! an outer stage seal or evidence that the helper/GPU owner has died.
+#![cfg(test)]
+
+use super::dir_calibration::DirCalibration;
+use super::dir_point::{self, Job, Operation};
+use super::image_files::LineSpec;
+use super::{R, admitted, digest};
+use serde::{Deserialize, Deserializer, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::File,
+    io::{Read, Seek, SeekFrom, Write},
+    path::{Path, PathBuf},
+};
+
+const VERSION: u32 = 1;
+const ERROR: &str = "GPU_DIR64_FILES_DESCRIPTOR";
+const IO_ERROR: &str = "GPU_DIR64_FILES_IO";
+const PATH_ERROR: &str = "GPU_DIR64_FILES_PATH";
+const SOURCE_CHANGED: &str = "GPU_DIR64_FILES_SOURCE_CHANGED";
+const CANCELLED: &str = "GPU_DIR64_FILES_CANCELLED";
+const MIB: u64 = 1024 * 1024;
+const METADATA_BYTES: u64 = 65_536;
+const HASH_BUFFER_BYTES: usize = 65_536;
+const DISK_SAFETY_BYTES: u64 = 256 * MIB;
+const CANDIDATES: [&str; 3] = [
+    "candidate-r64.bin",
+    "candidate-g64.bin",
+    "candidate-b64.bin",
+];
+const MARKER: &str = "candidate-ready.json";
+const C: &str = "correction64.bin";
+const G: &str = "core64.bin";
+const H: &str = "horizontal64.bin";
+const B: &str = "tail64.bin";
+const A: [&str; 2] = ["accumulator-064.bin", "accumulator-164.bin"];
+
+#[path = "dir_file_io.rs"]
+mod secure;
+
+pub(super) trait Compute {
+    fn check_status(&self) -> R<()>;
+    /// Successful return means the common owner's fence, unmap, numeric/device
+    /// checks and after-unmap cancellation check have all finished.
+    fn point(
+        &mut self,
+        calibration: &DirCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        cancelled: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>>;
+    fn raw(
+        &mut self,
+        spec: &LineSpec,
+        values: &[u64],
+        cancelled: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>>;
+    /// Every graph failure, including admission and filesystem failures, retires
+    /// the entire request. No partial receiver channel can be adopted.
+    fn poison(&mut self);
+}
+
+/// An explicit fixture assertion, NOT authentication. Actual test evidence must
+/// show original precision-f64 expose/log capture and compare these file bytes
+/// with the SAME ImageBuf passed to original filming::develop. A renamed file,
+/// a matching hash or this descriptor cannot establish original precision.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct FixtureOrigin {
+    pub kind: String,
+    pub precision: String,
+    pub producer: String,
+    pub fixture_mode: String,
+    pub build_sha256: String,
+    pub producer_sha256: String,
+    pub pipeline_sha256: String,
+    pub profile_sha256: String,
+    pub runtime_params_sha256: String,
+    pub fixture_sha256: String,
+    pub calibration_sha256: String,
+}
+impl FixtureOrigin {
+    fn validate(&self) -> R<()> {
+        if self.kind != "original-log64-test-fixture-v1"
+            || self.precision != "precision-f64"
+            || self.producer != "spektrafilm_core::stages::filming::expose"
+            || self.fixture_mode.is_empty()
+            || self.fixture_mode.len() > 1024
+            || self.fixture_mode.chars().any(char::is_control)
+            || [
+                &self.build_sha256,
+                &self.producer_sha256,
+                &self.pipeline_sha256,
+                &self.profile_sha256,
+                &self.runtime_params_sha256,
+                &self.fixture_sha256,
+                &self.calibration_sha256,
+            ]
+            .into_iter()
+            .any(|s| !valid_digest(s))
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct SourceIdentity {
+    pub path: PathBuf,
+    pub byte_length: u64,
+    pub sha256: String,
+    pub device: u64,
+    pub inode: u64,
+}
+impl SourceIdentity {
+    pub(super) fn capture(path: &Path, cancelled: &mut impl FnMut() -> bool) -> R<Self> {
+        check(cancelled)?;
+        let mut source = secure::Source::open(path)?;
+        let byte_length = io(source.file.metadata())?.len();
+        let sha256 = hash_file(&mut source.file, byte_length, cancelled)?;
+        source.unchanged()?;
+        let id = source.identity()?;
+        Ok(Self {
+            path: path.to_owned(),
+            byte_length,
+            sha256,
+            device: id.device,
+            inode: id.inode,
+        })
+    }
+    fn matches(&self, source: &secure::Source) -> R<()> {
+        source.unchanged()?;
+        let id = source.identity()?;
+        if (self.device, self.inode) != (id.device, id.inode) {
+            return Err(SOURCE_CHANGED.into());
+        }
+        exact_size(&source.file, self.byte_length)
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Sources {
+    pub planes: [SourceIdentity; 3],
+    pub origin: FixtureOrigin,
+}
+impl Sources {
+    pub(super) fn capture(
+        paths: [PathBuf; 3],
+        origin: FixtureOrigin,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Self> {
+        origin.validate()?;
+        let mut captured = Vec::with_capacity(3);
+        for path in paths {
+            captured.push(SourceIdentity::capture(&path, c)?);
+        }
+        let result = Self {
+            planes: captured.try_into().map_err(|_| ERROR)?,
+            origin,
+        };
+        result.validate(result.planes[0].byte_length)?;
+        Ok(result)
+    }
+    fn validate(&self, plane_bytes: u64) -> R<()> {
+        self.origin.validate()?;
+        for (i, source) in self.planes.iter().enumerate() {
+            plain_absolute(&source.path)?;
+            if source.byte_length != plane_bytes
+                || !valid_digest(&source.sha256)
+                || source.inode == 0
+            {
+                return Err(ERROR.into());
+            }
+            for previous in &self.planes[..i] {
+                if previous.path == source.path
+                    || (previous.device, previous.inode) == (source.device, source.inode)
+                {
+                    return Err(PATH_ERROR.into());
+                }
+            }
+        }
+        Ok(())
+    }
