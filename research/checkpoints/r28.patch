+        ImagePaths::new(PathBuf::from("/imaginary/private")),
+    )
+    .unwrap();
+    let r = plan.resources();
+    assert_eq!(plan.samples(), 50_331_648);
+    assert_eq!(r.source_disk_bytes, 384 * MIB);
+    assert_eq!(r.total_request_disk_bytes, 1152 * MIB + METADATA_BYTES);
+    assert_eq!(r.additional_disk_bytes, 768 * MIB + METADATA_BYTES);
+    assert_eq!(r.required_available_disk_bytes, 1024 * MIB + METADATA_BYTES);
+    assert_eq!(r.device_pool_bytes, 12 * MIB + 72);
+    assert_eq!(r.upload_allowance_bytes, 4 * MIB);
+    assert_eq!(r.device_reservation_bytes, 20 * MIB + 65_536);
+    assert_eq!(r.combined_reservation_bytes, 220 * MIB + 65_536);
+    assert_eq!(
+        r.device_pool_bytes + r.upload_allowance_bytes + r.device_headroom_bytes,
+        r.device_reservation_bytes
+    );
+    assert_eq!(plan.0.row_lines_per_batch, 64);
+    assert_eq!(plan.0.column_lines_per_batch, 85);
+    assert_eq!(plan.0.row_batch_count, 96);
+    assert_eq!(plan.0.column_batch_count, 97);
+    let encoded = serde_json::to_string(&plan).unwrap();
+    assert_eq!(
+        serde_json::from_str::<Soft64ImagePlan>(&encoded).unwrap(),
+        plan
+    );
+    let value = serde_json::to_value(&plan).unwrap();
+    for (field, replacement) in [
+        ("version", serde_json::json!(2)),
+        ("operation", serde_json::json!("closedDir")),
+        ("layout", serde_json::json!("fullLineFileBackedV1")),
+        ("axisOrder", serde_json::json!("columnsThenRows")),
+        ("width", serde_json::json!(0)),
+        ("height", serde_json::json!(40001)),
+        ("samples", serde_json::json!(u64::MAX)),
+        ("sigmaBits", serde_json::json!(0)),
+        ("coefficientBits", serde_json::json!([0, 0, 0, 0])),
+        ("coefficientSource", serde_json::json!("f32")),
+        ("originalGaussianSha256", serde_json::json!("0".repeat(64))),
+        ("sourceEncoding", serde_json::json!("binary32le")),
+        ("horizontalEncoding", serde_json::json!("binary32le")),
+        ("outputEncoding", serde_json::json!("f32_after_both_axes")),
+        ("rowPitchBytes", serde_json::json!(32768)),
+        ("paddingBytes", serde_json::json!(1)),
+        ("haloSamples", serde_json::json!(1)),
+        ("maximumCompleteLineLength", serde_json::json!(1)),
+        ("sampleCapacity", serde_json::json!(CAPACITY + 1)),
+        ("byteCapacity", serde_json::json!(4)),
+        ("rowLinesPerBatch", serde_json::json!(65)),
+        ("columnLinesPerBatch", serde_json::json!(86)),
+        ("rowBatchCount", serde_json::json!(1)),
+        ("columnBatchCount", serde_json::json!(1)),
+        ("completeLinePolicy", serde_json::json!("restartInsideLine")),
+        ("numericPolicy", serde_json::json!("clampUnderflowToZero")),
+        ("zeroPolicy", serde_json::json!("signedZeroExact")),
+        ("boundBits", serde_json::json!(0)),
+        ("rawKernelLayout", serde_json::json!("output32")),
+        ("sharedLibrarySha256", serde_json::json!("0".repeat(64))),
+        ("rawKernelSha256", serde_json::json!("0".repeat(64))),
+        ("composedShaderSha256", serde_json::json!("0".repeat(64))),
+    ] {
+        let mut changed = value.clone();
+        changed[field] = replacement;
+        assert!(
+            serde_json::from_value::<Soft64ImagePlan>(changed).is_err(),
+            "accepted {field}"
