+//! Closed, graph-neutral authentication for captured GPU f32 log words.
+//! Adapted from the reviewed9260f5 dir_derived provenance factory, not its graph.
+//! This is not original-reference log64 or a production route. Factory calls
+//! must run while the successful upstream packet and retained adapter exist.
+//! Context is trusted harness testimony, not independently verified history.
+//! Repeated packet checks do not establish adversarial same-UID atomicity.
+#![cfg(test)]
+use super::{R, admitted, digest};
+use crate::{
+    gpu_session_contract::StageTicket,
+    research_global::{
+        GlobalKind, GlobalPlan,
+        full_stage::{self as global_stage, StagePlan},
+    },
+};
+use serde::Serialize;
+use serde_json::Value;
+use spektrafilm_core::pipeline::Pipeline;
+use std::{
+    fs::{self, File},
+    io::Read,
+    path::{Component, Path, PathBuf},
+};
+
+pub(crate) const INPUT_IDENTITY: &str = "gpu-f32-log-promoted";
+const ERROR: &str = "GPU_DIR_DERIVED_IDENTITY";
+const CANCELLED: &str = "GPU_DIR_DERIVED_CANCELLED";
+const MAX_SEAL_BYTES: usize = 16 * 1024;
+const MAX_MANIFEST_BYTES: usize = 1024 * 1024;
+const EXPECTED_BACKEND: &str = "Vulkan f32 original global science";
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err(CANCELLED.into()) } else { Ok(()) }
+}
+fn valid_hash(s: &str) -> bool {
+    s.len() == 64
+        && s.bytes()
+            .all(|x| x.is_ascii_digit() || (b'a'..=b'f').contains(&x))
+}
+fn encode<T: Serialize>(x: &T) -> R<Vec<u8>> {
+    serde_json::to_vec(x).map_err(|_| ERROR.into())
+}
+
+/// Context asserted by the trusted closed chain harness. These hashes bind the
+/// comparison setup; they do not independently authenticate the earlier prefix.
+/// Full-chain tests must prove those actual prefix records separately. The
+/// harness must assert checkpoint=None and actual resume_stage==0. FreshFrame
+/// binds that assertion; this factory cannot independently reconstruct it.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct ExperimentContext {
+    pub build_sha256: String,
+    pub fixture_sha256: String,
+    pub profile_sha256: String,
+    pub params_sha256: String,
+    pub prefix_records_sha256: String,
+    pub actual_metered_ev_bits: Option<u32>,
+    /// Actual original expose input, exactly promoted from the GPU's f32 scale.
+    pub actual_ae_scale_promoted_bits: Option<u64>,
+    /// Separate original expose input: from_f32(2f32.powf(compEV)).
+    pub exposure_compensation_scale_promoted_bits: u64,
+    /// Additional harness summary only; never replaces the two ordered scales.
+    pub effective_exposure_factor_bits: u64,
+    pub log_correction_bits: u64,
+    pub resume: ExperimentResume,
+}
+/// Only a fresh prefix is admitted in this closed experiment. No Deserialize:
+/// callers cannot silently generalize checkpoint/resume behavior through JSON.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) enum ExperimentResume {
+    FreshFrame,
+}
+fn positive_f32_promotion(bits: u64) -> bool {
+    let value = f64::from_bits(bits);
+    admitted(bits) && value > 0. && (value as f32 as f64).to_bits() == bits
+}
+/// Exact hash recipe used by the chain harness and rechecked by the plan.
+/// Profile is the complete calibrated in-memory film Debug representation,
+/// pinned to this build, not an unrelated file-name assertion.
+pub(crate) fn pipeline_identities(pipe: &Pipeline) -> R<(String, String)> {
+    Ok((
+        digest(format!("{:?}", pipe.film).as_bytes()),
+        digest(&encode(&pipe.params)?),
+    ))
+}
+impl ExperimentContext {
+    fn validate(&self) -> R<()> {
+        if [
+            &self.build_sha256,
+            &self.fixture_sha256,
+            &self.profile_sha256,
+            &self.params_sha256,
+            &self.prefix_records_sha256,
+        ]
+        .iter()
+        .any(|s| !valid_hash(s))
+            || self
+                .actual_metered_ev_bits
+                .is_some_and(|w| !f32::from_bits(w).is_finite())
+            || self
+                .actual_ae_scale_promoted_bits
+                .is_some_and(|bits| !positive_f32_promotion(bits))
+            || !positive_f32_promotion(self.exposure_compensation_scale_promoted_bits)
+            || self.resume != ExperimentResume::FreshFrame
+            || ![
+                self.effective_exposure_factor_bits,
+                self.log_correction_bits,
+            ]
+            .into_iter()
+            .all(|w| admitted(w) && f64::from_bits(w) > 0.)
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+}
+
+/// Constructor-only evidence: no Deserialize and no public fields. Never mint
+/// it from a post-log filename or from the promoted-word condition alone.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct DerivedLogEvidence {
+    input_identity: String,
+    // Constructor provenance, serialized into the proof identity. Host mocks
+    // may exercise plans, but cannot pass the actual GPU admission gate.
+    real_factory_evidence: bool,
+    epoch: u64,
+    generation: u64,
+    sequence: u64,
+    token: u64,
+    plan: StagePlan,
+    plan_sha256: String,
+    native_seal_sha256: String,
+    producer_shader_sha256: String,
+    input_plane_sha256: [String; 3],
+    output_plane_sha256: [String; 3],
+    context: ExperimentContext,
+    // Retained identity only. Later copy checks must not reopen deleted packets.
+    producer_directory: PathBuf,
+    producer_outputs: [ProducerOutputIdentity; 3],
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ProducerOutputIdentity {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+}
+fn plain_absolute(path: &Path) -> bool {
+    path.is_absolute()
+        && path
+            .components()
+            .skip(1)
+            .all(|part| matches!(part, Component::Normal(_)))
+}
+impl ProducerOutputIdentity {
+    /// Identity observation only: producer packets never promised private-copy
+    /// modes or single-link counts, so none are imposed here.
+    #[cfg(unix)]
+    fn capture(path: &Path) -> R<Self> {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = fs::symlink_metadata(path).map_err(|_| ERROR)?;
+        if !metadata.is_file()
+            || metadata.file_type().is_symlink()
+            || !plain_absolute(path)
+            || path.canonicalize().map_err(|_| ERROR)? != path
+        {
+            return Err(ERROR.into());
+        }
+        Ok(Self {
+            path: path.to_owned(),
+            device: metadata.dev(),
+            inode: metadata.ino(),
+        })
+    }
+    #[cfg(not(unix))]
+    fn capture(_path: &Path) -> R<Self> {
+        Err("GPU_DIR_DERIVED_UNSUPPORTED".into())
+    }
+}
+fn producer_output_identities(paths: &[PathBuf; 3]) -> R<[ProducerOutputIdentity; 3]> {
+    Ok([
+        ProducerOutputIdentity::capture(&paths[0])?,
+        ProducerOutputIdentity::capture(&paths[1])?,
+        ProducerOutputIdentity::capture(&paths[2])?,
+    ])
+}
+fn validate_seal(ticket: StageTicket, token: u64, p: &StagePlan, sealed: &Value) -> R<()> {
+    let keys = [
+        "ok",
+        "schemaVersion",
+        "epoch",
+        "generation",
+        "sequence",
+        "token",
+        "operation",
+        "stageSealed",
+        "summary",
+        "session",
+    ];
+    let object = sealed.as_object().ok_or(ERROR)?;
+    if object.len() != keys.len()
+        || keys.iter().any(|k| !object.contains_key(*k))
+        || encode(sealed)?.len() > MAX_SEAL_BYTES
+        || [ticket.epoch, ticket.generation, ticket.sequence, token]
+            .into_iter()
+            .any(|v| v == 0 || v > i64::MAX as u64)
+        || p.schema_version != 1
+        || p.operation != "fullExposureLog"
+        || p.token != token
+        || !valid_hash(&p.manifest_sha256)
+        || p.width == 0
+        || p.height == 0
+        || p.width > 40_000
+        || p.height > 40_000
+        || sealed["ok"] != true
+        || sealed["schemaVersion"] != 1
+        || sealed["stageSealed"] != true
+        || sealed["epoch"].as_u64() != Some(ticket.epoch)
+        || sealed["generation"].as_u64() != Some(ticket.generation)
+        || sealed["sequence"].as_u64() != Some(ticket.sequence)
+        || sealed["token"].as_u64() != Some(token)
+        || sealed["operation"].as_str() != Some("fullExposureLog")
+    {
+        return Err(ERROR.into());
+    }
+    let s = &sealed["summary"];
+    if !s.is_object()
+        || s["ok"] != true
+        || s["schemaVersion"] != 1
+        || s["gpuUsed"] != true
+        || s["fullImage"] != true
+        || s["operation"].as_str() != Some("fullExposureLog")
+        || s["token"].as_u64() != Some(token)
+        || s["manifestSha256"].as_str() != Some(p.manifest_sha256.as_str())
+        || s["width"].as_u64() != Some(p.width as u64)
+        || s["height"].as_u64() != Some(p.height as u64)
+        || s["backend"].as_str() != Some(EXPECTED_BACKEND)
+        || !s["dispatches"].as_u64().is_some_and(|n| n > 0)
+        || s["hostArithmeticMirror"].as_bool() == Some(true)
+        || s["testOnly"].as_bool() == Some(true)
+        || sealed["session"]["epoch"].as_u64() != Some(ticket.epoch)
+    {
+        return Err(ERROR.into());
+    }
+    Ok(())
+}
+impl DerivedLogEvidence {
+    /// Call in NativeDelegate.begin immediately after the REAL native stage
+    /// returned success_sealed, before poll/adoption can remove stage_dir.
+    /// The sealed Value is trusted in-process return evidence, NOT a bearer
+    /// credential or an API accepting untrusted external receipt JSON.
+    pub(crate) fn from_verified_stage(
+        ticket: StageTicket,
+        token: u64,
+        stage_dir: &Path,
+        expected: &StagePlan,
+        sealed: &Value,
+        context: ExperimentContext,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Self> {
+        check(c)?;
+        context.validate()?;
+        validate_seal(ticket, token, expected, sealed)?;
+        let p = global_stage::plan_stage(stage_dir, token)?;
+        if p != *expected {
+            return Err(ERROR.into());
+        }
+        #[cfg(feature = "gpu-diffusion-research")]
+        {
+            let device =
+                crate::gpu_session::adapter_info_for_test(ticket.epoch).map_err(|_| ERROR)?;
+            if sealed["summary"]["vendor"].as_u64() != Some(device.vendor as u64) {
+                return Err(ERROR.into());
+            }
+        }
+        #[cfg(not(feature = "gpu-diffusion-research"))]
+        {
+            return Err("GPU_DIR_DERIVED_UNSUPPORTED".into());
+        }
+        let metadata = fs::symlink_metadata(stage_dir.join("manifest.json")).map_err(|_| ERROR)?;
+        if !metadata.is_file()
+            || metadata.file_type().is_symlink()
+            || metadata.len() > MAX_MANIFEST_BYTES as u64
+        {
+            return Err(ERROR.into());
+        }
+        let mut bytes = Vec::new();
+        File::open(stage_dir.join("manifest.json"))
+            .map_err(|_| ERROR)?
+            .take(MAX_MANIFEST_BYTES as u64 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|_| ERROR)?;
+        if bytes.len() > MAX_MANIFEST_BYTES || digest(&bytes) != p.manifest_sha256 {
+            return Err(ERROR.into());
+        }
+        let manifest: Value = serde_json::from_slice(&bytes).map_err(|_| ERROR)?;
+        let global: GlobalPlan =
+            serde_json::from_value(manifest["global"].clone()).map_err(|_| ERROR)?;
+        global.validate()?;
+        match global.kind {
+            GlobalKind::LogExposure { correction }
+                if correction.to_bits() == context.log_correction_bits => {}
+            _ => return Err(ERROR.into()),
+        }
+        let outputs =
+            match global_stage::validate_outputs(stage_dir, token, &p.manifest_sha256, &mut *c)? {
+                global_stage::GlobalOutput::Planes(paths) => paths,
+                _ => return Err(ERROR.into()),
+            };
+        // Observe producer inode identity before the same complete input/output
+        // hashing interval authenticated by the repeated plan/output checks.
+        let producer_directory = stage_dir.canonicalize().map_err(|_| ERROR)?;
+        let producer_outputs = producer_output_identities(&outputs)?;
+        let size = p.width as u64 * p.height as u64 * 8;
+        let mut input_hashes = Vec::new();
+        let mut output_hashes = Vec::new();
+        for channel in 0..3 {
+            check(c)?;
+            input_hashes.push(crate::research_streaming_route::file_hash(
+                &stage_dir.join(format!("source-{channel}.f64le")),
+                size,
+                &mut *c,
+            )?);
+            output_hashes.push(crate::research_streaming_route::file_hash(
+                &outputs[channel],
+                size,
+                &mut *c,
+            )?);
+        }
+        // Detect a manifest/packet substitution while complete hashes were read.
+        if global_stage::plan_stage(stage_dir, token)? != p {
+            return Err(ERROR.into());
+        }
+        global_stage::validate_outputs(stage_dir, token, &p.manifest_sha256, &mut *c)?;
+        if producer_output_identities(&outputs)? != producer_outputs
+            || stage_dir.canonicalize().map_err(|_| ERROR)? != producer_directory
+        {
+            return Err(ERROR.into());
+        }
+        check(c)?;
+        Ok(Self {
+            input_identity: INPUT_IDENTITY.into(),
+            real_factory_evidence: true,
+            epoch: ticket.epoch,
+            generation: ticket.generation,
+            sequence: ticket.sequence,
+            token,
+            plan_sha256: digest(&encode(&p)?),
+            plan: p,
+            native_seal_sha256: digest(&encode(sealed)?),
+            producer_shader_sha256: digest(crate::research_global::LOG_SHADER.as_bytes()),
+            input_plane_sha256: input_hashes.try_into().map_err(|_| ERROR)?,
+            output_plane_sha256: output_hashes.try_into().map_err(|_| ERROR)?,
+            context,
+            producer_directory,
+            producer_outputs,
+        })
+    }
+    pub(crate) fn validate(&self) -> R<()> {
+        self.context.validate()?;
+        if self.input_identity != INPUT_IDENTITY
+            || !plain_absolute(&self.producer_directory)
+            || self
+                .producer_outputs
+                .iter()
+                .enumerate()
+                .any(|(channel, output)| {
+                    output.path
+                        != self
+                            .producer_directory
+                            .join("candidate")
+                            .join(format!("plane-{channel}.f64le"))
+                })
+            || self.plan.operation != "fullExposureLog"
+            || self.plan.token != self.token
+            || [self.epoch, self.generation, self.sequence, self.token]
+                .into_iter()
+                .any(|x| x == 0 || x > i64::MAX as u64)
+            || self.plan_sha256 != digest(&encode(&self.plan)?)
+            || !valid_hash(&self.native_seal_sha256)
+            || self.producer_shader_sha256 != digest(crate::research_global::LOG_SHADER.as_bytes())
+            || self
+                .input_plane_sha256
+                .iter()
+                .chain(&self.output_plane_sha256)
+                .any(|s| !valid_hash(s))
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+    pub(crate) fn identity(&self) -> R<String> {
+        self.validate()?;
+        Ok(digest(&encode(self)?))
+    }
+    /// Must pass before actual GPU owner acquisition. Host-only synthetic
+    /// fixtures remain usable for schema and scheduling tests, never this gate.
+    pub(crate) fn require_actual_factory(&self) -> R<()> {
+        self.validate()?;
+        if !self.real_factory_evidence {
+            return Err("GPU_DIR_DERIVED_SYNTHETIC_HOST_ONLY".into());
+        }
+        Ok(())
+    }
+    pub(crate) fn output_hashes(&self) -> [String; 3] {
+        self.output_plane_sha256.clone()
+    }
+    pub(crate) fn geometry(&self) -> (u32, u32) {
+        (self.plan.width, self.plan.height)
+    }
+    pub(crate) fn context(&self) -> &ExperimentContext {
+        &self.context
+    }
+    pub(crate) fn producer_shader_hash(&self) -> &str {
+        &self.producer_shader_sha256
+    }
+    /// The caller supplies the actual copy identity obtained from its held,
+    /// no-follow source reader. All three producer inodes are checked, not just
+    /// the corresponding color. No producer path is reopened here.
+    pub(crate) fn reject_producer_alias(&self, path: &Path, device: u64, inode: u64) -> R<()> {
+        self.validate()?;
+        if !plain_absolute(path)
+            || path.starts_with(&self.producer_directory)
+            || self
+                .producer_outputs
+                .iter()
+                .any(|output| (device, inode) == (output.device, output.inode))
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+}
