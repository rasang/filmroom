+//! Closed test-only complete-line IIR arithmetic probe, not a rendering route.
+//! Binary64 source and forward/backward storage preserve the original recurrence.
+//! A separate final f32 diagnostic does not establish whole-image f64 parity.
+#![cfg(test)]
+
+use crate::research_grain::soft64;
+use crate::research_spatial::Filter;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub(super) type R<T> = Result<T, String>;
+pub(super) const CAPACITY: u32 = 524_288;
+const MIB: u64 = 1024 * 1024;
+pub(super) const BATCH_BYTES: u64 = 4 * MIB;
+pub(super) const F32_BYTES: u64 = 2 * MIB;
+pub(super) const READBACK_BYTES: u64 = BATCH_BYTES + F32_BYTES;
+// source64 + result64 + output32 + mapped readback64/32 + one upload allowance.
+// Error/map flags, aligned 64-byte uniform and padding fit the final 64 KiB.
+pub(super) const DEVICE_BYTES: u64 =
+    BATCH_BYTES + BATCH_BYTES + F32_BYTES + READBACK_BYTES + BATCH_BYTES + 65_536;
+pub(super) const HOST_BYTES: u64 = 64 * MIB;
+pub(super) const PIPELINE_BYTES: u64 = 8 * MIB;
+pub(super) const BOUND: f64 = 1e15f32 as f64;
+pub(super) const LAYOUT: &str = "source64:storage_read,result64:storage_read_write,output32:storage_read_write,error:atomic_u32,parameters:array_vec4_u32_4";
+const VERSION: u32 = 1;
+const MODE: &str = "binary64_complete_line_then_f32";
+const COEFFICIENT_SOURCE: &str = "original_f32_sigma_Filter_new_f64_bits";
+const ERROR_POLICY: &str = "request_sticky_reject_nonfinite_subnormal_or_per_operation_bound";
+const ZERO_POLICY: &str = "numeric_zero_equivalence_sign_not_guaranteed";
+const ERROR: &str = "GPU_IIR_SOFT64_DESCRIPTOR";
+const DOMAIN_ERROR: &str = "GPU_IIR_SOFT64_NUMERIC_DOMAIN";
+const SHADER_ERROR: &str = "GPU_IIR_SOFT64_SHADER_VERSION";
+const SOFT64_SHA256: &str = "7173a5998b5fc2d22434f12cd07b5b81091e25d4f5ac05c2923fe79947fd5ce1";
+const KERNEL_SHA256: &str = "d809112d549c6981e94f745253e477d6e263d864de0d55a31c6380d678489aa5";
+const KERNEL: &str = include_str!("research_iir_soft64/kernel.wgsl");
+const ORIGINAL_GAUSSIAN: &str = include_str!("../../spektrafilm-math/src/gaussian.rs");
+const ORIGINAL_GAUSSIAN_SHA256: &str =
+    "3ca8a50469aa5f2722d7a3518ba3523d31c5ee36a9fd5c156835c88547480821";
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Plan {
+    version: u32,
+    mode: String,
+    coefficient_source: String,
+    pub(super) sigma_bits: u32,
+    pub(super) coefficient_bits: [u64; 4],
+    pub(super) length: u32,
+    pub(super) lines: u32,
+    sample_capacity: u32,
+    source_scalar_bytes: u32,
+    forward_backward_scalar_bytes: u32,
+    final_scalar_bytes: u32,
+    batch_bytes: u64,
+    device_bytes: u64,
+    host_bytes: u64,
+    pipeline_bytes: u64,
+    pipeline_count: u32,
+    disk_bytes: u64,
+    layout: String,
+    error_policy: String,
+    zero_policy: String,
+    library_sha256: String,
+    kernel_sha256: String,
+    shader_sha256: String,
+}
+impl Plan {
+    pub(super) fn new(sigma: f32, length: u32, lines: u32) -> R<Self> {
+        let plan = Self {
+            version: VERSION,
+            mode: MODE.into(),
+            coefficient_source: COEFFICIENT_SOURCE.into(),
+            sigma_bits: sigma.to_bits(),
+            coefficient_bits: coefficients_for_sigma(sigma)?,
+            length,
+            lines,
+            sample_capacity: CAPACITY,
+            source_scalar_bytes: 8,
+            forward_backward_scalar_bytes: 8,
+            final_scalar_bytes: 4,
+            batch_bytes: BATCH_BYTES,
+            device_bytes: DEVICE_BYTES,
+            host_bytes: HOST_BYTES,
+            pipeline_bytes: PIPELINE_BYTES,
+            pipeline_count: 1,
+            disk_bytes: 0,
+            layout: LAYOUT.into(),
+            error_policy: ERROR_POLICY.into(),
+            zero_policy: ZERO_POLICY.into(),
+            library_sha256: SOFT64_SHA256.into(),
+            kernel_sha256: KERNEL_SHA256.into(),
+            shader_sha256: digest(shader()?.as_bytes()),
+        };
+        plan.validate()?;
+        Ok(plan)
+    }
+    pub(super) fn validate(&self) -> R<()> {
+        let count = self.length.checked_mul(self.lines).ok_or(ERROR)?;
+        if !(1..=40_000).contains(&self.length)
+            || self.lines == 0
+            || count > CAPACITY
+            || self.version != VERSION
+            || self.mode != MODE
+            || self.coefficient_source != COEFFICIENT_SOURCE
+            || self.coefficient_bits != coefficients_for_sigma(f32::from_bits(self.sigma_bits))?
+            || self.sample_capacity != CAPACITY
+            || self.source_scalar_bytes != 8
+            || self.forward_backward_scalar_bytes != 8
+            || self.final_scalar_bytes != 4
+            || self.batch_bytes != BATCH_BYTES
+            || self.device_bytes != DEVICE_BYTES
+            || self.host_bytes != HOST_BYTES
+            || self.pipeline_bytes != PIPELINE_BYTES
+            || self.pipeline_count != 1
+            || self.disk_bytes != 0
+            || self.layout != LAYOUT
+            || self.error_policy != ERROR_POLICY
+            || self.zero_policy != ZERO_POLICY
+            || self.library_sha256 != SOFT64_SHA256
+            || self.kernel_sha256 != KERNEL_SHA256
+            || self.shader_sha256 != digest(shader()?.as_bytes())
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+    /// Exactly four vec4<u32> groups: no uniform-array vec2 stride assumption.
+    pub(super) fn words(&self) -> [u32; 16] {
+        let mut words = [0u32; 16];
+        words[0] = self.length;
+        words[1] = self.lines;
+        words[2] = self.length.checked_mul(self.lines).unwrap_or(0);
+        for (i, bits) in self.coefficient_bits.iter().enumerate() {
+            words[4 + 2 * i] = *bits as u32;
+            words[5 + 2 * i] = (*bits >> 32) as u32;
+        }
+        words
+    }
+    /// Use only after validate, as all execution entry points do.
+    pub(super) fn samples(&self) -> usize {
+        self.length.checked_mul(self.lines).unwrap_or(0) as usize
+    }
+    pub(super) fn coefficients(&self) -> [f64; 4] {
+        self.coefficient_bits.map(f64::from_bits)
+    }
+    pub(super) fn validate_input(&self, source: &[u64]) -> R<()> {
+        self.validate()?;
+        if source.len() != self.samples() || source.iter().any(|&bits| !admitted(bits)) {
+            return Err(DOMAIN_ERROR.into());
+        }
+        Ok(())
+    }
+}
+fn coefficients_for_sigma(sigma: f32) -> R<[u64; 4]> {
+    let Filter::Iir(coefficients) = Filter::new(sigma)? else {
+        return Err("GPU_IIR_SOFT64_IIR_ONLY".into());
+    };
+    if coefficients.iter().any(|value| !admitted(value.to_bits())) {
+        return Err(DOMAIN_ERROR.into());
+    }
+    Ok(coefficients.map(f64::to_bits))
+}
+fn admitted(bits: u64) -> bool {
+    let exponent = (bits >> 52) & 2047;
+    let magnitude = bits & 0x7fff_ffff_ffff_ffff;
+    exponent != 2047 && (exponent != 0 || magnitude == 0) && magnitude <= BOUND.to_bits()
+}
+
+/// The same software operations as the shared grain reference. Bounds apply to
+/// every operand and every operation result, not merely the final recurrence.
+#[derive(Default)]
+struct Guard {
+    failed: bool,
+}
+impl Guard {
+    fn accept(&mut self, value: u64) -> bool {
+        self.failed |= !admitted(value);
+        !self.failed
+    }
+    fn operation(&mut self, a: u64, b: u64, operation: fn(u64, u64) -> u64) -> u64 {
+        if !self.accept(a) || !self.accept(b) {
+            return soft64::NAN;
+        }
+        let result = operation(a, b);
+        if self.accept(result) {
+            result
+        } else {
+            soft64::NAN
+        }
+    }
+    fn mul(&mut self, a: u64, b: u64) -> u64 {
+        self.operation(a, b, soft64::mul)
+    }
+    fn add(&mut self, a: u64, b: u64) -> u64 {
+        self.operation(a, b, soft64::add)
+    }
+    fn step(&mut self, c: [u64; 4], x: u64, s: [u64; 3]) -> u64 {
+        let p0 = self.mul(c[0], x);
+        let p1 = self.mul(c[1], s[0]);
+        let t0 = self.add(p0, p1);
+        let p2 = self.mul(c[2], s[1]);
+        let t1 = self.add(t0, p2);
+        let p3 = self.mul(c[3], s[2]);
+        self.add(t1, p3)
+    }
+}
+
+/// Raw after-backward bits. No f32 cast occurs between directions or lines.
+pub(super) fn cpu_reference(plan: &Plan, source: &[u64]) -> R<Vec<u64>> {
+    plan.validate_input(source)?;
+    let mut result = vec![0; source.len()];
+    let mut guard = Guard::default();
+    for (src, dst) in source
+        .chunks_exact(plan.length as usize)
+        .zip(result.chunks_exact_mut(plan.length as usize))
+    {
+        let mut state = [src[0]; 3];
+        for (input, output) in src.iter().zip(dst.iter_mut()) {
+            let value = guard.step(plan.coefficient_bits, *input, state);
+            if guard.failed {
+                return Err(DOMAIN_ERROR.into());
+            }
+            *output = value;
+            state = [value, state[0], state[1]];
+        }
+        state = [dst[dst.len() - 1]; 3];
+        for output in dst.iter_mut().rev() {
+            let value = guard.step(plan.coefficient_bits, *output, state);
+            if guard.failed {
+                return Err(DOMAIN_ERROR.into());
+            }
+            *output = value;
+            state = [value, state[0], state[1]];
+        }
+    }
+    Ok(result)
+}
+/// Diagnostic conversion only after the complete binary64 recurrence.
+pub(super) fn narrow(source: &[u64]) -> R<Vec<f32>> {
+    source
+        .iter()
+        .map(|&bits| {
+            if !admitted(bits) {
+                return Err(DOMAIN_ERROR.into());
+            }
+            let value = f64::from_bits(bits);
+            if value != 0. && value.abs() < f32::MIN_POSITIVE as f64 {
+                return Err(DOMAIN_ERROR.into());
+            }
+            // sf_scalar intentionally canonicalizes signed zero.
+            let scalar = if value == 0. { 0. } else { value as f32 };
+            if !scalar.is_finite() || scalar.is_subnormal() {
+                return Err(DOMAIN_ERROR.into());
+            }
+            Ok(scalar)
+        })
+        .collect()
+}
+#[cfg(feature = "precision-f64")]
+pub(super) fn original_reference(plan: &Plan, source: &[u64]) -> R<Vec<u64>> {
+    plan.validate_input(source)?;
+    let input: Vec<f64> = source.iter().map(|&bits| f64::from_bits(bits)).collect();
+    let mut output = vec![0f64; input.len()];
+    spektrafilm_math::gaussian::gaussian_blur_rows(
+        &input,
+        &mut output,
+        plan.length as usize,
+        f32::from_bits(plan.sigma_bits),
+    );
+    Ok(output.into_iter().map(f64::to_bits).collect())
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+// Exact pinned source makes this deliberately small brace scanner fail closed
+// before extraction if grammar, comments, declarations or implementation drift.
+fn functions(source: &str) -> R<BTreeMap<String, &str>> {
+    let mut output = BTreeMap::new();
+    let mut cursor = 0;
+    while let Some(relative) = source[cursor..].find("fn ") {
+        let start = cursor + relative;
+        let name_start = start + 3;
+        let name_end = source[name_start..].find('(').ok_or(SHADER_ERROR)? + name_start;
+        let name = &source[name_start..name_end];
+        if name.is_empty() || !name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_') {
+            return Err(SHADER_ERROR.into());
+        }
+        let open = source[name_end..].find('{').ok_or(SHADER_ERROR)? + name_end;
+        let mut depth = 0u32;
+        let mut end = None;
+        for (i, b) in source.bytes().enumerate().skip(open) {
+            if b == b'{' {
+                depth = depth.checked_add(1).ok_or(SHADER_ERROR)?;
+            }
+            if b == b'}' {
+                depth = depth.checked_sub(1).ok_or(SHADER_ERROR)?;
+                if depth == 0 {
+                    end = Some(i + 1);
+                    break;
+                }
+            }
+        }
+        let end = end.ok_or(SHADER_ERROR)?;
+        if output
+            .insert(name.to_owned(), &source[start..end])
+            .is_some()
+        {
+            return Err(SHADER_ERROR.into());
+        }
+        cursor = end;
+    }
+    Ok(output)
+}
+fn identifiers(source: &str) -> BTreeSet<&str> {
+    source
+        .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
+        .filter(|token| !token.is_empty())
+        .collect()
+}
+const HELPER_NAMES: [&str; 16] = [
+    "sf_abs",
+    "sf_add",
+    "sf_addu",
+    "sf_cmpu",
+    "sf_exp",
+    "sf_fail",
+    "sf_jam",
+    "sf_mul",
+    "sf_round",
+    "sf_scalar",
+    "sf_shl",
+    "sf_shr",
+    "sf_sig",
+    "sf_subu",
+    "sf_valid",
+    "sf_zero",
+];
+fn compose(source: &str, kernel: &str) -> R<String> {
+    if digest(source.as_bytes()) != SOFT64_SHA256 || digest(kernel.as_bytes()) != KERNEL_SHA256 {
+        return Err(SHADER_ERROR.into());
+    }
+    let all = functions(source)?;
+    if all.len() != 26 {
+        return Err(SHADER_ERROR.into());
+    }
+    let mut reached: BTreeSet<String> = identifiers(kernel)
+        .into_iter()
+        .filter(|name| all.contains_key(*name))
+        .map(str::to_owned)
+        .collect();
+    loop {
+        let mut next = reached.clone();
+        for name in &reached {
+            for identifier in identifiers(all[name]) {
+                if all.contains_key(identifier) {
+                    next.insert(identifier.to_owned());
+                }
+            }
+        }
+        if next == reached {
+            break;
+        }
+        reached = next;
+    }
+    if reached != HELPER_NAMES.into_iter().map(str::to_owned).collect() {
+        return Err(SHADER_ERROR.into());
+    }
+    let mut output = String::new();
+    for declaration in [
+        "const SF_NAN:vec2<u32>=vec2<u32>(0u,0x7ff80000u);",
+        "var<private> sf_failed:u32;",
+    ] {
+        if source.matches(declaration).count() != 1 {
+            return Err(SHADER_ERROR.into());
+        }
+        let start = source.find(declaration).ok_or(SHADER_ERROR)?;
+        output.push_str(&source[start..start + declaration.len()]);
+        output.push('\n');
+    }
+    for name in reached {
+        output.push_str(all[&name]);
+        output.push('\n');
+    }
+    output.push_str(kernel);
+    Ok(output)
+}
+pub(super) fn shader() -> R<String> {
+    compose(soft64::SHADER, KERNEL)
+}
