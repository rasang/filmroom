+//! CLOSED mixed DIR on authenticated GPU-f32 promoted log words, not original
+//! CPU log64 or a production route. Copy ownership and outer seals stay external.
+#![cfg(test)]
+use super::dir_mixed_calibration::DirMixedCalibration;
+use super::dir_mixed_files::{
+    self, Compute, DerivedMixedGraphPlan, DerivedMixedGraphReceipt, FixtureOrigin, Paths,
+    SourceIdentity,
+};
+use super::{R, digest};
+use serde::Serialize;
+use serde_json::Value;
+use spektrafilm_core::pipeline::Pipeline;
+use std::path::PathBuf;
+
+pub(crate) use super::dir_log_provenance::{
+    DerivedLogEvidence, ExperimentContext, ExperimentResume, pipeline_identities,
+};
+pub(crate) const INPUT_IDENTITY: &str = "gpu-f32-log-promoted";
+pub(crate) const OPERATION: &str = "closed-dir-mixed-from-gpu-f32-log-promoted";
+pub(crate) const LAYOUT: &str = "raw64-dir-derived-gpu-f32-log-mixed-v2";
+pub(crate) const STATUS: &str =
+    "privateDerivedMixedCandidateReadyRequiresOuterSealOrConfirmedHelperDeath";
+const ERROR: &str = "GPU_DIR_DERIVED_MIXED_IDENTITY";
+const CANCELLED: &str = "GPU_DIR_DERIVED_MIXED_CANCELLED";
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err(CANCELLED.into()) } else { Ok(()) }
+}
+fn encode<T: Serialize>(value: &T) -> R<Vec<u8>> {
+    serde_json::to_vec(value).map_err(|_| ERROR.into())
+}
+fn add(a: u64, b: u64) -> R<u64> {
+    a.checked_add(b).ok_or_else(|| ERROR.into())
+}
+
+/// Caller-created copies, not a file owner. Capture never writes, chmods,
+/// hardlinks, renames or deletes inputs. Their additional24N must already be
+/// admitted by the caller, including any retained upstream/comparison data.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct DerivedMixedSources {
+    planes: [SourceIdentity; 3],
+    evidence: DerivedLogEvidence,
+}
+impl DerivedMixedSources {
+    pub(crate) fn capture(
+        paths: [PathBuf; 3],
+        evidence: DerivedLogEvidence,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Self> {
+        evidence.validate()?;
+        check(c)?;
+        let (width, height) = evidence.geometry();
+        let size = u64::from(width)
+            .checked_mul(u64::from(height))
+            .and_then(|n| n.checked_mul(8))
+            .ok_or(ERROR)?;
+        let expected = evidence.output_hashes();
+        let mut planes: Vec<SourceIdentity> = Vec::with_capacity(3);
+        for (channel, path) in paths.iter().enumerate() {
+            let before = SourceIdentity::capture(path, c)?;
+            if before.byte_length != size || before.sha256 != expected[channel] {
+                return Err(ERROR.into());
+            }
+            evidence.reject_producer_alias(path, before.device, before.inode)?;
+            before.verify_f32_promoted(c)?;
+            if SourceIdentity::capture(path, c)? != before
+                || planes.iter().any(|previous| {
+                    previous.path == before.path
+                        || (previous.device, previous.inode) == (before.device, before.inode)
+                })
+            {
+                return Err(ERROR.into());
+            }
+            planes.push(before);
+        }
+        check(c)?;
+        Ok(Self {
+            planes: planes.try_into().map_err(|_| ERROR)?,
+            evidence,
+        })
+    }
+}
+
+/// Fresh graph lower bounds only. Existing session debt and any extra retained
+/// prefix/baseline data must be admitted separately by the real caller ledger.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct DerivedMixedBudget {
+    pub fresh_combined_bytes: u64,
+    pub fixed_bytes: u64,
+    pub driver_bytes: u64,
+    pub pipeline_families: u32,
+    pub device_pool_bytes: u64,
+    pub upload_allowance_bytes: u64,
+    pub graph_total_disk_bytes: u64,
+    pub graph_additional_disk_bytes: u64,
+    pub graph_required_available_after_copy_bytes: u64,
+    pub private_copy_bytes: u64,
+    pub total_with_retained_producer_planes_bytes: u64,
+    pub minimum_required_available_before_copy_bytes: u64,
+    pub cumulative_session_admission_required: bool,
+}
+
+impl DerivedMixedBudget {
+    /// Metadata-only pre-copy admission values, bound to the already verified
+    /// producer geometry. Does not allocate/copy pixels or reserve session debt.
+    pub(crate) fn for_evidence(evidence: &DerivedLogEvidence) -> R<Self> {
+        evidence.validate()?;
+        let (width, height) = evidence.geometry();
+        Self::from_resources(&dir_mixed_files::resources_for_geometry(width, height)?)
+    }
+    fn from_resources(r: &dir_mixed_files::Resources) -> R<Self> {
+        Ok(DerivedMixedBudget {
+            fresh_combined_bytes: r.combined_reservation_bytes,
+            fixed_bytes: add(r.host_bytes, r.helper_bytes)?,
+            driver_bytes: r.driver_and_three_pipelines_bytes,
+            pipeline_families: r.pipeline_families,
+            device_pool_bytes: r.device_pool_bytes,
+            upload_allowance_bytes: r.upload_allowance_bytes,
+            graph_total_disk_bytes: r.total_request_disk_bytes,
+            graph_additional_disk_bytes: r.additional_disk_bytes,
+            graph_required_available_after_copy_bytes: r.required_available_disk_bytes,
+            private_copy_bytes: r.source_disk_bytes,
+            total_with_retained_producer_planes_bytes: add(
+                r.total_request_disk_bytes,
+                r.source_disk_bytes,
+            )?,
+            minimum_required_available_before_copy_bytes: add(
+                r.required_available_disk_bytes,
+                r.source_disk_bytes,
+            )?,
+            cumulative_session_admission_required: true,
+        })
+    }
+}
