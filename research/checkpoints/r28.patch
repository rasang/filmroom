+//! Test-only injection into an exact private scratch directory. No GPU work.
+use super::*;
+use std::sync::{Arc,Mutex,atomic::{AtomicBool,Ordering}};
+#[derive(Clone)]
+struct Config {scratch:PathBuf, planes:[PathBuf;3], used:Arc<AtomicBool>}
+static CONFIG:Mutex<Option<Config>>=Mutex::new(None);
+pub(super) struct Scope {used:Arc<AtomicBool>}
+impl Scope {pub(super) fn used(&self)->bool{self.used.load(Ordering::SeqCst)}}
+impl Drop for Scope {fn drop(&mut self){*CONFIG.lock().unwrap()=None;}}
+pub(super) fn configure(scratch:PathBuf,planes:[PathBuf;3])->Scope{
+ let used=Arc::new(AtomicBool::new(false));let mut guard=CONFIG.lock().unwrap();assert!(guard.is_none());*guard=Some(Config{scratch,planes,used:used.clone()});Scope{used}
+}
+pub(super) fn inject(destinations:&[PathBuf;3],scratch:&Path,w:u32,h:u32)->Result<bool>{
+ let config=CONFIG.lock().unwrap().clone();let Some(config)=config.filter(|v|v.scratch==scratch)else{return Ok(false);};
+ if config.used.swap(true,Ordering::SeqCst){return Err(error("TEST_GRAIN_INJECTION_REPEAT","Only one exact grain boundary allowed"));}
+ for ch in 0..3{if config.planes[ch]==destinations[ch]||fs::metadata(&config.planes[ch]).map_err(io)?.len()!=w as u64*h as u64*8{return Err(error("TEST_GRAIN_SHAPE","Bad injected plane"));}fs::copy(&config.planes[ch],&destinations[ch]).map_err(io)?;}
+ Ok(true)
+}
