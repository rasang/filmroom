+  use std::io::Write;let root=std::path::PathBuf::from(root);assert!(root.is_absolute());std::fs::create_dir(&root).unwrap();
+  let canonical:Vec<u8>=(0..N as usize).flat_map(|i|(0..33).flat_map(move|slot|word(i,slot).to_le_bytes())).collect();
+  for(name,bytes)in [("probe-u32le.bin",canonical),("code-identity.json",serde_json::to_vec_pretty(&serde_json::json!({"aluAbi":super::super::alu_programs::ABI_VERSION,"codeSha256":super::super::alu_programs::CODE_PREFIX_SHA256})).unwrap()),("SUCCESS",b"Original assertions and deferred failure probes passed.\n".to_vec())]{let mut f=OpenOptions::new().write(true).create_new(true).open(root.join(name)).unwrap();f.write_all(&bytes).unwrap();f.sync_all().unwrap();}
+ }
