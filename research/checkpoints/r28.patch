+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct SourceIdentity {
+    pub path: PathBuf,
+    pub byte_length: u64,
+    pub sha256: String,
+    pub device: u64,
+    pub inode: u64,
+}
+impl SourceIdentity {
+    pub(super) fn capture(path: &Path, cancelled: &mut impl FnMut() -> bool) -> R<Self> {
+        check(cancelled)?;
+        let mut source = secure::Source::open(path)?;
+        let byte_length = io(source.file.metadata())?.len();
+        let sha256 = hash_file(&mut source.file, byte_length, cancelled)?;
+        source.unchanged()?;
+        let id = source.identity()?;
+        Ok(Self {
+            path: path.to_owned(),
+            byte_length,
+            sha256,
+            device: id.device,
+            inode: id.inode,
+        })
+    }
+    /// Encoding check only, not producer provenance. Use the same held-fd and
+    /// no-follow identity rules as ordinary source capture, not a raw path reopen.
+    pub(super) fn verify_f32_promoted(&self, c: &mut impl FnMut() -> bool) -> R<()> {
+        check(c)?;
+        let mut source = secure::Source::open(&self.path)?;
+        self.matches(&source)?;
+        let mut buffer = [0u8; HASH_BUFFER_BYTES];
+        let mut remaining = self.byte_length;
+        while remaining > 0 {
+            check(c)?;
+            let n = remaining.min(buffer.len() as u64) as usize;
+            if n % 8 != 0 {
+                return Err(ERROR.into());
+            }
+            io(source.file.read_exact(&mut buffer[..n]))?;
+            for word in buffer[..n].chunks_exact(8) {
+                let bits = u64::from_le_bytes(word.try_into().unwrap());
+                let value = f64::from_bits(bits);
+                if !admitted(bits) || ((value as f32) as f64).to_bits() != bits {
+                    return Err("GPU_DIR_DERIVED_NOT_PROMOTED_F32".into());
+                }
+            }
+            remaining -= n as u64;
+        }
+        self.matches(&source)?;
+        check(c)
+    }
+    fn matches(&self, source: &secure::Source) -> R<()> {
+        source.unchanged()?;
+        let id = source.identity()?;
+        if (self.device, self.inode) != (id.device, id.inode) {
+            return Err(SOURCE_CHANGED.into());
+        }
+        exact_size(&source.file, self.byte_length)
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Sources {
+    pub planes: [SourceIdentity; 3],
+    pub origin: FixtureOrigin,
+}
+impl Sources {
+    pub(super) fn capture(
+        paths: [PathBuf; 3],
+        origin: FixtureOrigin,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Self> {
+        origin.validate()?;
+        let mut captured = Vec::with_capacity(3);
+        for path in paths {
+            captured.push(SourceIdentity::capture(&path, c)?);
+        }
+        let result = Self {
+            planes: captured.try_into().map_err(|_| ERROR)?,
+            origin,
+        };
+        result.validate(result.planes[0].byte_length)?;
+        Ok(result)
+    }
+    fn validate(&self, plane_bytes: u64) -> R<()> {
+        self.validate_for(plane_bytes, InputPolicy::Original)
+    }
+    fn validate_for(&self, plane_bytes: u64, policy: InputPolicy) -> R<()> {
+        self.origin.validate_for(policy)?;
+        for (i, source) in self.planes.iter().enumerate() {
+            plain_absolute(&source.path)?;
+            if source.byte_length != plane_bytes
+                || !valid_digest(&source.sha256)
+                || source.inode == 0
+            {
+                return Err(ERROR.into());
+            }
+            for previous in &self.planes[..i] {
+                if previous.path == source.path
+                    || (previous.device, previous.inode) == (source.device, source.inode)
+                {
+                    return Err(PATH_ERROR.into());
+                }
+            }
+        }
+        Ok(())
+    }
+}
