--- /dev/null
+++ b/native/crates/film-engine/src/derived_chain_full.rs
@@ -0,0 +1,752 @@
+//! Closed, test-only same-frame bridge. No pixel arithmetic, fallback, session
+//! reset, production admission, or external proof deserialization occurs here.
+//! Candidate-ready is not adoption: real execution seal, all-three rename,
+//! confirm_adopted, pregrain, and actual packet observations are separate steps.
+#![cfg(all(test, feature = "gpu-diffusion-research", feature = "precision-f64"))]
+use crate::research_iir_soft64::dir_derived_mixed as derived;
+use crate::{gpu_session as session, gpu_session_contract::StageTicket};
+use serde::Serialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use spektrafilm_core::pipeline::Pipeline;
+use std::{
+    ffi::CString,
+    fs::{self, OpenOptions},
+    io::Read,
+    os::unix::{
+        ffi::OsStrExt,
+        fs::{MetadataExt, OpenOptionsExt},
+    },
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+type R<T> = Result<T, String>;
+const ERROR: &str = "TEST_DERIVED_CHAIN_FULL_IDENTITY";
+const CANCELLED: &str = "TEST_DERIVED_CHAIN_FULL_CANCELLED";
+pub(crate) type TicketProvider = Box<dyn FnMut() -> R<StageTicket> + Send>;
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+enum Step {
+    Configured,
+    Running,
+    Sealed,
+    Confirmed,
+    Pregrain,
+    GrainBefore,
+    GrainAfter,
+    Failed,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+struct FileId {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    bytes: u64,
+    sha256: String,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct DirectoryId {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GrainPhase {
+    Before,
+    After,
+}
+struct State {
+    output: PathBuf,
+    root: DirectoryId,
+    epoch: u64,
+    generation: u64,
+    provider: Option<TicketProvider>,
+    step: Step,
+    failure: Option<String>,
+    width: u32,
+    height: u32,
+    expected: Option<[FileId; 3]>,
+    adopted: Option<[FileId; 3]>,
+    grain: Option<Value>,
+    pregrain_checked: bool,
+    grain_after_checked: bool,
+    record: Value,
+}
+static CONFIG: Mutex<Option<Arc<Mutex<State>>>> = Mutex::new(None);
+pub(crate) struct Scope(Arc<Mutex<State>>);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if let Ok(mut slot) = CONFIG.lock() {
+            if slot.as_ref().is_some_and(|s| Arc::ptr_eq(s, &self.0)) {
+                *slot = None;
+            }
+        }
+        // Never delete caller inputs, candidates, or uncertain GPU resources.
+    }
+}
+pub(crate) struct SealedDerivedStage {
+    pub candidate: derived::DerivedMixedCandidate,
+    pub ticket: StageTicket,
+    pub seal: session::SessionStats,
+    /// Expected hashes until caller's all-three rename and confirm_adopted.
+    pub adopted_sha256: [String; 3],
+}
+fn err<T>() -> R<T> {
+    Err(ERROR.into())
+}
+fn io<T>(r: std::io::Result<T>) -> R<T> {
+    r.map_err(|e| format!("{ERROR}: {e}"))
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err(CANCELLED.into()) } else { Ok(()) }
+}
+fn directory(path: &Path, private: bool) -> R<DirectoryId> {
+    let m = io(fs::symlink_metadata(path))?;
+    if !path.is_absolute()
+        || !m.is_dir()
+        || m.file_type().is_symlink()
+        || io(path.canonicalize())? != path
+        || (private && (m.mode() & 0o777 != 0o700 || m.uid() != unsafe { libc::geteuid() }))
+    {
+        return err();
+    }
+    Ok(DirectoryId {
+        path: path.into(),
+        device: m.dev(),
+        inode: m.ino(),
+    })
+}
+fn hash_file(path: &Path, bytes: u64, c: &mut impl FnMut() -> bool) -> R<FileId> {
+    check(c)?;
+    if !path.is_absolute() || io(path.canonicalize())? != path {
+        return err();
+    }
+    let before = io(fs::symlink_metadata(path))?;
+    if !before.is_file() || before.file_type().is_symlink() || before.len() != bytes {
+        return err();
+    }
+    let mut f = io(OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path))?;
+    let opened = io(f.metadata())?;
+    if (before.dev(), before.ino(), before.len()) != (opened.dev(), opened.ino(), opened.len()) {
+        return err();
+    }
+    let mut remaining = bytes;
+    let mut b = [0u8; 65536];
+    let mut h = Sha256::new();
+    while remaining > 0 {
+        check(c)?;
+        let n = remaining.min(b.len() as u64) as usize;
+        io(f.read_exact(&mut b[..n]))?;
+        h.update(&b[..n]);
+        remaining -= n as u64;
+    }
+    let after = io(fs::symlink_metadata(path))?;
+    let final_fd = io(f.metadata())?;
+    let stamp = |m: &fs::Metadata| {
+        (
+            m.dev(),
+            m.ino(),
+            m.len(),
+            m.mtime(),
+            m.mtime_nsec(),
+            m.ctime(),
+            m.ctime_nsec(),
+        )
+    };
+    if stamp(&before) != stamp(&after) || stamp(&opened) != stamp(&final_fd) {
+        return err();
+    }
+    check(c)?;
+    Ok(FileId {
+        path: path.into(),
+        device: opened.dev(),
+        inode: opened.ino(),
+        bytes,
+        sha256: format!("{:x}", h.finalize()),
+    })
+}
+fn planes(paths: &[PathBuf; 3], bytes: u64, c: &mut impl FnMut() -> bool) -> R<[FileId; 3]> {
+    let mut ids = Vec::new();
+    for p in paths {
+        let f = hash_file(p, bytes, c)?;
+        if ids
+            .iter()
+            .any(|x: &FileId| x.path == f.path || (x.device, x.inode) == (f.device, f.inode))
+        {
+            return err();
+        }
+        ids.push(f);
+    }
+    ids.try_into().map_err(|_| ERROR.into())
+}
+fn available(path: &Path) -> R<u64> {
+    let p = CString::new(path.as_os_str().as_bytes()).map_err(|_| ERROR)?;
+    let mut v = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    if unsafe { libc::statvfs(p.as_ptr(), v.as_mut_ptr()) } != 0 {
+        return err();
+    }
+    let v = unsafe { v.assume_init() };
+    (v.f_bavail as u64)
+        .checked_mul(v.f_frsize as u64)
+        .ok_or_else(|| ERROR.into())
+}
+fn get(output: Option<&Path>) -> R<Option<Arc<Mutex<State>>>> {
+    let slot = CONFIG.lock().map_err(|_| ERROR)?;
+    if let Some(s) = slot.as_ref() {
+        if output.is_none() || s.lock().map_err(|_| ERROR)?.output == output.unwrap() {
+            return Ok(Some(s.clone()));
+        }
+    }
+    Ok(None)
+}
+pub(crate) fn enabled(output: &Path) -> bool {
+    // An uncertain/poisoned scope must not select the ordinary fallback route.
+    match get(Some(output)) {
+        Ok(scope) => scope.is_some(),
+        Err(_) => true,
+    }
+}
+pub(crate) fn configure(
+    output: PathBuf,
+    root: PathBuf,
+    epoch: u64,
+    generation: u64,
+    provider: TicketProvider,
+) -> R<Scope> {
+    if epoch == 0 || generation == 0 || !output.is_absolute() {
+        return err();
+    }
+    let root = directory(&root, true)?;
+    if root
+        .path
+        .join("derived-candidate")
+        .try_exists()
+        .map_err(|_| ERROR)?
+    {
+        return err();
+    }
+    let mut slot = CONFIG.lock().map_err(|_| ERROR)?;
+    if slot.is_some() {
+        return err();
+    }
+    let s = Arc::new(Mutex::new(State {
+        output,
+        root,
+        epoch,
+        generation,
+        provider: Some(provider),
+        step: Step::Configured,
+        failure: None,
+        width: 0,
+        height: 0,
+        expected: None,
+        adopted: None,
+        grain: None,
+        pregrain_checked: false,
+        grain_after_checked: false,
+        record: json!({}),
+    }));
+    *slot = Some(s.clone());
+    Ok(Scope(s))
+}
+fn transition(s: &mut State, from: Step, to: Step) -> R<()> {
+    if s.step != from {
+        return err();
+    }
+    s.step = to;
+    Ok(())
+}
+fn fail(s: &Arc<Mutex<State>>, error: &str) {
+    if let Ok(mut s) = s.lock() {
+        s.step = Step::Failed;
+        s.failure = Some(error.into());
+    }
+}
+fn ticket_value(t: StageTicket) -> Value {
+    json!({"epoch":t.epoch,"generation":t.generation,"sequence":t.sequence})
+}
+fn producer_ticket(proof: &derived::DerivedLogEvidence) -> R<StageTicket> {
+    proof.validate()?;
+    proof.require_actual_factory()?;
+    // Read only already constructor-authenticated metadata, never deserialize a proof.
+    let v = serde_json::to_value(proof).map_err(|_| ERROR)?;
+    Ok(StageTicket {
+        epoch: v["epoch"].as_u64().ok_or(ERROR)?,
+        generation: v["generation"].as_u64().ok_or(ERROR)?,
+        sequence: v["sequence"].as_u64().ok_or(ERROR)?,
+    })
+}
+fn validate_ticket(t: StageTicket, p: StageTicket, epoch: u64, generation: u64) -> R<()> {
+    if t.epoch != epoch
+        || t.generation != generation
+        || p.epoch != epoch
+        || p.generation != generation
+        || p.sequence == 0
+        || t.sequence <= p.sequence
+    {
+        return err();
+    }
+    Ok(())
+}
+pub(crate) fn run_if_enabled(
+    output: &Path,
+    pipe: &Pipeline,
+    pitch: f32,
+    width: u32,
+    height: u32,
+    private_copies: [PathBuf; 3],
+    proof: derived::DerivedLogEvidence,
+    cancelled: &mut impl FnMut() -> bool,
+) -> R<Option<SealedDerivedStage>> {
+    let Some(state) = get(Some(output))? else {
+        return Ok(None);
+    };
+    let setup = (|| -> R<_> {
+        let mut s = state.lock().map_err(|_| ERROR)?;
+        transition(&mut s, Step::Configured, Step::Running)?;
+        Ok((
+            s.root.clone(),
+            s.epoch,
+            s.generation,
+            s.provider.take().ok_or(ERROR)?,
+        ))
+    })();
+    let (root, epoch, generation, mut provider) = match setup {
+        Ok(v) => v,
+        Err(e) => {
+            fail(&state, &e);
+            return Err(e);
+        }
+    };
+    let mut stage_attempted = false;
+    let outcome = (|| -> R<_> {
+        let mut c = || cancelled() || session::is_cancelled(epoch);
+        check(&mut c)?;
+        if directory(&root.path, true)? != root || proof.geometry() != (width, height) {
+            return err();
+        }
+        let producer = producer_ticket(&proof)?;
+        if producer.epoch != epoch || producer.generation != generation {
+            return err();
+        }
+        let source_hashes = proof.output_hashes();
+        let sources = derived::DerivedMixedSources::capture(private_copies, proof, &mut c)?;
+        let plan = derived::DerivedMixedDirImagePlan::from_pipeline(
+            pipe,
+            pitch,
+            width,
+            height,
+            sources,
+            root.path.join("derived-candidate"),
+            65536,
+            524288,
+            524256,
+        )?;
+        let budget = plan.budget()?;
+        if !budget.cumulative_session_admission_required
+            || budget.pipeline_families != 3
+            || available(&root.path)? < budget.graph_required_available_after_copy_bytes
+        {
+            return Err("TEST_DERIVED_CHAIN_FULL_BUDGET".into());
+        }
+        check(&mut c)?;
+        session::validate_fixed_reserve(epoch, budget.fixed_bytes)?;
+        // Provider locks the real Audit. Neither CONFIG nor state is locked here.
+        let ticket = provider()?;
+        validate_ticket(ticket, producer, epoch, generation)?;
+        stage_attempted = true;
+        session::begin_stage(ticket, budget.driver_bytes)?;
+        let candidate = derived::run_gpu(&plan, &mut c)?;
+        check(&mut c)?;
+        // run_gpu has dropped its sole Context and all handles before this fence.
+        let seal = session::complete_stage(ticket)?;
+        check(&mut c)?;
+        if seal.epoch != epoch
+            || candidate.operation != derived::OPERATION
+            || candidate.layout != derived::LAYOUT
+            || candidate.status != derived::STATUS
+            || candidate.input_identity != derived::INPUT_IDENTITY
+            || !candidate.requires_outer_seal_or_confirmed_helper_death
+            || candidate.plan_sha256 != plan.identity()?
+            || candidate.source_proof_sha256 != plan.source_proof_identity()?
+            || candidate.source_sha256 != source_hashes
+            || candidate.paths != plan.output_paths()
+            || (candidate.width, candidate.height) != (width, height)
+            || candidate.candidate_marker
+                != root.path.join("derived-candidate/candidate-ready.json")
+        {
+            return err();
+        }
+        let m = &candidate.metrics_json;
+        let mut dispatches = 0u64;
+        for k in [
+            "pointDispatches",
+            "iirDispatches",
+            "firDispatches",
+            "identityDispatches",
+        ] {
+            dispatches = dispatches
+                .checked_add(m[k].as_u64().ok_or(ERROR)?)
+                .ok_or(ERROR)?;
+        }
+        if dispatches == 0
+            || m["pointDispatches"].as_u64().ok_or(ERROR)? == 0
+            || m["completedReadbacks"].as_u64() != Some(dispatches)
+            || m["transientReleases"].as_u64() != Some(dispatches)
+            || m["hostImageArithmetic"] != false
+        {
+            return err();
+        }
+        let bytes = u64::from(width)
+            .checked_mul(u64::from(height))
+            .and_then(|v| v.checked_mul(8))
+            .ok_or(ERROR)?;
+        let expected = planes(&candidate.paths, bytes, &mut c)?;
+        if expected.each_ref().map(|v| v.sha256.clone()) != candidate.sha256 {
+            return err();
+        }
+        let mm = io(fs::symlink_metadata(&candidate.candidate_marker))?;
+        if mm.len() == 0 || mm.len() > 65536 {
+            return err();
+        }
+        let marker = hash_file(&candidate.candidate_marker, mm.len(), &mut c)?;
+        if directory(&root.path, true)? != root {
+            return err();
+        }
+        check(&mut c)?;
+        let record = json!({"inputIdentity":derived::INPUT_IDENTITY,"operation":derived::OPERATION,"producerTicket":ticket_value(producer),"executionTicket":ticket_value(ticket),"executionSeal":seal,"budget":budget,"candidate":candidate,"candidateMarker":marker,"sameFrame":true,"sessionReset":false,"copyOwnership":"caller; private24N already created and separately admitted","beforeCopyDiskAdmission":"producer capture caller; graph additional admission checked here","candidateIsNotAdoption":true});
+        {
+            let mut s = state.lock().map_err(|_| ERROR)?;
+            transition(&mut s, Step::Running, Step::Sealed)?;
+            s.width = width;
+            s.height = height;
+            s.expected = Some(expected);
+            s.record = record;
+        }
+        Ok(SealedDerivedStage {
+            adopted_sha256: candidate.sha256.clone(),
+            candidate,
+            ticket,
+            seal,
+        })
+    })();
+    match outcome {
+        Ok(v) => Ok(Some(v)),
+        Err(e) => {
+            if stage_attempted {
+                let _ = session::request_stop(epoch);
+            }
+            fail(&state, &e);
+            Err(e)
+        }
+    }
+}
+fn observe(output: Option<&Path>, f: impl FnOnce(&mut State) -> R<()>) -> R<()> {
+    let Some(state) = get(output)? else {
+        return Ok(());
+    };
+    let result = {
+        let mut s = state.lock().map_err(|_| ERROR)?;
+        f(&mut s)
+    };
+    if let Err(ref e) = result {
+        fail(&state, e);
+    }
+    result
+}
+fn verify_adoption(s: &mut State, paths: &[PathBuf; 3], c: &mut impl FnMut() -> bool) -> R<()> {
+    if s.step != Step::Sealed {
+        return err();
+    }
+    let expected = s.expected.as_ref().ok_or(ERROR)?;
+    let actual = planes(paths, expected[0].bytes, c)?;
+    for (a, e) in actual.iter().zip(expected) {
+        // Adoption is a rename, not an unbudgeted retained duplicate. The caller
+        // owns rollback if fewer than all three renames succeeded.
+        if a.path == e.path
+            || a.path.starts_with(&s.root.path)
+            || (a.device, a.inode, a.bytes, &a.sha256) != (e.device, e.inode, e.bytes, &e.sha256)
+            || e.path.try_exists().map_err(|_| ERROR)?
+        {
+            return err();
+        }
+    }
+    transition(s, Step::Sealed, Step::Confirmed)?;
+    s.adopted = Some(actual);
+    Ok(())
+}
+pub(crate) fn confirm_adopted(output: &Path, scratch_paths: &[PathBuf; 3]) -> R<()> {
+    observe(Some(output), |s| {
+        let epoch = s.epoch;
+        verify_adoption(s, scratch_paths, &mut || session::is_cancelled(epoch))
+    })
+}
+fn verify_pregrain(s: &mut State, paths: &[PathBuf; 3], c: &mut impl FnMut() -> bool) -> R<()> {
+    if s.step != Step::Confirmed {
+        return err();
+    }
+    let adopted = s.adopted.as_ref().ok_or(ERROR)?;
+    if &adopted.each_ref().map(|f| f.path.clone()) != paths
+        || planes(paths, adopted[0].bytes, c)? != *adopted
+    {
+        return err();
+    }
+    transition(s, Step::Confirmed, Step::Pregrain)?;
+    s.pregrain_checked = true;
+    Ok(())
+}
+pub(crate) fn check_pregrain(output: &Path, density: &[PathBuf; 3]) -> R<()> {
+    observe(Some(output), |s| {
+        let epoch = s.epoch;
+        verify_pregrain(s, density, &mut || session::is_cancelled(epoch))
+    })
+}
+pub(crate) fn observe_grain_inputs(packet_dir: &Path, phase: GrainPhase) -> R<()> {
+    observe(None, |s| {
+        let wanted = match phase {
+            GrainPhase::Before => Step::Pregrain,
+            GrainPhase::After => Step::GrainBefore,
+        };
+        if s.step != wanted {
+            return err();
+        }
+        let directory = directory(packet_dir, false)?;
+        let token = packet_dir
+            .file_name()
+            .and_then(|s| s.to_str())
+            .and_then(|s| s.strip_prefix("gpu-stage-"))
+            .and_then(|s| s.parse::<u64>().ok())
+            .ok_or(ERROR)?;
+        let plan = crate::research_grain::full_stage::plan_stage(packet_dir, token)?;
+        if plan.operation != "fullFilmGrain"
+            || (plan.width, plan.height) != (s.width, s.height)
+            || plan.rng_mode != crate::research_grain::RngMode::SequentialMt19937
+            || plan.distribution_arithmetic != "guardedSoftwareBinary64"
+        {
+            return err();
+        }
+        let paths = std::array::from_fn(|ch| packet_dir.join(format!("source-{ch}.f64le")));
+        let expected = s.expected.as_ref().ok_or(ERROR)?;
+        let ids = planes(&paths, expected[0].bytes, &mut || {
+            session::is_cancelled(s.epoch)
+        })?;
+        if ids.each_ref().map(|v| &v.sha256) != expected.each_ref().map(|v| &v.sha256) {
+            return err();
+        }
+        let value = json!({"directory":directory.path,"device":directory.device,"inode":directory.inode,"plan":plan,"sources":ids});
+        match phase {
+            GrainPhase::Before => {
+                s.grain = Some(value);
+                transition(s, Step::Pregrain, Step::GrainBefore)
+            }
+            GrainPhase::After => {
+                if s.grain.as_ref() != Some(&value) {
+                    return err();
+                }
+                transition(s, Step::GrainBefore, Step::GrainAfter)?;
+                s.grain_after_checked = true;
+                Ok(())
+            }
+        }
+    })
+}
+pub(crate) fn report(output: &Path) -> R<Value> {
+    let Some(state) = get(Some(output))? else {
+        return err();
+    };
+    let s = state.lock().map_err(|_| ERROR)?;
+    Ok(
+        json!({"step":s.step,"failure":s.failure,"stage":s.record,"adopted":s.adopted,"grainInputs":s.grain,"adoptionCount":u8::from(s.adopted.is_some()),"pregrainCount":u8::from(s.pregrain_checked),"grainBeforeCount":u8::from(s.grain.is_some()),"grainAfterCount":u8::from(s.grain_after_checked),"observationScope":"source linkage only; grain output adoption and final image quality require the parent full-chain gate"}),
+    )
+}
