+//! HOST tests only. Echo/HostCompute are scheduling and byte/oracle tools, never
+//! GPU evidence. Synthetic sources below deliberately carry a test assertion;
+//! they do NOT establish original expose/log provenance. The actual GPU fixture
+//! must separately capture the real precision-f64 original producer.
+use super::*;
+use spektrafilm_core::{params::RuntimeParams, pipeline::Pipeline, profile::load_profile_by_name};
+use std::{
+    cell::Cell,
+    fs::{self, OpenOptions},
+    os::unix::fs::{OpenOptionsExt, PermissionsExt, symlink},
+    rc::Rc,
+    sync::{
+        OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+const PITCH: f32 = 36_000. / 8192.;
+static NEXT: AtomicU64 = AtomicU64::new(0);
+fn pipeline() -> &'static Pipeline {
+    static PIPE: OnceLock<Pipeline> = OnceLock::new();
+    PIPE.get_or_init(|| {
+        let data = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
+        Pipeline::new_with_spectral(
+            load_profile_by_name(&data, "kodak_portra_400").unwrap(),
+            load_profile_by_name(&data, "kodak_portra_endura").unwrap(),
+            RuntimeParams::default(),
+            &data,
+        )
+        .unwrap()
+    })
+}
+fn calibration(width: u32, height: u32) -> DirMixedCalibration {
+    DirMixedCalibration::from_pipeline(pipeline(), PITCH, width, height).unwrap()
+}
+fn origin(calibration: &DirMixedCalibration) -> FixtureOrigin {
+    let synthetic =
+        digest(b"SYNTHETIC HOST SCHEDULE TEST ONLY; NOT AUTHENTIC ORIGINAL LOG CAPTURE");
+    FixtureOrigin {
+        kind: "original-log64-test-fixture-v1".into(), precision: "precision-f64".into(),
+        producer: "spektrafilm_core::stages::filming::expose".into(),
+        fixture_mode: "Synthetic host scheduling fixture; asserted tags do not authenticate original expose execution".into(),
+        build_sha256: synthetic.clone(), producer_sha256: synthetic.clone(), pipeline_sha256: synthetic.clone(),
+        profile_sha256: synthetic.clone(), runtime_params_sha256: synthetic.clone(), fixture_sha256: synthetic,
+        calibration_sha256: digest(&serde_json::to_vec(calibration).unwrap()),
+    }
+}
+fn words(width: u32, height: u32) -> Vec<[u64; 3]> {
+    (0..width * height)
+        .map(|i| {
+            [
+                (-1.25 + (i % 29) as f64 / 128. + f64::EPSILON).to_bits(),
+                (-0.75 + (i % 23) as f64 / 256.).to_bits(),
+                (-0.25 + (i % 19) as f64 / 512.).to_bits(),
+            ]
+        })
+        .collect()
+}
+struct Fixture {
+    root: PathBuf,
+    source_paths: [PathBuf; 3],
+    input: Vec<[u64; 3]>,
+}
+impl Fixture {
+    fn new(width: u32, height: u32) -> Self {
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+            "film-dir-mixed64-host-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&root).unwrap();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+        let source_paths = ["source-r.bin", "source-g.bin", "source-b.bin"].map(|s| root.join(s));
+        let input = words(width, height);
+        for (channel, path) in source_paths.iter().enumerate() {
+            let mut file = OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .mode(0o600)
+                .open(path)
+                .unwrap();
+            for row in &input {
+                file.write_all(&row[channel].to_le_bytes()).unwrap();
+            }
+            file.sync_all().unwrap();
+        }
+        Self {
+            root,
+            source_paths,
+            input,
+        }
+    }
+    fn plan(
+        &self,
+        cal: DirMixedCalibration,
+        point: u32,
+        line: u32,
+        name: &str,
+    ) -> DirMixedImagePlan {
+        let sources =
+            Sources::capture(self.source_paths.clone(), origin(&cal), &mut || false).unwrap();
+        DirMixedImagePlan::new(
+            cal,
+            sources,
+            Paths::new(self.root.join(name)),
+            point,
+            line,
+            line.min(super::super::fir::CAPACITY),
+        )
+        .unwrap()
+    }
+    fn read(&self, receipt: &CandidateReceiptV2) -> Vec<[u64; 3]> {
+        let planes = receipt.candidate64.each_ref().map(|path| {
+            fs::read(path)
+                .unwrap()
+                .chunks_exact(8)
+                .map(|b| u64::from_le_bytes(b.try_into().unwrap()))
+                .collect::<Vec<_>>()
+        });
+        (0..self.input.len())
+            .map(|i| [planes[0][i], planes[1][i], planes[2][i]])
+            .collect()
+    }
+    fn assert_sources(&self) {
+        for (channel, path) in self.source_paths.iter().enumerate() {
+            assert_eq!(
+                fs::read(path).unwrap(),
+                self.input
+                    .iter()
+                    .flat_map(|r| r[channel].to_le_bytes())
+                    .collect::<Vec<_>>()
+            );
+        }
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Behavior {
+    Echo,
+    HostExact,
+}
+#[derive(Clone, Copy)]
+enum Failure {
+    Error,
+    Short,
+    NaN,
+    Status,
+    Cancel,
+}
+#[derive(Debug, PartialEq, Eq)]
+enum Event {
+    Point(Job, usize),
+    Spatial(Family, u32, u32),
+}
+struct HostCompute {
+    behavior: Behavior,
+    calls: usize,
+    poisoned: bool,
+    status_bad: bool,
+    fail: Option<(usize, Failure)>,
+    cancel: Rc<Cell<bool>>,
+    point_jobs: Vec<(Job, usize)>,
+    events: Vec<Event>,
+    spatial_specs: Vec<SpatialLine>,
+    source_mutation: Option<PathBuf>,
+    foreign_output: Option<PathBuf>,
+}
+impl HostCompute {
+    fn new(behavior: Behavior) -> Self {
+        Self {
+            behavior,
+            calls: 0,
+            poisoned: false,
+            status_bad: false,
+            fail: None,
+            cancel: Rc::new(Cell::new(false)),
+            point_jobs: Vec::new(),
+            events: Vec::new(),
+            spatial_specs: Vec::new(),
+            source_mutation: None,
+            foreign_output: None,
+        }
+    }
+    fn output(&mut self, mut words: Vec<u64>) -> R<Vec<u64>> {
+        self.calls += 1;
+        if let Some(path) = self.source_mutation.take() {
+            let mut f = OpenOptions::new().write(true).open(path).unwrap();
+            f.write_all(&7.0f64.to_bits().to_le_bytes()).unwrap();
+            f.sync_all().unwrap();
+        }
+        if let Some(path) = self.foreign_output.take() {
+            fs::remove_file(&path).unwrap();
+            let mut f = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(path)
+                .unwrap();
+            f.write_all(b"foreign-output-preserve").unwrap();
+            f.sync_all().unwrap();
+        }
+        if let Some((at, failure)) = self.fail {
+            if self.calls == at {
+                match failure {
+                    Failure::Error => return Err("HOST_INJECTED_COMPUTE_ERROR".into()),
+                    Failure::Short => {
+                        words.pop();
+                    }
+                    Failure::NaN => words[0] = f64::NAN.to_bits(),
+                    Failure::Status => self.status_bad = true,
+                    Failure::Cancel => self.cancel.set(true),
+                }
+            }
+        }
+        Ok(words)
+    }
+}
+impl Compute for HostCompute {
+    fn check_status(&self) -> R<()> {
+        if self.status_bad {
+            Err("HOST_INJECTED_DEVICE_STATUS".into())
+        } else {
+            Ok(())
+        }
+    }
+    fn point(
+        &mut self,
+        cal: &DirMixedCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        cancel: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        self.point_jobs.push((job, values.len()));
+        self.events.push(Event::Point(job, values.len()));
+        let result = dir_point::evaluate_mixed(cal, job, values, cancel)?;
+        self.output(result)
+    }
+    fn spatial(
+        &mut self,
+        spec: &SpatialLine,
+        values: &[u64],
+        cancel: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        check(cancel)?;
+        spec.validate_input(values)?;
+        self.spatial_specs.push(spec.clone());
+        self.events.push(Event::Spatial(
+            spatial_family(spec),
+            spatial_length(spec),
+            spatial_lines(spec),
+        ));
+        let result = match self.behavior {
+            Behavior::Echo => values.to_vec(),
+            Behavior::HostExact => match spec {
+                SpatialLine::Identity { copy, .. } | SpatialLine::Fir(copy) => {
+                    super::super::fir::cpu_reference(copy, values)?
+                }
+                SpatialLine::Iir(line) => {
+                    let plan = super::super::Plan::new(
+                        f32::from_bits(line.sigma_bits),
+                        line.length,
+                        line.lines,
+                    )?;
+                    super::super::cpu_reference(&plan, values)?
+                }
+            },
+        };
+        self.output(result)
+    }
+    fn poison(&mut self) {
+        self.poisoned = true;
+    }
+}
+fn spatial_sigma(spec: &SpatialLine) -> u32 {
+    match spec {
+        SpatialLine::Identity {
+            original_sigma_bits,
+            ..
+        } => *original_sigma_bits,
+        SpatialLine::Fir(line) => line.sigma_bits,
+        SpatialLine::Iir(line) => line.sigma_bits,
+    }
+}
+fn spatial_length(spec: &SpatialLine) -> u32 {
+    match spec {
+        SpatialLine::Identity { copy, .. } | SpatialLine::Fir(copy) => copy.length,
+        SpatialLine::Iir(line) => line.length,
+    }
+}
+fn spatial_lines(spec: &SpatialLine) -> u32 {
+    match spec {
+        SpatialLine::Identity { copy, .. } | SpatialLine::Fir(copy) => copy.lines,
+        SpatialLine::Iir(line) => line.lines,
+    }
+}
+fn spatial_family(spec: &SpatialLine) -> Family {
+    match spec {
+        SpatialLine::Identity { .. } => Family::Identity,
+        SpatialLine::Fir(_) => Family::Fir,
+        SpatialLine::Iir(_) => Family::Iir,
+    }
+}
+fn execute(p: &DirMixedImagePlan, g: &mut HostCompute) -> R<CandidateReceiptV2> {
+    let cancel = g.cancel.clone();
+    run(p, g, &mut || cancel.get())
+}
+fn assert_failed_clean(f: &Fixture, p: &DirMixedImagePlan, g: &HostCompute) {
+    assert!(g.poisoned);
+    assert!(!p.paths().candidate_marker.exists());
+    assert!(!p.paths().private_directory.exists());
+    f.assert_sources();
+}
+fn echo_expected(cal: &DirMixedCalibration, input: &[[u64; 3]]) -> Vec<[u64; 3]> {
+    let mut result = vec![[0; 3]; input.len()];
+    for channel in 0..3u32 {
+        let c = dir_point::evaluate_mixed(
+            cal,
+            Job {
+                operation: Operation::InitialCorrection,
+                channel,
+                component: 0,
+            },
+            input,
+            &mut || false,
+        )
+        .unwrap();
+        let out = if !cal.dir_active {
+            c
+        } else if f32::from_bits(cal.core_sigma_bits) <= 0. {
+            let rows = input
+                .iter()
+                .zip(&c)
+                .map(|(r, &c)| [r[channel as usize], c, 0])
+                .collect::<Vec<_>>();
+            dir_point::evaluate_mixed(
+                cal,
+                Job {
+                    operation: Operation::RedevelopUnfiltered,
+                    channel,
+                    component: 0,
+                },
+                &rows,
+                &mut || false,
+            )
+            .unwrap()
+        } else {
+            let mut a = vec![0; c.len()];
+            for component in 0..3 {
+                let rows = a
+                    .iter()
+                    .zip(&c)
+                    .map(|(&a, &c)| [a, c, 0])
+                    .collect::<Vec<_>>();
+                a = dir_point::evaluate_mixed(
+                    cal,
+                    Job {
+                        operation: Operation::TailAccumulate,
+                        channel,
+                        component,
+                    },
+                    &rows,
+                    &mut || false,
+                )
+                .unwrap();
+            }
+            let rows = input
+                .iter()
+                .zip(&c)
+                .zip(&a)
+                .map(|((r, &c), &a)| [r[channel as usize], c, a])
+                .collect::<Vec<_>>();
+            dir_point::evaluate_mixed(
+                cal,
+                Job {
+                    operation: Operation::RedevelopFiltered,
+                    channel,
+                    component: 0,
+                },
+                &rows,
+                &mut || false,
+            )
+            .unwrap()
+        };
+        for (row, value) in result.iter_mut().zip(out) {
+            row[channel as usize] = value;
+        }
+    }
+    result
+}
