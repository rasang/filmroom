+struct Fixture {
+    root: std::path::PathBuf,
+    plan: Soft64ImagePlan,
+    values: Vec<u64>,
+    sigma_bits: u32,
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+impl Fixture {
+    fn new(width: u32, height: u32, sigma_bits: u32, capacity: u32, values: Vec<u64>) -> Self {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+            "filmroom-iir64-image-{}-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir(&root).unwrap();
+        let source = root.join("source64.bin");
+        let bytes: Vec<_> = values.iter().flat_map(|x| x.to_le_bytes()).collect();
+        std::fs::write(&source, bytes).unwrap();
+        let identity = image_files::SourceIdentity::inspect(&source, &mut || false).unwrap();
+        let paths = image_files::ImagePaths::new(root.join("private-candidate"));
+        let plan =
+            Soft64ImagePlan::new(width, height, sigma_bits, capacity, identity, paths).unwrap();
+        Self {
+            root,
+            plan,
+            values,
+            sigma_bits,
+        }
+    }
+    fn read_words(path: &std::path::Path) -> Vec<u64> {
+        let bytes = std::fs::read(path).unwrap();
+        assert_eq!(bytes.len() % 8, 0);
+        bytes
+            .chunks_exact(8)
+            .map(|x| u64::from_le_bytes(x.try_into().unwrap()))
+            .collect()
+    }
+    fn verify(&self, receipt: &CandidateReceipt) -> Vec<u64> {
+        assert!(receipt.requires_outer_seal_or_confirmed_helper_death);
+        assert_eq!(receipt.encoding, "binary64le");
+        assert_eq!(receipt.source_sha256_before, self.plan.source().sha256);
+        assert_eq!(receipt.source_sha256_after, receipt.source_sha256_before);
+        assert_eq!(receipt.plane_byte_length, self.plan.samples() * 8);
+        assert_eq!(receipt.candidate64, self.plan.paths().candidate64);
+        let marker: CandidateReceipt =
+            serde_json::from_slice(&std::fs::read(&receipt.candidate_marker).unwrap()).unwrap();
+        assert_eq!(marker, *receipt);
+        let actual = Self::read_words(&receipt.candidate64);
+        let expected = original_2d(
+            self.plan.width(),
+            self.plan.height(),
+            self.sigma_bits,
+            &self.values,
+        );
+        assert_words_match(&expected, &actual);
+        assert_eq!(
+            digest(&std::fs::read(&receipt.candidate64).unwrap()),
+            receipt.candidate_sha256
+        );
+        let horizontal = Self::read_words(&self.plan.paths().horizontal64);
+        let source: Vec<_> = self
+            .values
+            .iter()
+            .map(|x| f64::from_bits(*x) as spektrafilm_math::precision::Scalar)
+            .collect();
+        let mut reference = vec![0. as spektrafilm_math::precision::Scalar; source.len()];
+        spektrafilm_math::gaussian::gaussian_blur_rows(
+            &source,
+            &mut reference,
+            self.plan.width() as usize,
+            f32::from_bits(self.sigma_bits),
+        );
+        assert_words_match(
+            &reference
+                .into_iter()
+                .map(|x| (x as f64).to_bits())
+                .collect::<Vec<_>>(),
+            &horizontal,
+        );
+        assert_eq!(
+            digest(&std::fs::read(&self.plan.paths().horizontal64).unwrap()),
+            receipt.horizontal_sha256
+        );
+        assert_eq!(Self::read_words(&self.plan.source().path), self.values);
+        actual
+    }
+    fn assert_no_candidate(&self) {
+        assert!(!self.plan.paths().private_directory.exists());
+        assert_eq!(Self::read_words(&self.plan.source().path), self.values);
+    }
+}
