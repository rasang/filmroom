+fn failures_cancellation_and_source_digest_never_leave_a_marker() {
+    // Small nonsquare geometry exercises every checkpoint and both multibatch
+    // axes without turning exhaustive cancellation into a syscall benchmark.
+    let fixture = Fixture::new(&pattern(3, 5));
+    let p = fixture.plan(3, 5, 5, "private");
+    let original = fs::read(&fixture.source).unwrap();
+    assert!(run(&p, &mut FailCompute, &mut || false).is_err());
+    assert!(!p.paths().private_directory.exists());
+    for failure in [InjectFailure::CandidateWrite, InjectFailure::BeforeMarker] {
+        assert!(run_inner(&p, &mut Echo { seen: vec![] }, &mut || false, Some(failure)).is_err());
+        assert!(!p.paths().private_directory.exists());
+    }
+    let calls = Cell::new(0usize);
+    let mut echo = Echo { seen: vec![] };
+    run(&p, &mut echo, &mut || {
+        calls.set(calls.get() + 1);
+        false
+    })
+    .unwrap();
+    fs::remove_dir_all(&p.paths().private_directory).unwrap();
+    // Every cancellation check, including after reads/writes, after execute,
+    // and immediately before/after marker close, is tested independently.
+    for stop in 0..calls.get() {
+        let mut count = 0;
+        let result = run(&p, &mut Echo { seen: vec![] }, &mut || {
+            let cancel = count == stop;
+            count += 1;
+            cancel
+        });
+        assert!(result.is_err(), "check {stop} unexpectedly succeeded");
+        assert!(
+            !p.paths().private_directory.exists(),
+            "check {stop} left private output"
+        );
+        assert_eq!(fs::read(&fixture.source).unwrap(), original);
+    }
+    let mut bad = p.clone();
+    bad.0.source.sha256 = "0".repeat(64);
+    assert!(run(&bad, &mut Echo { seen: vec![] }, &mut || false).is_err());
+    assert!(!p.paths().private_directory.exists());
+    OpenOptions::new()
+        .write(true)
+        .open(&fixture.source)
+        .unwrap()
+        .set_len(8)
+        .unwrap();
+    assert!(run(&p, &mut Echo { seen: vec![] }, &mut || false).is_err());
+    assert!(!p.paths().private_directory.exists());
