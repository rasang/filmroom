+    values
+}
+fn pattern(length: u32, lines: u32) -> Vec<u64> {
+    (0..length * lines)
+        .map(|i| {
+            let value = match i % 13 {
+                0 => 0.,
+                1 => -0.,
+                2 => 1. + f64::EPSILON,
+                3 => -1. - 3. * f64::EPSILON,
+                4 => 1e12 + i as f64 / 32.,
+                5 => -1e11 - i as f64 / 64.,
+                6 => 1e-200,
+                7 => -1e-200,
+                8 => 0.5,
+                9 => -0.25,
+                _ => (i as f64 - 37.) / 128.,
+            };
+            value.to_bits()
+        })
+        .collect()
+}
