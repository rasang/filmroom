+#[test]
+#[ignore = "One process: real raw64 two-axis files, forced complete-line batches, original full 2D f64 oracle and warm Context reuse"]
+fn actual_raw64_small_images_match_original_two_axes_and_reuse() {
+    use crate::gpu_session as session;
+    let epoch = 95401;
+    session::activate(epoch, COMBINED_BYTES, FIXED_BYTES, 1).unwrap();
+    for generation in 1..=2 {
+        let ticket = begin(epoch, generation);
+        let mut gpu = RawGpu::new(&mut || false).unwrap();
+        for sigma in [0x41a757a2, 0x428aae74, 0x42fbfc66] {
+            for (width, height) in [(1, 1), (1, 17), (17, 1), (2, 3), (17, 31)] {
+                for kind in 0..3 {
+                    let values = image_values(width, height, kind);
+                    let small =
+                        Fixture::new(width, height, sigma, width.max(height), values.clone());
+                    let receipt = gpu.run_files(&small.plan, &mut || false).unwrap();
+                    let actual = small.verify(&receipt);
+                    if width == 17 && height == 31 && kind == 2 {
+                        assert!(receipt.row_batches > 1 && receipt.column_batches > 1);
+                        let bulk = Fixture::new(width, height, sigma, CAPACITY, values);
+                        let large_receipt = gpu.run_files(&bulk.plan, &mut || false).unwrap();
+                        assert_eq!(
+                            actual,
+                            bulk.verify(&large_receipt),
+                            "complete-line grouping must not change any word"
+                        );
+                        let h = Fixture::read_words(&small.plan.paths().horizontal64);
+                        assert!(
+                            h.iter()
+                                .any(|x| (f64::from_bits(*x) as f32 as f64).to_bits() != *x),
+                            "horizontal raw bits must not be a promoted f32 spool"
+                        );
+                    }
+                }
+            }
+        }
+        assert!(
+            session::complete_stage(ticket).is_err(),
+            "candidate-ready cannot seal a live owner"
+        );
+        assert!(
+            gpu.metrics.dispatches > 2 && gpu.metrics.completed_readbacks == gpu.metrics.dispatches
+        );
+        drop(gpu);
+        let stats = session::complete_stage(ticket).unwrap();
+        assert_eq!(stats.pool_bytes, RESIDENT_BYTES);
+        assert!(stats.charged_bytes <= COMBINED_BYTES);
+        if generation == 2 {
+            assert!(stats.pipeline_hits > 0 && stats.buffer_hits > 0);
+        }
+        session::finish_frame(epoch, generation).unwrap();
+    }
+}
