+pub fn compose(mut source:String)->R<String>{
+ for (old,new) in [(OLD_STRUCT,NEW_STRUCT),(OLD_PREPARE,NEW_PREPARE),(OLD_STORE,NEW_STORE),(OLD_LOAD,NEW_LOAD)]{
+  if source.matches(old).count()!=1{return Err("GPU_GRAIN_POISSON_CACHE_VERSION".into());}
+  source=source.replacen(old,new,1);
+ }
+ source.push_str(CACHE_HELPER);Ok(source)
+}
