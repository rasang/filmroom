+    for value in [f32::from_bits(1), f32::MIN_POSITIVE, 0.25, 1., 3.5] {
+        let mut changed = good.clone();
+        changed.actual_ae_scale_promoted_bits = Some((value as f64).to_bits());
+        changed.exposure_compensation_scale_promoted_bits = (value as f64).to_bits();
+        changed.validate().unwrap();
+    }
+    let mut no_ae = good;
