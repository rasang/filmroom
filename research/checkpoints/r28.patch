+/// No external Deserialize. Evidence and graph construction cannot be bypassed
+/// by a JSON tag or promoted-bit condition. Real mixed calibration only.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct DerivedMixedDirImagePlan {
+    graph: DerivedMixedGraphPlan,
+    evidence: DerivedLogEvidence,
+}
+impl DerivedMixedDirImagePlan {
+    pub(crate) fn from_pipeline(
+        pipe: &Pipeline,
+        actual_pitch: f32,
+        width: u32,
+        height: u32,
+        sources: DerivedMixedSources,
+        private_output_directory: PathBuf,
+        point_capacity: u32,
+        iir_line_capacity: u32,
+        fir_line_capacity: u32,
+    ) -> R<Self> {
+        sources.evidence.validate()?;
+        if sources.evidence.geometry() != (width, height) {
+            return Err(ERROR.into());
+        }
+        let calibration = DirMixedCalibration::from_pipeline(pipe, actual_pitch, width, height)?;
+        let (profile, parameters) = pipeline_identities(pipe)?;
+        let context = sources.evidence.context();
+        if context.profile_sha256 != profile || context.params_sha256 != parameters {
+            return Err(ERROR.into());
+        }
+        let origin = FixtureOrigin {
+            kind: INPUT_IDENTITY.into(),
+            precision: "gpu-f32-promoted-to-binary64".into(),
+            producer: "verified-native-fullExposureLog".into(),
+            fixture_mode: "Closed derived-mixed experiment. Authenticated GPU log words are preserved by original raw64 DIR arithmetic; this is not original CPU log64. The original-log64 entry remains separate.".into(),
+            build_sha256: context.build_sha256.clone(),
+            producer_sha256: sources.evidence.producer_shader_hash().to_owned(),
+            pipeline_sha256: sources.evidence.identity()?,
+            profile_sha256: context.profile_sha256.clone(),
+            runtime_params_sha256: context.params_sha256.clone(),
+            fixture_sha256: context.fixture_sha256.clone(),
+            calibration_sha256: digest(&encode(&calibration)?),
+        };
+        let graph = DerivedMixedGraphPlan::new(
+            calibration,
+            dir_mixed_files::Sources {
+                planes: sources.planes,
+                origin,
+            },
+            Paths::new(private_output_directory),
+            point_capacity,
+            iir_line_capacity,
+            fir_line_capacity,
+        )?;
+        let result = Self {
+            graph,
+            evidence: sources.evidence,
+        };
+        result.validate()?;
+        Ok(result)
+    }
+    fn validate(&self) -> R<()> {
+        self.graph.validate()?;
+        self.evidence.validate()?;
+        let sources = self.graph.sources();
+        let context = self.evidence.context();
+        if sources.origin.pipeline_sha256 != self.evidence.identity()?
+            || sources.origin.producer_sha256 != self.evidence.producer_shader_hash()
+            || sources.origin.build_sha256 != context.build_sha256
+            || sources.origin.profile_sha256 != context.profile_sha256
+            || sources.origin.runtime_params_sha256 != context.params_sha256
+            || sources.origin.fixture_sha256 != context.fixture_sha256
+            || sources.planes.each_ref().map(|p| p.sha256.clone()) != self.evidence.output_hashes()
+            || (
+                self.graph.calibration().width,
+                self.graph.calibration().height,
+            ) != self.evidence.geometry()
+        {
+            return Err(ERROR.into());
+        }
+        for source in &sources.planes {
+            self.evidence
+                .reject_producer_alias(&source.path, source.device, source.inode)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn identity(&self) -> R<String> {
+        self.validate()?;
+        self.graph.identity()
+    }
+    pub(crate) fn source_proof_identity(&self) -> R<String> {
+        self.validate()?;
+        self.evidence.identity()
+    }
+    pub(crate) fn budget(&self) -> R<DerivedMixedBudget> {
+        self.validate()?;
+        let r = self.graph.resources();
+        DerivedMixedBudget::from_resources(r)
+    }
+    pub(crate) fn source_paths(&self) -> [PathBuf; 3] {
+        self.graph
+            .sources()
+            .planes
+            .each_ref()
+            .map(|p| p.path.clone())
+    }
+    pub(crate) fn output_paths(&self) -> [PathBuf; 3] {
+        self.graph.paths().candidate64.clone()
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct DerivedMixedCandidate {
+    pub operation: String,
+    pub layout: String,
+    pub status: String,
+    pub input_identity: String,
+    pub plan_sha256: String,
+    pub source_proof_sha256: String,
+    pub source_sha256: [String; 3],
+    pub paths: [PathBuf; 3],
+    pub sha256: [String; 3],
+    pub candidate_marker: PathBuf,
+    pub width: u32,
+    pub height: u32,
+    pub requires_outer_seal_or_confirmed_helper_death: bool,
+    pub metrics_json: Value,
+}
+fn run_with_compute<G: Compute>(
+    p: &DerivedMixedDirImagePlan,
+    gpu: &mut G,
+    c: &mut impl FnMut() -> bool,
+) -> R<DerivedMixedGraphReceipt> {
+    let result = (|| -> R<DerivedMixedGraphReceipt> {
+        p.validate()?;
+        check(c)?;
+        for source in &p.graph.sources().planes {
+            let before = SourceIdentity::capture(&source.path, c)?;
+            if &before != source {
+                return Err(ERROR.into());
+            }
+            p.evidence
+                .reject_producer_alias(&source.path, source.device, source.inode)?;
+            before.verify_f32_promoted(c)?;
+            if SourceIdentity::capture(&source.path, c)? != before {
+                return Err(ERROR.into());
+            }
+        }
+        dir_mixed_files::run_derived_mixed_graph(&p.graph, gpu, c)
+    })();
+    if result.is_err() {
+        gpu.poison();
+    }
+    result
+}
+#[cfg(feature = "gpu-diffusion-research")]
+pub(crate) fn run_gpu(
+    p: &DerivedMixedDirImagePlan,
+    c: &mut impl FnMut() -> bool,
+) -> R<DerivedMixedCandidate> {
+    p.validate()?;
+    check(c)?;
+    p.evidence.require_actual_factory()?;
+    // The caller already sealed/dropped the producer and began a real stage.
+    // Context admission preserves all existing epoch debt. No fake empty pool,
+    // fresh-epoch assertion, prepaid grant or stage seal is performed here.
+    let mut gpu = super::dir_mixed_gpu::MixedDirGpu::new(c)?;
+    let receipt = run_with_compute(p, &mut gpu, c)?;
+    let parts = receipt.into_candidate_parts(&p.graph)?;
+    let metrics = serde_json::json!({
+        "pointDispatches":gpu.metrics.point_dispatches,
+        "iirDispatches":gpu.metrics.iir_dispatches,
+        "firDispatches":gpu.metrics.fir_dispatches,
+        "identityDispatches":gpu.metrics.identity_dispatches,
+        "completedReadbacks":gpu.metrics.completed_readbacks,
+        "transientReleases":gpu.metrics.transient_releases,
+        "uploadBytes":gpu.metrics.upload_bytes,"readbackBytes":gpu.metrics.readback_bytes,
+        "uploadMs":gpu.metrics.upload_ms,"waitReadbackMs":gpu.metrics.wait_readback_ms,
+        "adapter":gpu.metrics.adapter.clone(),"hostImageArithmetic":false,
+        "freshBudgetIsNotCumulativeSessionAdmission":true
+    });
+    // Owner and all its handles must drop BEFORE the caller's complete_stage.
+    drop(gpu);
+    Ok(DerivedMixedCandidate {
+        operation: parts.operation,
+        layout: parts.layout,
+        status: parts.status,
+        input_identity: INPUT_IDENTITY.into(),
+        plan_sha256: parts.plan_sha256,
+        source_proof_sha256: p.evidence.identity()?,
+        source_sha256: parts.source_sha256_before,
+        paths: parts.candidate64,
+        sha256: parts.candidate_sha256,
+        candidate_marker: parts.candidate_marker,
+        width: parts.width,
+        height: parts.height,
+        requires_outer_seal_or_confirmed_helper_death: parts
+            .requires_outer_seal_or_confirmed_helper_death,
+        metrics_json: metrics,
+    })
+}
