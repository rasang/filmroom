+// Test-only, identical hook in two separately built ABI versions. No extra GPU
+// snapshot/readback commands and no changes to scientific calls or diagnostics.
+#[derive(serde::Serialize)]
+#[serde(rename_all="camelCase")]
+struct WarmObservation{
+ summary:serde_json::Value,
+ run_wall_ms:f64,
+ input_sha256:[String;3],
+ output_sha256:[String;3],
+ max_abs:f64,
+ rms:f64,
+}
+fn warm_sha(bytes:&[u8])->String{use sha2::{Digest,Sha256};format!("{:x}",Sha256::digest(bytes))}
+fn warm_write(root:&Path,name:&str,value:&serde_json::Value){
+ let mut file=OpenOptions::new().write(true).create_new(true).open(root.join(name)).unwrap();
+ let bytes=serde_json::to_vec_pretty(value).unwrap();file.write_all(&bytes).unwrap();file.sync_all().unwrap();
+}
+#[test]
+#[cfg(feature="precision-f64")]
+#[ignore="actual full grain65x65 MT: one cold plus three genuine session-warm frames; fresh process only"]
+fn actual_grain_65x65_session_cold_and_three_warm(){
+ use crate::{gpu_session as session,gpu_session_contract::StageTicket};
