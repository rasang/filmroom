+use super::*;
+use spektrafilm_core::{params::RuntimeParams, profile::load_profile_by_name};
+use std::{path::Path, sync::OnceLock};
+
+const FIXTURE_PITCH: f32 = 36.0 * 1000.0 / 8192.0;
+
+fn pipeline(positive: bool) -> &'static Pipeline {
+    static NEGATIVE: OnceLock<Pipeline> = OnceLock::new();
+    static POSITIVE: OnceLock<Pipeline> = OnceLock::new();
+    let slot = if positive { &POSITIVE } else { &NEGATIVE };
+    slot.get_or_init(|| {
+        let data = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
+        Pipeline::new_with_spectral(
+            load_profile_by_name(
+                &data,
+                if positive {
+                    "kodak_ektachrome_100"
+                } else {
+                    "kodak_portra_400"
+                },
+            )
+            .unwrap(),
+            load_profile_by_name(&data, "kodak_portra_endura").unwrap(),
+            RuntimeParams::default(),
+            &data,
+        )
+        .unwrap()
+    })
+}
+fn fixture() -> DirCalibration {
+    DirCalibration::from_pipeline(pipeline(false), FIXTURE_PITCH, 23, 17).unwrap()
+}
+fn curve_matches(actual: &CurveWords, original: &crate::research_dir::Curve) {
+    assert_eq!(
+        actual.axis,
+        original
+            .axis
+            .iter()
+            .map(|x| x.to_bits())
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        actual.inverse_dx,
+        original
+            .inverse_dx
+            .iter()
+            .map(|x| x.to_bits())
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        actual.values,
+        original
+            .values
+            .iter()
+            .map(|row| row.map(f64::to_bits))
+            .collect::<Vec<_>>()
+    );
+}
+// Independent transcription of the frozen native gaussian.rs coefficient order.
+// This is only a coefficient check, never a substituted image oracle.
+fn original_coefficients(sigma: f32) -> [u64; 4] {
+    let q = 0.98711 * sigma as f64 - 0.96330;
+    let q2 = q * q;
+    let q3 = q2 * q;
+    let b0 = 1.57825 + 2.44413 * q + 1.4281 * q2 + 0.422205 * q3;
+    let b1 = (2.44413 * q + 2.85619 * q2 + 1.26661 * q3) / b0;
+    let b2 = -(1.4281 * q2 + 1.26661 * q3) / b0;
+    let b3 = (0.422205 * q3) / b0;
+    [1. - b1 - b2 - b3, b1, b2, b3].map(f64::to_bits)
+}
