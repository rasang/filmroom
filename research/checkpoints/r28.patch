+#[ignore = "Fresh process: last input infinity independently rejects entire dispatch"]
+fn actual_fir_late_infinity_rejects_and_poison() {
+    reject_packet(96105, |p| {
+        *p.words.last_mut().unwrap() = f64::INFINITY.to_bits()
+    });
+}
+#[test]
+#[ignore = "Fresh process: last input subnormal independently rejects entire dispatch"]
+fn actual_fir_late_subnormal_rejects_and_poison() {
