+fn zero_wrappers_preserve_bits_and_reject_zero_denominator_first(){
+    for a in [0f64,-0f64] {for b in [0f64,-0f64] {
+        assert_eq!((V::c(a)+V::c(b)).0,(a+b).to_bits());
+        assert_eq!((V::c(a)-V::c(b)).0,(a-b).to_bits());
+        assert_eq!((V::c(a)*V::c(b)).0,(a*b).to_bits());
+        assert!(!admitted((V::c(a)/V::c(b)).0));
+    }
+    for b in [-3f64,3f64] {
+        assert_eq!((V::c(a)/V::c(b)).0,(a/b).to_bits());
+        assert_eq!((V::c(a)*V::c(b)).0,(a*b).to_bits());
+    }}
+    for bad in [f64::NAN,f64::INFINITY,f64::from_bits(1),BOUND*2.] {
+        assert!(!admitted((V::c(0.)/V::c(bad)).0));
