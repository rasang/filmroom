+//! Actual GPU graph fixtures. Original expose/develop calls below are ONLY
+//! input creation and independent oracle; run() itself never uses HostCompute.
+//! Every ignored case requires its own process because session faults are sticky.
+use super::super::dir_files::{
+    self, CandidateReceipt, DirImagePlan, Fault, FixtureOrigin, Paths, Sources,
+};
+use super::super::dir_gpu::AfterUnmapFault;
+use super::super::dir_point::{Operation, tests as oracle};
+use super::super::{admitted, digest};
+use super::*;
+use crate::{gpu_session as session, gpu_session_contract::StageTicket};
+use sha2::{Digest, Sha256};
+use spektrafilm_core::pipeline::Pipeline;
+use spektrafilm_gpu::cpu_backend::CpuBackend;
+use spektrafilm_math::{
+    image::ImageBuf,
+    precision::{from_f64, to_f64},
+};
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{Read, Write},
+    os::unix::fs::{OpenOptionsExt, PermissionsExt},
+    path::{Path, PathBuf},
+    sync::{
+        Arc, OnceLock,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+};
+
+const PITCH: f32 = 36_000. / 8192.;
+const MIB: u64 = 1024 * 1024;
+const COMBINED: u64 = 228 * MIB + 65_536;
+const FIXED: u64 = 128 * MIB;
+const DRIVER: u64 = 80 * MIB;
+const POOL: u64 = 12 * MIB + 72;
+static NEXT: AtomicU64 = AtomicU64::new(0);
+fn file_digest(path: &Path) -> String {
+    let mut file = File::open(path).unwrap();
+    let mut h = Sha256::new();
+    let mut buffer = [0u8; 65_536];
+    loop {
+        let n = file.read(&mut buffer).unwrap();
+        if n == 0 {
+            break;
+        }
+        h.update(&buffer[..n]);
+    }
+    format!("{:x}", h.finalize())
+}
+fn binary_digest() -> String {
+    static HASH: OnceLock<String> = OnceLock::new();
+    HASH.get_or_init(|| file_digest(&std::env::current_exe().unwrap()))
+        .clone()
+}
+fn begin(epoch: u64, generation: u64) -> StageTicket {
+    let ticket = StageTicket {
+        epoch,
+        generation,
+        sequence: generation,
+    };
+    session::begin_frame(epoch, generation).unwrap();
+    session::begin_stage(ticket, DRIVER).unwrap();
+    ticket
+}
+fn activate(epoch: u64) {
+    session::activate(epoch, COMBINED, FIXED, 2).unwrap();
+}
+fn finish(ticket: StageTicket, gpu: DirGpu) -> session::SessionStats {
+    assert_eq!(
+        gpu.metrics.completed_readbacks,
+        gpu.metrics.point_dispatches + gpu.metrics.raw_dispatches
+    );
+    assert_eq!(
+        gpu.metrics.completed_readbacks,
+        gpu.metrics.transient_releases
+    );
+    assert!(
+        session::complete_stage(ticket).is_err(),
+        "candidate marker does not seal a live owner"
+    );
+    eprintln!("DIR64 complete graph metrics: {:?}", gpu.metrics);
+    drop(gpu);
+    let stats = session::complete_stage(ticket).unwrap();
+    assert_eq!(stats.pipeline_slots, 2);
+    assert_eq!(stats.pool_bytes, POOL);
+    assert_eq!(stats.charged_bytes, FIXED + DRIVER + POOL);
+    session::finish_frame(ticket.epoch, ticket.generation).unwrap();
+    stats
+}
+
+struct Fixture {
+    root: PathBuf,
+    sources: [PathBuf; 3],
+    source_bytes: [Vec<u8>; 3],
+    expected: Vec<[u64; 3]>,
+    cal: DirCalibration,
+    origin: FixtureOrigin,
+}
+impl Fixture {
+    fn new(mut pipe: Pipeline, width: u32, height: u32) -> Self {
+        assert!(cfg!(feature = "precision-f64"));
+        pipe.params.camera.pixel_size_um_override = Some(PITCH);
+        pipe.params.film_render.grain.active = false;
+        let cal = DirCalibration::from_pipeline(&pipe, PITCH, width, height).unwrap();
+        let rgb = ImageBuf::from_data(
+            width,
+            height,
+            (0..width as usize * height as usize)
+                .flat_map(|i| {
+                    // Intentionally original f64 synthetic RGB, not an f32-derived log.
+                    [
+                        0.01 + (i % 29) as f64 / 37. + f64::EPSILON,
+                        0.02 + (i % 31) as f64 / 43.,
+                        0.03 + (i % 37) as f64 / 47.,
+                    ]
+                    .map(from_f64)
+                })
+                .collect(),
+        );
+        let fixture_bytes: Vec<u8> = rgb
+            .data
+            .iter()
+            .flat_map(|&x| to_f64(x).to_bits().to_le_bytes())
+            .collect();
+        // Explicit None/None selects the ORIGINAL simplified exposure branch.
+        // This is not evidence of the default spectral exposure path or GPU optics.
+        let log = spektrafilm_core::stages::filming::expose(
+            &rgb,
+            &pipe.film,
+            &pipe.params,
+            &CpuBackend,
+            None,
+            None,
+            &[],
+            1.,
+        );
+        let source_bytes: [Vec<u8>; 3] = std::array::from_fn(|channel| {
+            log.data
+                .chunks_exact(3)
+                .flat_map(|r| to_f64(r[channel]).to_bits().to_le_bytes())
+                .collect()
+        });
+        assert!(log.data.iter().all(|&x| admitted(to_f64(x).to_bits())));
+        // Same ImageBuf as captured into the source files, not a promoted reload.
+        let expected =
+            spektrafilm_core::stages::filming::develop(&log, &pipe.film, &pipe.params, &CpuBackend)
+                .data
+                .chunks_exact(3)
+                .map(|r| std::array::from_fn(|c| to_f64(r[c]).to_bits()))
+                .collect();
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+            "film-dir64-real-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&root).unwrap();
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+        let sources = ["log-r64.bin", "log-g64.bin", "log-b64.bin"].map(|s| root.join(s));
+        for (path, bytes) in sources.iter().zip(&source_bytes) {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(path)
+                .unwrap();
+            file.write_all(bytes).unwrap();
+            file.sync_all().unwrap();
+            drop(file);
+            assert_eq!(
+                fs::read(path).unwrap(),
+                *bytes,
+                "capture bytes differ from original log ImageBuf"
+            );
+        }
+        let params = serde_json::to_vec(&pipe.params).unwrap();
+        let stock = pipe.film.info.stock.as_ref().unwrap();
+        assert!(stock.chars().all(|x| x.is_ascii_alphanumeric() || x == '_'));
+        let profile = fs::read(
+            Path::new(env!("CARGO_MANIFEST_DIR")).join(format!("../../data/profiles/{stock}.json")),
+        )
+        .unwrap();
+        // Recipe hash binds actual pipeline implementation plus the complete
+        // runtime params, loaded calibrated film profile, and typed calibration.
+        let mut pipeline_bytes =
+            include_bytes!("../../../../spektrafilm-core/src/pipeline.rs").to_vec();
+        pipeline_bytes.extend_from_slice(&params);
+        pipeline_bytes.extend_from_slice(&profile);
+        pipeline_bytes.extend_from_slice(format!("{:?}", pipe.film).as_bytes());
+        pipeline_bytes.extend_from_slice(&serde_json::to_vec(&cal).unwrap());
+        let origin=FixtureOrigin {
+            kind:"original-log64-test-fixture-v1".into(),precision:"precision-f64".into(),
+            producer:"spektrafilm_core::stages::filming::expose".into(),
+            fixture_mode:"Controlled original precision-f64 expose: None TC LUT / None Mallett simplified RGB branch; original CPU optics and log; explicit 36mm/8192 pitch; grain disabled for DIR-only oracle; not default spectral exposure or full-chain evidence".into(),
+            build_sha256:binary_digest(),producer_sha256:digest(include_bytes!("../../../../spektrafilm-core/src/stages/filming.rs")),
+            pipeline_sha256:digest(&pipeline_bytes),profile_sha256:digest(&profile),runtime_params_sha256:digest(&params),
+            fixture_sha256:digest(&fixture_bytes),calibration_sha256:digest(&serde_json::to_vec(&cal).unwrap()),
+        };
+        eprintln!(
+            "DIR64 actual producer fixture origin: {}",
+            serde_json::to_string(&origin).unwrap()
+        );
+        Self {
+            root,
+            sources,
+            source_bytes,
+            expected,
+            cal,
+            origin,
+        }
+    }
+    fn plan(&self, name: &str, points: u32, lines: u32) -> DirImagePlan {
+        DirImagePlan::new(
+            self.cal.clone(),
+            Sources::capture(self.sources.clone(), self.origin.clone(), &mut || false).unwrap(),
+            Paths::new(self.root.join(name)),
+            points,
+            lines,
+        )
+        .unwrap()
+    }
+    fn assert_sources(&self) {
+        for (path, bytes) in self.sources.iter().zip(&self.source_bytes) {
+            assert_eq!(fs::read(path).unwrap(), *bytes);
+        }
+    }
+    fn verify(&self, p: &DirImagePlan, r: &CandidateReceipt) -> Vec<[u64; 3]> {
+        assert_eq!(r.plan_sha256, p.identity().unwrap());
+        assert_eq!(
+            r.status,
+            "privateCandidateReadyRequiresOuterSealOrConfirmedHelperDeath"
+        );
+        assert_eq!(r.encoding, "threePlanarBinary64LittleEndian");
+        assert!(r.requires_outer_seal_or_confirmed_helper_death);
+        assert_eq!(r.temporary_planes_remaining, 0);
+        assert!(r.temporary_plane_highwater <= 5);
+        assert!(r.temporary_byte_highwater <= 40 * p.samples());
+        assert_eq!(r.plane_byte_length, 8 * p.samples());
+        let expected_hashes = self.source_bytes.each_ref().map(|x| digest(x));
+        assert_eq!(r.source_sha256_before, expected_hashes);
+        assert_eq!(r.source_sha256_after, expected_hashes);
+        let planes = r.candidate64.each_ref().map(|path| fs::read(path).unwrap());
+        for c in 0..3 {
+            assert_eq!(planes[c].len() as u64, r.plane_byte_length);
+            assert_eq!(digest(&planes[c]), r.candidate_sha256[c]);
+        }
+        let actual: Vec<[u64; 3]> = (0..p.samples() as usize)
+            .map(|i| {
+                std::array::from_fn(|c| {
+                    u64::from_le_bytes(planes[c][i * 8..i * 8 + 8].try_into().unwrap())
+                })
+            })
+            .collect();
+        let actual_words: Vec<_> = actual.iter().flatten().copied().collect();
+        let expected_words: Vec<_> = self.expected.iter().flatten().copied().collect();
+        assert!(
+            actual_words
+                .iter()
+                .chain(&expected_words)
+                .all(|&x| admitted(x))
+        );
+        let zeros = oracle::assert_words(
+            &actual_words,
+            &expected_words,
+            "full DIR file graph vs original filming::develop of same captured expose ImageBuf",
+        );
+        let marker = fs::read(&r.candidate_marker).unwrap();
+        assert!(marker.len() <= 65_536);
+        assert_eq!(
+            *r,
+            serde_json::from_slice::<CandidateReceipt>(&marker).unwrap()
+        );
+        assert_eq!(
+            fs::read_dir(&p.paths().private_directory).unwrap().count(),
+            4,
+            "only 3 candidates and one marker remain"
+        );
+        self.assert_sources();
+        eprintln!(
+            "DIR64 graph {}x{} points={} rows={} columns={} highwater={} / {} bytes; zero sign differences={zeros}",
+            r.width,
+            r.height,
+            r.point_batches,
+            r.row_batches,
+            r.column_batches,
+            r.temporary_plane_highwater,
+            r.temporary_byte_highwater
+        );
+        actual
+    }
+    fn assert_no_candidates(&self, p: &DirImagePlan) {
+        assert!(!p.paths().candidate_marker.exists());
+        assert!(p.paths().candidate64.iter().all(|p| !p.exists()));
+        if p.paths().private_directory.exists() {
+            assert_eq!(
+                fs::read_dir(&p.paths().private_directory).unwrap().count(),
+                0
+            );
+        }
+        self.assert_sources();
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.root);
+    }
+}
