+//! Candidate: one device-side admission per immutable code allocation.
+//! Never reuse its token for another Runner, buffer checkout, or code upload.
+use super::R;
+pub const VERSION:u32=2;
+pub const OP:u32=67;
+pub const FLAG_BYTES:usize=24;
+pub const ID:[u32;2]=[0x1b9d3003,0x5a8884f5];
+pub fn expected_words()->R<Vec<u8>>{
+ let code=super::super::alu_programs::validated_prefix()?;
+ Ok(code.chunks_exact(4).flat_map(|b|{let n=u32::from_le_bytes(b.try_into().unwrap());[(n&65535)as f32,(n>>16)as f32].into_iter().flat_map(f32::to_le_bytes)}).collect())
+}
+const SHADER:&str=r#"
+fn grain_code_reject(){
+ tail_numeric_error.code_status=3u;
+ atomicOr(&tail_numeric_error.value,1u);
+}
+fn grain_code_admit(){
+ // Only the fresh, zeroed Runner token may transition to admitted. Failure is
+ // irreversible even if host test instrumentation restores code/flag bytes.
+ if(atomicLoad(&tail_numeric_error.value)!=0u||tail_numeric_error.code_status!=0u){grain_code_reject();return;}
+ tail_numeric_error.code_status=1u;
+ let capacity=arrayLength(&grain_scratch.frames);
+ if(p.u[3].x!=2u||p.u[3].y!=0x1b9d3003u||p.u[3].z!=0x5a8884f5u||(capacity!=256u&&capacity!=16384u)||arrayLength(&probe.values)<2400u){grain_code_reject();return;}
+ for(var program=0u;program<3u;program=program+1u){if(!sr_palu_program_valid(program)){grain_code_reject();return;}}
+ for(var program=0u;program<4u;program=program+1u){if(!sr_alu_program_valid(program)){grain_code_reject();return;}}
+ // Exact 1200-word comparison, not a device hash or structural-only identity.
+ // Expected words arrive from the separately authenticated immutable prefix.
+ for(var row=0u;row<300u;row=row+1u){
+  var actual:vec4<u32>;
+  if(row<93u){actual=grain_scratch.poisson_code[row];}else{actual=grain_scratch.binomial_code[row-93u];}
+  for(var column=0u;column<4u;column=column+1u){
+   let at=2u*(4u*row+column);let lo=probe.values[at];let hi=probe.values[at+1u];
+   if(!(lo>=0.0&&lo<=65535.0&&hi>=0.0&&hi<=65535.0)){grain_code_reject();return;}
+   if(lo!=floor(lo)||hi!=floor(hi)||actual[column]!=(u32(lo)|(u32(hi)<<16u))){grain_code_reject();return;}
+  }
+ }
+ tail_numeric_error.code_version=2u;tail_numeric_error.code_capacity=capacity;
+ tail_numeric_error.code_id0=0x1b9d3003u;tail_numeric_error.code_id1=0x5a8884f5u;
+ tail_numeric_error.code_status=2u;
+}
+"#;
+const CHECK:&str=r#" if(atomicLoad(&tail_numeric_error.value)!=0u||tail_numeric_error.code_status!=2u||tail_numeric_error.code_version!=2u||tail_numeric_error.code_capacity!=capacity||tail_numeric_error.code_id0!=0x1b9d3003u||tail_numeric_error.code_id1!=0x5a8884f5u){return grain_alu_reject();}
+"#;
+pub fn compose(mut source:String)->R<String>{
+ let replacements=[
+  ("struct TailNumericError { value: atomic<u32>, }", "struct TailNumericError { value: atomic<u32>, code_status:u32, code_version:u32, code_capacity:u32, code_id0:u32, code_id1:u32, }"),
+  (" for(var program=0u;program<3u;program=program+1u){if(!sr_palu_program_valid(program)){return grain_alu_reject();}}\n for(var program=0u;program<4u;program=program+1u){if(!sr_alu_program_valid(program)){return grain_alu_reject();}}\n", CHECK),
+  (" if(op==50u){", " if(op==67u){if(i==0u){grain_code_admit();}return;}\n if(op==50u){"),
+ ];
+ for(old,new)in replacements{if source.matches(old).count()!=1{return Err("GPU_GRAIN_CODE_ADMISSION_VERSION".into());}source=source.replace(old,new);}
+ source.push_str(SHADER);Ok(source)
+}
