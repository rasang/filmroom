+        gpu.execute(&p, &input, &mut || false).unwrap_err(),
+        "GPU_FIR64_NUMERIC_DOMAIN"
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert_eq!(gpu.metrics.transient_releases, 0);
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    assert_eq!(
+        gpu.execute(&p, &input, &mut || false).unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+}
+
+fn final_map_fault(epoch: u64, cancel: bool) {
+    let ticket = activate(epoch);
+    let mut gpu = FirGpu::new(&mut || false).unwrap();
+    let flag = Arc::new(AtomicBool::new(false));
+    gpu.after_unmap_fault = Some(if cancel {
+        AfterUnmapFault::Cancel(flag.clone())
+    } else {
+        AfterUnmapFault::DeviceError
+    });
+    let p = FirSpec::new(0.5, 17, 3).unwrap();
+    let input = values(17, 3, 0);
+    let result = gpu.execute(&p, &input, &mut || flag.load(Ordering::Acquire));
+    assert_eq!(
+        result.unwrap_err(),
+        if cancel {
+            "CANCELLED"
+        } else {
+            "GPU_DEVICE_FAILED"
+        }
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert_eq!(gpu.metrics.completed_readbacks, 1);
+    assert_eq!(gpu.metrics.transient_releases, 0);
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    assert_eq!(
+        gpu.execute(&p, &input, &mut || false).unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+}
+#[test]
+#[ignore = "Fresh process: deterministic successful-map/decode/unmap then cancellation, no output acceptance or transient release or seal"]
+fn actual_fir_after_unmap_cancel_rejects_and_poison() {
+    final_map_fault(96111, true);
+}
+#[test]
+#[ignore = "Fresh process: deterministic successful-map/decode/unmap then device error, independent of cancellation sticky state"]
+fn actual_fir_after_unmap_device_error_rejects_and_poison() {
+    final_map_fault(96112, false);
+}
+
+#[test]
+fn fir_cancelled_constructor_never_acquires_device() {
+    let result = FirGpu::new(&mut || true);
+    assert!(matches!(result, Err(ref e) if e == "CANCELLED"));
+}
+#[test]
+#[ignore = "Fresh process: deterministic cancellation immediately after actual queue submit, before mapped acceptance, retires without reuse/seal"]
+fn actual_fir_post_submit_cancel_rejects_and_poison() {
+    let ticket = activate(96113);
+    let mut gpu = FirGpu::new(&mut || false).unwrap();
+    let flag = Arc::new(AtomicBool::new(false));
+    gpu.after_submit_cancel = Some(flag.clone());
+    let p = FirSpec::new(0.5, 17, 3).unwrap();
+    let input = values(17, 3, 0);
+    assert_eq!(
+        gpu.execute(&p, &input, &mut || flag.load(Ordering::Acquire))
+            .unwrap_err(),
+        "CANCELLED"
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    assert_eq!(gpu.metrics.completed_readbacks, 0);
+    assert_eq!(gpu.metrics.transient_releases, 0);
+    assert!(gpu.context.error.load(Ordering::Acquire));
+    assert_eq!(
+        gpu.execute(&p, &input, &mut || false).unwrap_err(),
+        "GPU_DEVICE_FAILED"
+    );
+    assert_eq!(gpu.metrics.dispatches, 1);
+    drop(gpu);
+    assert!(session::complete_stage(ticket).is_err());
+}
