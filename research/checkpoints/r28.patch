+++ b/native/crates/film-engine/src/research_iir_soft64/dir_mixed_gpu.rs
@@ -0,0 +1,513 @@
+//! Closed three-family DIR owner. One Context and one physical buffer set;
+//! separate mixed-calibration admission, unchanged point/IIR/FIR shader math.
+#![cfg(test)]
+
+use super::dir_mixed_calibration::{DirMixedCalibration, SpatialLine};
+use super::dir_point::{self, Job, Packet};
+use super::{BATCH_BYTES, DEVICE_BYTES, HOST_BYTES, R, admitted};
+use crate::gpu_phase_diagnostics::{self as trace, Phase as GpuPhase};
+use std::{
+    sync::{atomic::Ordering, mpsc},
+    time::{Duration, Instant},
+};
+
+const MAP_BYTES: u64 = BATCH_BYTES + 4;
+const RESIDENT_BYTES: u64 = 2 * BATCH_BYTES + MAP_BYTES + 4 + 64;
+const FIXED_BYTES: u64 = 2 * HOST_BYTES;
+const DRIVER_BYTES: u64 = 88 * 1024 * 1024; // Base 64 MiB plus three 8 MiB families.
+const COMBINED_BYTES: u64 = DEVICE_BYTES + FIXED_BYTES + DRIVER_BYTES;
+
+#[derive(Debug, Default)]
+pub(super) struct Metrics {
+    pub(super) point_dispatches: u64,
+    pub(super) iir_dispatches: u64,
+    pub(super) fir_dispatches: u64,
+    pub(super) identity_dispatches: u64,
+    pub(super) completed_readbacks: u64,
+    pub(super) transient_releases: u64,
+    pub(super) upload_bytes: u64,
+    pub(super) readback_bytes: u64,
+    pub(super) upload_ms: f64,
+    pub(super) wait_readback_ms: f64,
+    pub(super) adapter: String,
+}
+#[derive(Clone, Copy)]
+enum Family {
+    Point,
+    Iir,
+    Fir,
+    Identity,
+}
+impl Family {
+    fn domain_error(self) -> &'static str {
+        match self {
+            Self::Point => dir_point::DOMAIN_ERROR,
+            Self::Iir => "GPU_IIR64_IMAGE_NUMERIC_DOMAIN",
+            Self::Fir | Self::Identity => "GPU_FIR64_NUMERIC_DOMAIN",
+        }
+    }
+}
+// Explicit private fault hooks. No normal execution API accepts a bypass flag,
+// a mutable packet, or arbitrary uniforms. Each device fault runs in a fresh
+// process so that a prior request-sticky rejection cannot mask its outcome.
+enum PacketFault {
+    Input {
+        sample: usize,
+        lane: usize,
+        bits: u64,
+    },
+    UnusedBeforeTable {
+        bits: u64,
+    },
+}
+pub(super) enum AfterUnmapFault {
+    Cancel(std::sync::Arc<std::sync::atomic::AtomicBool>),
+    DeviceError,
+}
+pub(super) struct MixedDirGpu {
+    source: wgpu::Buffer,
+    result64: wgpu::Buffer,
+    error: wgpu::Buffer,
+    readback: wgpu::Buffer,
+    raw_pipeline: wgpu::ComputePipeline,
+    point_pipeline: wgpu::ComputePipeline,
+    fir_pipeline: wgpu::ComputePipeline,
+    pub(super) metrics: Metrics,
+    pub(super) after_unmap_fault: Option<AfterUnmapFault>,
+    // Fault only after this many successful readbacks; default applies next.
+    pub(super) after_unmap_readback: Option<u64>,
+    // Last: all owned GPU resources must drop before Context makes sealing legal.
+    pub(super) context: crate::gpu_session::Context,
+}
+impl MixedDirGpu {
+    pub(super) fn new(c: &mut impl FnMut() -> bool) -> R<Self> {
+        check(c)?;
+        let raw_source = super::image_kernel::shader()?;
+        let point_source = super::dir_kernel::shader()?;
+        let fir_source = super::fir_kernel::shader()?;
+        let context = trace::phase_result(GpuPhase::Device, || {
+            crate::gpu_session::Context::acquire(MAP_BYTES, 3, true)
+        })?;
+        let result = (|| {
+            // Identical binding entries and size/usage pool keys to R13.
+            let entries: Vec<_> = (0..4)
+                .map(|index| wgpu::BindGroupLayoutEntry {
+                    binding: index,
+                    visibility: wgpu::ShaderStages::COMPUTE,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: if index == 3 {
+                            wgpu::BufferBindingType::Uniform
+                        } else {
+                            wgpu::BufferBindingType::Storage {
+                                read_only: index == 0,
+                            }
+                        },
+                        has_dynamic_offset: false,
+                        min_binding_size: wgpu::BufferSize::new(match index {
+                            0 | 1 => 8,
+                            3 => 64,
+                            _ => 4,
+                        }),
+                    },
+                    count: None,
+                })
+                .collect();
+            check(c)?;
+            // Reserve all three families atomically in a fresh, fully prepaid
+            // epoch. Never erase an earlier epoch's cumulative policy debt.
+            let (mut pipelines, _) = trace::phase_result(GpuPhase::Pipeline, || {
+                context.pipelines(&[&raw_source, &point_source, &fir_source], Some(&entries))
+            })?;
+            let fir_pipeline = pipelines.pop().ok_or("GPU_DIR64_MIXED_PIPELINE")?;
+            let point_pipeline = pipelines.pop().ok_or("GPU_DIR64_MIXED_PIPELINE")?;
+            let raw_pipeline = pipelines.pop().ok_or("GPU_DIR64_MIXED_PIPELINE")?;
+            if !pipelines.is_empty() {
+                return Err("GPU_DIR64_MIXED_PIPELINE".into());
+            }
+            let storage = wgpu::BufferUsages::STORAGE
+                | wgpu::BufferUsages::COPY_SRC
+                | wgpu::BufferUsages::COPY_DST;
+            let make = |label, size, usage| {
+                context.buffer(
+                    &wgpu::BufferDescriptor {
+                        label: Some(label),
+                        size,
+                        usage,
+                        mapped_at_creation: false,
+                    },
+                    false,
+                )
+            };
+            let source = make(
+                "closed mixed DIR point/IIR/FIR source",
+                BATCH_BYTES,
+                storage,
+            )?;
+            let result64 = make(
+                "closed mixed DIR point/IIR/FIR result",
+                BATCH_BYTES,
+                storage,
+            )?;
+            // Context zeroes checkout. Never clear between operations/batches.
+            let error = make("closed DIR request-sticky numeric rejection", 4, storage)?;
+            let readback = make(
+                "closed mixed DIR point/IIR/FIR words and flag",
+                MAP_BYTES,
+                wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            )?;
+            check(c)?;
+            Ok((
+                source,
+                result64,
+                error,
+                readback,
+                raw_pipeline,
+                point_pipeline,
+                fir_pipeline,
+            ))
+        })();
+        let (source, result64, error, readback, raw_pipeline, point_pipeline, fir_pipeline) =
+            match result {
+                Ok(value) => value,
+                Err(error) => {
+                    context.error.store(true, Ordering::Release);
+                    crate::gpu_session::retire_current();
+                    return Err(error);
+                }
+            };
+        let metrics = Metrics {
+            adapter: context.info.name.clone(),
+            ..Default::default()
+        };
+        Ok(Self {
+            source,
+            result64,
+            error,
+            readback,
+            raw_pipeline,
+            point_pipeline,
+            fir_pipeline,
+            metrics,
+            after_unmap_fault: None,
+            after_unmap_readback: None,
+            context,
+        })
+    }
+    pub(super) fn poison(&self) {
+        self.context.error.store(true, Ordering::Release);
+        crate::gpu_session::retire_current();
+    }
+    pub(super) fn ready(&self, c: &mut impl FnMut() -> bool) -> R<()> {
+        if self.context.error.load(Ordering::Acquire) {
+            return Err("GPU_DEVICE_FAILED".into());
+        }
+        check(c)
+    }
+    pub(super) fn point(
+        &mut self,
+        p: &DirMixedCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        let result = (|| {
+            self.ready(c)?;
+            // Recompute and validate calibration plus all input words before
+            // packing/upload. The packet is never accepted from outside here.
+            let packet = Packet::new_mixed(p, job, values)?;
+            self.dispatch(
+                Family::Point,
+                &packet.words,
+                &packet.parameters,
+                packet.count,
+                packet.invocations(),
+                c,
+            )
+        })();
+        if result.is_err() {
+            self.poison();
+        }
+        result
+    }
+    pub(super) fn spatial(
+        &mut self,
+        spec: &SpatialLine,
+        values: &[u64],
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        let result = (|| {
+            self.ready(c)?;
+            spec.validate_input(values)?;
+            match spec {
+                SpatialLine::Iir(p) => self.dispatch(
+                    Family::Iir,
+                    values,
+                    &p.words(),
+                    p.sample_count() as u32,
+                    p.lines,
+                    c,
+                ),
+                SpatialLine::Fir(p) => {
+                    let packet = p.packet(values)?;
+                    packet.validate(p)?;
+                    self.dispatch(
+                        Family::Fir,
+                        &packet.words,
+                        &packet.parameters,
+                        p.sample_count()? as u32,
+                        packet.invocations,
+                        c,
+                    )
+                }
+                SpatialLine::Identity { copy, .. } => {
+                    // Original nonpositive sigma is retained in SpatialLine;
+                    // its checked implementation is an explicit raw copy.
+                    let packet = copy.packet(values)?;
+                    packet.validate(copy)?;
+                    self.dispatch(
+                        Family::Identity,
+                        &packet.words,
+                        &packet.parameters,
+                        copy.sample_count()? as u32,
+                        packet.invocations,
+                        c,
+                    )
+                }
+            }
+        })();
+        if result.is_err() {
+            self.poison();
+        }
+        result
+    }
+    fn point_with_test_fault(
+        &mut self,
+        p: &DirMixedCalibration,
+        job: Job,
+        values: &[[u64; 3]],
+        fault: PacketFault,
+    ) -> R<Vec<u64>> {
+        let result = (|| {
+            self.ready(&mut || false)?;
+            let mut packet = Packet::new_mixed(p, job, values)?;
+            match fault {
+                PacketFault::Input { sample, lane, bits } => {
+                    assert!(sample < values.len() && lane < 3);
+                    packet.words[dir_point::PREFIX_WORDS + 3 * sample + lane] = bits;
+                }
+                PacketFault::UnusedBeforeTable { bits } => {
+                    assert_eq!(job.operation, dir_point::Operation::InitialCurve);
+                    // Last knot, unused channel in an entirely unused table.
+                    // The device must scan all table words, not sampled values.
+                    let index = packet.parameters[12] as usize - 1;
+                    assert!(index >= packet.parameters[9] as usize);
+                    packet.words[index] = bits;
+                }
+            }
+            self.dispatch(
+                Family::Point,
+                &packet.words,
+                &packet.parameters,
+                packet.count,
+                packet.invocations(),
+                &mut || false,
+            )
+        })();
+        if result.is_err() {
+            self.poison();
+        }
+        result
+    }
+    fn dispatch(
+        &mut self,
+        family: Family,
+        values: &[u64],
+        parameters: &[u32; 16],
+        count: u32,
+        invocations: u32,
+        c: &mut impl FnMut() -> bool,
+    ) -> R<Vec<u64>> {
+        self.ready(c)?;
+        let upload_size = (values.len() as u64)
+            .checked_mul(8)
+            .ok_or("GPU_DIR64_MIXED_BUDGET")?;
+        let size64 = u64::from(count) * 8;
+        let mapped_size = size64 + 4;
+        if count == 0
+            || invocations == 0
+            || upload_size > BATCH_BYTES
+            || size64 > BATCH_BYTES
+            || mapped_size > MAP_BYTES
+        {
+            return Err("GPU_DIR64_MIXED_BUDGET".into());
+        }
+        let at = Instant::now();
+        let bytes: Vec<u8> = values.iter().flat_map(|x| x.to_le_bytes()).collect();
+        self.context.queue.write_buffer(&self.source, 0, &bytes);
+        let uniform = self.context.buffer_init(
+            &wgpu::util::BufferInitDescriptor {
+                label: Some("closed immutable point or complete-line descriptor"),
+                contents: bytemuck::cast_slice(parameters),
+                usage: wgpu::BufferUsages::UNIFORM,
+            },
+            true,
+        )?;
+        self.metrics.upload_bytes += upload_size + 64;
+        self.metrics.upload_ms += at.elapsed().as_secs_f64() * 1000.;
+        drop(bytes);
+        let pipeline = match family {
+            Family::Point => &self.point_pipeline,
+            Family::Iir => &self.raw_pipeline,
+            Family::Fir | Family::Identity => &self.fir_pipeline,
+        };
+        let entries = [
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: self.source.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 1,
+                resource: self.result64.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: self.error.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 3,
+                resource: uniform.as_entire_binding(),
+            },
+        ];
+        let group = self
+            .context
+            .device
+            .create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("closed point/IIR/FIR shared physical ABI"),
+                layout: &pipeline.get_bind_group_layout(0),
+                entries: &entries,
+            });
+        let mut encoder = self
+            .context
+            .device
+            .create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+                label: Some("closed binary64 point or complete-line operation"),
+                timestamp_writes: None,
+            });
+            pass.set_pipeline(pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(invocations.div_ceil(64), 1, 1);
+        }
+        encoder.copy_buffer_to_buffer(&self.result64, 0, &self.readback, 0, size64);
+        encoder.copy_buffer_to_buffer(&self.error, 0, &self.readback, size64, 4);
+        self.ready(c)?;
+        self.context.queue.submit([encoder.finish()]);
+        match family {
+            Family::Point => self.metrics.point_dispatches += 1,
+            Family::Iir => self.metrics.iir_dispatches += 1,
+            Family::Fir => self.metrics.fir_dispatches += 1,
+            Family::Identity => self.metrics.identity_dispatches += 1,
+        }
+        let (tx, rx) = mpsc::channel();
+        self.readback
+            .slice(0..mapped_size)
+            .map_async(wgpu::MapMode::Read, move |r| {
+                let _ = tx.send(r);
+            });
+        let start = Instant::now();
+        let result = (|| {
+            loop {
+                self.ready(c)?;
+                let _ = self.context.device.poll(wgpu::Maintain::Poll);
+                match rx.try_recv() {
+                    Ok(Ok(())) => break,
+                    Ok(Err(_)) | Err(mpsc::TryRecvError::Disconnected) => {
+                        return Err("GPU_DIR64_MIXED_READBACK".into());
+                    }
+                    Err(mpsc::TryRecvError::Empty) => {}
+                }
+                // Preserve R13's original queue/map watchdog, including for points.
+                if start.elapsed() > Duration::from_secs(5) {
+                    return Err("GPU_DIR64_MIXED_TIMEOUT".into());
+                }
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            let mapped = self.readback.slice(0..mapped_size).get_mapped_range();
+            let flag = u32::from_le_bytes(mapped[size64 as usize..].try_into().unwrap());
+            if flag != 0 {
+                return Err(family.domain_error().into());
+            }
+            let words: Vec<u64> = mapped[..size64 as usize]
+                .chunks_exact(8)
+                .map(|x| u64::from_le_bytes(x.try_into().unwrap()))
+                .collect();
+            if words.iter().any(|&x| !admitted(x)) {
+                return Err(family.domain_error().into());
+            }
+            Ok(words)
+        })();
+        // No mapped view escapes, including numeric and map failure paths.
+        self.readback.unmap();
+        self.metrics.wait_readback_ms += start.elapsed().as_secs_f64() * 1000.;
+        drop(group);
+        drop(uniform);
+        if result.is_ok() {
+            self.metrics.completed_readbacks += 1;
+            let inject = self
+                .after_unmap_readback
+                .is_none_or(|n| n == self.metrics.completed_readbacks);
+            if let Some(fault) = if inject {
+                self.after_unmap_fault.take()
+            } else {
+                None
+            } {
+                match fault {
+                    AfterUnmapFault::Cancel(flag) => flag.store(true, Ordering::Release),
+                    AfterUnmapFault::DeviceError => {
+                        self.context.error.store(true, Ordering::Release)
+                    }
+                }
+            }
+            // This explicit after-unmap boundary is not selected by poll count.
+            // Recheck cancellation and device health before any pool release.
+            self.ready(c)?;
+            self.context.release_transients_after_fence()?;
+            self.metrics.transient_releases += 1;
+            self.metrics.readback_bytes += mapped_size;
+        }
+        result
+    }
+}
+fn check(c: &mut impl FnMut() -> bool) -> R<()> {
+    if c() { Err("CANCELLED".into()) } else { Ok(()) }
+}
