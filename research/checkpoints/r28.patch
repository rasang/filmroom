@@ -0,0 +1,96 @@
+// Closed full-line original FIR, raw binary64 input/output. No narrowing conversion.
+// Prefix words hold the CPU-calibrated original exp/normalized coefficients.
+struct FirParameters { words: array<vec4<u32>, 4>, }
+@group(0) @binding(0) var<storage, read> fir_source: array<vec2<u32>>;
+@group(0) @binding(1) var<storage, read_write> fir_result: array<vec2<u32>>;
+@group(0) @binding(2) var<storage, read_write> fir_error: atomic<u32>;
+@group(0) @binding(3) var<uniform> fir_parameters: FirParameters;
+const FIR_BOUND: vec2<u32> = vec2<u32>(0x20000000u, 0x430c6bf5u);
+const FIR_ONE: vec2<u32> = vec2<u32>(0u, 0x3ff00000u);
+
+fn fir_reject() {
+    sf_failed = 1u;
+    atomicOr(&fir_error, 1u);
+}
+fn fir_accept(x: vec2<u32>) -> bool {
+    if (sf_failed != 0u || !sf_valid(x)) { fir_reject(); return false; }
+    if (sf_cmpu(sf_abs(x), FIR_BOUND) > 0) { fir_reject(); return false; }
+    return true;
+}
+fn fir_mul(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!fir_accept(a) || !fir_accept(b)) { return SF_NAN; }
+    let result = sf_mul(a, b);
+    if (!fir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn fir_add(a: vec2<u32>, b: vec2<u32>) -> vec2<u32> {
+    if (!fir_accept(a) || !fir_accept(b)) { return SF_NAN; }
+    let result = sf_add(a, b);
+    if (!fir_accept(result)) { return SF_NAN; }
+    return result;
+}
+fn fir_reflect(index: i32, length: u32) -> u32 {
+    if (length <= 1u) { return 0u; }
+    let period = i32(2u * length);
+    // WGSL signed % is remainder; add one period to implement rem_euclid.
+    var folded = index % period;
+    if (folded < 0) { folded = folded + period; }
+    if (folded >= i32(length)) { folded = period - 1 - folded; }
+    return u32(folded);
+}
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
+    if (atomicLoad(&fir_error) != 0u) { return; }
+    let dimensions = fir_parameters.words[0];
+    let kernel = fir_parameters.words[1];
+    let length = dimensions.x;
+    let lines = dimensions.y;
+    let total = dimensions.z;
+    let mode = dimensions.w;
+    let radius = kernel.x;
+    let size = kernel.y;
+    if (length == 0u || length > 40000u || lines == 0u || mode > 1u ||
+        kernel.z != 32u || kernel.w != 0u ||
+        any(fir_parameters.words[2] != vec4<u32>(0u)) ||
+        any(fir_parameters.words[3] != vec4<u32>(0u))) { fir_reject(); return; }
+    if (lines > 524256u / length || total != length * lines ||
+        arrayLength(&fir_source) < 32u || total > arrayLength(&fir_source) - 32u ||
+        total > arrayLength(&fir_result)) { fir_reject(); return; }
+    if ((mode == 0u && (radius != 0u || size != 0u)) ||
+        (mode == 1u && (radius > 9u || size != 2u * radius + 1u))) {
+        fir_reject(); return;
+    }
+    let index = gid.x;
+    // The owner dispatches max(total,32) and checks request-wide sticky only
+    // after all work completes. An unused corrupted word cannot be hidden by
+    // an identity branch or an output lane that did not sample that word.
+    if (index < 32u) {
+        let value = fir_source[index];
+        if (index < size) {
+            if (!fir_accept(value) || sf_zero(value) || (value.y >> 31u) != 0u ||
+                sf_cmpu(value, FIR_ONE) > 0) { fir_reject(); return; }
+        } else if (any(value != vec2<u32>(0u))) { fir_reject(); return; }
+    }
+    if (index >= total) { return; }
+    let input = fir_source[32u + index];
+    if (!fir_accept(input)) { return; }
+    if (mode == 0u) {
+        // Original sigma +/-0 copies bits, including negative zero.
+        fir_result[index] = input;
+        return;
+    }
+    let x = index % length;
+    let base = index - x;
+    var sum = vec2<u32>(0u);
+    for (var ki = 0u; ki < size; ki = ki + 1u) {
+        let sx = fir_reflect(i32(x) + i32(ki) - i32(radius), length);
+        // Original ascending kernel order, separate multiplication then add.
+        let product = fir_mul(fir_source[32u + base + sx], fir_source[ki]);
+        sum = fir_add(sum, product);
+        if (sf_failed != 0u) { fir_reject(); return; }
+    }
+    // With +0 initial state and no subnormal arithmetic admitted, an exact
+    // zero accumulator is +0. Shared zero-product canonicalization therefore
+    // preserves this FIR sum, unlike the separate sigma-zero copy branch.
+    fir_result[index] = sum;
+}
diff --git a/native/crates/film-engine/src/research_iir_soft64/gpu.rs b/native/crates/film-engine/src/research_iir_soft64/gpu.rs
