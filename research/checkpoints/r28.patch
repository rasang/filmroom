+//! Closed, test-only binary64 image spool. CPU work is byte movement, identities,
+//! bounds and cancellation only. `Compute` owns all recurrence arithmetic and
+//! its poisoned-session/fence rules. A helper completion marker is NOT a native
+//! stage seal, a dead-helper proof, an adoption token or a production route.
+use super::{CAPACITY, R, admitted, coefficients_for_sigma, digest, image_kernel};
+use serde::{Deserialize, Deserializer, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, File},
+    io::{Read, Seek, SeekFrom, Write},
+    path::{Path, PathBuf},
+};
+
+const MIB: u64 = 1024 * 1024;
+const VERSION: u32 = 1;
+const ERROR: &str = "GPU_IIR64_IMAGE_DESCRIPTOR";
+const IO_ERROR: &str = "GPU_IIR64_IMAGE_IO";
+const PATH_ERROR: &str = "GPU_IIR64_IMAGE_PATH";
+const DOMAIN_ERROR: &str = "GPU_IIR64_IMAGE_NUMERIC_DOMAIN";
+const CANCELLED: &str = "GPU_IIR64_IMAGE_CANCELLED";
+const SOURCE_CHANGED: &str = "GPU_IIR64_IMAGE_SOURCE_CHANGED";
+const COMPLETE: &str = "privateCandidateCompleteRequiresOuterSealOrConfirmedDeath";
+const METADATA_BYTES: u64 = 65_536;
+// A separately named physical-free-space safety allowance, not an image plane.
+const DISK_SAFETY_BYTES: u64 = 256 * MIB;
+const HASH_BUFFER_BYTES: usize = 65_536;
+const HORIZONTAL_NAME: &str = "horizontal64.bin";
+const CANDIDATE_NAME: &str = "candidate64.bin";
+const MARKER_NAME: &str = "candidate.complete.json";
+
+/// Raw-only dispatch description. It deliberately does not reuse the old
+/// final-f32 diagnostic Plan or its buffer/layout identity.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct LineSpec {
+    pub length: u32,
+    pub lines: u32,
+    pub sigma_bits: u32,
+    pub coefficient_bits: [u64; 4],
+}
+impl LineSpec {
+    pub(super) fn validate(&self) -> R<()> {
+        if !(1..=40_000).contains(&self.length)
+            || self.lines == 0
+            || self
+                .length
+                .checked_mul(self.lines)
+                .is_none_or(|n| n > CAPACITY)
+            || self.coefficient_bits != coefficients_for_sigma(f32::from_bits(self.sigma_bits))?
+        {
+            return Err(ERROR.into());
+        }
+        Ok(())
+    }
+    pub(super) fn sample_count(&self) -> usize {
+        self.length.checked_mul(self.lines).unwrap_or(0) as usize
+    }
+    pub(super) fn validate_input(&self, values: &[u64]) -> R<()> {
+        self.validate()?;
+        if values.len() != self.sample_count() || values.iter().any(|&v| !admitted(v)) {
+            return Err(DOMAIN_ERROR.into());
+        }
+        Ok(())
+    }
+    pub(super) fn words(&self) -> [u32; 16] {
+        let mut words = [0; 16];
+        words[0] = self.length;
+        words[1] = self.lines;
+        words[2] = self.length.checked_mul(self.lines).unwrap_or(0);
+        for (i, &bits) in self.coefficient_bits.iter().enumerate() {
+            words[4 + 2 * i] = bits as u32;
+            words[5 + 2 * i] = (bits >> 32) as u32;
+        }
+        words
+    }
+}
