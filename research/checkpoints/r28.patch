+
+const ORIGINAL_PITCH: f32 = 10.;
+const LEGACY_PITCH: f32 = 36. * 1000. / 8192.;
+
+fn pipeline(positive: bool) -> &'static Pipeline {
+    static NEGATIVE: OnceLock<Pipeline> = OnceLock::new();
+    static POSITIVE: OnceLock<Pipeline> = OnceLock::new();
+    let slot = if positive { &POSITIVE } else { &NEGATIVE };
+    slot.get_or_init(|| {
+        let data = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../data");
+        Pipeline::new_with_spectral(
+            load_profile_by_name(
+                &data,
+                if positive {
+                    "kodak_ektachrome_100"
+                } else {
+                    "kodak_portra_400"
+                },
+            )
+            .unwrap(),
+            load_profile_by_name(&data, "kodak_portra_endura").unwrap(),
+            RuntimeParams::default(),
+            &data,
+        )
+        .unwrap()
+    })
+}
+
+fn original384_pipeline() -> Pipeline {
+    let mut pipe = pipeline(false).clone();
+    let d = &mut pipe.params.film_render.dir_couplers;
+    d.active = true;
+    d.diffusion_size_um = 5.;
+    d.diffusion_tail_um = 2.;
+    pipe
+}
+fn fixture() -> DirMixedCalibration {
+    DirMixedCalibration::from_pipeline(&original384_pipeline(), ORIGINAL_PITCH, 384, 512).unwrap()
+}
+fn hex(value: u64) -> Value {
+    json!(format!("{value:016x}"))
+}
+
+// Independent original CPU small preparation, starting with the Pipeline and
+// original model functions. Never read candidate tables, its captured inputs,
+// PreparedPointScience, or a synthetic legacy DirCalibration to form an oracle.
+struct OriginalCurve {
+    axis: Vec<f64>,
+    inverse_dx: Vec<f64>,
+    values: Vec<[f64; 3]>,
+}
+struct OriginalPoint {
+    initial: OriginalCurve,
+    before_dir: OriginalCurve,
+    matrix: [[f64; 3]; 3],
+    density_max: [f64; 3],
+}
+fn original_curve(axis: Vec<f64>, values: Vec<[f64; 3]>, gamma: f64) -> OriginalCurve {
+    let axis = if (gamma - 1.).abs() < 1e-12 {
+        axis
+    } else {
+        axis.into_iter().map(|x| x / gamma).collect()
+    };
+    let inverse_dx = axis
+        .windows(2)
+        .map(|pair| {
+            let dx = pair[1] - pair[0];
+            if dx != 0. { 1. / dx } else { 0. }
+        })
+        .collect();
+    OriginalCurve {
+        axis,
+        inverse_dx,
+        values,
+    }
+}
+fn original_prepare(pipe: &Pipeline) -> OriginalPoint {
+    let d = &pipe.params.film_render.dir_couplers;
+    let gamma = pipe.params.film_render.density_curve_gamma as f64;
+    let initial = original_curve(
+        pipe.film.log_exposure_f64(),
+        spektrafilm_model::density_curves::normalize_density_curves_f64(
+            &pipe.film.density_curves_f64(),
+        ),
+        gamma,
+    );
+    let mut matrix = spektrafilm_model::couplers::compute_dir_couplers_matrix(
+        d.gamma_samelayer_rgb,
+        d.gamma_interlayer_r_to_gb,
+        d.gamma_interlayer_g_to_rb,
+        d.gamma_interlayer_b_to_rg,
+        d.inhibition_samelayer,
+        d.inhibition_interlayer,
+    );
+    for row in &mut matrix {
+        for value in row {
+            *value *= d.amount;
+        }
+    }
+    let norm = spektrafilm_model::density_curves::normalize_density_curves(
+        &pipe.film.density_curves_f32(),
+    );
+    let axis = pipe.film.log_exposure_f32();
+    let before = spektrafilm_model::couplers::compute_curves_before_dir(
+        &norm,
+        &axis,
+        &matrix.map(|row| row.map(|x| x as f32)),
+        pipe.film.is_positive(),
+    );
+    let before_dir = original_curve(
+        axis.into_iter().map(|x| x as f64).collect(),
+        before
+            .into_iter()
+            .map(|row| row.map(|x| x as f64))
+            .collect(),
+        gamma,
+    );
+    OriginalPoint {
+        initial,
+        before_dir,
+        matrix,
+        density_max: spektrafilm_model::density_curves::max_density(&norm).map(|x| x as f64),
+    }
+}
+fn assert_curve(actual: &CurveWords, original: &OriginalCurve) {
+    // Checks every exact knot on both independently prepared axes, not sampled
+    // curve locations chosen from the candidate. All reciprocal words matter.
+    assert_eq!(
+        actual.axis,
+        original
+            .axis
+            .iter()
+            .map(|x| x.to_bits())
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        actual.inverse_dx,
+        original
+            .inverse_dx
+            .iter()
+            .map(|x| x.to_bits())
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        actual.values,
+        original
+            .values
+            .iter()
+            .map(|row| row.map(f64::to_bits))
+            .collect::<Vec<_>>()
+    );
+}
+fn assert_original_point(actual: &DirMixedCalibration, pipe: &Pipeline) {
+    let original = original_prepare(pipe);
+    assert_curve(&actual.initial, &original.initial);
+    assert_curve(&actual.before_dir, &original.before_dir);
+    assert_eq!(
+        actual.matrix_bits,
+        original.matrix.map(|row| row.map(f64::to_bits))
+    );
+    assert_eq!(
+        actual.density_max_bits,
+        original.density_max.map(f64::to_bits)
+    );
+}
+
+// Independent transcription of the original Gaussian small-kernel and IIR
+// coefficient expressions. No device image arithmetic or fallback is involved.
+fn original_fir(sigma: f32) -> (u32, Vec<u64>) {
+    let sigma = sigma as f64;
+    let radius = (3. * sigma + 0.5) as u32;
+    let size = 2 * radius + 1;
+    let s2 = 2. * sigma * sigma;
+    let mut kernel = Vec::with_capacity(size as usize);
+    for i in 0..size {
+        let x = i as f64 - radius as f64;
+        kernel.push((-x * x / s2).exp());
+    }
+    let sum: f64 = kernel.iter().sum();
+    for value in &mut kernel {
+        *value /= sum;
+    }
+    (radius, kernel.into_iter().map(f64::to_bits).collect())
+}
+fn original_iir(sigma: f32) -> [u64; 4] {
+    let q = 0.98711 * sigma as f64 - 0.96330;
+    let q2 = q * q;
+    let q3 = q2 * q;
+    let b0 = 1.57825 + 2.44413 * q + 1.4281 * q2 + 0.422205 * q3;
+    let b1 = (2.44413 * q + 2.85619 * q2 + 1.26661 * q3) / b0;
+    let b2 = -(1.4281 * q2 + 1.26661 * q3) / b0;
+    let b3 = (0.422205 * q3) / b0;
+    [1. - b1 - b2 - b3, b1, b2, b3].map(f64::to_bits)
+}
