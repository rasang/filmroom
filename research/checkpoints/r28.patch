+#[cfg(unix)]
+mod producer_files {
+    use super::*;
+    use std::{
+        os::unix::fs::{PermissionsExt, symlink},
+        sync::atomic::{AtomicU64, Ordering},
+    };
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    struct Packet {
+        root: PathBuf,
+        directory: PathBuf,
+        outputs: [PathBuf; 3],
+    }
+    impl Packet {
+        fn new() -> Self {
+            let root = std::env::temp_dir().canonicalize().unwrap().join(format!(
+                "film-dir-log-provenance-host-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed),
+            ));
+            let directory = root.join("gpu-stage-73");
+            fs::create_dir(&root).unwrap();
+            fs::create_dir(&directory).unwrap();
+            fs::create_dir(directory.join("candidate")).unwrap();
+            let outputs = std::array::from_fn(|channel| {
+                directory
+                    .join("candidate")
+                    .join(format!("plane-{channel}.f64le"))
+            });
+            for output in &outputs {
+                fs::write(output, 1f64.to_le_bytes()).unwrap();
+                fs::set_permissions(output, fs::Permissions::from_mode(0o644)).unwrap();
+            }
+            Self {
+                root,
+                directory,
+                outputs,
+            }
+        }
+        fn evidence(&self) -> DerivedLogEvidence {
+            let mut evidence = evidence();
+            evidence.producer_directory = self.directory.clone();
+            evidence.producer_outputs = producer_output_identities(&self.outputs).unwrap();
+            evidence.validate().unwrap();
+            evidence
+        }
+    }
+    impl Drop for Packet {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.root);
+        }
+    }
+
+    #[test]
+    fn synthetic_producer_regular_metadata_does_not_require_private_copy_modes() {
+        let packet = Packet::new();
+        let identities = producer_output_identities(&packet.outputs).unwrap();
+        fs::hard_link(
+            &packet.outputs[0],
+            packet.root.join("producer-hardlink.bin"),
+        )
+        .unwrap();
+        assert_eq!(
+            identities,
+            producer_output_identities(&packet.outputs).unwrap()
+        );
+        // A hardlink is valid producer metadata but never an independent copy.
+        let evidence = packet.evidence();
+        assert!(
+            evidence
+                .reject_producer_alias(
+                    &packet.root.join("producer-hardlink.bin"),
+                    identities[0].device,
+                    identities[0].inode
+                )
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn synthetic_producer_symlink_directory_and_inode_replacement_reject() {
+        let packet = Packet::new();
+        let before = producer_output_identities(&packet.outputs).unwrap();
+        let symlink_path = packet.root.join("symlink.bin");
+        symlink(&packet.outputs[0], &symlink_path).unwrap();
+        assert!(ProducerOutputIdentity::capture(&symlink_path).is_err());
+        assert!(ProducerOutputIdentity::capture(&packet.directory).is_err());
+        let replacement = packet.root.join("replacement.bin");
+        fs::write(&replacement, 1f64.to_le_bytes()).unwrap();
+        fs::rename(&replacement, &packet.outputs[1]).unwrap();
+        assert_ne!(before, producer_output_identities(&packet.outputs).unwrap());
+    }
+
+    #[test]
+    fn synthetic_retained_producer_alias_checks_survive_packet_cleanup() {
+        let packet = Packet::new();
+        let evidence = packet.evidence();
+        let retained = evidence.producer_outputs[2].clone();
+        let identity = evidence.identity().unwrap();
+        fs::remove_dir_all(&packet.directory).unwrap();
+        assert_eq!(identity, evidence.identity().unwrap());
+        assert!(
+            evidence
+                .reject_producer_alias(&packet.directory.join("copy.bin"), 17, 19)
+                .is_err()
+        );
+        assert!(
+            evidence
+                .reject_producer_alias(
+                    &packet.root.join("renamed-alias.bin"),
+                    retained.device,
+                    retained.inode
+                )
+                .is_err()
+        );
+        evidence
+            .reject_producer_alias(&packet.root.join("independent-copy.bin"), 17, 19)
+            .unwrap();
+    }
+}
